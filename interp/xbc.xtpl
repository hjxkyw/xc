#include "totvs.ch"
#include "tlpp-core.th"

// xbc.xtpl -- the interpreter of xc's bytecode (docs/bytecode.md), written
// in xtpl, to run a .xbc on an AppServer.
//
//   appserver -run=u_xbc -env=NAME [out=FILE] [run=NAME] module.xbc ...
//
// It loads the modules, runs each one's __INIT in the order given, then NAME
// -- U_MAIN when it is not given and there is one, else the first user
// function of the last module. The machine is the page's: frames, a stack,
// cells for the locals a code block shares, references copied in and out,
// regions for Break and errors, defers, areas, classes. A function no module
// has is the AppServer's, called by its name; the program's code blocks are
// the AppServer's own, which call back here, so aEval(), aSort() and the
// runtime's verbs run them.
//
// With out=FILE what ConOut() is given and the error nothing catches go to
// FILE instead, as xc-vm writes them -- 'exit N', '--- output', its lines,
// '--- errors', its lines --: what ctest's 'interp' compares with xc-vm's.
//
// xc-vm runs it too (cpp/tests/interp.cmake), after xtpl's runtime, as the
// AppServer has the runtime in its RPO: there the AppServer's macros are
// not, and xc-vm's XBC_ functions call, read and write by name instead.
//
// The names of the machine are hashes ({ => }): the operations, the
// functions, the classes, the variables; the instructions and the frames
// are arrays, which the loop reads by position. The loop keeps TL++'s own
// forms; the rest is xtpl's.
// -----------------------------------------------------------------------------

// ---- instructions -----------------------------------------------------------
#define OP_NIL        1
#define OP_TRUE       2
#define OP_FALSE      3
#define OP_NUM        4
#define OP_STR        5
#define OP_LOCAL      6
#define OP_SETLOCAL   7
#define OP_BOX        8
#define OP_CELL       9
#define OP_SETCELL    10
#define OP_UPVAL      11
#define OP_SETUPVAL   12
#define OP_STATIC     13
#define OP_SETSTATIC  14
#define OP_MEMVAR     15
#define OP_SETMEMVAR  16
#define OP_PRIVATE    17
#define OP_PUBLIC     18
#define OP_FIELD      19
#define OP_SETFIELD   20
#define OP_FIELDX     21
#define OP_SETFIELDX  22
#define OP_REFLOCAL   23
#define OP_REFCELL    24
#define OP_REFUPVAL   25
#define OP_REFSTATIC  26
#define OP_REFMEMVAR  27
#define OP_POP        28
#define OP_DUP        29
#define OP_DUP2       30
#define OP_ARRAY      31
#define OP_INDEX      32
#define OP_SETINDEX   33
#define OP_MEMBER     34
#define OP_SETMEMBER  35
#define OP_SELF       36
#define OP_ADD        37
#define OP_SUB        38
#define OP_MUL        39
#define OP_DIV        40
#define OP_MOD        41
#define OP_POW        42
#define OP_NEG        43
#define OP_NOT        44
#define OP_EQ         45
#define OP_EXACT      46
#define OP_NE         47
#define OP_LT         48
#define OP_GT         49
#define OP_LE         50
#define OP_GE         51
#define OP_CONTAINS   52
#define OP_ISNIL      53
#define OP_JUMP       54
#define OP_JUMPF      55
#define OP_JUMPT      56
#define OP_ANDJUMP    57
#define OP_ORJUMP     58
#define OP_CALL       59
#define OP_CALLX      60
#define OP_METHOD     61
#define OP_SUPER      62
#define OP_NEW        63
#define OP_RET        64
#define OP_BLOCK      65
#define OP_MACRO      66
#define OP_SETMACRO   67
#define OP_LINE       68
#define OP_SEQ        69
#define OP_TRY        70
#define OP_ENDSEQ     71
#define OP_DEFER      72
#define OP_RUNDEFERS  73
#define OP_ENDDEFER   74
#define OP_AREA       75
#define OP_ENDAREA    76

// An instruction: {op, a, b, s, s2, n, what a call found}.
#define I_OP 1
#define I_A  2
#define I_B  3
#define I_S  4
#define I_S2 5
#define I_N  6
#define I_C  7

// A function: {name, kind, parameters, locals, module, instructions}.
#define FN_NAME    1
#define FN_KIND    2
#define FN_PARAMS  3
#define FN_NLOCALS 4
#define FN_MOD     5
#define FN_CODE    6

// A module: {source, statics, NAME => function, namespace, usings, its
// functions in order, the namespaces a plain name is looked for in}.
#define M_SOURCE  1
#define M_STATICS 2
#define M_FNS     3
#define M_NS      4
#define M_USINGS  5
#define M_LIST    6
#define M_SEARCH  7

// A class: {name, module, classes above, data, init, NAME => {function's
// name, static, {function, static} once found}, the init's function}.
#define C_NAME    1
#define C_MOD     2
#define C_SUPERS  3
#define C_DATA    4
#define C_INIT    5
#define C_METHODS 6
#define C_INITFN  7

// A frame: what a call has while it runs.
#define F_FN      1
#define F_LOCALS  2
#define F_STACK   3
#define F_SP      4
#define F_PC      5
#define F_LINE    6
#define F_ARGC    7
#define F_CELLS   8
#define F_SELF    9
#define F_BYREF   10
#define F_REGIONS 11
#define F_AREAS   12
#define F_DEFERS  13
#define F_BACK    14
#define F_PRIVS   15
#define F_CTOR    16

// What a reference and an error on its way are: arrays no program makes,
// their first element one of these.
Static scRef
Static scErr
// What the last Break was given, kept by XbcBreak() for the plain Recover
// that takes it -- scNone once taken. A Recover under USING the AppServer
// runs with Locals that are not the function's, and keeps nothing it
// assigns (probes xdp, xdq).
Static sxBroke
Static scNone

// ---- the entry --------------------------------------------------------------
// The arguments of -run are the command line's: the AppServer's own, then
// ours -- 'out=FILE', 'run=NAME', 'trace=FILE' (or '--out=', ...), the
// modules --; xc-vm gives those after '--'.
User Function xbc(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16)
  Local oVM := XbcVM():New()
  Local aFiles := {}
  Local cOut := ""
  Local cEntry := ""
  Local cTrace := ""
  Local nExit
  scRef := Chr(1) + "xbc reference"
  scErr := Chr(1) + "xbc error"
  scNone := Chr(1) + "xbc none"
  sxBroke := scNone
  for xArg in {p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16}
    Local cArg := If(ValType(xArg) == "C", xArg, "")
    Local cOpt := If(Left(cArg, 2) == "--", SubStr(cArg, 3), cArg)
    Do Case
    Case Empty(cArg)
      Loop
    Case Left(cOpt, 4) == "out="
      cOut := SubStr(cOpt, 5)
    Case Left(cOpt, 4) == "run="
      cEntry := SubStr(cOpt, 5)
    Case Left(cOpt, 6) == "trace="
      cTrace := SubStr(cOpt, 7)
    Case !(Left(cArg, 1) == "-" .Or. ".exe" $ Lower(cArg) .Or. "appsrv" $ Lower(cArg))
      AAdd(aFiles, cArg)
    EndCase
  next
  oVM:lCapture := !Empty(cOut)
  oVM:aTrace := {} if !Empty(cTrace)
  nExit := oVM:Start(aFiles, cEntry)
  oVM:Report(cOut, nExit) if !Empty(cOut)
  MemoWrite(cTrace, oVM:aTrace |> map([l] l + Chr(10)) |> join) if !Empty(cTrace)
Return nExit

// Is it a reference, an error on its way.
Static Function XbcIsRef(xValue)
Return ValType(xValue) == "A" .And. Len(xValue) == 3 .And. ValType(xValue[1]) == "C" .And. xValue[1] == scRef

Static Function XbcIsErr(xValue)
Return ValType(xValue) == "A" .And. Len(xValue) == 2 .And. ValType(xValue[1]) == "C" .And. xValue[1] == scErr

// A Break, its value kept for the Recover that takes it: every Break the
// machine can take comes through here -- the program's Break(), its own,
// an error on its way.
Static Function XbcBreak(xValue)
  sxBroke := xValue
  Break(xValue)
Return Nil

// What the Break a plain Recover took was given, and forgotten: Nil for one
// that did not come through XbcBreak() -- a Break in a block a macro of the
// program's made, which the AppServer runs.
Static Function XbcCaught()
  Local xValue := sxBroke
  sxBroke := scNone
Return If(ValType(xValue) == "C" .And. xValue == scNone, Nil, xValue)

// ---- the machine ------------------------------------------------------------
Class XbcVM
  Public Data aMods
  Public Data hOps
  Public Data hEvery
  Public Data hGlobals
  Public Data hClasses
  Public Data aFrames
  Public Data hPrivs
  Public Data hPubs
  Public Data hCache
  Public Data bProgErr
  Public Data lInErr
  Public Data cWhere
  Public Data aOut
  Public Data aErr
  Public Data lCapture
  Public Data lHost
  Public Data aTrace
  Public Data aOpNames
  Public Method New() Constructor
  Public Method Start(aFiles, cEntry)
  Public Method Report(cFile, nExit)
  Public Method Load(cPath)
  Public Method Parsed(cLine, cPath)
  Public Method Run(nBase)
  Public Method Exec(nBase)
  Public Method Unwind(nBase, xWhat, lError)
  Public Method Push(aFn, aArgs, aCells, xSelf)
  Public Method EndFrame(aF)
  Public Method Resolve(aMod, cName, lMacro)
  Public Method ClassNamed(aMod, cName)
  Public Method MethodOf(aCls, cName)
  Public Method Above(aCls, cName)
  Public Method Instance(aCls)
  Public Method Invoke(aF, cName, aArgs, lMacro, aIns)
  Public Method CallNative(cName, aArgs)
  Public Method Native(cWhat, cName, cMethod, xObj, aArgs)
  Public Method MethodCall(xObj, cName, aArgs)
  Public Method MemberOf(xObj, cName)
  Public Method SetMemberOf(xObj, cName, xValue)
  Public Method NewNative(cClass, cName, aArgs)
  Public Method MemCell(cName)
  Public Method PrivCell(cName, lFresh)
  Public Method Fail(cMessage)
  Public Method OnError(oErr)
  Public Method Trace(aF, nPc, aIns, nSp, aSt)
  Public Method Note(cLine)
  Public Method MakeBlock(aClo)
  Public Method Enter(aClo, aArgs)
  Public Method Macro(cText)
  Public Method SetMacro(cText, xValue)
  Public Method FieldOf(cAlias, cName)
  Public Method SetFieldOf(cAlias, cName, xValue)
  Public Method Cached(cKey, cSource)
EndClass

Method New() Class XbcVM
  // Each operation's number, and what follows its word: I a number, W a
  // word, N a number as AdvPL reads it, S a string.
  Local aOps := {{"nil", ""}, {"true", ""}, {"false", ""}, {"num", "N"}, {"str", "S"}, {"local", "I"}, ;
                 {"setlocal", "I"}, {"box", "I"}, {"cell", "I"}, {"setcell", "I"}, {"upval", "I"}, ;
                 {"setupval", "I"}, {"static", "I"}, {"setstatic", "I"}, {"memvar", "W"}, {"setmemvar", "W"}, ;
                 {"private", "W"}, {"public", "W"}, {"field", "WW"}, {"setfield", "WW"}, {"fieldx", "W"}, ;
                 {"setfieldx", "W"}, {"reflocal", "I"}, {"refcell", "I"}, {"refupval", "I"}, ;
                 {"refstatic", "I"}, {"refmemvar", "W"}, {"pop", ""}, {"dup", ""}, {"dup2", ""}, ;
                 {"array", "I"}, {"index", ""}, {"setindex", ""}, {"member", "W"}, {"setmember", "W"}, ;
                 {"self", ""}, {"add", ""}, {"sub", ""}, {"mul", ""}, {"div", ""}, {"mod", ""}, {"pow", ""}, ;
                 {"neg", ""}, {"not", ""}, {"eq", ""}, {"exact", ""}, {"ne", ""}, {"lt", ""}, {"gt", ""}, ;
                 {"le", ""}, {"ge", ""}, {"contains", ""}, {"isnil", ""}, {"jump", "I"}, {"jumpf", "I"}, ;
                 {"jumpt", "I"}, {"andjump", "I"}, {"orjump", "I"}, {"call", "IW"}, {"callx", "I"}, ;
                 {"method", "IW"}, {"super", "IW"}, {"new", "IWW"}, {"ret", ""}, {"block", "WI"}, ;
                 {"macro", ""}, {"setmacro", ""}, {"line", "I"}, {"seq", "I"}, {"try", "I"}, {"endseq", ""}, ;
                 {"defer", "II"}, {"rundefers", ""}, {"enddefer", ""}, {"area", ""}, {"endarea", ""}}
  ::hOps := { => }
  for aOp, nOp in aOps
    ::hOps{aOp[1]} := {nOp, aOp[2]}
  next
  ::aOpNames := aOps
  ::aTrace := Nil
  ::aMods := {}
  ::hEvery := { => }
  ::hGlobals := { => }
  ::hClasses := { => }
  ::aFrames := {}
  ::hPrivs := { => }
  ::hPubs := { => }
  ::hCache := { => }
  ::bProgErr := Nil
  ::lInErr := .F.
  ::cWhere := ""
  ::aOut := {}
  ::aErr := {}
  ::lCapture := .F.
  ::lHost := FindFunction("XBC_CALL")
Return Self

// Loads the modules, runs their __INITs, then the entry: what the process
// exits with.
Method Start(aFiles, cEntry) Class XbcVM
  Local bOld := ErrorBlock({|oErr| ::OnError(oErr)})
  Local nExit := 0
  Local xCaught
  Local aFn
  defer ErrorBlock(bOld)
  Begin Sequence
    aFiles |> tap([c] ::Load(c))
    for aMod in ::aMods
      If local aInit := aMod[M_FNS]{"__INIT"}, aInit != Nil
        ::Push(aInit, {}, Nil, Nil)
        ::Run(Len(::aFrames))
      EndIf
    next
    If !Empty(cEntry)
      aFn := ::hGlobals{Upper(cEntry)}
    ElseIf ::hGlobals has "U_MAIN"
      aFn := ::hGlobals{"U_MAIN"}
    ElseIf !Empty(::aMods)
      aFn := ATail(::aMods)[M_LIST] |> first([f] f[FN_KIND] == "user")
    EndIf
    If aFn == Nil
      AAdd(::aErr, "xc-vm: nothing to run")
      nExit := 2
    Else
      ::Push(aFn, {}, Nil, Nil)
      ::Run(Len(::aFrames))
    EndIf
  Recover
    xCaught := XbcCaught()
    Do Case
    Case XbcIsErr(xCaught)
      AAdd(::aErr, "xc-vm: error: ${::MemberOf(xCaught[2], 'Description')} (${::cWhere})")
      nExit := 1
    Case ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: "
      AAdd(::aErr, xCaught)
      nExit := 2
    Otherwise
      AAdd(::aErr, "xc-vm: a Break with no Begin Sequence to take it")
      nExit := 1
    EndCase
  End Sequence
  ::aErr |> tap(ConOut) if !::lCapture
Return nExit

// What ran, as xc-vm prints it: its exit code, its output, its errors.
Method Report(cFile, nExit) Class XbcVM
  Local cNl := Chr(10)
  MemoWrite(cFile, "exit ${nExit}" + cNl + "--- output" + cNl + (::aOut |> map([l] l + cNl) |> join) + ;
                   "--- errors" + cNl + (::aErr |> map([l] l + cNl) |> join))
Return Nil

// ---- loading ----------------------------------------------------------------
// A .xbc: its header, its classes, its functions; each instruction parsed
// once, into an array. A word is compared with '==': AdvPL's '=' and '!='
// take "endseq" for "end".
Method Load(cPath) Class XbcVM
  Local aLines := {}
  Local aMod := {cPath, {}, { => }, "", {}, {}, {}}
  Local aWords
  Local aCls
  Local aFn
  Local nI := 4
  for cRead in XbcLines(cPath)
    Local cLine := LTrim(StrTran(StrTran(cRead, Chr(13), ""), Chr(9), " "))
    AAdd(aLines, cLine) if !Empty(cLine)
  next
  XbcBreak("xc-vm: ${cPath}: not a .xbc of version 1") if Len(aLines) < 3 .Or. !(aLines[1] == "xbc 1")
  aMod[M_SOURCE] := XbcWords(aLines[2])[2]
  aMod[M_STATICS] := Array(Val(XbcWords(aLines[3])[2]))
  While nI <= Len(aLines)
    aWords := XbcWords(aLines[nI++])
    Do Case With local cWord := aWords[1]
    Case cWord == "namespace"
      aMod[M_NS] := aWords[2]
    Case cWord == "using"
      AAdd(aMod[M_USINGS], aWords[2])
    Case cWord == "class"
      // class NAME / from ... / data ... / init F / method N F / static N F / end
      aCls := {aWords[2], aMod, {}, {}, "", { => }, Nil}
      While nI <= Len(aLines) .And. !(aLines[nI] == "end")
        aWords := XbcWords(aLines[nI++])
        Do Case With local cLine := aWords[1]
        Case cLine == "from"
          aCls[C_SUPERS] := aWords |> drop(1)
        Case cLine == "data"
          aCls[C_DATA] := aWords |> drop(1)
        Case cLine == "init"
          aCls[C_INIT] := aWords[2]
        Case cLine == "method" .Or. cLine == "static"
          aCls[C_METHODS]{aWords[2]} := {aWords[3], cLine == "static", Nil}
        EndCase
      EndDo
      nI++
      ::hClasses{aCls[C_NAME]} := aCls
    Case cWord == "function"
      aFn := {aWords[2], aWords[3], Val(aWords[4]), Val(aWords[5]), aMod, {}}
      While nI <= Len(aLines) .And. !(aLines[nI] == "end")
        Local cIns := aLines[nI++]
        AAdd(aFn[FN_CODE], ::Parsed(cIns, cPath)) if !XbcNames(cIns)
      EndDo
      nI++
      aMod[M_FNS]{Upper(aFn[FN_NAME])} := aFn
      AAdd(aMod[M_LIST], aFn)
      ::hEvery{Upper(aFn[FN_NAME])} := aFn
      ::hGlobals{Upper(aFn[FN_NAME])} := aFn if aFn[FN_KIND] in {"user", "function", "main"}
    EndCase
  EndDo
  // Where a plain name is looked for: the namespace, then those it uses.
  aMod[M_SEARCH] := If(Empty(aMod[M_NS]), {}, {Upper(aMod[M_NS])})
  aMod[M_USINGS] |> tap([u] AAdd(aMod[M_SEARCH], Upper(u)))
  AAdd(::aMods, aMod)
Return aMod

// 'locals ...', 'upvals ...': names, for a debugger to show. ('in' is no
// use for a word: it asks aScan(), whose '=' takes "local" for "locals".)
Static Function XbcNames(cLine)
  Local cWord := XbcWords(cLine)[1]
Return cWord == "locals" .Or. cWord == "upvals"

// An instruction: its operation's number and its operands, by its shape.
Method Parsed(cLine, cPath) Class XbcVM
  Local nAt := At(" ", cLine)
  Local cWord := If(nAt > 0, Left(cLine, nAt - 1), cLine)
  Local aOp := ::hOps{cWord}
  Local aIns
  Local aWords
  XbcBreak("xc-vm: ${cPath}: no instruction '${cWord}'") if aOp == Nil
  aIns := {aOp[1], 0, 0, "", "", 0, Nil}
  Do Case
  Case aOp[2] == "S"
    // The string: from the first '"' to the last character of the line.
    nAt := At('"', cLine)
    aIns[I_S] := SubStr(cLine, nAt + 1, Len(cLine) - nAt - 1)
  Case !Empty(aOp[2])
    aWords := XbcWords(cLine)
    for nW in 1..Len(aOp[2])
      Local cKind := SubStr(aOp[2], nW, 1)
      Local cArg := If(nW < Len(aWords), aWords[nW + 1], "")
      Do Case
      Case cKind == "N"
        aIns[I_N] := Val(cArg)
      Case cKind == "I"
        aIns[If(nW == 1, I_A, I_B)] := Val(cArg)
      Otherwise
        aIns[If(Empty(aIns[I_S]), I_S, I_S2)] := cArg
      EndCase
    next
  EndCase
Return aIns

// The words of a line, one blank or more between them.
Static Function XbcWords(cLine)
  Local aWords := split(AllTrim(cLine), " ") |> reject([w] Empty(w))
Return If(Empty(aWords), {""}, aWords)

// A file's lines, read whole: the AppServer's FT_FReadLn() -- and so
// lines() -- gives a line longer than 1023 characters in pieces, and a
// string of the bytecode's makes one.
Static Function XbcLines(cPath)
  Local nFile := FOpen(cPath, 0)
  Local cText := ""
  Local cBlock
  Local nRead
  XbcBreak("xc-vm: ${cPath}: cannot be read") if nFile < 0
  defer FClose(nFile)
  While .T.
    cBlock := Space(65536)
    nRead := FRead(nFile, @cBlock, 65536)
    Exit if nRead <= 0
    cText += Left(cBlock, nRead)
  EndDo
Return split(StrTran(cText, Chr(13), ""), Chr(10))

// ---- frames -----------------------------------------------------------------
// A frame for a function of a module: its parameters from the arguments --
// a reference's value, written back when it ends.
Method Push(aFn, aArgs, aCells, xSelf) Class XbcVM
  Local aLocals := Array(aFn[FN_NLOCALS])
  Local aByRef := {}
  ::Fail("stack overflow") if Len(::aFrames) > 4000
  for xArg, nI in aArgs
    Exit if nI > aFn[FN_PARAMS]
    If XbcIsRef(xArg)
      aLocals[nI] := xArg[2][xArg[3]]
      AAdd(aByRef, {nI, xArg})
    Else
      aLocals[nI] := xArg
    EndIf
  next
  AAdd(::aFrames, {aFn, aLocals, Array(16), 0, 1, 0, Len(aArgs), aCells, xSelf, aByRef, {}, {}, {}, 0, {}, .F.})
Return Nil

// A frame's end: what its parameters passed by reference hold written back
// -- a cell's value, for one a code block shares --, its privates gone.
Method EndFrame(aF) Class XbcVM
  for aBy in aF[F_BYREF]
    Local xValue := aF[F_LOCALS][aBy[1]]
    xValue := xValue[1] if XbcBoxed(aF, aBy[1])
    aBy[2][2][aBy[2][3]] := xValue
  next
  for cName in aF[F_PRIVS]
    Local aStack := ::hPrivs{cName}
    ASize(aStack, Len(aStack) - 1)
  next
Return Nil

// Is local N of the frame a cell: its function boxes it, at its start.
Static Function XbcBoxed(aF, nLocal)
Return aF[F_FN][FN_CODE] |> takewhile([i] i[I_OP] == OP_BOX) |> anyof([i] i[I_A] == nLocal)

// Runs until the frame at nBase returns, and gives what it returned. A Break
// -- the program's, or an error on its way -- goes to the innermost region
// that takes it in this run; with none, on to the run that called. Its
// value is XbcBreak()'s: a plain Recover, not one under USING.
Method Run(nBase) Class XbcVM
  Local xResult
  Local xCaught
  Local lDone := .F.
  While !lDone
    sxBroke := scNone
    Begin Sequence
      xResult := ::Exec(nBase)
      lDone := .T.
    Recover
      xCaught := XbcCaught()
      ::lInErr := .F.
      If ::aTrace != Nil
        ::Note("  caught by the run from frame ${nBase}: " + ;
                       If(XbcIsErr(xCaught), "error " + ::MemberOf(xCaught[2], "Description"), XbcShown(xCaught)))
      EndIf
    End Sequence
    If !lDone
      // The machine's own trouble -- a file it cannot read -- goes all the
      // way out.
      XbcBreak(xCaught) if ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: "
      XbcBreak(xCaught) if !::Unwind(nBase, If(XbcIsErr(xCaught), xCaught[2], xCaught), XbcIsErr(xCaught))
    EndIf
  EndDo
Return xResult

// The innermost region that takes it -- a Break any, an error a 'try' --:
// the frames above it go, its stack is cut back, the value pushed. False
// when none in this run does: then the run's frames go.
Method Unwind(nBase, xWhat, lError) Class XbcVM
  For local nK := Len(::aFrames) To nBase Step -1
    Local aF := ::aFrames[nK]
    For local nR := Len(aF[F_REGIONS]) To 1 Step -1
      Local aReg := aF[F_REGIONS][nR]
      Loop if lError .And. !aReg[1]
      While Len(::aFrames) > nK
        ::EndFrame(ATail(::aFrames))
        ASize(::aFrames, Len(::aFrames) - 1)
      EndDo
      ASize(aF[F_REGIONS], nR - 1)
      ASize(aF[F_AREAS], aReg[4])
      aF[F_SP] := aReg[3] + 1
      ASize(aF[F_STACK], aF[F_SP] * 2) if aF[F_SP] > Len(aF[F_STACK])
      aF[F_STACK][aF[F_SP]] := xWhat
      aF[F_PC] := aReg[2]
      Return .T.
    Next
  Next
  While Len(::aFrames) >= nBase
    ::EndFrame(ATail(::aFrames))
    ASize(::aFrames, Len(::aFrames) - 1)
  EndDo
Return .F.

// ---- the loop ---------------------------------------------------------------
Method Exec(nBase) Class XbcVM
  Local aF := ::aFrames[Len(::aFrames)]
  Local aCode := aF[F_FN][FN_CODE]
  Local aSt := aF[F_STACK]
  Local nSp := aF[F_SP]
  Local nPc := aF[F_PC]
  Local aIns
  Local nOp
  Local aArgs
  Local xA
  Local xB
  Local xC
  Local nI
  Local nN
  Local aCls
  Local aM
  Local aFn
  Local cName
  Local nAt
  While .T.
    aIns := aCode[nPc]
    ::Trace(aF, nPc, aIns, nSp, aSt) if ::aTrace != Nil
    nPc++
    nOp := aIns[I_OP]
    If nOp <= OP_REFMEMVAR
      Do Case
        Case nOp == OP_LOCAL
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aF[F_LOCALS][aIns[I_A]]
        Case nOp == OP_SETLOCAL
          aF[F_LOCALS][aIns[I_A]] := aSt[nSp]
          nSp--
        Case nOp == OP_NUM
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aIns[I_N]
        Case nOp == OP_STR
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aIns[I_S]
        Case nOp == OP_NIL .Or. nOp == OP_TRUE .Or. nOp == OP_FALSE
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := If(nOp == OP_NIL, Nil, nOp == OP_TRUE)
        Case nOp == OP_CELL
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aF[F_LOCALS][aIns[I_A]][1]
        Case nOp == OP_SETCELL
          aF[F_LOCALS][aIns[I_A]][1] := aSt[nSp]
          nSp--
        Case nOp == OP_BOX
          aF[F_LOCALS][aIns[I_A]] := {aF[F_LOCALS][aIns[I_A]]}
        Case nOp == OP_UPVAL
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aF[F_CELLS][aIns[I_A]][1]
        Case nOp == OP_SETUPVAL
          aF[F_CELLS][aIns[I_A]][1] := aSt[nSp]
          nSp--
        Case nOp == OP_STATIC
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]]
        Case nOp == OP_SETSTATIC
          aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]] := aSt[nSp]
          nSp--
        Case nOp == OP_MEMVAR
          xA := ::MemCell(aIns[I_S])
          ::Fail("variable does not exist: ${aIns[I_S]}") if xA == Nil
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := xA[1]
        Case nOp == OP_SETMEMVAR
          xA := ::MemCell(aIns[I_S]) ?: ::PrivCell(aIns[I_S])
          xA[1] := aSt[nSp]
          nSp--
        Case nOp == OP_PRIVATE
          ::PrivCell(aIns[I_S], .T.)
        Case nOp == OP_PUBLIC
          ::hPubs{aIns[I_S]} := {Nil} if !(::hPubs has aIns[I_S])
        Case nOp == OP_FIELD
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := ::FieldOf(aIns[I_S], aIns[I_S2])
        Case nOp == OP_SETFIELD
          ::SetFieldOf(aIns[I_S], aIns[I_S2], aSt[nSp])
          nSp--
        Case nOp == OP_FIELDX
          aSt[nSp] := ::FieldOf(aSt[nSp], aIns[I_S])
        Case nOp == OP_SETFIELDX
          ::SetFieldOf(aSt[nSp - 1], aIns[I_S], aSt[nSp])
          nSp -= 2
        Case nOp == OP_REFLOCAL
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := {scRef, aF[F_LOCALS], aIns[I_A]}
        Case nOp == OP_REFCELL
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := {scRef, aF[F_LOCALS][aIns[I_A]], 1}
        Case nOp == OP_REFUPVAL
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := {scRef, aF[F_CELLS][aIns[I_A]], 1}
        Case nOp == OP_REFSTATIC
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := {scRef, aF[F_FN][FN_MOD][M_STATICS], aIns[I_A]}
        Case nOp == OP_REFMEMVAR
          xA := ::MemCell(aIns[I_S]) ?: ::PrivCell(aIns[I_S])
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := {scRef, xA, 1}
      EndCase
    ElseIf nOp <= OP_SELF
      Do Case
        Case nOp == OP_POP
          nSp--
        Case nOp == OP_INDEX
          xA := aSt[nSp - 1]
          xB := aSt[nSp]
          nSp--
          aSt[nSp] := xA[xB]
        Case nOp == OP_MEMBER
          aSt[nSp] := ::MemberOf(aSt[nSp], aIns[I_S])
        Case nOp == OP_SETMEMBER
          ::SetMemberOf(aSt[nSp - 1], aIns[I_S], aSt[nSp])
          nSp -= 2
        Case nOp == OP_SETINDEX
          xA := aSt[nSp - 2]
          xA[aSt[nSp - 1]] := aSt[nSp]
          nSp -= 3
        Case nOp == OP_DUP
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aSt[nSp - 1]
        Case nOp == OP_DUP2
          nSp += 2
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp - 1] := aSt[nSp - 3]
          aSt[nSp] := aSt[nSp - 2]
        Case nOp == OP_ARRAY
          nN := aIns[I_A]
          xA := Array(nN)
          For nI := 1 To nN
            xA[nI] := aSt[nSp - nN + nI]
          Next
          nSp := nSp - nN + 1
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := xA
        Case nOp == OP_SELF
          nSp++
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := aF[F_SELF]
      EndCase
    ElseIf nOp <= OP_ORJUMP
      Do Case
        Case nOp == OP_JUMPF
          If !aSt[nSp]
            nPc := aIns[I_A]
          EndIf
          nSp--
        Case nOp == OP_JUMP
          nPc := aIns[I_A]
        Case nOp == OP_ADD
          aSt[nSp - 1] := aSt[nSp - 1] + aSt[nSp]
          nSp--
        Case nOp == OP_SUB
          aSt[nSp - 1] := aSt[nSp - 1] - aSt[nSp]
          nSp--
        Case nOp == OP_MUL
          aSt[nSp - 1] := aSt[nSp - 1] * aSt[nSp]
          nSp--
        Case nOp == OP_DIV
          aSt[nSp - 1] := aSt[nSp - 1] / aSt[nSp]
          nSp--
        Case nOp == OP_MOD
          aSt[nSp - 1] := aSt[nSp - 1] % aSt[nSp]
          nSp--
        Case nOp == OP_POW
          aSt[nSp - 1] := aSt[nSp - 1] ** aSt[nSp]
          nSp--
        Case nOp == OP_NEG
          aSt[nSp] := -aSt[nSp]
        Case nOp == OP_NOT
          aSt[nSp] := !aSt[nSp]
        Case nOp == OP_EQ
          aSt[nSp - 1] := (aSt[nSp - 1] = aSt[nSp])
          nSp--
        Case nOp == OP_EXACT
          aSt[nSp - 1] := (aSt[nSp - 1] == aSt[nSp])
          nSp--
        Case nOp == OP_NE
          aSt[nSp - 1] := (aSt[nSp - 1] != aSt[nSp])
          nSp--
        Case nOp == OP_LT
          aSt[nSp - 1] := (aSt[nSp - 1] < aSt[nSp])
          nSp--
        Case nOp == OP_GT
          aSt[nSp - 1] := (aSt[nSp - 1] > aSt[nSp])
          nSp--
        Case nOp == OP_LE
          aSt[nSp - 1] := (aSt[nSp - 1] <= aSt[nSp])
          nSp--
        Case nOp == OP_GE
          aSt[nSp - 1] := (aSt[nSp - 1] >= aSt[nSp])
          nSp--
        Case nOp == OP_CONTAINS
          aSt[nSp - 1] := (aSt[nSp - 1] $ aSt[nSp])
          nSp--
        Case nOp == OP_ISNIL
          aSt[nSp] := (ValType(aSt[nSp]) == "U")
        Case nOp == OP_JUMPT
          If aSt[nSp]
            nPc := aIns[I_A]
          EndIf
          nSp--
        Case nOp == OP_ANDJUMP
          If !aSt[nSp]
            nPc := aIns[I_A]
          Else
            nSp--
          EndIf
        Case nOp == OP_ORJUMP
          If aSt[nSp]
            nPc := aIns[I_A]
          Else
            nSp--
          EndIf
      EndCase
    Else
      Do Case
        Case nOp == OP_LINE
          aF[F_LINE] := aIns[I_A]
        Case nOp == OP_CALL .Or. nOp == OP_CALLX
          nN := aIns[I_A]
          aArgs := Array(nN)
          For nI := 1 To nN
            aArgs[nI] := aSt[nSp - nN + nI]
          Next
          nSp -= nN
          If nOp == OP_CALLX
            cName := aSt[nSp]
            nSp--
            ::Fail("&name.(): the name is no string") if ValType(cName) != "C"
          Else
            cName := aIns[I_S]
          EndIf
          aF[F_SP] := nSp
          aF[F_PC] := nPc
          xA := ::Invoke(aF, cName, aArgs, nOp == OP_CALLX, If(nOp == OP_CALL, aIns, Nil))
          If xA
            // A function of a module: its frame runs on.
            aF := ::aFrames[Len(::aFrames)]
            aCode := aF[F_FN][FN_CODE]
            aSt := aF[F_STACK]
            nSp := aF[F_SP]
            nPc := aF[F_PC]
          Else
            nSp := aF[F_SP]
          EndIf
        Case nOp == OP_RET
          xA := aSt[nSp]
          xA := aF[F_SELF] if aF[F_CTOR]
          ::EndFrame(aF)
          ASize(::aFrames, Len(::aFrames) - 1)
          If Len(::aFrames) < nBase
            Return xA
          EndIf
          aF := ::aFrames[Len(::aFrames)]
          aCode := aF[F_FN][FN_CODE]
          aSt := aF[F_STACK]
          nSp := aF[F_SP] + 1
          nPc := aF[F_PC]
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := xA
        Case nOp == OP_METHOD .Or. nOp == OP_SUPER .Or. nOp == OP_NEW
          nN := aIns[I_A]
          aArgs := Array(nN)
          For nI := 1 To nN
            aArgs[nI] := aSt[nSp - nN + nI]
          Next
          nSp -= nN
          aFn := Nil
          xC := Nil
          aF[F_SP] := nSp
          aF[F_PC] := nPc
          If nOp == OP_METHOD
            xB := aSt[nSp]
            nSp--
            aF[F_SP] := nSp
            If ValType(xB) == "O" .And. XbcIsObj(xB)
              aCls := xB:xbcCls
              // The class it found last, and the method: one class a call
              // sees, as a rule.
              If aIns[I_C] != Nil .And. aIns[I_C][1] == aCls
                aM := aIns[I_C][2]
              Else
                aM := ::MethodOf(aCls, Upper(aIns[I_S]))
                ::Fail("no method ${aIns[I_S]} of ${aCls[C_NAME]}") if aM == Nil
                aIns[I_C] := {aCls, aM}
              EndIf
              aFn := aM[1]
              xC := xB
            Else
              xA := ::MethodCall(xB, aIns[I_S], aArgs)
              nSp++
              If nSp > Len(aSt)
                ASize(aSt, nSp * 2)
              EndIf
              aSt[nSp] := xA
            EndIf
          ElseIf nOp == OP_SUPER
            cName := Upper(aF[F_FN][FN_NAME])
            nAt := At("#", cName)
            If nAt > 0
              cName := Left(cName, nAt - 1)
            EndIf
            nAt := At(":", cName)
            aCls := If(nAt > 0, ::hClasses{Left(cName, nAt - 1)}, Nil)
            ::Fail("_Super outside a method") if aCls == Nil
            aM := ::Above(aCls, Upper(aIns[I_S]))
            aFn := If(aM != Nil, aM[1], Nil)
            If aFn == Nil
              // A class above that is the AppServer's: its constructor is Self.
              ::Fail("no method ${aIns[I_S]} above ${aCls[C_NAME]}") if !(Upper(aIns[I_S]) == "NEW")
              nSp++
              If nSp > Len(aSt)
                ASize(aSt, nSp * 2)
              EndIf
              aSt[nSp] := aF[F_SELF]
            Else
              xC := aF[F_SELF]
            EndIf
          Else
            // 'Name():M(...)': an object of the class, M run on it -- the
            // object what the caller gets; a static M, what it returns.
            aCls := ::ClassNamed(aF[F_FN][FN_MOD], aIns[I_S])
            If aCls == Nil
              xA := ::NewNative(aIns[I_S], aIns[I_S2], aArgs)
              nSp++
              If nSp > Len(aSt)
                ASize(aSt, nSp * 2)
              EndIf
              aSt[nSp] := xA
            Else
              aM := ::MethodOf(aCls, Upper(aIns[I_S2]))
              ::Fail("Cannot find method ${aCls[C_NAME]}:${Upper(aIns[I_S2])}") if aM == Nil
              aFn := aM[1]
              xC := ::Instance(aCls) if !aM[2]
            EndIf
          EndIf
          If aFn != Nil
            ::Push(aFn, aArgs, Nil, xC)
            ATail(::aFrames)[F_CTOR] := .T. if nOp == OP_NEW .And. xC != Nil
            aF := ::aFrames[Len(::aFrames)]
            aCode := aF[F_FN][FN_CODE]
            aSt := aF[F_STACK]
            nSp := aF[F_SP]
            nPc := aF[F_PC]
          EndIf
        Case nOp == OP_BLOCK
          nN := aIns[I_B]
          aIns[I_C] ?= aF[F_FN][FN_MOD][M_FNS]{Upper(aIns[I_S])}
          aFn := aIns[I_C]
          ::Fail("no block function ${aIns[I_S]}") if aFn == Nil
          xA := Array(nN)
          For nI := 1 To nN
            xA[nI] := aSt[nSp - nN + nI][2]
          Next
          nSp := nSp - nN + 1
          If nSp > Len(aSt)
            ASize(aSt, nSp * 2)
          EndIf
          aSt[nSp] := ::MakeBlock({aFn, xA, aF[F_SELF]})
        Case nOp == OP_MACRO
          aSt[nSp] := ::Macro(aSt[nSp])
        Case nOp == OP_SETMACRO
          ::SetMacro(aSt[nSp - 1], aSt[nSp])
          nSp -= 2
        Case nOp == OP_SEQ .Or. nOp == OP_TRY
          AAdd(aF[F_REGIONS], {nOp == OP_TRY, aIns[I_A], nSp, Len(aF[F_AREAS])})
        Case nOp == OP_ENDSEQ
          ASize(aF[F_REGIONS], Len(aF[F_REGIONS]) - 1)
        Case nOp == OP_DEFER
          // Once, however many times it is reached.
          AAdd(aF[F_DEFERS], {aIns[I_A], aIns[I_B]}) if !(aF[F_DEFERS] |> anyof([d] d[1] == aIns[I_A]))
        Case nOp == OP_RUNDEFERS
          // The highest number first: the last one written.
          If !Empty(aF[F_DEFERS])
            xA := aF[F_DEFERS] |> maxby([d] d[1])
            aF[F_BACK] := nPc - 1
            nPc := xA[2]
            aF[F_DEFERS] := aF[F_DEFERS] |> reject([d] d[1] == xA[1])
          EndIf
        Case nOp == OP_ENDDEFER
          nPc := aF[F_BACK]
        Case nOp == OP_AREA
          AAdd(aF[F_AREAS], ::CallNative("Select", {}))
          ::CallNative("DbSelectArea", {aSt[nSp]})
          nSp--
        Case nOp == OP_ENDAREA
          ::CallNative("DbSelectArea", {ATail(aF[F_AREAS])})
          ASize(aF[F_AREAS], Len(aF[F_AREAS]) - 1)
      EndCase
    EndIf
  EndDo
Return Nil

// ---- calls ------------------------------------------------------------------
// A call by name: a function of a module pushes its frame, .T.; any other is
// the AppServer's, its result on the caller's stack, .F. What a 'call'
// found is kept in its instruction.
Method Invoke(aF, cName, aArgs, lMacro, aIns) Class XbcVM
  Local xFound
  Local xResult
  If aIns != Nil
    aIns[I_C] ?= ::Resolve(aF[F_FN][FN_MOD], cName, lMacro)
    xFound := aIns[I_C]
  Else
    xFound := ::Resolve(aF[F_FN][FN_MOD], cName, lMacro)
  EndIf
  If ValType(xFound) == "A"
    ::Push(xFound, aArgs, Nil, Nil)
    Return .T.
  EndIf
  // The AppServer's -- but what is the frame's, or the program's, or a
  // Break, whose value a plain Recover is to find.
  Do Case
  Case xFound == "PCOUNT"
    xResult := aF[F_ARGC]
  Case xFound == "BREAK"
    XbcBreak(If(Empty(aArgs), Nil, aArgs[1]))
  Case xFound == "EVAL" .And. !Empty(aArgs) .And. ValType(aArgs[1]) == "B" .And. !(aArgs |> anyof([x] XbcIsRef(x)))
    xResult := XbcEvalArgs(aArgs[1], aArgs |> drop(1))
  Case xFound == "ERRORBLOCK"
    xResult := ::bProgErr
    ::bProgErr := aArgs[1] if !Empty(aArgs)
  Case (xFound == "CONOUT" .Or. xFound == "QOUT") .And. ::lCapture
    aArgs |> tap([x] AAdd(::aOut, If(ValType(x) $ "CNLDF", cValToChar(x), "")))
  Otherwise
    xResult := ::CallNative(cName, aArgs)
  EndCase
  aF[F_SP]++
  ASize(aF[F_STACK], aF[F_SP] * 2) if aF[F_SP] > Len(aF[F_STACK])
  aF[F_STACK][aF[F_SP]] := xResult
Return .F.

// A function by name, from a module: its own, then -- a name with no
// namespace -- its namespace's, then those it uses, then one of no
// namespace; a macro's name in no namespace. Else the AppServer's: its name
// in upper case.
Method Resolve(aMod, cName, lMacro) Class XbcVM
  Local cUp := Upper(cName)
  Local aFn := aMod[M_FNS]{cUp}
  Return aFn if aFn != Nil .And. aFn[FN_KIND] in {"user", "static", "function", "main"}
  If !lMacro .And. !("." $ cUp)
    aFn := aMod[M_SEARCH] |> map([n] ::hGlobals{n + "." + cUp}) |> first([f] f != Nil)
    Return aFn if aFn != Nil
  EndIf
Return ::hGlobals{cUp} ?: cUp

// A class by name, from a module: as a function is found.
Method ClassNamed(aMod, cName) Class XbcVM
  Local cUp := Upper(cName)
  Local aCls
  If !("." $ cUp)
    aCls := aMod[M_SEARCH] |> map([n] ::hClasses{n + "." + cUp}) |> first([c] c != Nil)
    Return aCls if aCls != Nil
  EndIf
Return ::hClasses{cUp}

// A method, of the class or of one above it: {its function, static}.
Method MethodOf(aCls, cName) Class XbcVM
  If local aM := aCls[C_METHODS]{cName}, aM != Nil
    aM[3] ?= {::hEvery{Upper(aM[1])}, aM[2]}
    Return aM[3] if aM[3][1] != Nil
  EndIf
Return ::Above(aCls, cName)

// The method of the classes above it, in the order 'from' says.
Method Above(aCls, cName) Class XbcVM
Return aCls[C_SUPERS] ;
         |> map([s] ::ClassNamed(aCls[C_MOD], s)) ;
         |> filter([k] k != Nil) ;
         |> map([k] ::MethodOf(k, cName)) ;
         |> first([m] m != Nil)

// A new object of a module's class: the data of the classes above it and
// its own, Nil, then the values each class gives them, the topmost first.
Method Instance(aCls) Class XbcVM
  Local aChain := XbcChain(Self, aCls)
  Local oObj := XbcObj():New(aCls)
  aChain |> expand([k] k[C_DATA]) |> tap([d] oObj:hProps{d} := Nil)
  for aK in aChain
    Loop if Empty(aK[C_INIT])
    aK[C_INITFN] ?= ::hEvery{Upper(aK[C_INIT])}
    ::Fail("no function ${aK[C_INIT]} for the data of ${aK[C_NAME]}") if aK[C_INITFN] == Nil
    ::Push(aK[C_INITFN], {}, Nil, oObj)
    ::Run(Len(::aFrames))
  next
Return oObj

// The classes above a class, the topmost first, and it.
Static Function XbcChain(oVM, aCls)
  Local aChain := aCls[C_SUPERS] ;
                    |> map([s] oVM:ClassNamed(aCls[C_MOD], s)) ;
                    |> filter([k] k != Nil) ;
                    |> expand([k] XbcChain(oVM, k))
  AAdd(aChain, aCls)
Return aChain

// Is it an object of a module's class.
Static Function XbcIsObj(oObj)
Return AttIsMemberOf(oObj, "xbcCls")

// ---- the AppServer's --------------------------------------------------------
// A function of the AppServer's, by name. A reference is passed as one, and
// written back.
Method CallNative(cName, aArgs) Class XbcVM
Return ::Native("f", cName, "", Nil, aArgs)

// A function, a method of an object, or 'Class():Method()' of the
// AppServer's, by name: aArgs' references passed as such and written back.
// On the AppServer a block a macro makes once per name, number of arguments
// and references -- each argument a parameter of its own, by reference where
// the call had one --; on xc-vm, its XBC_ functions.
Method Native(cWhat, cName, cMethod, xObj, aArgs) Class XbcVM
  Local aVals := Array(Len(aArgs))
  Local aRefs := {}
  Local cKey
  Local cSrc
  Local xResult
  // Every call of the AppServer's comes here: one walk, no blocks.
  for xArg, nI in aArgs
    If XbcIsRef(xArg)
      aVals[nI] := xArg[2][xArg[3]]
      AAdd(aRefs, nI)
    Else
      aVals[nI] := xArg
    EndIf
  next
  If ::lHost
    Do Case
    Case cWhat == "f"
      xResult := XBC_CALL(cName, aVals, aRefs)
    Case cWhat == "m"
      xResult := XBC_METHOD(xObj, cMethod, aVals, aRefs)
    Otherwise
      xResult := XBC_NEW(cName, cMethod, aVals, aRefs)
    EndCase
  Else
    cKey := "${cWhat}:${cName}:${cMethod}:${Len(aVals)}" + (aRefs |> map([k] ":${k}") |> join)
    If !(::hCache has cKey)
      // {|a, o, p1, p2, r| r := F(p1, @p2), a[2] := p2, r}
      Local cList := aVals |> enumerate |> map([p] If(p[1] in aRefs, "@", "") + "p${p[1]}") |> join(", ")
      Local cCall := If(cWhat == "f", cName, If(cWhat == "m", "o:", cName + "():") + cMethod)
      cSrc := "{|a, o" + (aVals |> enumerate |> map([p] ", p${p[1]}") |> join) + ", r| r := ${cCall}(${cList})" + ;
              (aRefs |> map([k] ", a[${k}] := p${k}") |> join) + ", r}"
      ::hCache{cKey} := &(cSrc)
    EndIf
    xResult := XbcEvalN(::hCache{cKey}, aVals, xObj)
  EndIf
  If ::aTrace != Nil
    ::Note("  the AppServer's ${cWhat}:${cName}:${cMethod}(" + (aVals |> map([x] XbcShown(x)) |> join(", ")) + ;
                   ") -> " + XbcShown(xResult))
  EndIf
  aRefs |> tap([k] aArgs[k][2][aArgs[k][3]] := aVals[k])
Return xResult

// Eval of a block made with a parameter for the arguments array, one for
// the object, one for each argument.
Static Function XbcEvalN(bBlock, a, o)
  Local nN := Len(a)
  Do Case
  Case nN == 0
    Return Eval(bBlock, a, o)
  Case nN == 1
    Return Eval(bBlock, a, o, a[1])
  Case nN == 2
    Return Eval(bBlock, a, o, a[1], a[2])
  Case nN == 3
    Return Eval(bBlock, a, o, a[1], a[2], a[3])
  Case nN == 4
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4])
  Case nN == 5
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5])
  Case nN == 6
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6])
  Case nN == 7
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7])
  Case nN == 8
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8])
  Case nN == 9
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9])
  Case nN == 10
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10])
  EndCase
Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], ;
            a[14], a[15], a[16], a[17], a[18], a[19], a[20])

// The program's Eval(block, ...), run here, compiled: through a macro's
// block -- {|a, o, p1, p2, r| r := Eval(p1, p2), r} -- the AppServer gave
// back the argument of a block of the program's, not its value (02-blocks,
// on 24.3.1.9).
Static Function XbcEvalArgs(bBlock, a)
  Local nN := Len(a)
  Local aAll
  Do Case
  Case nN == 0
    Return Eval(bBlock)
  Case nN == 1
    Return Eval(bBlock, a[1])
  Case nN == 2
    Return Eval(bBlock, a[1], a[2])
  Case nN == 3
    Return Eval(bBlock, a[1], a[2], a[3])
  Case nN == 4
    Return Eval(bBlock, a[1], a[2], a[3], a[4])
  EndCase
  aAll := AClone(a)
  ASize(aAll, Max(nN, 12))
Return Eval(bBlock, aAll[1], aAll[2], aAll[3], aAll[4], aAll[5], aAll[6], aAll[7], aAll[8], aAll[9], aAll[10], ;
            aAll[11], aAll[12])

// A method of an object of the AppServer's.
Method MethodCall(xObj, cName, aArgs) Class XbcVM
Return ::Native("m", "", cName, xObj, aArgs)

// 'Name():M(...)' of a class no module has: the AppServer's.
Method NewNative(cClass, cName, aArgs) Class XbcVM
Return ::Native("n", cClass, cName, Nil, aArgs)

// A member of an object: a module's class's data, or the AppServer's.
Method MemberOf(xObj, cName) Class XbcVM
  If ValType(xObj) == "O" .And. XbcIsObj(xObj)
    ::Fail("no data ${cName} of ${xObj:xbcCls[C_NAME]}") if !(xObj:hProps has Upper(cName))
    Return xObj:hProps{Upper(cName)}
  EndIf
  Return XBC_MEMBER(xObj, cName) if ::lHost
  ::hCache{"g:" + cName} ?= &("{|o| o:${cName}}")
Return Eval(::hCache{"g:" + cName}, xObj)

Method SetMemberOf(xObj, cName, xValue) Class XbcVM
  If ValType(xObj) == "O" .And. XbcIsObj(xObj)
    ::Fail("no data ${cName} of ${xObj:xbcCls[C_NAME]}") if !(xObj:hProps has Upper(cName))
    xObj:hProps{Upper(cName)} := xValue
  ElseIf ::lHost
    XBC_SETMEMBER(xObj, cName, xValue)
  Else
    ::hCache{"s:" + cName} ?= &("{|o, v| o:${cName} := v}")
    Eval(::hCache{"s:" + cName}, xObj, xValue)
  EndIf
Return Nil

// ALIAS->NAME, in its area -- the alias FIELD the area selected.
Method FieldOf(cAlias, cName) Class XbcVM
  Local nWas := ::CallNative("Select", {})
  Local xValue
  ::CallNative("DbSelectArea", {cAlias}) if !(Upper(cValToChar(cAlias)) == "FIELD")
  xValue := ::CallNative("FieldGet", {::CallNative("FieldPos", {cName})})
  ::CallNative("DbSelectArea", {nWas})
Return xValue

Method SetFieldOf(cAlias, cName, xValue) Class XbcVM
  Local nWas := ::CallNative("Select", {})
  ::CallNative("DbSelectArea", {cAlias}) if !(Upper(cValToChar(cAlias)) == "FIELD")
  ::CallNative("FieldPut", {::CallNative("FieldPos", {cName}), xValue})
  ::CallNative("DbSelectArea", {nWas})
Return Nil

// ---- memvars ----------------------------------------------------------------
// The variable NAME: the innermost private, else the public; Nil when there
// is none.
Method MemCell(cName) Class XbcVM
  If local aStack := ::hPrivs{cName}, aStack != Nil .And. !Empty(aStack)
    Return ATail(aStack)
  EndIf
Return ::hPubs{cName}

// A private NAME of the running frame: one it has already, Nil again with
// lFresh.
Method PrivCell(cName, lFresh) Class XbcVM
  Local aF := ATail(::aFrames)
  Local aStack := ::hPrivs{cName} ?: {}
  Local aCell
  ::hPrivs{cName} := aStack
  If aF[F_PRIVS] |> anyof([n] n == cName)
    aCell := ATail(aStack)
    aCell[1] := Nil if ValType(lFresh) == "L" .And. lFresh
    Return aCell
  EndIf
  aCell := {Nil}
  AAdd(aStack, aCell)
  AAdd(aF[F_PRIVS], cName)
Return aCell

// &(text): a variable's name is the variable; anything else the AppServer's.
Method Macro(cText) Class XbcVM
  Local cName := Upper(AllTrim(cText))
  If XbcPlain(cName)
    Local aCell := ::MemCell(cName)
    ::Fail("variable does not exist: ${cName}") if aCell == Nil
    Return aCell[1]
  EndIf
  ::Fail("xc-vm runs no macro but a variable's name: &(${cText})") if ::lHost
Return &(cText)

Method SetMacro(cText, xValue) Class XbcVM
  Local cName := Upper(AllTrim(cText))
  Local aCell
  ::Fail("xc-vm runs no macro but a variable's name: &(${cText})") if !XbcPlain(cName)
  aCell := ::MemCell(cName) ?: ::PrivCell(cName)
  aCell[1] := xValue
Return Nil

// A name, and nothing else.
Static Function XbcPlain(cName)
  Return .F. if Empty(cName) .Or. IsDigit(cName)
  for nI in 1..Len(cName)
    Local cC := SubStr(cName, nI, 1)
    Return .F. if !(IsAlpha(cC) .Or. IsDigit(cC) .Or. cC == "_")
  next
Return .T.

// ---- errors -----------------------------------------------------------------
// An error of the machine's: an error the AppServer raises, as any other.
Method Fail(cMessage) Class XbcVM
  UserException(cMessage)
Return Nil

// The error block the machine runs under: an error goes to the program's
// ErrorBlock() first -- a Break there goes to the innermost region --, else
// on its way to the innermost 'try'.
Method OnError(oErr) Class XbcVM
  If local aF := ATail(::aFrames), aF != Nil
    ::cWhere := "${aF[F_FN][FN_NAME]}, line ${aF[F_LINE]}"
  EndIf
  ::Note("  error: " + ::MemberOf(oErr, "Description")) if ::aTrace != Nil
  If ::bProgErr != Nil .And. !::lInErr
    ::lInErr := .T.
    Eval(::bProgErr, oErr)
    ::lInErr := .F.
  EndIf
  XbcBreak({scErr, oErr})
Return Nil

// ---- the trace --------------------------------------------------------------
// An instruction about to run, with trace=FILE: the frames' depth, the
// function, where in it, the instruction, the stack's height and its top.
Method Trace(aF, nPc, aIns, nSp, aSt) Class XbcVM
  Local aOp := ::aOpNames[aIns[I_OP]]
  Local cLine := "${Len(::aFrames)} ${aF[F_FN][FN_NAME]}:${nPc} ${aOp[1]}"
  cLine += " ${aIns[I_A]}" if "I" $ aOp[2]
  cLine += " ${aIns[I_B]}" if aOp[2] == "IWW" .Or. aOp[2] == "II" .Or. aOp[2] == "WI"
  cLine += " " + cValToChar(aIns[I_N]) if aOp[2] == "N"
  cLine += " " + aIns[I_S] if "W" $ aOp[2] .Or. aOp[2] == "S"
  cLine += " " + aIns[I_S2] if aOp[2] == "WW" .Or. aOp[2] == "IWW"
  ::Note(cLine + " | sp ${nSp}" + If(nSp > 0, ", top " + XbcShown(aSt[nSp]), ""))
Return Nil

// A line of the trace, while there are fewer than 20,000.
Method Note(cLine) Class XbcVM
  AAdd(::aTrace, cLine) if Len(::aTrace) < 20000
Return Nil

// A value, short, for the trace.
Static Function XbcShown(xValue)
  Local cType := ValType(xValue)
  Do Case
  Case cType == "C"
    Return 'C "' + Left(xValue, 30) + If(Len(xValue) > 30, '..."', '"')
  Case cType $ "NLD"
    Return cType + " " + cValToChar(xValue)
  Case cType == "A"
    Return "A[${Len(xValue)}]"
  EndCase
Return cType

// ---- code blocks ------------------------------------------------------------
// The program's code block: one of the AppServer's that runs it here, with
// as many arguments as its function takes.
Method MakeBlock(aClo) Class XbcVM
Return {|p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12| ;
        ::Enter(aClo, {p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12})}

Method Enter(aClo, aArgs) Class XbcVM
  Local xResult
  ::Push(aClo[1], aArgs |> take(aClo[1][FN_PARAMS]), aClo[2], aClo[3])
  xResult := ::Run(Len(::aFrames))
  ::Note("  the block ${aClo[1][FN_NAME]} gave " + XbcShown(xResult)) if ::aTrace != Nil
Return xResult

// ---- objects ----------------------------------------------------------------
// An object of a module's class: its class, and its data -- NAME => value.
Class XbcObj
  Public Data xbcCls
  Public Data hProps
  Public Method New(aCls) Constructor
EndClass

Method New(aCls) Class XbcObj
  ::xbcCls := aCls
  ::hProps := { => }
Return Self
