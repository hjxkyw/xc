#include "totvs.ch"
#include "tlpp-core.th"

// xbc.xtpl -- the interpreter of xc's bytecode (docs/bytecode.md), written
// in xtpl, to run a .xbc on an AppServer.
//
//   appserver -run=u_xbc -env=NAME [out=FILE] [run=NAME] module.xbc ...
//
// It loads the modules, runs each one's __INIT in the order given, then NAME
// -- U_MAIN when it is not given and there is one, else the first user
// function of the last module. The machine is the page's: frames, a stack,
// cells for the locals a code block shares, references copied in and out,
// regions for Break and errors, defers, areas, classes. A function no module
// has is the AppServer's, called by its name; the program's code blocks are
// the AppServer's own, which call back here, so aEval(), aSort() and the
// runtime's verbs run them.
//
// With out=FILE what ConOut() is given and the error nothing catches go to
// FILE instead, as xc-vm writes them -- 'exit N', '--- output', its lines,
// '--- errors', its lines --: what ctest's 'interp' compares with xc-vm's.
//
// xc-vm runs it too (cpp/tests/interp.cmake), after xtpl's runtime, as the
// AppServer has the runtime in its RPO: there the AppServer's macros are
// not, and xc-vm's XBC_ functions call, read and write by name instead.
//
// The names of the machine are hashes ({ => }): the operations, the
// functions, the classes, the variables; the instructions and the frames
// are arrays, which the loop reads by position. What it loads becomes what
// the loop runs fastest (Load(), XbcFused()), and the loop makes the calls
// it can itself (Run()). The loop keeps TL++'s own forms; the rest is
// xtpl's.
// -----------------------------------------------------------------------------

// ---- instructions -----------------------------------------------------------
// Numbered by how often a program runs them, the most first: the loop asks
// for the first ones first. Some are the loader's own: two to four of the
// bytecode's run as one (XbcFused()); JIT, a run of them as one code block
// the AppServer's macro compiler makes (XbcJitRuns(), Jit()).
#define OP_JIT        1
#define OP_LOCAL      2
#define OP_SETLOCAL   3
#define OP_NUM        4
#define OP_LOCAL2     5
#define OP_CALL       6
#define OP_JUMPF      7
#define OP_ADD        8
#define OP_JUMP       9
#define OP_LOCALIDX   10
#define OP_LOCALIDXL  11
#define OP_INDEX      12
#define OP_NUMIDX     13
#define OP_INCLOCAL   14
#define OP_ADDNUM     15
#define OP_ADDSET     16
#define OP_LEJF       17
#define OP_LTJF       18
#define OP_GEJF       19
#define OP_GTJF       20
#define OP_EXACTJF    21
#define OP_NEJF       22
#define OP_EQJF       23
#define OP_RET        24
#define OP_POP        25
#define OP_STR        26
#define OP_NIL        27
#define OP_METHOD     28
#define OP_MEMBER     29
#define OP_SETMEMBER  30
#define OP_SETINDEX   31
#define OP_SELF       32
#define OP_EXACT      33
#define OP_TRUE       34
#define OP_FALSE      35
#define OP_SUB        36
#define OP_MUL        37
#define OP_DIV        38
#define OP_MOD        39
#define OP_NOT        40
#define OP_EQ         41
#define OP_NE         42
#define OP_LT         43
#define OP_GT         44
#define OP_LE         45
#define OP_GE         46
#define OP_ANDJUMP    47
#define OP_ORJUMP     48
#define OP_JUMPT      49
#define OP_ARRAY      50
#define OP_DUP        51
#define OP_DUP2       52
#define OP_CELL       53
#define OP_SETCELL    54
#define OP_UPVAL      55
#define OP_SETUPVAL   56
#define OP_REFLOCAL   57
#define OP_REFCELL    58
#define OP_REFUPVAL   59
#define OP_BLOCK      60
#define OP_ISNIL      61
#define OP_NEG        62
#define OP_POW        63
#define OP_CONTAINS   64
#define OP_STATIC     65
#define OP_SETSTATIC  66
#define OP_BOX        67
// The rare ones, from here: a method's of their own (Rare()).
#define OP_RARE       68
#define OP_NEW        68
#define OP_REFSTATIC  69
#define OP_MEMVAR     70
#define OP_SETMEMVAR  71
#define OP_REFMEMVAR  72
#define OP_PRIVATE    73
#define OP_PUBLIC     74
#define OP_FIELD      75
#define OP_SETFIELD   76
#define OP_FIELDX     77
#define OP_SETFIELDX  78
#define OP_CALLX      79
#define OP_SUPER      80
#define OP_MACRO      81
#define OP_SETMACRO   82
#define OP_LINE       83
#define OP_SEQ        84
#define OP_TRY        85
#define OP_ENDSEQ     86
#define OP_DEFER      87
#define OP_RUNDEFERS  88
#define OP_ENDDEFER   89
#define OP_AREA       90
#define OP_ENDAREA    91
#define OP_COUNT      91

// An instruction: {op, a, b, s, s2, n, what it found, its line, what kind
// of call it is, what the call runs}. A fused one: LOCAL2 a b, LOCALIDX a n
// (local a's element n), LOCALIDXL a b (local a's element local b), NUMIDX
// n, INCLOCAL a n (local a plus n), ADDNUM n, ADDSET a (add, setlocal a),
// and LEJF a ... EQJF a (the comparison, and jumpf a). JIT a b: the run of
// instructions after it, I_X, as one block -- a where it ends, b where the
// jump that ends it goes, n which jump (1 jumpf, 2 jumpt, 3 jump, 0 none);
// the block I_C, its constants I_S2, the stack's height it was made for
// I_D and the height after it I_E; I_K 0 not made yet, 1 made, 2 not to be.
#define I_OP   1
#define I_A    2
#define I_B    3
#define I_S    4
#define I_S2   5
#define I_N    6
#define I_C    7
#define I_LINE 8
#define I_K    9
#define I_X    10
#define I_D    11
#define I_E    12

// What a call is, found the first time it runs -- an argument by reference
// at a call is there every time: K_FN a function of a module, I_X; K_SYS
// one of the AppServer's in the table, the block I_X; K_PCOUNT, K_EVAL of a
// block; K_MACRO another of the AppServer's, the block a macro made for it,
// I_X; K_SLOW any other, through Invoke(). For a method: K_FN when it has
// no reference, K_SLOW when it has.
#define K_FN      1
#define K_SYS     2
#define K_PCOUNT  3
#define K_EVAL    4
#define K_MACRO   5
#define K_SLOW    9

// A function: {name, kind, parameters, locals, module, instructions, the
// most its stack holds, its number in the machine's list of them, what its
// code blocks run instead of it -- .F. for none, Nil before the first is
// made (JitWhole())}.
#define FN_NAME    1
#define FN_KIND    2
#define FN_PARAMS  3
#define FN_NLOCALS 4
#define FN_MOD     5
#define FN_CODE    6
#define FN_STACK   7
#define FN_ID      8
#define FN_FAST    9

// A module: {source, statics, NAME => function, namespace, usings, its
// functions in order, the namespaces a plain name is looked for in}.
#define M_SOURCE  1
#define M_STATICS 2
#define M_FNS     3
#define M_NS      4
#define M_USINGS  5
#define M_LIST    6
#define M_SEARCH  7

// A class: {name, module, classes above, data, init, NAME => {function's
// name, static, {function, static} once found}, the init's function, NAME
// => the place of a data in an object's, how many} -- the last two made
// with its first object.
#define C_NAME    1
#define C_MOD     2
#define C_SUPERS  3
#define C_DATA    4
#define C_INIT    5
#define C_METHODS 6
#define C_INITFN  7
#define C_SLOTS   8
#define C_NSLOTS  9

// A frame: what a call has while it runs -- an array of few elements: the
// AppServer takes longer to make a longer one. Its locals and its stack are
// one array, the stack above the locals. What few frames have is in F_MORE,
// Nil until one has some of it: {its parameters by reference, regions,
// areas, defers, where 'rundefers' was, privates, whether the caller gets
// Self}.
#define F_FN      1
#define F_LOCALS  2
#define F_SP      3
#define F_PC      4
#define F_ARGC    5
#define F_CELLS   6
#define F_SELF    7
#define F_MORE    8
#define X_BYREF   1
#define X_REGIONS 2
#define X_AREAS   3
#define X_DEFERS  4
#define X_BACK    5
#define X_PRIVS   6
#define X_CTOR    7

// The JIT's state: {the stack -- {text, 0 a constant or a kept value, 1 one
// that reads what may be set, 2 one with a call or a new array} --, the
// statements, the constants, how many values kept, the stack's height at
// the start, how many it took from below that, whether it read them}.
#define J_STACK  1
#define J_OUT    2
#define J_CONSTS 3
#define J_TEMPS  4
#define J_BASE   5
#define J_BELOW  6
#define J_READS  7
#define J_WHOLE  8

// What a reference and an error on its way are: arrays no program makes,
// their first element one of these.
Static scRef
Static scErr
// What the last Break was given, kept by XbcBreak() for the plain Recover
// that takes it -- scNone once taken. A Recover under USING the AppServer
// runs with Locals that are not the function's, and keeps nothing it
// assigns (probes xdp, xdq).
Static sxBroke
Static scNone
// The machine running, which the program's code blocks run in
// (XbcMakeBlock()).
Static sxVM
// The number of the function a code block of the JIT's whole is running
// for, 0 for none: where an error in it is (XbcMakeFast(), OnError()).
Static snFast

// ---- the entry --------------------------------------------------------------
// The arguments of -run are the command line's: the AppServer's own, then
// ours -- 'out=FILE', 'run=NAME', 'trace=FILE', 'jit=off', 'jitdump=FILE'
// (or '--out=', ...), the modules --; xc-vm gives those after '--'.
User Function xbc(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16)
  Local oVM := XbcVM():New()
  Local aFiles := {}
  Local cOut := ""
  Local cEntry := ""
  Local cTrace := ""
  Local nExit
  scRef := Chr(1) + "xbc reference"
  scErr := Chr(1) + "xbc error"
  scNone := Chr(1) + "xbc none"
  sxBroke := scNone
  snFast := 0
  for xArg in {p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16}
    Local cArg := If(ValType(xArg) == "C", xArg, "")
    Local cOpt := If(Left(cArg, 2) == "--", SubStr(cArg, 3), cArg)
    Do Case
    Case Empty(cArg)
      Loop
    Case Left(cOpt, 4) == "out="
      cOut := SubStr(cOpt, 5)
    Case Left(cOpt, 4) == "run="
      cEntry := SubStr(cOpt, 5)
    Case Left(cOpt, 6) == "trace="
      cTrace := SubStr(cOpt, 7)
    Case cOpt == "jit=off"
      oVM:lJit := .F.
    Case Left(cOpt, 8) == "jitdump="
      oVM:cJitDump := SubStr(cOpt, 9)
    Case !(Left(cArg, 1) == "-" .Or. ".exe" $ Lower(cArg) .Or. "appsrv" $ Lower(cArg))
      AAdd(aFiles, cArg)
    EndCase
  next
  oVM:lCapture := !Empty(cOut)
  oVM:aTrace := {} if !Empty(cTrace)
  nExit := oVM:Start(aFiles, cEntry)
  oVM:Report(cOut, nExit) if !Empty(cOut)
  oVM:JitDump() if !Empty(oVM:cJitDump)
  MemoWrite(cTrace, XbcJoined(oVM:aTrace)) if !Empty(cTrace)
Return nExit

// Is it a reference, an error on its way.
Static Function XbcIsRef(xValue)
Return ValType(xValue) == "A" .And. Len(xValue) == 3 .And. ValType(xValue[1]) == "C" .And. xValue[1] == scRef

// Is one of them a reference. A loop, not a lambda: no code block is made
// where the machine's arrays are in reach (the AppServer's walk, at
// XbcMakeBlock()).
Static Function XbcAnyRef(aArgs)
  Local nI
  For nI := 1 To Len(aArgs)
    Return .T. if XbcIsRef(aArgs[nI])
  Next
Return .F.

Static Function XbcIsErr(xValue)
Return ValType(xValue) == "A" .And. Len(xValue) == 2 .And. ValType(xValue[1]) == "C" .And. xValue[1] == scErr

// A Break, its value kept for the Recover that takes it: every Break the
// machine can take comes through here -- the program's Break(), its own,
// an error on its way.
Static Function XbcBreak(xValue)
  sxBroke := xValue
  Break(xValue)
Return Nil

// What the Break a plain Recover took was given, and forgotten: Nil for one
// that did not come through XbcBreak() -- a Break in a block a macro of the
// program's made, which the AppServer runs.
Static Function XbcCaught()
  Local xValue := sxBroke
  sxBroke := scNone
Return If(ValType(xValue) == "C" .And. xValue == scNone, Nil, xValue)

// ---- the machine ------------------------------------------------------------
Class XbcVM
  Public Data aMods
  Public Data aFns
  Public Data hOps
  Public Data hEvery
  Public Data hGlobals
  Public Data hClasses
  Public Data aFrames
  Public Data hPrivs
  Public Data hPubs
  Public Data hCache
  Public Data bProgErr
  Public Data lInErr
  Public Data cWhere
  Public Data aErrAt
  Public Data nRuns
  Public Data lJit
  Public Data cJitDump
  Public Data hJitDump
  Public Data aOut
  Public Data aErr
  Public Data lCapture
  Public Data lHost
  Public Data aTrace
  Public Data aOpNames
  Public Data hSys
  Public Data aSys
  Public Method New() Constructor
  Public Method Start(aFiles, cEntry)
  Public Method Report(cFile, nExit)
  Public Method Load(cPath)
  Public Method Parsed(cLine, cPath)
  Public Method Run(nBase)
  Public Method Run1(nBase)
  Public Method Run2(nBase)
  Public Method Run3(nBase)
  Public Method Rare(aF, aIns)
  Public Method Unwind(nBase, xWhat, lError)
  Public Method Push(aFn, aArgs, aCells, xSelf)
  Public Method EndFrame(aF)
  Public Method Resolve(aMod, cName, lMacro)
  Public Method ClassNamed(aMod, cName)
  Public Method MethodOf(aCls, cName)
  Public Method Above(aCls, cName)
  Public Method Instance(aCls)
  Public Method SlotOf(aCls, cName)
  Public Method Invoke(aF, cName, aArgs, lMacro, aIns)
  Public Method Classify(aIns, xFound, aArgs)
  Public Method JitCallable(cName)
  Public Method Jit(aF, aIns, nSp)
  Public Method JitOps(aJ, aMod, aRun)
  Public Method JitWhole(aFn)
  Public Method JitDump()
  Public Method CallNative(cName, aArgs)
  Public Method Native(cWhat, cName, cMethod, xObj, aArgs)
  Public Method MacroOf(cWhat, cName, cMethod, nArgs, aRefs)
  Public Method MethodCall(xObj, cName, aArgs)
  Public Method MemberOf(xObj, cName)
  Public Method SetMemberOf(xObj, cName, xValue)
  Public Method NewNative(cClass, cName, aArgs)
  Public Method MemCell(cName)
  Public Method PrivCell(cName, lFresh)
  Public Method Fail(cMessage)
  Public Method OnError(oErr)
  Public Method Trace(aF, nPc, aIns, nSp, aSt)
  Public Method Note(cLine)
  Public Method Enter(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12)
  Public Method Enter1(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12)
  Public Method Enter2(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12)
  Public Method Enter3(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12)
  Public Method Macro(cText)
  Public Method SetMacro(cText, xValue)
  Public Method FieldOf(cAlias, cName)
  Public Method SetFieldOf(cAlias, cName, xValue)
EndClass

Method New() Class XbcVM
  // Each operation's word, what follows it -- I a number, W a word, N a
  // number as AdvPL reads it, S a string --, and its number.
  Local aOps := {{"local", "I", OP_LOCAL}, {"setlocal", "I", OP_SETLOCAL}, {"num", "N", OP_NUM}, ;
                 {"call", "IW", OP_CALL}, {"jumpf", "I", OP_JUMPF}, {"add", "", OP_ADD}, {"jump", "I", OP_JUMP}, ;
                 {"index", "", OP_INDEX}, {"ret", "", OP_RET}, {"pop", "", OP_POP}, {"str", "S", OP_STR}, ;
                 {"nil", "", OP_NIL}, {"method", "IW", OP_METHOD}, {"member", "W", OP_MEMBER}, ;
                 {"setmember", "W", OP_SETMEMBER}, {"setindex", "", OP_SETINDEX}, {"self", "", OP_SELF}, ;
                 {"exact", "", OP_EXACT}, {"true", "", OP_TRUE}, {"false", "", OP_FALSE}, {"sub", "", OP_SUB}, ;
                 {"mul", "", OP_MUL}, {"div", "", OP_DIV}, {"mod", "", OP_MOD}, {"not", "", OP_NOT}, ;
                 {"eq", "", OP_EQ}, {"ne", "", OP_NE}, {"lt", "", OP_LT}, {"gt", "", OP_GT}, {"le", "", OP_LE}, ;
                 {"ge", "", OP_GE}, {"andjump", "I", OP_ANDJUMP}, {"orjump", "I", OP_ORJUMP}, ;
                 {"jumpt", "I", OP_JUMPT}, {"array", "I", OP_ARRAY}, {"dup", "", OP_DUP}, {"dup2", "", OP_DUP2}, ;
                 {"cell", "I", OP_CELL}, {"setcell", "I", OP_SETCELL}, {"upval", "I", OP_UPVAL}, ;
                 {"setupval", "I", OP_SETUPVAL}, {"reflocal", "I", OP_REFLOCAL}, {"refcell", "I", OP_REFCELL}, ;
                 {"refupval", "I", OP_REFUPVAL}, {"block", "WI", OP_BLOCK}, {"new", "IWW", OP_NEW}, ;
                 {"isnil", "", OP_ISNIL}, {"neg", "", OP_NEG}, {"pow", "", OP_POW}, {"contains", "", OP_CONTAINS}, ;
                 {"static", "I", OP_STATIC}, {"setstatic", "I", OP_SETSTATIC}, {"refstatic", "I", OP_REFSTATIC}, ;
                 {"memvar", "W", OP_MEMVAR}, {"setmemvar", "W", OP_SETMEMVAR}, {"refmemvar", "W", OP_REFMEMVAR}, ;
                 {"private", "W", OP_PRIVATE}, {"public", "W", OP_PUBLIC}, {"field", "WW", OP_FIELD}, ;
                 {"setfield", "WW", OP_SETFIELD}, {"fieldx", "W", OP_FIELDX}, {"setfieldx", "W", OP_SETFIELDX}, ;
                 {"box", "I", OP_BOX}, {"callx", "I", OP_CALLX}, {"super", "IW", OP_SUPER}, {"macro", "", OP_MACRO}, ;
                 {"setmacro", "", OP_SETMACRO}, {"line", "I", OP_LINE}, {"seq", "I", OP_SEQ}, {"try", "I", OP_TRY}, ;
                 {"endseq", "", OP_ENDSEQ}, {"defer", "II", OP_DEFER}, {"rundefers", "", OP_RUNDEFERS}, ;
                 {"enddefer", "", OP_ENDDEFER}, {"area", "", OP_AREA}, {"endarea", "", OP_ENDAREA}}
  ::hOps := { => }
  ::aOpNames := Array(OP_COUNT)
  for aOp in aOps
    ::hOps{aOp[1]} := {aOp[3], aOp[2]}
    ::aOpNames[aOp[3]] := {aOp[1], aOp[2]}
  next
  // The loader's own, which no .xbc has.
  for aOp in {{"jit", "II", OP_JIT}, {"local2", "II", OP_LOCAL2}, {"localidx", "I", OP_LOCALIDX}, ;
              {"numidx", "", OP_NUMIDX}, ;
              {"localidxl", "II", OP_LOCALIDXL}, {"inclocal", "I", OP_INCLOCAL}, {"addnum", "", OP_ADDNUM}, ;
              {"addset", "I", OP_ADDSET}, {"lejf", "I", OP_LEJF}, ;
              {"ltjf", "I", OP_LTJF}, {"gejf", "I", OP_GEJF}, {"gtjf", "I", OP_GTJF}, {"exactjf", "I", OP_EXACTJF}, ;
              {"nejf", "I", OP_NEJF}, {"eqjf", "I", OP_EQJF}}
    ::aOpNames[aOp[3]] := {aOp[1], aOp[2]}
  next
  ::aTrace := Nil
  ::hSys := { => }
  ::aSys := {}
  for aCall in XbcSyscalls()
    AAdd(::aSys, aCall[2])
    ::hSys{aCall[1]} := Len(::aSys)
  next
  ::aMods := {}
  ::aFns := {}
  ::hEvery := { => }
  ::hGlobals := { => }
  ::hClasses := { => }
  ::aFrames := {}
  ::hPrivs := { => }
  ::hPubs := { => }
  ::hCache := { => }
  ::bProgErr := Nil
  ::lInErr := .F.
  ::cWhere := ""
  ::aErrAt := Nil
  ::nRuns := 0
  ::lJit := .T.
  ::cJitDump := ""
  ::hJitDump := { => }
  ::aOut := {}
  ::aErr := {}
  ::lCapture := .F.
  ::lHost := FindFunction("XBC_CALL")
Return Self

// Loads the modules, runs their __INITs, then the entry: what the process
// exits with.
Method Start(aFiles, cEntry) Class XbcVM
  Local oWas := sxVM
  Local bOld
  Local nExit := 0
  Local xCaught
  Local aFn
  sxVM := Self
  bOld := ErrorBlock(XbcOnError())
  defer sxVM := oWas
  defer ErrorBlock(bOld)
  Begin Sequence
    for cFile in aFiles
      ::Load(cFile)
    next
    for aMod in ::aMods
      If local aInit := aMod[M_FNS]{"__INIT"}, aInit != Nil
        ::Push(aInit, {}, Nil, Nil)
        ::Run(Len(::aFrames))
      EndIf
    next
    If !Empty(cEntry)
      aFn := ::hGlobals{Upper(cEntry)}
    ElseIf ::hGlobals has "U_MAIN"
      aFn := ::hGlobals{"U_MAIN"}
    ElseIf !Empty(::aMods)
      aFn := ATail(::aMods)[M_LIST] |> first([f] f[FN_KIND] == "user")
    EndIf
    If aFn == Nil
      AAdd(::aErr, "xc-vm: nothing to run")
      nExit := 2
    Else
      ::Push(aFn, {}, Nil, Nil)
      ::Run(Len(::aFrames))
    EndIf
  Recover
    xCaught := XbcCaught()
    Do Case
    Case XbcIsErr(xCaught)
      AAdd(::aErr, "xc-vm: error: ${::MemberOf(xCaught[2], 'Description')} (${::cWhere})")
      nExit := 1
    Case ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: "
      AAdd(::aErr, xCaught)
      nExit := 2
    Otherwise
      AAdd(::aErr, "xc-vm: a Break with no Begin Sequence to take it")
      nExit := 1
    EndCase
  End Sequence
  ::aErr |> tap(ConOut) if !::lCapture
Return nExit

// The error block of the program's run: made here, not in Start() -- no
// code block is made where the machine's arrays are in reach (the
// AppServer's walk, at XbcMakeBlock()).
Static Function XbcOnError()
Return {|oErr| sxVM:OnError(oErr)}

// What ran, as xc-vm prints it: its exit code, its output, its errors.
Method Report(cFile, nExit) Class XbcVM
  Local cNl := Chr(10)
  MemoWrite(cFile, "exit ${nExit}" + cNl + "--- output" + cNl + XbcJoined(::aOut) + ;
                   "--- errors" + cNl + XbcJoined(::aErr))
Return Nil

// Lines, each ended. A loop, not a lambda (XbcMakeBlock()).
Static Function XbcJoined(aLines)
  Local cText := ""
  for cLine in aLines
    cText += cLine + Chr(10)
  next
Return cText

// ---- loading ----------------------------------------------------------------
// A .xbc: its header, its classes, its functions; each instruction parsed
// once, into an array, with its line -- the last 'line' before it. Then
// what a function's stack holds at the most, and its instructions as the
// loop runs them (XbcFused()) -- but with trace=FILE, which shows them as
// they are. A word is compared with '==': AdvPL's '=' and '!=' take
// "endseq" for "end".
Method Load(cPath) Class XbcVM
  Local aLines := {}
  Local aMod := {cPath, {}, { => }, "", {}, {}, {}}
  Local aWords
  Local aCls
  Local aFn
  Local aIns
  Local nLine
  Local lJit
  Local nI := 4
  for cRead in XbcLines(cPath)
    Local cLine := LTrim(StrTran(StrTran(cRead, Chr(13), ""), Chr(9), " "))
    AAdd(aLines, cLine) if !Empty(cLine)
  next
  XbcBreak("xc-vm: ${cPath}: not a .xbc of version 1") if Len(aLines) < 3 .Or. !(aLines[1] == "xbc 1")
  aMod[M_SOURCE] := XbcWords(aLines[2])[2]
  aMod[M_STATICS] := Array(Val(XbcWords(aLines[3])[2]))
  While nI <= Len(aLines)
    aWords := XbcWords(aLines[nI++])
    Do Case With local cWord := aWords[1]
    Case cWord == "namespace"
      aMod[M_NS] := aWords[2]
    Case cWord == "using"
      AAdd(aMod[M_USINGS], aWords[2])
    Case cWord == "class"
      // class NAME / from ... / data ... / init F / method N F / static N F / end
      aCls := {aWords[2], aMod, {}, {}, "", { => }, Nil, Nil, 0}
      While nI <= Len(aLines) .And. !(aLines[nI] == "end")
        aWords := XbcWords(aLines[nI++])
        Do Case With local cLine := aWords[1]
        Case cLine == "from"
          aCls[C_SUPERS] := aWords |> drop(1)
        Case cLine == "data"
          aCls[C_DATA] := aWords |> drop(1)
        Case cLine == "init"
          aCls[C_INIT] := aWords[2]
        Case cLine == "method" .Or. cLine == "static"
          aCls[C_METHODS]{aWords[2]} := {aWords[3], cLine == "static", Nil}
        EndCase
      EndDo
      nI++
      ::hClasses{aCls[C_NAME]} := aCls
    Case cWord == "function"
      aFn := {aWords[2], aWords[3], Val(aWords[4]), Val(aWords[5]), aMod, {}, 0, Len(::aFns) + 1, Nil}
      AAdd(::aFns, aFn)
      nLine := 0
      While nI <= Len(aLines) .And. !(aLines[nI] == "end")
        Local cIns := aLines[nI++]
        If !XbcNames(cIns)
          aIns := ::Parsed(cIns, cPath)
          nLine := aIns[I_A] if aIns[I_OP] == OP_LINE
          aIns[I_LINE] := nLine
          AAdd(aFn[FN_CODE], aIns)
        EndIf
      EndDo
      nI++
      aMod[M_FNS]{Upper(aFn[FN_NAME])} := aFn
      AAdd(aMod[M_LIST], aFn)
      ::hEvery{Upper(aFn[FN_NAME])} := aFn
      ::hGlobals{Upper(aFn[FN_NAME])} := aFn if aFn[FN_KIND] in {"user", "function", "main"}
    EndCase
  EndDo
  // What each function's stack holds at the most, and its instructions as
  // the loop runs them -- once the module's functions are known: a call of
  // one is no run of the JIT's. The JIT is the AppServer's macro compiler;
  // on xc-vm, a module of the blocks it would make, which jitdump=FILE
  // writes (cpp/tests/interp.cmake).
  lJit := ::aTrace == Nil .And. ::lJit .And. (!::lHost .Or. !Empty(::cJitDump) .Or. FindFunction("U_XBCJIT"))
  for aOne in aMod[M_LIST]
    aOne[FN_STACK] := XbcDepth(aOne[FN_CODE]) + 2
    aOne[FN_CODE] := XbcFused(aOne[FN_CODE], If(lJit, Self, Nil)) if ::aTrace == Nil
  next
  // Where a plain name is looked for: the namespace, then those it uses.
  aMod[M_SEARCH] := If(Empty(aMod[M_NS]), {}, {Upper(aMod[M_NS])})
  aMod[M_USINGS] |> tap([u] AAdd(aMod[M_SEARCH], Upper(u)))
  AAdd(::aMods, aMod)
Return aMod

// 'locals ...', 'upvals ...': names, for a debugger to show. ('in' is no
// use for a word: it asks aScan(), whose '=' takes "local" for "locals".)
Static Function XbcNames(cLine)
  Local cWord := XbcWords(cLine)[1]
Return cWord == "locals" .Or. cWord == "upvals"

// An instruction: its operation's number and its operands, by its shape.
Method Parsed(cLine, cPath) Class XbcVM
  Local nAt := At(" ", cLine)
  Local cWord := If(nAt > 0, Left(cLine, nAt - 1), cLine)
  Local aOp := ::hOps{cWord}
  Local aIns
  Local aWords
  XbcBreak("xc-vm: ${cPath}: no instruction '${cWord}'") if aOp == Nil
  aIns := {aOp[1], 0, 0, "", "", 0, Nil, 0, 0, Nil}
  Do Case
  Case aOp[2] == "S"
    // The string: from the first '"' to the last character of the line.
    nAt := At('"', cLine)
    aIns[I_S] := SubStr(cLine, nAt + 1, Len(cLine) - nAt - 1)
  Case !Empty(aOp[2])
    aWords := XbcWords(cLine)
    for nW in 1..Len(aOp[2])
      Local cKind := SubStr(aOp[2], nW, 1)
      Local cArg := If(nW < Len(aWords), aWords[nW + 1], "")
      Do Case
      Case cKind == "N"
        aIns[I_N] := Val(cArg)
      Case cKind == "I"
        aIns[If(nW == 1, I_A, I_B)] := Val(cArg)
      Otherwise
        aIns[If(Empty(aIns[I_S]), I_S, I_S2)] := cArg
      EndCase
    next
  EndCase
  // A member's and a method's name in upper case, as an object's data and
  // its class's methods are.
  If aIns[I_OP] == OP_METHOD .Or. aIns[I_OP] == OP_MEMBER .Or. aIns[I_OP] == OP_SETMEMBER .Or. aIns[I_OP] == OP_SUPER
    aIns[I_S2] := Upper(aIns[I_S])
  EndIf
Return aIns

// The words of a line, one blank or more between them.
Static Function XbcWords(cLine)
  Local aWords := split(AllTrim(cLine), " ") |> reject([w] Empty(w))
Return If(Empty(aWords), {""}, aWords)

// The most a function's stack holds -- so the loop never has to make it
// bigger: each instruction reached from the first, from a region's target,
// with what a Break pushes there, and the deferred code, from the most the
// stack holds at a 'rundefers'; an instruction is looked at again only when
// reached with more.
Static Function XbcDepth(aCode)
  Local aAt := Array(Len(aCode))
  Local aWork := {}
  Local aBodies := {}
  Local nDefers := -1
  Local nMost := 0
  Local nI
  Local nD
  Local nAfter
  Local aIns
  Local nOp
  For nI := 1 To Len(aCode)
    AAdd(aBodies, aCode[nI][I_B]) if aCode[nI][I_OP] == OP_DEFER
  Next
  XbcReach(aAt, aWork, 1, 0)
  While !Empty(aWork)
    nI := ATail(aWork)
    ASize(aWork, Len(aWork) - 1)
    nD := aAt[nI]
    aIns := aCode[nI]
    nOp := aIns[I_OP]
    nAfter := nD + XbcEffect(aIns)
    nMost := Max(nMost, Max(nD, nAfter))
    // Something is off: plenty, then.
    Return 256 if nMost > 1000
    Do Case
    Case nOp == OP_JUMP
      XbcReach(aAt, aWork, aIns[I_A], nD)
    Case nOp == OP_JUMPF .Or. nOp == OP_JUMPT
      XbcReach(aAt, aWork, aIns[I_A], nAfter)
      XbcReach(aAt, aWork, nI + 1, nAfter)
    Case nOp == OP_ANDJUMP .Or. nOp == OP_ORJUMP
      XbcReach(aAt, aWork, aIns[I_A], nD)
      XbcReach(aAt, aWork, nI + 1, nD - 1)
    Case nOp == OP_SEQ .Or. nOp == OP_TRY
      XbcReach(aAt, aWork, aIns[I_A], nD + 1)
      XbcReach(aAt, aWork, nI + 1, nD)
    Case nOp == OP_RUNDEFERS
      If nD > nDefers
        nDefers := nD
        for nBody in aBodies
          XbcReach(aAt, aWork, nBody, nD)
        next
      EndIf
      XbcReach(aAt, aWork, nI + 1, nD)
    Case nOp != OP_RET .And. nOp != OP_ENDDEFER
      XbcReach(aAt, aWork, nI + 1, nAfter)
    EndCase
  EndDo
Return nMost

// Instruction nTo reached with nDepth on the stack: to be looked at, when it
// was not reached before, or with less.
Static Function XbcReach(aAt, aWork, nTo, nDepth)
  If nTo >= 1 .And. nTo <= Len(aAt) .And. (aAt[nTo] == Nil .Or. nDepth > aAt[nTo])
    aAt[nTo] := nDepth
    AAdd(aWork, nTo)
  EndIf
Return Nil

// What an instruction does to the height of the stack, going on to the next
// one: a jump that leaves its value when it jumps is 0.
Static Function XbcEffect(aIns)
  Local nOp := aIns[I_OP]
  Do Case
  Case nOp == OP_LOCAL .Or. nOp == OP_NUM .Or. nOp == OP_STR .Or. nOp == OP_NIL .Or. nOp == OP_TRUE .Or. ;
       nOp == OP_FALSE .Or. nOp == OP_SELF .Or. nOp == OP_DUP .Or. nOp == OP_CELL .Or. nOp == OP_UPVAL .Or. ;
       nOp == OP_STATIC .Or. nOp == OP_MEMVAR .Or. nOp == OP_FIELD .Or. nOp == OP_REFLOCAL .Or. ;
       nOp == OP_REFCELL .Or. nOp == OP_REFUPVAL .Or. nOp == OP_REFSTATIC .Or. nOp == OP_REFMEMVAR
    Return 1
  Case nOp == OP_DUP2
    Return 2
  Case nOp == OP_SETLOCAL .Or. nOp == OP_SETCELL .Or. nOp == OP_SETUPVAL .Or. nOp == OP_SETSTATIC .Or. ;
       nOp == OP_SETMEMVAR .Or. nOp == OP_SETFIELD .Or. nOp == OP_POP .Or. nOp == OP_INDEX .Or. ;
       nOp == OP_JUMPF .Or. nOp == OP_JUMPT .Or. nOp == OP_AREA .Or. nOp == OP_RET .Or. ;
       nOp == OP_ADD .Or. nOp == OP_SUB .Or. nOp == OP_MUL .Or. nOp == OP_DIV .Or. nOp == OP_MOD .Or. ;
       nOp == OP_POW .Or. nOp == OP_EQ .Or. nOp == OP_EXACT .Or. nOp == OP_NE .Or. nOp == OP_LT .Or. ;
       nOp == OP_GT .Or. nOp == OP_LE .Or. nOp == OP_GE .Or. nOp == OP_CONTAINS
    Return -1
  Case nOp == OP_SETFIELDX .Or. nOp == OP_SETMEMBER .Or. nOp == OP_SETMACRO
    Return -2
  Case nOp == OP_SETINDEX
    Return -3
  Case nOp == OP_ARRAY .Or. nOp == OP_CALL .Or. nOp == OP_SUPER .Or. nOp == OP_NEW
    Return 1 - aIns[I_A]
  Case nOp == OP_CALLX .Or. nOp == OP_METHOD
    Return -aIns[I_A]
  Case nOp == OP_BLOCK
    Return 1 - aIns[I_B]
  EndCase
Return 0

// A function's instructions as the loop runs them. 'line' goes -- each
// instruction has its line --, and a few runs of instructions a program
// has again and again become one: 'local a, local b' LOCAL2 a b; 'local a,
// num n, index' LOCALIDX a n; 'local a, local b, index' LOCALIDXL a b;
// 'num n, index' NUMIDX n; 'local a, num n, add, setlocal a' INCLOCAL a n;
// 'num n, add' ADDNUM n; 'add, setlocal a' ADDSET a; a comparison and
// 'jumpf a' LEJF a, LTJF a, ... -- never over an instruction something
// jumps to. What jumped to an instruction jumps to the one it is in now.
Static Function XbcFused(aCode, oJit)
  Local aMap := Array(Len(aCode))
  Local aOne := {}
  Local aOut := {}
  Local aTo
  Local nNext := 0
  Local nI
  Local nTake
  Local nOp
  Local nOp2
  Local aIns
  Local aNew
  // Without 'line': what went to one goes to the instruction after it.
  For nI := 1 To Len(aCode)
    If aCode[nI][I_OP] != OP_LINE
      AAdd(aOne, aCode[nI])
    EndIf
  Next
  nNext := Len(aOne) + 1
  For nI := Len(aCode) To 1 Step -1
    nNext-- if aCode[nI][I_OP] != OP_LINE
    aMap[nI] := nNext
  Next
  XbcRetarget(aOne, aMap)
  aOne := XbcJitRuns(aOne, oJit) if oJit != Nil
  aTo := XbcTargets(aOne)
  aMap := Array(Len(aOne) + 1)
  aMap[Len(aOne) + 1] := Len(aOne) + 1
  nI := 1
  While nI <= Len(aOne)
    aIns := aOne[nI]
    nOp := aIns[I_OP]
    nOp2 := If(nI < Len(aOne) .And. !aTo[nI + 1], aOne[nI + 1][I_OP], 0)
    aNew := aIns
    nTake := 1
    Do Case
    Case nOp == OP_LOCAL .And. nOp2 == OP_NUM .And. nI + 3 <= Len(aOne) .And. !aTo[nI + 2] .And. ;
         !aTo[nI + 3] .And. aOne[nI + 2][I_OP] == OP_ADD .And. aOne[nI + 3][I_OP] == OP_SETLOCAL .And. ;
         aOne[nI + 3][I_A] == aIns[I_A]
      aNew := XbcIns(OP_INCLOCAL, aIns[I_A], 0, aOne[nI + 1][I_N], aIns[I_LINE])
      nTake := 4
    Case nOp == OP_LOCAL .And. nOp2 == OP_NUM .And. nI + 2 <= Len(aOne) .And. !aTo[nI + 2] .And. ;
         aOne[nI + 2][I_OP] == OP_INDEX
      aNew := XbcIns(OP_LOCALIDX, aIns[I_A], 0, aOne[nI + 1][I_N], aIns[I_LINE])
      nTake := 3
    Case nOp == OP_LOCAL .And. nOp2 == OP_LOCAL .And. nI + 2 <= Len(aOne) .And. !aTo[nI + 2] .And. ;
         aOne[nI + 2][I_OP] == OP_INDEX
      aNew := XbcIns(OP_LOCALIDXL, aIns[I_A], aOne[nI + 1][I_A], 0, aIns[I_LINE])
      nTake := 3
    Case nOp == OP_LOCAL .And. nOp2 == OP_LOCAL
      aNew := XbcIns(OP_LOCAL2, aIns[I_A], aOne[nI + 1][I_A], 0, aIns[I_LINE])
      nTake := 2
    Case nOp == OP_NUM .And. nOp2 == OP_INDEX
      aNew := XbcIns(OP_NUMIDX, 0, 0, aIns[I_N], aIns[I_LINE])
      nTake := 2
    Case nOp == OP_NUM .And. nOp2 == OP_ADD
      aNew := XbcIns(OP_ADDNUM, 0, 0, aIns[I_N], aIns[I_LINE])
      nTake := 2
    Case nOp == OP_ADD .And. nOp2 == OP_SETLOCAL
      aNew := XbcIns(OP_ADDSET, aOne[nI + 1][I_A], 0, 0, aIns[I_LINE])
      nTake := 2
    Case nOp2 == OP_JUMPF .And. XbcJumpOf(nOp) > 0
      aNew := XbcIns(XbcJumpOf(nOp), aOne[nI + 1][I_A], 0, 0, aIns[I_LINE])
      nTake := 2
    EndCase
    AAdd(aOut, aNew)
    For local nK := nI To nI + nTake - 1
      aMap[nK] := Len(aOut)
    Next
    nI += nTake
  EndDo
  aMap[Len(aOne) + 1] := Len(aOut) + 1
  XbcRetarget(aOut, aMap)
Return aOut

// What something jumps to: aTo[N] for instruction N, and N + 1 past the end.
Static Function XbcTargets(aCode)
  Local aTo := Array(Len(aCode) + 1)
  Local nTo
  For local nI := 1 To Len(aTo)
    aTo[nI] := .F.
  Next
  for aJump in aCode
    nTo := XbcTarget(aJump)
    aTo[nTo] := .T. if nTo > 0 .And. nTo <= Len(aTo)
    // A JIT's run ends at a jump: where that goes too.
    If aJump[I_OP] == OP_JIT .And. aJump[I_B] > 0 .And. aJump[I_B] <= Len(aTo)
      aTo[aJump[I_B]] := .T.
    EndIf
  next
Return aTo

// The runs of instructions the JIT is to make one code block of, the first
// time each runs: each a JIT instruction before it, which jumps over it
// once its block is made; what jumped to the run's first instruction jumps
// to the JIT. A run is on one line, and nothing jumps into it: locals,
// statics, cells, constants, operators, arrays, the AppServer's functions
// the machine's JitCallable() takes -- and a jump that ends it, whose
// condition the block gives.
// It is worth it from three instructions, or with a call.
Static Function XbcJitRuns(aCode, oJit)
  Local aTo := XbcTargets(aCode)
  Local aOut := {}
  Local aMap := Array(Len(aCode) + 1)
  Local nI := 1
  Local nEnd
  Local nCalls
  Local nTerm
  Local nOp
  Local nLine
  Local aRun
  While nI <= Len(aCode)
    nLine := aCode[nI][I_LINE]
    nEnd := nI
    nCalls := 0
    While nEnd <= Len(aCode) .And. (nEnd == nI .Or. (!aTo[nEnd] .And. aCode[nEnd][I_LINE] == nLine)) .And. ;
          XbcJitOp(aCode[nEnd], oJit)
      nCalls++ if aCode[nEnd][I_OP] == OP_CALL
      nEnd++
    EndDo
    nTerm := 0
    If nEnd > nI .And. nEnd <= Len(aCode) .And. !aTo[nEnd] .And. aCode[nEnd][I_LINE] == nLine
      nOp := aCode[nEnd][I_OP]
      nTerm := If(nOp == OP_JUMPF, 1, If(nOp == OP_JUMPT, 2, If(nOp == OP_JUMP, 3, 0)))
    EndIf
    If nCalls > 0 .Or. nEnd - nI + If(nTerm > 0, 1, 0) >= 3
      aRun := {}
      For local nK := nI To nEnd - 1
        AAdd(aRun, aCode[nK])
      Next
      AAdd(aOut, {OP_JIT, nEnd + If(nTerm > 0, 1, 0), If(nTerm > 0, aCode[nEnd][I_A], 0), "", Nil, nTerm, Nil, ;
                  nLine, 0, aRun, 0, 0})
      aMap[nI] := Len(aOut)
      nEnd++ if nTerm > 0
      For local nK := nI To nEnd - 1
        AAdd(aOut, aCode[nK])
        aMap[nK] := Len(aOut) if nK > nI
      Next
      nI := nEnd
    Else
      nEnd := Max(nEnd, nI + 1)
      For local nK := nI To nEnd - 1
        AAdd(aOut, aCode[nK])
        aMap[nK] := Len(aOut)
      Next
      nI := nEnd
    EndIf
  EndDo
  aMap[Len(aCode) + 1] := Len(aOut) + 1
  XbcRetarget(aOut, aMap)
Return aOut

// Can the JIT have it in a run.
Static Function XbcJitOp(aIns, oJit)
  Local nOp := aIns[I_OP]
  Do Case
  Case nOp == OP_CALL
    Return oJit:JitCallable(aIns[I_S])
  Case nOp == OP_NIL .Or. nOp == OP_TRUE .Or. nOp == OP_FALSE .Or. nOp == OP_NUM .Or. nOp == OP_STR .Or. ;
       nOp == OP_LOCAL .Or. nOp == OP_SETLOCAL .Or. nOp == OP_CELL .Or. nOp == OP_SETCELL .Or. nOp == OP_UPVAL .Or. ;
       nOp == OP_SETUPVAL .Or. nOp == OP_STATIC .Or. nOp == OP_SETSTATIC .Or. nOp == OP_SELF .Or. nOp == OP_POP .Or. ;
       nOp == OP_DUP .Or. nOp == OP_DUP2 .Or. nOp == OP_ARRAY .Or. nOp == OP_INDEX .Or. nOp == OP_SETINDEX .Or. ;
       nOp == OP_ADD .Or. nOp == OP_SUB .Or. nOp == OP_MUL .Or. nOp == OP_DIV .Or. nOp == OP_MOD .Or. ;
       nOp == OP_POW .Or. nOp == OP_NEG .Or. nOp == OP_NOT .Or. nOp == OP_ISNIL .Or. nOp == OP_EQ .Or. ;
       nOp == OP_EXACT .Or. nOp == OP_NE .Or. ;
       nOp == OP_LT .Or. nOp == OP_GT .Or. nOp == OP_LE .Or. nOp == OP_GE .Or. nOp == OP_CONTAINS
    Return .T.
  EndCase
Return .F.

// A new instruction of the loader's.
Static Function XbcIns(nOp, nA, nB, nN, nLine)
Return {nOp, nA, nB, "", "", nN, Nil, nLine, 0, Nil}

// The comparison's fused instruction, with 'jumpf' after it; 0 for one that
// is not a comparison.
Static Function XbcJumpOf(nOp)
  Do Case
  Case nOp == OP_LE
    Return OP_LEJF
  Case nOp == OP_LT
    Return OP_LTJF
  Case nOp == OP_GE
    Return OP_GEJF
  Case nOp == OP_GT
    Return OP_GTJF
  Case nOp == OP_EXACT
    Return OP_EXACTJF
  Case nOp == OP_NE
    Return OP_NEJF
  Case nOp == OP_EQ
    Return OP_EQJF
  EndCase
Return 0

// The instruction an instruction goes to -- a jump's, a region's, a
// defer's --, or 0.
Static Function XbcTarget(aIns)
  Local nOp := aIns[I_OP]
  Do Case
  Case nOp == OP_JUMP .Or. nOp == OP_JUMPF .Or. nOp == OP_JUMPT .Or. nOp == OP_ANDJUMP .Or. nOp == OP_ORJUMP .Or. ;
       nOp == OP_SEQ .Or. nOp == OP_TRY .Or. (nOp >= OP_LEJF .And. nOp <= OP_EQJF) .Or. nOp == OP_JIT
    Return aIns[I_A]
  Case nOp == OP_DEFER
    Return aIns[I_B]
  EndCase
Return 0

// What goes to instruction N goes to aMap[N] now -- a JIT's end, and where
// the jump that ends its run goes, both.
Static Function XbcRetarget(aCode, aMap)
  for aIns in aCode
    Local nTo := XbcTarget(aIns)
    If aIns[I_OP] == OP_JIT .And. aIns[I_B] > 0 .And. aIns[I_B] <= Len(aMap)
      aIns[I_B] := aMap[aIns[I_B]]
    EndIf
    Loop if nTo <= 0 .Or. nTo > Len(aMap)
    If aIns[I_OP] == OP_DEFER
      aIns[I_B] := aMap[nTo]
    Else
      aIns[I_A] := aMap[nTo]
    EndIf
  next
Return Nil

// A file's lines, read whole: the AppServer's FT_FReadLn() -- and so
// lines() -- gives a line longer than 1023 characters in pieces, and a
// string of the bytecode's makes one.
Static Function XbcLines(cPath)
  Local nFile := FOpen(cPath, 0)
  Local cText := ""
  Local cBlock
  Local nRead
  XbcBreak("xc-vm: ${cPath}: cannot be read") if nFile < 0
  defer FClose(nFile)
  While .T.
    cBlock := Space(65536)
    nRead := FRead(nFile, @cBlock, 65536)
    Exit if nRead <= 0
    cText += Left(cBlock, nRead)
  EndDo
Return split(StrTran(cText, Chr(13), ""), Chr(10))

// ---- frames -----------------------------------------------------------------
// A frame for a function of a module: its parameters from the arguments --
// a reference's value, written back when it ends. The loop makes the frame
// of a call with no reference itself.
Method Push(aFn, aArgs, aCells, xSelf) Class XbcVM
  Local aLocals := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
  Local aByRef := Nil
  ::Fail("stack overflow") if Len(::aFrames) > 4000
  for xArg, nI in aArgs
    Exit if nI > aFn[FN_PARAMS]
    If XbcIsRef(xArg)
      aLocals[nI] := xArg[2][xArg[3]]
      aByRef ?= {}
      AAdd(aByRef, {nI, xArg})
    Else
      aLocals[nI] := xArg
    EndIf
  next
  AAdd(::aFrames, {aFn, aLocals, aFn[FN_NLOCALS], 1, Len(aArgs), aCells, xSelf, ;
                   If(aByRef == Nil, Nil, {aByRef, Nil, Nil, Nil, 0, Nil, .F.})})
Return Nil

// A frame's end: what its parameters passed by reference hold written back
// -- a cell's value, for one a code block shares --, its privates gone.
Method EndFrame(aF) Class XbcVM
  Return Nil if aF[F_MORE] == Nil
  for aBy in aF[F_MORE][X_BYREF] ?: {}
    Local xValue := aF[F_LOCALS][aBy[1]]
    xValue := xValue[1] if XbcBoxed(aF, aBy[1])
    aBy[2][2][aBy[2][3]] := xValue
  next
  for cName in aF[F_MORE][X_PRIVS] ?: {}
    Local aStack := ::hPrivs{cName}
    ASize(aStack, Len(aStack) - 1)
  next
Return Nil

// Is local N of the frame a cell: its function boxes it, at its start.
Static Function XbcBoxed(aF, nLocal)
Return aF[F_FN][FN_CODE] |> takewhile([i] i[I_OP] == OP_BOX) |> anyof([i] i[I_A] == nLocal)

// The innermost region that takes it -- a Break any, an error a 'try' --:
// the frames above it go, its stack is cut back, the value pushed. False
// when none in this run does: then the run's frames go.
Method Unwind(nBase, xWhat, lError) Class XbcVM
  For local nK := Len(::aFrames) To nBase Step -1
    Local aF := ::aFrames[nK]
    Loop if aF[F_MORE] == Nil .Or. aF[F_MORE][X_REGIONS] == Nil
    For local nR := Len(aF[F_MORE][X_REGIONS]) To 1 Step -1
      Local aReg := aF[F_MORE][X_REGIONS][nR]
      Loop if lError .And. !aReg[1]
      While Len(::aFrames) > nK
        ::EndFrame(ATail(::aFrames))
        ASize(::aFrames, Len(::aFrames) - 1)
      EndDo
      ASize(aF[F_MORE][X_REGIONS], nR - 1)
      ASize(aF[F_MORE][X_AREAS], aReg[4]) if aF[F_MORE][X_AREAS] != Nil
      aF[F_SP] := aReg[3] + 1
      ASize(aF[F_LOCALS], aF[F_SP] * 2) if aF[F_SP] > Len(aF[F_LOCALS])
      aF[F_LOCALS][aF[F_SP]] := xWhat
      aF[F_PC] := aReg[2]
      Return .T.
    Next
  Next
  While Len(::aFrames) >= nBase
    ::EndFrame(ATail(::aFrames))
    ASize(::aFrames, Len(::aFrames) - 1)
  EndDo
Return .F.

// ---- the loop ---------------------------------------------------------------
// Runs the frames from the last one until the frame at nBase returns, and
// gives what it returned. What it uses most it keeps in Locals: the frame's
// code, locals and stack, the list of frames. A call of a module's function
// with no argument by reference, a method of a module's class and a return
// switch frames here, with no method between; a call of one of the
// AppServer's functions in the table runs its block here.
//
// A Break -- the program's, or an error on its way -- goes to the innermost
// region that takes it in this run, and the loop goes on there; with none,
// on to the run that called. Its value is XbcBreak()'s: a plain Recover,
// not one under USING. An error is at the instruction this ran last -- its
// line, for the report --, which only the Recover here still knows.
//
// A run inside this one -- a code block of the program's that the
// AppServer runs -- is one of its copies, Run1() to Run3() (XbcRun()):
// ::nRuns says how many runs there are.
Method Run(nBase) Class XbcVM
  Local aFrames := ::aFrames
  Local aF
  Local aCode
  Local aLoc
  Local aSt
  Local nSp
  Local nPc
  Local lTrace := ::aTrace != Nil
  Local lDone := .F.
  Local xCaught
  Local aIns
  Local nOp
  Local aArgs
  Local xA
  Local xB
  Local nI
  Local nK
  Local nN
  Local nAt
  Local aCls
  Local aM
  Local aFn
  Local xResult
  ::nRuns++
  While !lDone
    aF := aFrames[Len(aFrames)]
    aCode := aF[F_FN][FN_CODE]
    aLoc := aF[F_LOCALS]
    aSt := aF[F_LOCALS]
    nSp := aF[F_SP]
    nPc := aF[F_PC]
    sxBroke := scNone
    Begin Sequence
      While .T.
        aIns := aCode[nPc]
        ::Trace(aF, nPc, aIns, nSp, aSt) if lTrace
        nPc++
        nOp := aIns[I_OP]
        If nOp <= OP_JUMP
          Do Case
          Case nOp == OP_JIT
            // A run as one block, made the first time, for the stack's height
            // then; at another height the run is interpreted.
            ::Jit(aF, aIns, nSp) if aIns[I_K] == 0
            If aIns[I_K] == 1 .And. aIns[I_D] == nSp
              xA := Eval(aIns[I_C], aLoc, aIns[I_S2], aF[F_CELLS], aF[F_FN][FN_MOD][M_STATICS], aF[F_SELF])
              nSp := aIns[I_E]
              Do Case
              Case aIns[I_N] == 0
                nPc := aIns[I_A]
              Case aIns[I_N] == 3
                nPc := aIns[I_B]
              Case aIns[I_N] == 1
                nPc := If(xA, aIns[I_A], aIns[I_B])
              Otherwise
                nPc := If(xA, aIns[I_B], aIns[I_A])
              EndCase
            EndIf
          Case nOp == OP_LOCAL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]]
          Case nOp == OP_SETLOCAL
            aLoc[aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_NUM
            nSp++
            aSt[nSp] := aIns[I_N]
          Case nOp == OP_LOCAL2
            aSt[nSp + 1] := aLoc[aIns[I_A]]
            nSp += 2
            aSt[nSp] := aLoc[aIns[I_B]]
          Case nOp == OP_CALL
            nN := aIns[I_A]
            nK := aIns[I_K]
            If nK == K_FN
              // A function of a module: its frame, its parameters from the
              // stack.
              aFn := aIns[I_X]
              xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
              nAt := nSp - nN
              nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
              For nK := 1 To nI
                xA[nK] := aSt[nAt + nK]
              Next
              aF[F_SP] := nAt
              aF[F_PC] := nPc
              ::Fail("stack overflow") if Len(aFrames) > 4000
              aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, Nil, Nil}
              AAdd(aFrames, aF)
              aCode := aFn[FN_CODE]
              aLoc := xA
              aSt := xA
              nSp := aFn[FN_NLOCALS]
              nPc := 1
            Else
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN
              Do Case
              Case nK == K_SYS
                xA := Eval(aIns[I_X], Nil, aArgs)
                nSp++
                aSt[nSp] := xA
              Case nK == K_PCOUNT
                nSp++
                aSt[nSp] := aF[F_ARGC]
              Case nK == K_EVAL .And. ValType(aArgs[1]) == "B"
                // Here, for the few arguments a block has as a rule: a
                // function between would be entered again by a block that
                // runs Eval() inside an Eval().
                Do Case
                Case nN == 1
                  xA := Eval(aArgs[1])
                Case nN == 2
                  xA := Eval(aArgs[1], aArgs[2])
                Case nN == 3
                  xA := Eval(aArgs[1], aArgs[2], aArgs[3])
                Otherwise
                  xA := XbcEvalArgs(aArgs[1], aArgs)
                EndCase
                nSp++
                aSt[nSp] := xA
              Case nK == K_MACRO
                xA := XbcEvalN(aIns[I_X], aArgs, Nil)
                nSp++
                aSt[nSp] := xA
              Otherwise
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If ::Invoke(aF, aIns[I_S], aArgs, .F., aIns)
                  // A function of a module: its frame runs on.
                  aF := aFrames[Len(aFrames)]
                  aCode := aF[F_FN][FN_CODE]
                  aLoc := aF[F_LOCALS]
                  aSt := aF[F_LOCALS]
                  nSp := aF[F_SP]
                  nPc := aF[F_PC]
                Else
                  nSp := aF[F_SP]
                EndIf
              EndCase
            EndIf
          Case nOp == OP_JUMPF
            If !aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          Case nOp == OP_ADD
            nSp--
            aSt[nSp] := aSt[nSp] + aSt[nSp + 1]
          Case nOp == OP_JUMP
            nPc := aIns[I_A]
          EndCase
        ElseIf nOp <= OP_EQJF
          Do Case
          // What is subscripted is a Local: the AppServer words an error of an
          // element subscripted again otherwise -- 'array out of bounds ( 2
          // of 0 )', not '[2] of [0]' (04-flow, on 24.3.1.9).
          Case nOp == OP_LOCALIDX
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_LOCALIDXL
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aLoc[aIns[I_B]]]
          Case nOp == OP_INDEX
            xA := aSt[nSp - 1]
            nSp--
            aSt[nSp] := xA[aSt[nSp + 1]]
          Case nOp == OP_NUMIDX
            xA := aSt[nSp]
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_INCLOCAL
            aLoc[aIns[I_A]] := aLoc[aIns[I_A]] + aIns[I_N]
          Case nOp == OP_ADDNUM
            aSt[nSp] := aSt[nSp] + aIns[I_N]
          Case nOp == OP_ADDSET
            aLoc[aIns[I_A]] := aSt[nSp - 1] + aSt[nSp]
            nSp -= 2
          Case nOp == OP_LEJF
            If !(aSt[nSp - 1] <= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_LTJF
            If !(aSt[nSp - 1] < aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GEJF
            If !(aSt[nSp - 1] >= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GTJF
            If !(aSt[nSp - 1] > aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EXACTJF
            If !(aSt[nSp - 1] == aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_NEJF
            If !(aSt[nSp - 1] != aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EQJF
            If !(aSt[nSp - 1] = aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          EndCase
        ElseIf nOp <= OP_FALSE
          Do Case
          Case nOp == OP_RET
            xA := aSt[nSp]
            If aF[F_MORE] != Nil
              xA := aF[F_SELF] if aF[F_MORE][X_CTOR]
              ::EndFrame(aF)
            EndIf
            ASize(aFrames, Len(aFrames) - 1)
            If Len(aFrames) < nBase
              xResult := xA
              lDone := .T.
              Exit
            EndIf
            aF := aFrames[Len(aFrames)]
            aCode := aF[F_FN][FN_CODE]
            aLoc := aF[F_LOCALS]
            aSt := aF[F_LOCALS]
            nSp := aF[F_SP] + 1
            nPc := aF[F_PC]
            aSt[nSp] := xA
          Case nOp == OP_POP
            nSp--
          Case nOp == OP_STR
            nSp++
            aSt[nSp] := aIns[I_S]
          Case nOp == OP_NIL
            nSp++
            aSt[nSp] := Nil
          Case nOp == OP_METHOD
            nN := aIns[I_A]
            xB := aSt[nSp - nN]
            If ValType(xB) == "O" .And. AttIsMemberOf(xB, "xbcCls")
              // A module's class: the class it found last, and the method --
              // one class a call sees, as a rule --, its frame.
              aCls := xB:xbcCls
              If aIns[I_C] != Nil .And. aIns[I_C][1] == aCls
                aM := aIns[I_C][2]
              Else
                aM := ::MethodOf(aCls, aIns[I_S2])
                ::Fail("no method ${aIns[I_S]} of ${aCls[C_NAME]}") if aM == Nil
                aIns[I_C] := {aCls, aM}
              EndIf
              aFn := aM[1]
              If aIns[I_K] == K_FN
                xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
                nAt := nSp - nN
                nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
                For nK := 1 To nI
                  xA[nK] := aSt[nAt + nK]
                Next
                aF[F_SP] := nAt - 1
                aF[F_PC] := nPc
                ::Fail("stack overflow") if Len(aFrames) > 4000
                aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, xB, Nil}
                AAdd(aFrames, aF)
              Else
                aArgs := Array(nN)
                For nI := 1 To nN
                  aArgs[nI] := aSt[nSp - nN + nI]
                Next
                nSp -= nN + 1
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If aIns[I_K] == 0 .And. !lTrace
                  aIns[I_K] := If(XbcAnyRef(aArgs), K_SLOW, K_FN)
                EndIf
                ::Push(aFn, aArgs, Nil, xB)
                aF := aFrames[Len(aFrames)]
              EndIf
              aCode := aF[F_FN][FN_CODE]
              aLoc := aF[F_LOCALS]
              aSt := aF[F_LOCALS]
              nSp := aF[F_SP]
              nPc := aF[F_PC]
            Else
              // The AppServer's: the table's block for the method, found the
              // first time, when the call has no reference.
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN + 1
              If aIns[I_X] == Nil .And. !lTrace
                aIns[I_X] := .F.
                If !XbcAnyRef(aArgs)
                  nAt := ::hSys{"m:" + aIns[I_S2] + "/" + cValToChar(nN)}
                  aIns[I_X] := ::aSys[nAt] if nAt != Nil
                EndIf
              EndIf
              If ValType(aIns[I_X]) == "B"
                xA := Eval(aIns[I_X], xB, aArgs)
              Else
                xA := ::MethodCall(xB, aIns[I_S], aArgs)
              EndIf
              nSp++
              aSt[nSp] := xA
            EndIf
          Case nOp == OP_MEMBER
            xA := aSt[nSp]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              // A module's class: the place of the data, found once for the
              // class it sees.
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              aSt[nSp] := xA:aProps[aIns[I_C][2]]
            Else
              aSt[nSp] := ::MemberOf(xA, aIns[I_S])
            EndIf
          Case nOp == OP_SETMEMBER
            xA := aSt[nSp - 1]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              xA:aProps[aIns[I_C][2]] := aSt[nSp]
            Else
              ::SetMemberOf(xA, aIns[I_S], aSt[nSp])
            EndIf
            nSp -= 2
          Case nOp == OP_SETINDEX
            xA := aSt[nSp - 2]
            xA[aSt[nSp - 1]] := aSt[nSp]
            nSp -= 3
          Case nOp == OP_SELF
            nSp++
            aSt[nSp] := aF[F_SELF]
          Case nOp == OP_EXACT
            nSp--
            aSt[nSp] := (aSt[nSp] == aSt[nSp + 1])
          Case nOp == OP_TRUE
            nSp++
            aSt[nSp] := .T.
          Case nOp == OP_FALSE
            nSp++
            aSt[nSp] := .F.
          EndCase
        ElseIf nOp <= OP_JUMPT
          Do Case
          Case nOp == OP_SUB
            nSp--
            aSt[nSp] := aSt[nSp] - aSt[nSp + 1]
          Case nOp == OP_MUL
            nSp--
            aSt[nSp] := aSt[nSp] * aSt[nSp + 1]
          Case nOp == OP_DIV
            nSp--
            aSt[nSp] := aSt[nSp] / aSt[nSp + 1]
          Case nOp == OP_MOD
            nSp--
            aSt[nSp] := aSt[nSp] % aSt[nSp + 1]
          Case nOp == OP_NOT
            aSt[nSp] := !aSt[nSp]
          Case nOp == OP_EQ
            nSp--
            aSt[nSp] := (aSt[nSp] = aSt[nSp + 1])
          Case nOp == OP_NE
            nSp--
            aSt[nSp] := (aSt[nSp] != aSt[nSp + 1])
          Case nOp == OP_LT
            nSp--
            aSt[nSp] := (aSt[nSp] < aSt[nSp + 1])
          Case nOp == OP_GT
            nSp--
            aSt[nSp] := (aSt[nSp] > aSt[nSp + 1])
          Case nOp == OP_LE
            nSp--
            aSt[nSp] := (aSt[nSp] <= aSt[nSp + 1])
          Case nOp == OP_GE
            nSp--
            aSt[nSp] := (aSt[nSp] >= aSt[nSp + 1])
          Case nOp == OP_ANDJUMP
            If !aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_ORJUMP
            If aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_JUMPT
            If aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          EndCase
        ElseIf nOp <= OP_CONTAINS
          Do Case
          Case nOp == OP_ARRAY
            nN := aIns[I_A]
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI]
            Next
            nSp := nSp - nN + 1
            aSt[nSp] := xA
          Case nOp == OP_DUP
            nSp++
            aSt[nSp] := aSt[nSp - 1]
          Case nOp == OP_DUP2
            aSt[nSp + 1] := aSt[nSp - 1]
            aSt[nSp + 2] := aSt[nSp]
            nSp += 2
          Case nOp == OP_CELL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]][1]
          Case nOp == OP_SETCELL
            aLoc[aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_UPVAL
            nSp++
            aSt[nSp] := aF[F_CELLS][aIns[I_A]][1]
          Case nOp == OP_SETUPVAL
            aF[F_CELLS][aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_REFLOCAL
            nSp++
            aSt[nSp] := {scRef, aLoc, aIns[I_A]}
          Case nOp == OP_REFCELL
            nSp++
            aSt[nSp] := {scRef, aLoc[aIns[I_A]], 1}
          Case nOp == OP_REFUPVAL
            nSp++
            aSt[nSp] := {scRef, aF[F_CELLS][aIns[I_A]], 1}
          Case nOp == OP_BLOCK
            nN := aIns[I_B]
            If aIns[I_C] == Nil
              aIns[I_C] := aF[F_FN][FN_MOD][M_FNS]{Upper(aIns[I_S])}
            EndIf
            aFn := aIns[I_C]
            ::Fail("no block function ${aIns[I_S]}") if aFn == Nil
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI][2]
            Next
            nSp := nSp - nN + 1
            ::JitWhole(aFn) if aFn[FN_FAST] == Nil
            If ValType(aFn[FN_FAST]) == "L"
              aSt[nSp] := XbcMakeBlock(aFn[FN_ID], xA, aF[F_SELF])
            Else
              aSt[nSp] := XbcMakeFast(aFn[FN_FAST], xA, aF[F_SELF])
            EndIf
          Case nOp == OP_ISNIL
            aSt[nSp] := (ValType(aSt[nSp]) == "U")
          Case nOp == OP_NEG
            aSt[nSp] := -aSt[nSp]
          Case nOp == OP_POW
            nSp--
            aSt[nSp] := aSt[nSp] ** aSt[nSp + 1]
          Case nOp == OP_CONTAINS
            nSp--
            aSt[nSp] := (aSt[nSp] $ aSt[nSp + 1])
          EndCase
        ElseIf nOp <= OP_BOX
          Do Case
          Case nOp == OP_STATIC
            nSp++
            aSt[nSp] := aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]]
          Case nOp == OP_SETSTATIC
            aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_BOX
            aLoc[aIns[I_A]] := {aLoc[aIns[I_A]]}
          EndCase
        Else
          // The rare ones (Rare()): the frame's stack and place there, and
          // back from the frame on top -- a new one, for a call.
          aF[F_SP] := nSp
          aF[F_PC] := nPc
          ::Rare(aF, aIns)
          aF := aFrames[Len(aFrames)]
          aCode := aF[F_FN][FN_CODE]
          aLoc := aF[F_LOCALS]
          aSt := aF[F_LOCALS]
          nSp := aF[F_SP]
          nPc := aF[F_PC]
        EndIf
      EndDo
    Recover
      xCaught := XbcCaught()
      // An error in the frame this was running: the line of the instruction
      // it ran last.
      If ::aErrAt != Nil .And. ::aErrAt == aF
        ::cWhere := "${aF[F_FN][FN_NAME]}, line ${aCode[Max(nPc - 1, 1)][I_LINE]}"
        ::aErrAt := Nil
      EndIf
      ::lInErr := .F.
      If lTrace
        ::Note("  caught by the run from frame ${nBase}: " + ;
               If(XbcIsErr(xCaught), "error " + ::MemberOf(xCaught[2], "Description"), XbcShown(xCaught)))
      EndIf
    End Sequence
    If !lDone
      // The machine's own trouble -- a file it cannot read -- goes all the way
      // out, and so does what no region of this run takes.
      If (ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: ") .Or. ;
         !::Unwind(nBase, If(XbcIsErr(xCaught), xCaught[2], xCaught), XbcIsErr(xCaught))
        ::nRuns--
        XbcBreak(xCaught)
      EndIf
    EndIf
  EndDo
  ::nRuns--
Return xResult

// ---- the rare instructions --------------------------------------------------
// What a program runs seldom -- objects made, statics by reference,
// privates and publics, fields, calls by name, _Super, macros, regions,
// defers, areas --, out of the loop: the AppServer enters a function at a
// cost that grows with its size, and the loop is four times in the file
// (the loop's copies). The loop puts the frame's stack and place in aF,
// and takes them back from the frame on top -- a new one, for a call.
Method Rare(aF, aIns) Class XbcVM
  Local nOp := aIns[I_OP]
  Local aSt := aF[F_LOCALS]
  Local nSp := aF[F_SP]
  Local nPc := aF[F_PC]
  Local aArgs
  Local aCls
  Local aM
  Local xA
  Local cName
  Local nAt
  If nOp == OP_NEW .Or. nOp == OP_CALLX .Or. nOp == OP_SUPER
    aArgs := Array(aIns[I_A])
    For local nI := 1 To aIns[I_A]
      aArgs[nI] := aSt[nSp - aIns[I_A] + nI]
    Next
    nSp -= aIns[I_A]
  EndIf
  Do Case
  Case nOp == OP_NEW
    // 'Name():M(...)': an object of the class, M run on it -- the object
    // what the caller gets; a static M, what it returns.
    aF[F_SP] := nSp
    aCls := ::ClassNamed(aF[F_FN][FN_MOD], aIns[I_S])
    If aCls == Nil
      xA := ::NewNative(aIns[I_S], aIns[I_S2], aArgs)
      nSp++
      aSt[nSp] := xA
    Else
      aM := ::MethodOf(aCls, Upper(aIns[I_S2]))
      ::Fail("Cannot find method ${aCls[C_NAME]}:${Upper(aIns[I_S2])}") if aM == Nil
      xA := If(aM[2], Nil, ::Instance(aCls))
      ::Push(aM[1], aArgs, Nil, xA)
      XbcMore(ATail(::aFrames))[X_CTOR] := .T. if xA != Nil
      Return Nil
    EndIf
  Case nOp == OP_REFSTATIC
    nSp++
    aSt[nSp] := {scRef, aF[F_FN][FN_MOD][M_STATICS], aIns[I_A]}
  Case nOp == OP_MEMVAR
    xA := ::MemCell(aIns[I_S])
    ::Fail("variable does not exist: ${aIns[I_S]}") if xA == Nil
    nSp++
    aSt[nSp] := xA[1]
  Case nOp == OP_SETMEMVAR
    xA := ::MemCell(aIns[I_S]) ?: ::PrivCell(aIns[I_S])
    xA[1] := aSt[nSp]
    nSp--
  Case nOp == OP_REFMEMVAR
    xA := ::MemCell(aIns[I_S]) ?: ::PrivCell(aIns[I_S])
    nSp++
    aSt[nSp] := {scRef, xA, 1}
  Case nOp == OP_PRIVATE
    ::PrivCell(aIns[I_S], .T.)
  Case nOp == OP_PUBLIC
    ::hPubs{aIns[I_S]} := {Nil} if !(::hPubs has aIns[I_S])
  Case nOp == OP_FIELD
    nSp++
    aSt[nSp] := ::FieldOf(aIns[I_S], aIns[I_S2])
  Case nOp == OP_SETFIELD
    ::SetFieldOf(aIns[I_S], aIns[I_S2], aSt[nSp])
    nSp--
  Case nOp == OP_FIELDX
    aSt[nSp] := ::FieldOf(aSt[nSp], aIns[I_S])
  Case nOp == OP_SETFIELDX
    ::SetFieldOf(aSt[nSp - 1], aIns[I_S], aSt[nSp])
    nSp -= 2
  Case nOp == OP_CALLX
    cName := aSt[nSp]
    nSp--
    ::Fail("&name.(): the name is no string") if ValType(cName) != "C"
    aF[F_SP] := nSp
    // A function of a module pushes its frame; any other's result is on
    // the stack.
    ::Invoke(aF, cName, aArgs, .T., Nil)
    Return Nil
  Case nOp == OP_SUPER
    aF[F_SP] := nSp
    cName := Upper(aF[F_FN][FN_NAME])
    nAt := At("#", cName)
    cName := Left(cName, nAt - 1) if nAt > 0
    nAt := At(":", cName)
    aCls := If(nAt > 0, ::hClasses{Left(cName, nAt - 1)}, Nil)
    ::Fail("_Super outside a method") if aCls == Nil
    aM := ::Above(aCls, aIns[I_S2])
    If aM == Nil
      // A class above that is the AppServer's: its constructor is Self.
      ::Fail("no method ${aIns[I_S]} above ${aCls[C_NAME]}") if !(aIns[I_S2] == "NEW")
      nSp++
      aSt[nSp] := aF[F_SELF]
    Else
      ::Push(aM[1], aArgs, Nil, aF[F_SELF])
      Return Nil
    EndIf
  Case nOp == OP_MACRO
    aSt[nSp] := ::Macro(aSt[nSp])
  Case nOp == OP_SETMACRO
    ::SetMacro(aSt[nSp - 1], aSt[nSp])
    nSp -= 2
  Case nOp == OP_LINE
    // Its line is each instruction's: a 'line' left in -- with trace=FILE
    // -- does nothing.
  Case nOp == OP_SEQ .Or. nOp == OP_TRY
    xA := XbcMore(aF)
    xA[X_REGIONS] ?= {}
    AAdd(xA[X_REGIONS], {nOp == OP_TRY, aIns[I_A], nSp, If(xA[X_AREAS] == Nil, 0, Len(xA[X_AREAS]))})
  Case nOp == OP_ENDSEQ
    ASize(aF[F_MORE][X_REGIONS], Len(aF[F_MORE][X_REGIONS]) - 1)
  Case nOp == OP_DEFER
    XbcDefer(aF, aIns[I_A], aIns[I_B])
  Case nOp == OP_RUNDEFERS
    If aF[F_MORE] != Nil .And. aF[F_MORE][X_DEFERS] != Nil .And. !Empty(aF[F_MORE][X_DEFERS])
      aF[F_MORE][X_BACK] := nPc - 1
      nPc := XbcNextDefer(aF)
    EndIf
  Case nOp == OP_ENDDEFER
    nPc := aF[F_MORE][X_BACK]
  Case nOp == OP_AREA
    xA := XbcMore(aF)
    xA[X_AREAS] ?= {}
    AAdd(xA[X_AREAS], ::CallNative("Select", {}))
    ::CallNative("DbSelectArea", {aSt[nSp]})
    nSp--
  Case nOp == OP_ENDAREA
    ::CallNative("DbSelectArea", {ATail(aF[F_MORE][X_AREAS])})
    ASize(aF[F_MORE][X_AREAS], Len(aF[F_MORE][X_AREAS]) - 1)
  EndCase
  aF[F_SP] := nSp
  aF[F_PC] := nPc
Return Nil

// A run inside a run: the copy of the loop next to the one running -- the
// AppServer enters a function already running further down at a cost that
// grows with its size (the loop's copies, below).
Static Function XbcRun(oVM, nBase)
  Local nCopy := oVM:nRuns % 4
  Do Case
  Case nCopy == 0
    Return oVM:Run(nBase)
  Case nCopy == 1
    Return oVM:Run1(nBase)
  Case nCopy == 2
    Return oVM:Run2(nBase)
  EndCase
Return oVM:Run3(nBase)

// A defer reached: to run when the frame returns -- once, however many times
// it is reached.
Static Function XbcDefer(aF, nId, nAt)
  Local aMore := XbcMore(aF)
  aMore[X_DEFERS] ?= {}
  for aD in aMore[X_DEFERS]
    Return Nil if aD[1] == nId
  next
  AAdd(aMore[X_DEFERS], {nId, nAt})
Return Nil

// The deferred code to run now -- the highest number first, the last one
// written --, forgotten: where it is. Loops, not lambdas: the frame is in
// reach (XbcMakeBlock()).
Static Function XbcNextDefer(aF)
  Local aDefers := aF[F_MORE][X_DEFERS]
  Local nTop := 1
  Local nAt
  For local nK := 2 To Len(aDefers)
    nTop := nK if aDefers[nK][1] > aDefers[nTop][1]
  Next
  nAt := aDefers[nTop][2]
  ADel(aDefers, nTop)
  ASize(aDefers, Len(aDefers) - 1)
Return nAt

// What few frames have, made the first time a frame needs some of it.
Static Function XbcMore(aF)
  aF[F_MORE] ?= {Nil, Nil, Nil, Nil, 0, Nil, .F.}
Return aF[F_MORE]

// ---- calls ------------------------------------------------------------------
// A call by name: a function of a module pushes its frame, .T.; any other is
// the AppServer's, its result on the caller's stack, .F. What a 'call'
// found is kept in its instruction, and what kind of call it is, for the
// loop to make the next ones itself (Classify()).
Method Invoke(aF, cName, aArgs, lMacro, aIns) Class XbcVM
  Local xFound
  Local xResult
  If aIns != Nil
    aIns[I_C] ?= ::Resolve(aF[F_FN][FN_MOD], cName, lMacro)
    xFound := aIns[I_C]
    ::Classify(aIns, xFound, aArgs) if aIns[I_K] == 0 .And. ::aTrace == Nil
  Else
    xFound := ::Resolve(aF[F_FN][FN_MOD], cName, lMacro)
  EndIf
  If ValType(xFound) == "A"
    ::Push(xFound, aArgs, Nil, Nil)
    Return .T.
  EndIf
  // The AppServer's -- but what is the frame's, or the program's, or a
  // Break, whose value a plain Recover is to find.
  Do Case
  Case xFound == "PCOUNT"
    xResult := aF[F_ARGC]
  Case xFound == "BREAK"
    XbcBreak(If(Empty(aArgs), Nil, aArgs[1]))
  Case xFound == "EVAL" .And. !Empty(aArgs) .And. ValType(aArgs[1]) == "B" .And. !XbcAnyRef(aArgs)
    xResult := XbcEvalArgs(aArgs[1], aArgs)
  Case xFound == "ERRORBLOCK"
    xResult := ::bProgErr
    ::bProgErr := aArgs[1] if !Empty(aArgs)
  Case (xFound == "CONOUT" .Or. xFound == "QOUT") .And. ::lCapture
    aArgs |> tap([x] AAdd(::aOut, If(ValType(x) $ "CNLDF", cValToChar(x), "")))
  Otherwise
    xResult := ::CallNative(cName, aArgs)
  EndCase
  aF[F_SP]++
  ASize(aF[F_LOCALS], aF[F_SP] * 2) if aF[F_SP] > Len(aF[F_LOCALS])
  aF[F_LOCALS][aF[F_SP]] := xResult
Return .F.

// What a call is, the first time it runs (K_): a function of a module, one
// of the AppServer's in the table, PCount(), Eval(), another of the
// AppServer's -- each with no argument by reference --, or any other; the
// next times the loop makes the first five itself. The program's Break(), ErrorBlock() and, with out=FILE, its
// ConOut() and QOut() are the interpreter's.
Method Classify(aIns, xFound, aArgs) Class XbcVM
  Local nSys
  aIns[I_K] := K_SLOW
  Return Nil if XbcAnyRef(aArgs)
  Do Case
  Case ValType(xFound) == "A"
    aIns[I_K] := K_FN
    aIns[I_X] := xFound
  Case xFound == "PCOUNT"
    aIns[I_K] := K_PCOUNT
  Case xFound == "EVAL"
    aIns[I_K] := K_EVAL if !Empty(aArgs)
  Case xFound == "BREAK" .Or. xFound == "ERRORBLOCK" .Or. ;
       ((xFound == "CONOUT" .Or. xFound == "QOUT") .And. ::lCapture)
  Otherwise
    nSys := ::hSys{"f:" + xFound + "/" + cValToChar(Len(aArgs))}
    Do Case
    Case nSys != Nil
      aIns[I_K] := K_SYS
      aIns[I_X] := ::aSys[nSys]
    Case !::lHost
      aIns[I_K] := K_MACRO
      aIns[I_X] := ::MacroOf("f", xFound, "", Len(aArgs), {})
    EndCase
  EndCase
Return Nil

// ---- the JIT ----------------------------------------------------------------
// Can a call be in a run of the JIT's: one of the AppServer's functions --
// not one a module loaded so far has, nor the program's own PCount(),
// Break(), ErrorBlock(), nor, with out=FILE, ConOut() and QOut(); nor one
// that runs code blocks: in a macro's block, Eval() of a block of the
// program's gave back its argument, not its value (02-blocks, on 24.3.1.9).
// Of the runtime's, those that take no block.
Method JitCallable(cName) Class XbcVM
  Local cUp := Upper(cName)
  Return .F. if "." $ cUp .Or. ::hEvery has cUp
  Return .F. if cUp == "PCOUNT" .Or. cUp == "BREAK" .Or. cUp == "ERRORBLOCK" .Or. cUp == "EVAL" .Or. ;
                cUp == "AEVAL" .Or. cUp == "ASCAN" .Or. cUp == "ASORT" .Or. cUp == "DBEVAL"
  Return .F. if (cUp == "CONOUT" .Or. cUp == "QOUT") .And. ::lCapture
  If Left(cUp, 2) == "U_"
    for cOk in {"U_XTPL_ASUM", "U_XTPL_APROD", "U_XTPL_AMAX", "U_XTPL_AMIN", "U_XTPL_IN", "U_XTPL_HGET", ;
                "U_XTPL_HSET", "U_XTPL_HHAS", "U_XTPL_HNEW", "U_XTPL_JNEW", "U_XTPL_TAKE", "U_XTPL_DROP", ;
                "U_XTPL_DISTINCT", "U_XTPL_SEEN", "U_XTPL_REVERSE", "U_XTPL_FLATTEN", "U_XTPL_ENUMERATE", ;
                "U_XTPL_CHUNKS", "U_XTPL_ZIP", "U_XTPL_PAIRS", "U_XTPL_KEYS", "U_XTPL_VALUES", ;
                "U_XTPL_PAIRWISE", "U_XTPL_SPLIT", "U_XTPL_JOIN", "U_XTPL_STARTS", "U_XTPL_ENDS", ;
                "U_XTPL_CONTAINS", "U_XTPL_QUEUE", "U_XTPL_APICK", "U_XTPL_AROLL", "U_XTPL_SETMAXROLL"}
      Return .T. if cOk == cUp
    next
    Return .F.
  EndIf
Return .T.

// A run of instructions (XbcJitRuns()) as one code block the AppServer's
// macro compiler makes, the first time it runs, for the stack's height
// then:
//
//   {|XL, XK, XC, XT, XO, X1, X2| statement, ..., condition}
//
// XL the frame's locals and stack, XK the run's constants, XC its cells, XT
// the module's statics, XO Self, X1 ... values kept on the way. What the
// run pushes and takes again is an expression, never stored; what it
// leaves goes where it would be, and the condition of the jump that ends
// it is what the block gives. A value is kept before anything is set --
// one read before, or a call --, and a subscript is u_xbcidx()'s or
// u_xbcset()'s. A call that turns out to be a module's, or a block the
// macro compiler refuses, leaves the run to the loop. On xc-vm, the block
// is u_xbcjit()'s, from the module jitdump=FILE wrote.
Method Jit(aF, aIns, nSp) Class XbcVM
  Local aJ := {{}, {}, {}, 0, nSp, 0, .F., Nil}
  Local cText
  Local cCond := ""
  Local cTemps := ""
  Local bBlock := Nil
  Local nTop
  aIns[I_K] := 2
  Return Nil if !::JitOps(aJ, aF[F_FN][FN_MOD], aIns[I_X])
  If aIns[I_N] == 1 .Or. aIns[I_N] == 2
    cCond := XjPop(aJ)[1]
  EndIf
  // What it leaves, where it would be -- each kept first when one reads
  // the stack below the run, which they go over.
  nTop := aJ[J_BASE] - aJ[J_BELOW]
  If aJ[J_READS] .And. !Empty(aJ[J_STACK])
    XjPush(aJ, cCond, 1) if !Empty(cCond)
    XjSettle(aJ)
    cCond := XjPop(aJ)[1] if !Empty(cCond)
  EndIf
  for aEach, nK in aJ[J_STACK]
    cText := "XL[${nTop + nK}]"
    AAdd(aJ[J_OUT], cText + " := " + aEach[1]) if !(aEach[1] == cText)
  next
  AAdd(aJ[J_OUT], If(Empty(cCond), "Nil", cCond))
  For local nT := 1 To aJ[J_TEMPS]
    cTemps += ", X${nT}"
  Next
  cText := "{|XL, XK, XC, XT, XO${cTemps}| " + (aJ[J_OUT] |> join(", ")) + "}"
  If ::lHost
    bBlock := u_xbcjit(cText) if FindFunction("U_XBCJIT")
  Else
    bBlock := XbcJitBlock(cText)
  EndIf
  If ValType(bBlock) != "B"
    ::hJitDump{cText} := .T. if !Empty(::cJitDump)
    Return Nil
  EndIf
  aIns[I_C] := bBlock
  aIns[I_S2] := aJ[J_CONSTS]
  aIns[I_D] := nSp
  aIns[I_E] := nTop + Len(aJ[J_STACK])
  aIns[I_K] := 1
Return Nil

// The JIT's block, by the AppServer's macro compiler: Nil for one it cannot
// make. Here, not in Jit() -- no code block is made where the machine's
// arrays are in reach (XbcMakeBlock()).
Static Function XbcJitBlock(cText)
  Local bOld := ErrorBlock({|e| Break(e)})
  Local bBlock
  Begin Sequence
    bBlock := &(cText)
  Recover
    bBlock := Nil
  End Sequence
  ErrorBlock(bOld)
Return bBlock

// A run's instructions, the JIT's way, into aJ: .F. for one the JIT cannot
// have -- a call that turns out to be a module's function; in a whole, a
// cell of its own.
Method JitOps(aJ, aMod, aRun) Class XbcVM
  Local aE
  Local aA
  Local aX
  Local aArgs
  Local cText
  Local nOp
  for aOne in aRun
    nOp := aOne[I_OP]
    Do Case
    Case nOp == OP_NIL
      XjPush(aJ, "Nil", 0)
    Case nOp == OP_TRUE
      XjPush(aJ, ".T.", 0)
    Case nOp == OP_FALSE
      XjPush(aJ, ".F.", 0)
    Case nOp == OP_NUM
      If aOne[I_N] == Int(aOne[I_N]) .And. Abs(aOne[I_N]) < 1000000000
        XjPush(aJ, "(" + cValToChar(aOne[I_N]) + ")", 0)
      Else
        XjPush(aJ, XjConst(aJ, aOne[I_N]), 0)
      EndIf
    Case nOp == OP_STR
      XjPush(aJ, XjConst(aJ, aOne[I_S]), 0)
    Case nOp == OP_LOCAL
      XjPush(aJ, XjLocal(aJ, aOne[I_A]), 1)
    Case nOp == OP_CELL
      Return .F. if aJ[J_WHOLE] != Nil
      XjPush(aJ, "XL[${aOne[I_A]}][1]", 1)
    Case nOp == OP_UPVAL
      XjPush(aJ, "XC[${aOne[I_A]}][1]", 1)
    Case nOp == OP_STATIC
      XjPush(aJ, "XT[${aOne[I_A]}]", 1)
    Case nOp == OP_SELF
      XjPush(aJ, "XO", 0)
    Case nOp == OP_SETLOCAL .Or. nOp == OP_SETCELL .Or. nOp == OP_SETUPVAL .Or. nOp == OP_SETSTATIC
      aE := XjPop(aJ)
      XjSettle(aJ)
      Do Case
      Case nOp == OP_SETLOCAL
        cText := XjLocal(aJ, aOne[I_A])
      Case nOp == OP_SETCELL
        Return .F. if aJ[J_WHOLE] != Nil
        cText := "XL[${aOne[I_A]}][1]"
      Case nOp == OP_SETUPVAL
        cText := "XC[${aOne[I_A]}][1]"
      Otherwise
        cText := "XT[${aOne[I_A]}]"
      EndCase
      AAdd(aJ[J_OUT], cText + " := " + aE[1])
    Case nOp == OP_POP
      aE := XjPop(aJ)
      If aE[2] == 2
        XjSettle(aJ)
        AAdd(aJ[J_OUT], aE[1])
      EndIf
    Case nOp == OP_DUP
      // Twice the same value: an expression kept, not worked out twice.
      aE := XjPop(aJ)
      Do Case
      Case aE[2] == 2 .Or. XjCalls(aJ)
        XjPush(aJ, aE[1], aE[2])
        XjSettle(aJ)
        aE := XjPop(aJ)
      Case "(" $ aE[1]
        aE := {XjVar(aJ, aE), 0}
      EndCase
      XjPush(aJ, aE[1], aE[2])
      XjPush(aJ, aE[1], aE[2])
    Case nOp == OP_DUP2
      aE := XjPop(aJ)
      aA := XjPop(aJ)
      If aE[2] == 2 .Or. aA[2] == 2
        XjPush(aJ, aA[1], aA[2])
        XjPush(aJ, aE[1], aE[2])
        XjSettle(aJ)
        aE := XjPop(aJ)
        aA := XjPop(aJ)
      EndIf
      XjPush(aJ, aA[1], aA[2])
      XjPush(aJ, aE[1], aE[2])
      XjPush(aJ, aA[1], aA[2])
      XjPush(aJ, aE[1], aE[2])
    Case nOp == OP_ARRAY
      aArgs := XjPops(aJ, aOne[I_A])
      XjPush(aJ, "{" + XjTexts(aArgs) + "}", 2)
    Case nOp == OP_INDEX
      aE := XjPop(aJ)
      aA := XjPop(aJ)
      XjPush(aJ, "u_xbcidx(" + aA[1] + ", " + aE[1] + ")", Max(1, Max(aA[2], aE[2])))
    Case nOp == OP_SETINDEX
      aX := XjPop(aJ)
      aE := XjPop(aJ)
      aA := XjPop(aJ)
      XjSettle(aJ)
      AAdd(aJ[J_OUT], "u_xbcset(" + aA[1] + ", " + aE[1] + ", " + aX[1] + ")")
    Case nOp == OP_NEG .Or. nOp == OP_NOT
      aE := XjPop(aJ)
      XjPush(aJ, "(" + If(nOp == OP_NEG, "-", "!") + aE[1] + ")", aE[2])
    Case nOp == OP_ISNIL
      aE := XjPop(aJ)
      XjPush(aJ, "(ValType(" + aE[1] + ") == " + XjConst(aJ, "U") + ")", aE[2])
    Case nOp == OP_CALL
      Return .F. if ValType(::Resolve(aMod, aOne[I_S], .F.)) == "A" .Or. !::JitCallable(aOne[I_S])
      aArgs := XjPops(aJ, aOne[I_A])
      XjPush(aJ, aOne[I_S] + "(" + XjTexts(aArgs) + ")", 2)
    Otherwise
      cText := XjOperator(nOp)
      Return .F. if Empty(cText)
      aE := XjPop(aJ)
      aA := XjPop(aJ)
      XjPush(aJ, "(" + aA[1] + " " + cText + " " + aE[1] + ")", Max(aA[2], aE[2]))
    EndCase
  next
Return .T.

// A code block's function that is one run of the JIT's and its 'ret' --
// most of a program's, '[x] x * 3', '{|x| nSum += x}' -- is one block the
// macro compiler makes, the first time a block of it is made, that the
// program's block runs itself, with no frame and no loop (XbcMakeFast()):
//
//   {|XC, XK, XT, XO, P1, ..., L1, ..., X1, ...| statement, ..., value}
//
// P its parameters -- as many as the block passes, none, one, two or 12
// --, L its other locals, then what a run's block has. A run that leaves
// other than one value, or reads below it, is not one.
Method JitWhole(aFn) Class XbcVM
  Local aCode := aFn[FN_CODE]
  Local aIns := aCode[1]
  Local nP := aFn[FN_PARAMS]
  Local nSlots := If(nP <= 2, nP, 12)
  Local aJ
  Local cText := ""
  Local bBlock
  Local lStatics := .F.
  aFn[FN_FAST] := .F.
  Return Nil if nP > 12 .Or. !(aIns[I_OP] == OP_JIT .And. aIns[I_N] == 0 .And. aIns[I_A] <= Len(aCode))
  Return Nil if !(aCode[aIns[I_A]][I_OP] == OP_RET)
  aJ := {{}, {}, {}, 0, aFn[FN_NLOCALS], 0, .F., nP}
  Return Nil if !::JitOps(aJ, aFn[FN_MOD], aIns[I_X]) .Or. !(Len(aJ[J_STACK]) == 1) .Or. aJ[J_READS]
  For local nK := 1 To nSlots
    cText += ", P${nK}"
  Next
  For local nK := nP + 1 To aFn[FN_NLOCALS]
    cText += ", L${nK}"
  Next
  For local nT := 1 To aJ[J_TEMPS]
    cText += ", X${nT}"
  Next
  AAdd(aJ[J_OUT], aJ[J_STACK][1][1])
  cText := "{|XC, XK, XT, XO${cText}| " + (aJ[J_OUT] |> join(", ")) + "}"
  If ::lHost
    bBlock := u_xbcjit(cText) if FindFunction("U_XBCJIT")
  Else
    bBlock := XbcJitBlock(cText)
  EndIf
  If ValType(bBlock) != "B"
    ::hJitDump{cText} := .T. if !Empty(::cJitDump)
    Return Nil
  EndIf
  for aOne in aIns[I_X]
    lStatics := .T. if aOne[I_OP] == OP_STATIC .Or. aOne[I_OP] == OP_SETSTATIC
  next
  aFn[FN_FAST] := {bBlock, aJ[J_CONSTS], If(lStatics, aFn[FN_MOD][M_STATICS], Nil), aFn[FN_ID], nSlots}
Return Nil

// A local, in a run: of the frame's locals and stack; in a whole, one of
// the block's parameters, P for one of the function's, L for another.
Static Function XjLocal(aJ, nLocal)
  Return "XL[${nLocal}]" if aJ[J_WHOLE] == Nil
Return If(nLocal <= aJ[J_WHOLE], "P", "L") + cValToChar(nLocal)

// A subscript in a block of the JIT's, of a Local as in the loop: in a
// macro's block the AppServer words an error of one 'array out of bounds
// ( 2 of 0 )', not '[2] of [0]' (04-flow, on 24.3.1.9).
User Function xbcidx(xArray, xIndex)
Return xArray[xIndex]

User Function xbcset(xArray, xIndex, xValue)
  xArray[xIndex] := xValue
Return xValue

// With jitdump=FILE: the blocks the JIT could not make, as a module whose
// u_xbcjit(cText) gives the block of each -- for xc-vm, which has no macro
// compiler, to load the next time (cpp/tests/interp.cmake).
Method JitDump() Class XbcVM
  Local cNl := Chr(10)
  Local aTexts := ::hJitDump |> keys
  Local cSrc := "#include " + Chr(34) + "totvs.ch" + Chr(34) + cNl + cNl + ;
                "// The blocks the interpreter's JIT makes, for xc-vm (interp/xbc.xtpl, JitDump())." + cNl + ;
                "User Function xbcjit(cText)" + cNl + "  Do Case" + cNl + ;
                "  Case cText == " + Chr(34) + Chr(34) + cNl + "    Return Nil" + cNl
  ASort(aTexts)
  for cText in aTexts
    cSrc += "  Case cText == " + Chr(34) + cText + Chr(34) + cNl + "    Return " + cText + cNl
  next
  MemoWrite(::cJitDump, cSrc + "  EndCase" + cNl + "Return Nil" + cNl)
Return Nil

Static Function XjPush(aJ, cText, nKind)
  AAdd(aJ[J_STACK], {cText, nKind})
Return Nil

// The top of the stack: below what the run pushed, the stack it found.
Static Function XjPop(aJ)
  Local aE
  If Empty(aJ[J_STACK])
    aE := {"XL[${aJ[J_BASE] - aJ[J_BELOW]}]", 1}
    aJ[J_BELOW]++
    aJ[J_READS] := .T.
    Return aE
  EndIf
  aE := ATail(aJ[J_STACK])
  ASize(aJ[J_STACK], Len(aJ[J_STACK]) - 1)
Return aE

// The top N, in the order they were pushed.
Static Function XjPops(aJ, nN)
  Local aEs := Array(nN)
  For local nK := nN To 1 Step -1
    aEs[nK] := XjPop(aJ)
  Next
Return aEs

Static Function XjTexts(aEs)
Return aEs |> map([e] e[1]) |> join(", ")

// Each value on the stack that something set next could change, or that
// has a call, kept now, in order.
Static Function XjSettle(aJ)
  Local cTemp
  for aE in aJ[J_STACK]
    Loop if aE[2] == 0
    cTemp := XjTemp(aJ)
    AAdd(aJ[J_OUT], cTemp + " := " + aE[1])
    aE[1] := cTemp
    aE[2] := 0
  next
Return Nil

Static Function XjCalls(aJ)
Return aJ[J_STACK] |> anyof([e] e[2] == 2)

Static Function XjTemp(aJ)
  aJ[J_TEMPS]++
Return "X${aJ[J_TEMPS]}"

// A variable holding the value: itself when it is one kept, else one now.
Static Function XjVar(aJ, aE)
  Local cTemp
  Return aE[1] if Left(aE[1], 1) == "X" .And. Len(aE[1]) > 1 .And. ;
                  AllTrim(Str(Val(SubStr(aE[1], 2)))) == SubStr(aE[1], 2)
  cTemp := XjTemp(aJ)
  AAdd(aJ[J_OUT], cTemp + " := " + aE[1])
Return cTemp

Static Function XjConst(aJ, xValue)
  AAdd(aJ[J_CONSTS], xValue)
Return "XK[${Len(aJ[J_CONSTS])}]"

// A binary operator's text, or "".
Static Function XjOperator(nOp)
  Do Case
  Case nOp == OP_ADD
    Return "+"
  Case nOp == OP_SUB
    Return "-"
  Case nOp == OP_MUL
    Return "*"
  Case nOp == OP_DIV
    Return "/"
  Case nOp == OP_MOD
    Return "%"
  Case nOp == OP_POW
    Return "**"
  Case nOp == OP_EQ
    Return "="
  Case nOp == OP_EXACT
    Return "=="
  Case nOp == OP_NE
    Return "!="
  Case nOp == OP_LT
    Return "<"
  Case nOp == OP_GT
    Return ">"
  Case nOp == OP_LE
    Return "<="
  Case nOp == OP_GE
    Return ">="
  Case nOp == OP_CONTAINS
    Return "$"
  EndCase
Return ""

// A function by name, from a module: its own, then -- a name with no
// namespace -- its namespace's, then those it uses, then one of no
// namespace; a macro's name in no namespace. Else the AppServer's: its name
// in upper case.
Method Resolve(aMod, cName, lMacro) Class XbcVM
  Local cUp := Upper(cName)
  Local aFn := aMod[M_FNS]{cUp}
  Return aFn if aFn != Nil .And. aFn[FN_KIND] in {"user", "static", "function", "main"}
  If !lMacro .And. !("." $ cUp)
    aFn := aMod[M_SEARCH] |> map([n] ::hGlobals{n + "." + cUp}) |> first([f] f != Nil)
    Return aFn if aFn != Nil
  EndIf
Return ::hGlobals{cUp} ?: cUp

// A class by name, from a module: as a function is found.
Method ClassNamed(aMod, cName) Class XbcVM
  Local cUp := Upper(cName)
  Local aCls
  If !("." $ cUp)
    aCls := aMod[M_SEARCH] |> map([n] ::hClasses{n + "." + cUp}) |> first([c] c != Nil)
    Return aCls if aCls != Nil
  EndIf
Return ::hClasses{cUp}

// A method, of the class or of one above it: {its function, static}.
Method MethodOf(aCls, cName) Class XbcVM
  If local aM := aCls[C_METHODS]{cName}, aM != Nil
    aM[3] ?= {::hEvery{Upper(aM[1])}, aM[2]}
    Return aM[3] if aM[3][1] != Nil
  EndIf
Return ::Above(aCls, cName)

// The method of the classes above it, in the order 'from' says.
Method Above(aCls, cName) Class XbcVM
Return aCls[C_SUPERS] ;
         |> map([s] ::ClassNamed(aCls[C_MOD], s)) ;
         |> filter([k] k != Nil) ;
         |> map([k] ::MethodOf(k, cName)) ;
         |> first([m] m != Nil)

// A new object of a module's class: the data of the classes above it and
// its own, Nil -- each once, in the place the class gives its name with its
// first object --, then the values each class gives them, the topmost
// first.
Method Instance(aCls) Class XbcVM
  Local aChain := XbcChain(Self, aCls)
  Local oObj
  If aCls[C_SLOTS] == Nil
    aCls[C_SLOTS] := { => }
    for aK in aChain
      for cData in aK[C_DATA]
        Loop if aCls[C_SLOTS] has Upper(cData)
        aCls[C_NSLOTS]++
        aCls[C_SLOTS]{Upper(cData)} := aCls[C_NSLOTS]
      next
    next
  EndIf
  oObj := XbcObj():New(aCls, aCls[C_NSLOTS])
  for aK in aChain
    Loop if Empty(aK[C_INIT])
    aK[C_INITFN] ?= ::hEvery{Upper(aK[C_INIT])}
    ::Fail("no function ${aK[C_INIT]} for the data of ${aK[C_NAME]}") if aK[C_INITFN] == Nil
    ::Push(aK[C_INITFN], {}, Nil, oObj)
    XbcRun(Self, Len(::aFrames))
  next
Return oObj

// The place of a data in the objects of a class: an error for one they do
// not have.
Method SlotOf(aCls, cName) Class XbcVM
  Local nSlot := aCls[C_SLOTS]{Upper(cName)}
  ::Fail("no data ${cName} of ${aCls[C_NAME]}") if nSlot == Nil
Return nSlot

// The classes above a class, the topmost first, and it.
// Loops, not lambdas: the class is in reach (XbcMakeBlock()).
Static Function XbcChain(oVM, aCls)
  Local aChain := {}
  for cSuper in aCls[C_SUPERS]
    Local aK := oVM:ClassNamed(aCls[C_MOD], cSuper)
    Loop if aK == Nil
    for aUp in XbcChain(oVM, aK)
      AAdd(aChain, aUp)
    next
  next
  AAdd(aChain, aCls)
Return aChain

// Is it an object of a module's class.
Static Function XbcIsObj(oObj)
Return AttIsMemberOf(oObj, "xbcCls")

// ---- the AppServer's --------------------------------------------------------
// A function of the AppServer's, by name. A reference is passed as one, and
// written back.
Method CallNative(cName, aArgs) Class XbcVM
Return ::Native("f", cName, "", Nil, aArgs)

// A function, a method of an object, or 'Class():Method()' of the
// AppServer's, by name: aArgs' references passed as such and written back.
// A well-known one is called by its number, as compiled code
// (XbcSyscalls()). Else, on the AppServer, a block a macro
// makes once per name, number of arguments and references -- each argument
// a parameter of its own, by reference where the call had one --; on xc-vm,
// its XBC_ functions.
Method Native(cWhat, cName, cMethod, xObj, aArgs) Class XbcVM
  Local nSys
  Local aVals := Array(Len(aArgs))
  Local aRefs := {}
  Local xResult
  // Every call of the AppServer's comes here: one walk, no blocks.
  for xArg, nI in aArgs
    If XbcIsRef(xArg)
      aVals[nI] := xArg[2][xArg[3]]
      AAdd(aRefs, nI)
    Else
      aVals[nI] := xArg
    EndIf
  next
  nSys := ::hSys{cWhat + ":" + If(cWhat == "m", "", Upper(cName) + If(cWhat == "n", ":", "")) + Upper(cMethod) + ;
                 "/" + cValToChar(Len(aVals)) + XbcRefsKey(aRefs)}
  If nSys != Nil
    xResult := Eval(::aSys[nSys], xObj, aVals)
  ElseIf ::lHost
    Do Case
    Case cWhat == "f"
      xResult := XBC_CALL(cName, aVals, aRefs)
    Case cWhat == "m"
      xResult := XBC_METHOD(xObj, cMethod, aVals, aRefs)
    Otherwise
      xResult := XBC_NEW(cName, cMethod, aVals, aRefs)
    EndCase
  Else
    xResult := XbcEvalN(::MacroOf(cWhat, cName, cMethod, Len(aVals), aRefs), aVals, xObj)
  EndIf
  If ::aTrace != Nil
    ::Note("  the AppServer's ${cWhat}:${cName}:${cMethod}" + If(nSys != Nil, " #${nSys}", "") + "(" + ;
           XbcShownAll(aVals) + ;
                   ") -> " + XbcShown(xResult))
  EndIf
  aRefs |> tap([k] aArgs[k][2][aArgs[k][3]] := aVals[k])
Return xResult

// Values as a trace shows them, between commas.
Static Function XbcShownAll(aVals)
  Local cText := ""
  for xVal, nI in aVals
    cText += If(nI > 1, ", ", "") + XbcShown(xVal)
  next
Return cText

// ':N' for each argument by reference, in order -- a loop, not a lambda
// (XbcMakeBlock()).
Static Function XbcRefsKey(aRefs)
  Local cKey := ""
  for nK in aRefs
    cKey += ":" + cValToChar(nK)
  next
Return cKey

// &(text), run here, not in a method of the machine's: what it makes may
// be a code block (XbcMakeBlock()).
Static Function XbcMacroRun(cText)
Return &(cText)

// The block a macro makes once for a call of the AppServer's not in the
// table -- for its name, number of arguments and references --, each
// argument a parameter of its own: {|a, o, p1, p2, r| r := F(p1, @p2), a[2]
// := p2, r}.
Method MacroOf(cWhat, cName, cMethod, nArgs, aRefs) Class XbcVM
  Local cKey := "${cWhat}:${cName}:${cMethod}:${nArgs}" + XbcRefsKey(aRefs)
  Local cParams := ""
  Local cList := ""
  Local cCall
  If !(::hCache has cKey)
    For local nK := 1 To nArgs
      cParams += ", p${nK}"
      cList += If(nK > 1, ", ", "") + If(nK in aRefs, "@", "") + "p${nK}"
    Next
    cCall := If(cWhat == "f", cName, If(cWhat == "m", "o:", cName + "():") + cMethod)
    cList := "r := ${cCall}(${cList})"
    for nK in aRefs
      cList += ", a[${nK}] := p${nK}"
    next
    ::hCache{cKey} := XbcMacroRun("{|a, o${cParams}, r| ${cList}, r}")
  EndIf
Return ::hCache{cKey}

// Eval of a block made with a parameter for the arguments array, one for
// the object, one for each argument.
Static Function XbcEvalN(bBlock, a, o)
  Local nN := Len(a)
  Do Case
  Case nN == 0
    Return Eval(bBlock, a, o)
  Case nN == 1
    Return Eval(bBlock, a, o, a[1])
  Case nN == 2
    Return Eval(bBlock, a, o, a[1], a[2])
  Case nN == 3
    Return Eval(bBlock, a, o, a[1], a[2], a[3])
  Case nN == 4
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4])
  Case nN == 5
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5])
  Case nN == 6
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6])
  Case nN == 7
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7])
  Case nN == 8
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8])
  Case nN == 9
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9])
  Case nN == 10
    Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10])
  EndCase
Return Eval(bBlock, a, o, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], ;
            a[14], a[15], a[16], a[17], a[18], a[19], a[20])

// The program's Eval(block, ...), run here, compiled -- the block a[1], its
// arguments the rest: through a macro's block -- {|a, o, p1, p2, r| r :=
// Eval(p1, p2), r} -- the AppServer gave back the argument of a block of the
// program's, not its value (02-blocks, on 24.3.1.9).
Static Function XbcEvalArgs(bBlock, a)
  Local nN := Len(a) - 1
  Local aAll
  Do Case
  Case nN == 0
    Return Eval(bBlock)
  Case nN == 1
    Return Eval(bBlock, a[2])
  Case nN == 2
    Return Eval(bBlock, a[2], a[3])
  Case nN == 3
    Return Eval(bBlock, a[2], a[3], a[4])
  Case nN == 4
    Return Eval(bBlock, a[2], a[3], a[4], a[5])
  EndCase
  aAll := AClone(a)
  ASize(aAll, Max(Len(a), 13))
Return Eval(bBlock, aAll[2], aAll[3], aAll[4], aAll[5], aAll[6], aAll[7], aAll[8], aAll[9], aAll[10], aAll[11], ;
            aAll[12], aAll[13])

// A method of an object of the AppServer's.
Method MethodCall(xObj, cName, aArgs) Class XbcVM
Return ::Native("m", "", cName, xObj, aArgs)

// 'Name():M(...)' of a class no module has: the AppServer's.
Method NewNative(cClass, cName, aArgs) Class XbcVM
Return ::Native("n", cClass, cName, Nil, aArgs)

// A member of an object: a module's class's data, or the AppServer's.
Method MemberOf(xObj, cName) Class XbcVM
  If ValType(xObj) == "O" .And. XbcIsObj(xObj)
    Return xObj:aProps[::SlotOf(xObj:xbcCls, cName)]
  EndIf
  If local nSys := ::hSys{"g:" + Upper(cName)}, nSys != Nil
    Return Eval(::aSys[nSys], xObj)
  EndIf
  Return XBC_MEMBER(xObj, cName) if ::lHost
  ::hCache{"g:" + cName} ?= XbcMacroRun("{|o| o:${cName}}")
Return Eval(::hCache{"g:" + cName}, xObj)

Method SetMemberOf(xObj, cName, xValue) Class XbcVM
  If ValType(xObj) == "O" .And. XbcIsObj(xObj)
    xObj:aProps[::SlotOf(xObj:xbcCls, cName)] := xValue
  ElseIf ::hSys has "s:" + Upper(cName)
    Eval(::aSys[::hSys{"s:" + Upper(cName)}], xObj, xValue)
  ElseIf ::lHost
    XBC_SETMEMBER(xObj, cName, xValue)
  Else
    ::hCache{"s:" + cName} ?= XbcMacroRun("{|o, v| o:${cName} := v}")
    Eval(::hCache{"s:" + cName}, xObj, xValue)
  EndIf
Return Nil

// ALIAS->NAME, in its area -- the alias FIELD the area selected.
Method FieldOf(cAlias, cName) Class XbcVM
  Local nWas := ::CallNative("Select", {})
  Local xValue
  ::CallNative("DbSelectArea", {cAlias}) if !(Upper(cValToChar(cAlias)) == "FIELD")
  xValue := ::CallNative("FieldGet", {::CallNative("FieldPos", {cName})})
  ::CallNative("DbSelectArea", {nWas})
Return xValue

Method SetFieldOf(cAlias, cName, xValue) Class XbcVM
  Local nWas := ::CallNative("Select", {})
  ::CallNative("DbSelectArea", {cAlias}) if !(Upper(cValToChar(cAlias)) == "FIELD")
  ::CallNative("FieldPut", {::CallNative("FieldPos", {cName}), xValue})
  ::CallNative("DbSelectArea", {nWas})
Return Nil

// ---- memvars ----------------------------------------------------------------
// The variable NAME: the innermost private, else the public; Nil when there
// is none.
Method MemCell(cName) Class XbcVM
  If local aStack := ::hPrivs{cName}, aStack != Nil .And. !Empty(aStack)
    Return ATail(aStack)
  EndIf
Return ::hPubs{cName}

// A private NAME of the running frame: one it has already, Nil again with
// lFresh.
Method PrivCell(cName, lFresh) Class XbcVM
  Local aF := ATail(::aFrames)
  Local aStack := ::hPrivs{cName} ?: {}
  Local aMore := XbcMore(aF)
  Local aCell
  ::hPrivs{cName} := aStack
  aMore[X_PRIVS] ?= {}
  for cHad in aMore[X_PRIVS]
    Loop if !(cHad == cName)
    aCell := ATail(aStack)
    aCell[1] := Nil if ValType(lFresh) == "L" .And. lFresh
    Return aCell
  next
  aCell := {Nil}
  AAdd(aStack, aCell)
  AAdd(aMore[X_PRIVS], cName)
Return aCell

// &(text): a variable's name is the variable; anything else the AppServer's.
Method Macro(cText) Class XbcVM
  Local cName := Upper(AllTrim(cText))
  If XbcPlain(cName)
    Local aCell := ::MemCell(cName)
    ::Fail("variable does not exist: ${cName}") if aCell == Nil
    Return aCell[1]
  EndIf
  ::Fail("xc-vm runs no macro but a variable's name: &(${cText})") if ::lHost
Return XbcMacroRun(cText)

Method SetMacro(cText, xValue) Class XbcVM
  Local cName := Upper(AllTrim(cText))
  Local aCell
  ::Fail("xc-vm runs no macro but a variable's name: &(${cText})") if !XbcPlain(cName)
  aCell := ::MemCell(cName) ?: ::PrivCell(cName)
  aCell[1] := xValue
Return Nil

// A name, and nothing else.
Static Function XbcPlain(cName)
  Return .F. if Empty(cName) .Or. IsDigit(cName)
  for nI in 1..Len(cName)
    Local cC := SubStr(cName, nI, 1)
    Return .F. if !(IsAlpha(cC) .Or. IsDigit(cC) .Or. cC == "_")
  next
Return .T.

// ---- errors -----------------------------------------------------------------
// An error of the machine's: an error the AppServer raises, as any other.
Method Fail(cMessage) Class XbcVM
  UserException(cMessage)
Return Nil

// The error block the machine runs under: an error goes to the program's
// ErrorBlock() first -- a Break there goes to the innermost region --, else
// on its way to the innermost 'try'.
Method OnError(oErr) Class XbcVM
  Local aAt
  Local cAt
  Local aFn
  Local aF := ATail(::aFrames)
  // Where: the function of a whole of the JIT's running, at its line;
  // else the frame running, at the instruction it called from -- the loop
  // running it puts the line of the one it ran last (Run()).
  If snFast > 0
    aFn := ::aFns[snFast]
    snFast := 0
    ::aErrAt := Nil
    ::cWhere := "${aFn[FN_NAME]}, line ${aFn[FN_CODE][1][I_LINE]}"
  ElseIf aF != Nil
    ::aErrAt := aF
    ::cWhere := "${aF[F_FN][FN_NAME]}, line ${aF[F_FN][FN_CODE][Max(aF[F_PC] - 1, 1)][I_LINE]}"
  EndIf
  ::Note("  error: " + ::MemberOf(oErr, "Description")) if ::aTrace != Nil
  If ::bProgErr != Nil .And. !::lInErr
    aAt := ::aErrAt
    cAt := ::cWhere
    ::lInErr := .T.
    Eval(::bProgErr, oErr)
    ::lInErr := .F.
    ::aErrAt := aAt
    ::cWhere := cAt
  EndIf
  XbcBreak({scErr, oErr})
Return Nil

// ---- the trace --------------------------------------------------------------
// An instruction about to run, with trace=FILE: the frames' depth, the
// function, where in it, the instruction, the stack's height and its top.
Method Trace(aF, nPc, aIns, nSp, aSt) Class XbcVM
  Local aOp := ::aOpNames[aIns[I_OP]]
  Local cLine := "${Len(::aFrames)} ${aF[F_FN][FN_NAME]}:${nPc} ${aOp[1]}"
  cLine += " ${aIns[I_A]}" if "I" $ aOp[2]
  cLine += " ${aIns[I_B]}" if aOp[2] == "IWW" .Or. aOp[2] == "II" .Or. aOp[2] == "WI"
  cLine += " " + cValToChar(aIns[I_N]) if aOp[2] == "N"
  cLine += " " + aIns[I_S] if "W" $ aOp[2] .Or. aOp[2] == "S"
  cLine += " " + aIns[I_S2] if aOp[2] == "WW" .Or. aOp[2] == "IWW"
  ::Note(cLine + " | sp ${nSp}" + If(nSp > 0, ", top " + XbcShown(aSt[nSp]), ""))
Return Nil

// A line of the trace, while there are fewer than 20,000.
Method Note(cLine) Class XbcVM
  AAdd(::aTrace, cLine) if Len(::aTrace) < 20000
Return Nil

// A value, short, for the trace.
Static Function XbcShown(xValue)
  Local cType := ValType(xValue)
  Do Case
  Case cType == "C"
    Return 'C "' + Left(xValue, 30) + If(Len(xValue) > 30, '..."', '"')
  Case cType $ "NLD"
    Return cType + " " + cValToChar(xValue)
  Case cType == "A"
    Return "A[${Len(xValue)}]"
  EndCase
Return cType

// ---- the AppServer's well-known functions -----------------------------------
// Each with as many arguments as it is given, a block of compiled code --
// {|o, a| ...}, the object and the arguments --: the number a call is made
// by is its place here. f:NAME/N a function, m:NAME/N a method,
// n:CLASS:NAME/N 'Class():Name()', and :K after it for each argument K
// passed by reference; g:NAME and s:NAME a member read and written, an
// error's. No macro is compiled for them. One a line; a call not here goes
// through a macro's block. Not one with fewer arguments than the AppServer
// declares: it warns (W0008, "Too few parameters calling DEC_CREATE").
Static Function XbcSyscalls()
  Local aT := {}
  AAdd(aT, {"f:AADD/2", {|o, a| AAdd(a[1], a[2])}})
  AAdd(aT, {"f:ABS/1", {|o, a| Abs(a[1])}})
