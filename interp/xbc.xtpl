  AAdd(aT, {"f:U_XTPL_CHUNKS/1", {|o, a| u_xtpl_chunks(a[1])}})
  AAdd(aT, {"f:U_XTPL_CHUNKS/2", {|o, a| u_xtpl_chunks(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_ELVIS/0", {|o, a| u_xtpl_elvis()}})
  AAdd(aT, {"f:U_XTPL_ELVIS/1", {|o, a| u_xtpl_elvis(a[1])}})
  AAdd(aT, {"f:U_XTPL_ELVIS/2", {|o, a| u_xtpl_elvis(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_ZIP/0", {|o, a| u_xtpl_zip()}})
  AAdd(aT, {"f:U_XTPL_ZIP/1", {|o, a| u_xtpl_zip(a[1])}})
  AAdd(aT, {"f:U_XTPL_ZIP/2", {|o, a| u_xtpl_zip(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_ZIP/3", {|o, a| u_xtpl_zip(a[1], a[2], a[3])}})
  AAdd(aT, {"f:U_XTPL_ZIP/4", {|o, a| u_xtpl_zip(a[1], a[2], a[3], a[4])}})
  AAdd(aT, {"f:U_XTPL_ZIP/5", {|o, a| u_xtpl_zip(a[1], a[2], a[3], a[4], a[5])}})
  AAdd(aT, {"f:U_XTPL_ZIP/6", {|o, a| u_xtpl_zip(a[1], a[2], a[3], a[4], a[5], a[6])}})
  AAdd(aT, {"f:U_XTPL_PAIRS/0", {|o, a| u_xtpl_pairs()}})
  AAdd(aT, {"f:U_XTPL_PAIRS/1", {|o, a| u_xtpl_pairs(a[1])}})
  AAdd(aT, {"f:U_XTPL_KEYS/0", {|o, a| u_xtpl_keys()}})
  AAdd(aT, {"f:U_XTPL_KEYS/1", {|o, a| u_xtpl_keys(a[1])}})
  AAdd(aT, {"f:U_XTPL_VALUES/0", {|o, a| u_xtpl_values()}})
  AAdd(aT, {"f:U_XTPL_VALUES/1", {|o, a| u_xtpl_values(a[1])}})
  AAdd(aT, {"f:U_XTPL_TAKEWHILE/0", {|o, a| u_xtpl_takewhile()}})
  AAdd(aT, {"f:U_XTPL_TAKEWHILE/1", {|o, a| u_xtpl_takewhile(a[1])}})
  AAdd(aT, {"f:U_XTPL_TAKEWHILE/2", {|o, a| u_xtpl_takewhile(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_DROPWHILE/0", {|o, a| u_xtpl_dropwhile()}})
  AAdd(aT, {"f:U_XTPL_DROPWHILE/1", {|o, a| u_xtpl_dropwhile(a[1])}})
  AAdd(aT, {"f:U_XTPL_DROPWHILE/2", {|o, a| u_xtpl_dropwhile(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_CHUNKBY/0", {|o, a| u_xtpl_chunkby()}})
  AAdd(aT, {"f:U_XTPL_CHUNKBY/1", {|o, a| u_xtpl_chunkby(a[1])}})
  AAdd(aT, {"f:U_XTPL_CHUNKBY/2", {|o, a| u_xtpl_chunkby(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_FIRST/0", {|o, a| u_xtpl_first()}})
  AAdd(aT, {"f:U_XTPL_FIRST/1", {|o, a| u_xtpl_first(a[1])}})
  AAdd(aT, {"f:U_XTPL_FIRST/2", {|o, a| u_xtpl_first(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_COUNT/0", {|o, a| u_xtpl_count()}})
  AAdd(aT, {"f:U_XTPL_COUNT/1", {|o, a| u_xtpl_count(a[1])}})
  AAdd(aT, {"f:U_XTPL_COUNT/2", {|o, a| u_xtpl_count(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_DISTINCTADJACENT/0", {|o, a| u_xtpl_distinctadjacent()}})
  AAdd(aT, {"f:U_XTPL_DISTINCTADJACENT/1", {|o, a| u_xtpl_distinctadjacent(a[1])}})
  AAdd(aT, {"f:U_XTPL_DISTINCTADJACENT/2", {|o, a| u_xtpl_distinctadjacent(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_MAXBY/0", {|o, a| u_xtpl_maxby()}})
  AAdd(aT, {"f:U_XTPL_MAXBY/1", {|o, a| u_xtpl_maxby(a[1])}})
  AAdd(aT, {"f:U_XTPL_MAXBY/2", {|o, a| u_xtpl_maxby(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_MINBY/0", {|o, a| u_xtpl_minby()}})
  AAdd(aT, {"f:U_XTPL_MINBY/1", {|o, a| u_xtpl_minby(a[1])}})
  AAdd(aT, {"f:U_XTPL_MINBY/2", {|o, a| u_xtpl_minby(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_SCAN/0", {|o, a| u_xtpl_scan()}})
  AAdd(aT, {"f:U_XTPL_SCAN/1", {|o, a| u_xtpl_scan(a[1])}})
  AAdd(aT, {"f:U_XTPL_SCAN/2", {|o, a| u_xtpl_scan(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_SCAN/3", {|o, a| u_xtpl_scan(a[1], a[2], a[3])}})
  AAdd(aT, {"f:U_XTPL_EXPAND/0", {|o, a| u_xtpl_expand()}})
  AAdd(aT, {"f:U_XTPL_EXPAND/1", {|o, a| u_xtpl_expand(a[1])}})
  AAdd(aT, {"f:U_XTPL_EXPAND/2", {|o, a| u_xtpl_expand(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_TAP/0", {|o, a| u_xtpl_tap()}})
  AAdd(aT, {"f:U_XTPL_TAP/1", {|o, a| u_xtpl_tap(a[1])}})
  AAdd(aT, {"f:U_XTPL_TAP/2", {|o, a| u_xtpl_tap(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_PAIRWISE/0", {|o, a| u_xtpl_pairwise()}})
  AAdd(aT, {"f:U_XTPL_PAIRWISE/1", {|o, a| u_xtpl_pairwise(a[1])}})
  AAdd(aT, {"f:U_XTPL_ANYOF/0", {|o, a| u_xtpl_anyof()}})
  AAdd(aT, {"f:U_XTPL_ANYOF/1", {|o, a| u_xtpl_anyof(a[1])}})
  AAdd(aT, {"f:U_XTPL_ANYOF/2", {|o, a| u_xtpl_anyof(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_ALLOF/0", {|o, a| u_xtpl_allof()}})
  AAdd(aT, {"f:U_XTPL_ALLOF/1", {|o, a| u_xtpl_allof(a[1])}})
  AAdd(aT, {"f:U_XTPL_ALLOF/2", {|o, a| u_xtpl_allof(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_NONEOF/0", {|o, a| u_xtpl_noneof()}})
  AAdd(aT, {"f:U_XTPL_NONEOF/1", {|o, a| u_xtpl_noneof(a[1])}})
  AAdd(aT, {"f:U_XTPL_NONEOF/2", {|o, a| u_xtpl_noneof(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_SPLIT/0", {|o, a| u_xtpl_split()}})
  AAdd(aT, {"f:U_XTPL_SPLIT/1", {|o, a| u_xtpl_split(a[1])}})
  AAdd(aT, {"f:U_XTPL_SPLIT/2", {|o, a| u_xtpl_split(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_JOIN/0", {|o, a| u_xtpl_join()}})
  AAdd(aT, {"f:U_XTPL_JOIN/1", {|o, a| u_xtpl_join(a[1])}})
  AAdd(aT, {"f:U_XTPL_JOIN/2", {|o, a| u_xtpl_join(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_STARTS/0", {|o, a| u_xtpl_starts()}})
  AAdd(aT, {"f:U_XTPL_STARTS/1", {|o, a| u_xtpl_starts(a[1])}})
  AAdd(aT, {"f:U_XTPL_STARTS/2", {|o, a| u_xtpl_starts(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_ENDS/0", {|o, a| u_xtpl_ends()}})
  AAdd(aT, {"f:U_XTPL_ENDS/1", {|o, a| u_xtpl_ends(a[1])}})
  AAdd(aT, {"f:U_XTPL_ENDS/2", {|o, a| u_xtpl_ends(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_CONTAINS/0", {|o, a| u_xtpl_contains()}})
  AAdd(aT, {"f:U_XTPL_CONTAINS/1", {|o, a| u_xtpl_contains(a[1])}})
  AAdd(aT, {"f:U_XTPL_CONTAINS/2", {|o, a| u_xtpl_contains(a[1], a[2])}})
  AAdd(aT, {"n:XTPLQUEUE:NEW/0", {|o, a| XtplQueue():New()}})
  AAdd(aT, {"n:XTPLQUEUE:NEW/1", {|o, a| XtplQueue():New(a[1])}})
  AAdd(aT, {"m:PUSH/0", {|o, a| o:Push()}})
  AAdd(aT, {"m:PUSH/1", {|o, a| o:Push(a[1])}})
  AAdd(aT, {"m:POP/0", {|o, a| o:Pop()}})
  AAdd(aT, {"m:PEEK/0", {|o, a| o:Peek()}})
  AAdd(aT, {"m:COUNT/0", {|o, a| o:Count()}})
  AAdd(aT, {"m:ISEMPTY/0", {|o, a| o:IsEmpty()}})
  AAdd(aT, {"f:U_XTPL_QUEUE/0", {|o, a| u_xtpl_queue()}})
  AAdd(aT, {"f:U_XTPL_QUEUE/1", {|o, a| u_xtpl_queue(a[1])}})
  AAdd(aT, {"f:U_XTPL_APICK/0", {|o, a| u_xtpl_apick()}})
  AAdd(aT, {"f:U_XTPL_APICK/1", {|o, a| u_xtpl_apick(a[1])}})
  AAdd(aT, {"f:U_XTPL_APICK/2", {|o, a| u_xtpl_apick(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_AROLL/0", {|o, a| u_xtpl_aroll()}})
  AAdd(aT, {"f:U_XTPL_AROLL/1", {|o, a| u_xtpl_aroll(a[1])}})
  AAdd(aT, {"f:U_XTPL_AROLL/2", {|o, a| u_xtpl_aroll(a[1], a[2])}})
  AAdd(aT, {"f:U_XTPL_SETMAXROLL/0", {|o, a| u_xtpl_setmaxroll()}})
  AAdd(aT, {"f:U_XTPL_SETMAXROLL/1", {|o, a| u_xtpl_setmaxroll(a[1])}})
  // <<< the runtime's
Return aT

// ---- code blocks ------------------------------------------------------------
// The program's code block: one of the AppServer's that runs it here, with
// as many arguments as its function takes, 12 at the most. Its closure is a
// Local made here: made in a method, from one call site run again and
// again, every block the AppServer made saw the parameter of the last call
// -- every block of the program ran as the last one made (02-blocks,
// 09-classes on 24.3.1.9).
//
// What its closure holds is small: the function's number in the machine's
// list, its cells, its object -- and the machine is sxVM. A function that
// made a code block has, when it returns, every array its Locals reach
// walked by the AppServer, and the walk took longer the more blocks had
// been made (tLocalEnv::checkCircularArray(); bench6, xeh2 on 24.3.1.9). A
// function's record reaches the whole program -- its code, the functions
// its calls found, its module and every function in it --: with it here,
// a block took 76 us to make at first, 3 ms half a minute later. So no
// code block is made where the machine's arrays are in reach: not in the
// loop, not in a method of the machine's, not with a frame or a function's
// record in a Local.
//
// It runs in the copy of the loop after the one running, through the copy
// of Enter() that goes with it -- no function between that a block run
// inside it would enter again (the loop's copies, below).
Static Function XbcMakeBlock(nFn, aCells, xSelf)
  Local aClo := {nFn, aCells, xSelf}
Return {|p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12| ;
        If(sxVM:nRuns % 4 == 0, sxVM:Enter(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12), ;
        If(sxVM:nRuns % 4 == 1, sxVM:Enter1(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12), ;
        If(sxVM:nRuns % 4 == 2, sxVM:Enter2(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12), ;
                                sxVM:Enter3(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12))))}

// The program's code block whose function is a whole of the JIT's
// (JitWhole()): one of the AppServer's that runs that block, with the
// cells, the constants, the statics -- for one that has some -- and the
// object, and what it was given. snFast says, while it runs, whose it is:
// an error in it is on the function's line (OnError()). What it uses are
// Locals made here: a block that used a parameter of this function got Nil
// for it (02-blocks on 24.3.1.9; XbcMakeBlock()). Its closure holds no
// array of the machine's either.
Static Function XbcMakeFast(aFast, aCells, xSelf)
  Local bFast := aFast[1]
  Local aK := aFast[2]
  Local aT := aFast[3]
  Local nFn := aFast[4]
  Local aC := aCells
  Local xO := xSelf
  Do Case
  Case aFast[5] == 0
    Return {|r| snFast := nFn, r := Eval(bFast, aC, aK, aT, xO), snFast := 0, r}
  Case aFast[5] == 1
    Return {|p1, r| snFast := nFn, r := Eval(bFast, aC, aK, aT, xO, p1), snFast := 0, r}
  Case aFast[5] == 2
    Return {|p1, p2, r| snFast := nFn, r := Eval(bFast, aC, aK, aT, xO, p1, p2), snFast := 0, r}
  EndCase
Return {|p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, r| snFast := nFn, ;
        r := Eval(bFast, aC, aK, aT, xO, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12), snFast := 0, r}

// A block run: its frame, its parameters from what it was given, in Run() --
// Enter1() in Run1(), and so on.
Method Enter(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12) Class XbcVM
  Local aFn := ::aFns[aClo[1]]
  Local nP := aFn[FN_PARAMS]
  Local aLoc := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
  Local xResult
  If nP > 0
    aLoc[1] := p1
    aLoc[2] := p2 if nP > 1
    aLoc[3] := p3 if nP > 2
    If nP > 3
      aLoc[4] := p4
      aLoc[5] := p5 if nP > 4
      aLoc[6] := p6 if nP > 5
      aLoc[7] := p7 if nP > 6
      aLoc[8] := p8 if nP > 7
      aLoc[9] := p9 if nP > 8
      aLoc[10] := p10 if nP > 9
      aLoc[11] := p11 if nP > 10
      aLoc[12] := p12 if nP > 11
    EndIf
  EndIf
  ::Fail("stack overflow") if Len(::aFrames) > 4000
  AAdd(::aFrames, {aFn, aLoc, aFn[FN_NLOCALS], 1, Min(nP, 12), aClo[2], aClo[3], Nil})
  xResult := ::Run(Len(::aFrames))
  ::Note("  the block ${aFn[FN_NAME]} gave " + XbcShown(xResult)) if ::aTrace != Nil
Return xResult

// ---- objects ----------------------------------------------------------------
// An object of a module's class: its class, and its data -- each in the
// place its class gives its name.
Class XbcObj
  Public Data xbcCls
  Public Data aProps
  Public Method New(aCls, nSlots) Constructor
EndClass

Method New(aCls, nSlots) Class XbcObj
  ::xbcCls := aCls
  ::aProps := Array(nSlots)
Return Self

// ---- the loop's copies ------------------------------------------------------
// The AppServer enters a function that is already running further down at
// a cost that grows with its size: some 45 us for the loop, where calling
// it costs 5 (probes xea, xeb). A run inside a run -- a code block of the
// program's that the AppServer runs, the values an object's data starts
// with -- is the next copy instead (XbcRun(), XbcMakeBlock()): Run() three
// times again under other names, and Enter() with each, to run the block in
// it. cpp/tests/loop-copies.cmake writes them, and ctest's interp checks
// them.
// >>> the loop's copies
Method Run1(nBase) Class XbcVM
  Local aFrames := ::aFrames
  Local aF
  Local aCode
  Local aLoc
  Local aSt
  Local nSp
  Local nPc
  Local lTrace := ::aTrace != Nil
  Local lDone := .F.
  Local xCaught
  Local aIns
  Local nOp
  Local aArgs
  Local xA
  Local xB
  Local nI
  Local nK
  Local nN
  Local nAt
  Local aCls
  Local aM
  Local aFn
  Local xResult
  ::nRuns++
  While !lDone
    aF := aFrames[Len(aFrames)]
    aCode := aF[F_FN][FN_CODE]
    aLoc := aF[F_LOCALS]
    aSt := aF[F_LOCALS]
    nSp := aF[F_SP]
    nPc := aF[F_PC]
    sxBroke := scNone
    Begin Sequence
      While .T.
        aIns := aCode[nPc]
        ::Trace(aF, nPc, aIns, nSp, aSt) if lTrace
        nPc++
        nOp := aIns[I_OP]
        If nOp <= OP_JUMP
          Do Case
          Case nOp == OP_JIT
            // A run as one block, made the first time, for the stack's height
            // then; at another height the run is interpreted.
            ::Jit(aF, aIns, nSp) if aIns[I_K] == 0
            If aIns[I_K] == 1 .And. aIns[I_D] == nSp
              xA := Eval(aIns[I_C], aLoc, aIns[I_S2], aF[F_CELLS], aF[F_FN][FN_MOD][M_STATICS], aF[F_SELF])
              nSp := aIns[I_E]
              Do Case
              Case aIns[I_N] == 0
                nPc := aIns[I_A]
              Case aIns[I_N] == 3
                nPc := aIns[I_B]
              Case aIns[I_N] == 1
                nPc := If(xA, aIns[I_A], aIns[I_B])
              Otherwise
                nPc := If(xA, aIns[I_B], aIns[I_A])
              EndCase
            EndIf
          Case nOp == OP_LOCAL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]]
          Case nOp == OP_SETLOCAL
            aLoc[aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_NUM
            nSp++
            aSt[nSp] := aIns[I_N]
          Case nOp == OP_LOCAL2
            aSt[nSp + 1] := aLoc[aIns[I_A]]
            nSp += 2
            aSt[nSp] := aLoc[aIns[I_B]]
          Case nOp == OP_CALL
            nN := aIns[I_A]
            nK := aIns[I_K]
            If nK == K_FN
              // A function of a module: its frame, its parameters from the
              // stack.
              aFn := aIns[I_X]
              xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
              nAt := nSp - nN
              nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
              For nK := 1 To nI
                xA[nK] := aSt[nAt + nK]
              Next
              aF[F_SP] := nAt
              aF[F_PC] := nPc
              ::Fail("stack overflow") if Len(aFrames) > 4000
              aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, Nil, Nil}
              AAdd(aFrames, aF)
              aCode := aFn[FN_CODE]
              aLoc := xA
              aSt := xA
              nSp := aFn[FN_NLOCALS]
              nPc := 1
            Else
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN
              Do Case
              Case nK == K_SYS
                xA := Eval(aIns[I_X], Nil, aArgs)
                nSp++
                aSt[nSp] := xA
              Case nK == K_PCOUNT
                nSp++
                aSt[nSp] := aF[F_ARGC]
              Case nK == K_EVAL .And. ValType(aArgs[1]) == "B"
                // Here, for the few arguments a block has as a rule: a
                // function between would be entered again by a block that
                // runs Eval() inside an Eval().
                Do Case
                Case nN == 1
                  xA := Eval(aArgs[1])
                Case nN == 2
                  xA := Eval(aArgs[1], aArgs[2])
                Case nN == 3
                  xA := Eval(aArgs[1], aArgs[2], aArgs[3])
                Otherwise
                  xA := XbcEvalArgs(aArgs[1], aArgs)
                EndCase
                nSp++
                aSt[nSp] := xA
              Case nK == K_MACRO
                xA := XbcEvalN(aIns[I_X], aArgs, Nil)
                nSp++
                aSt[nSp] := xA
              Otherwise
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If ::Invoke(aF, aIns[I_S], aArgs, .F., aIns)
                  // A function of a module: its frame runs on.
                  aF := aFrames[Len(aFrames)]
                  aCode := aF[F_FN][FN_CODE]
                  aLoc := aF[F_LOCALS]
                  aSt := aF[F_LOCALS]
                  nSp := aF[F_SP]
                  nPc := aF[F_PC]
                Else
                  nSp := aF[F_SP]
                EndIf
              EndCase
            EndIf
          Case nOp == OP_JUMPF
            If !aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          Case nOp == OP_ADD
            nSp--
            aSt[nSp] := aSt[nSp] + aSt[nSp + 1]
          Case nOp == OP_JUMP
            nPc := aIns[I_A]
          EndCase
        ElseIf nOp <= OP_EQJF
          Do Case
          // What is subscripted is a Local: the AppServer words an error of an
          // element subscripted again otherwise -- 'array out of bounds ( 2
          // of 0 )', not '[2] of [0]' (04-flow, on 24.3.1.9).
          Case nOp == OP_LOCALIDX
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_LOCALIDXL
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aLoc[aIns[I_B]]]
          Case nOp == OP_INDEX
            xA := aSt[nSp - 1]
            nSp--
            aSt[nSp] := xA[aSt[nSp + 1]]
          Case nOp == OP_NUMIDX
            xA := aSt[nSp]
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_INCLOCAL
            aLoc[aIns[I_A]] := aLoc[aIns[I_A]] + aIns[I_N]
          Case nOp == OP_ADDNUM
            aSt[nSp] := aSt[nSp] + aIns[I_N]
          Case nOp == OP_ADDSET
            aLoc[aIns[I_A]] := aSt[nSp - 1] + aSt[nSp]
            nSp -= 2
          Case nOp == OP_LEJF
            If !(aSt[nSp - 1] <= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_LTJF
            If !(aSt[nSp - 1] < aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GEJF
            If !(aSt[nSp - 1] >= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GTJF
            If !(aSt[nSp - 1] > aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EXACTJF
            If !(aSt[nSp - 1] == aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_NEJF
            If !(aSt[nSp - 1] != aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EQJF
            If !(aSt[nSp - 1] = aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          EndCase
        ElseIf nOp <= OP_FALSE
          Do Case
          Case nOp == OP_RET
            xA := aSt[nSp]
            If aF[F_MORE] != Nil
              xA := aF[F_SELF] if aF[F_MORE][X_CTOR]
              ::EndFrame(aF)
            EndIf
            ASize(aFrames, Len(aFrames) - 1)
            If Len(aFrames) < nBase
              xResult := xA
              lDone := .T.
              Exit
            EndIf
            aF := aFrames[Len(aFrames)]
            aCode := aF[F_FN][FN_CODE]
            aLoc := aF[F_LOCALS]
            aSt := aF[F_LOCALS]
            nSp := aF[F_SP] + 1
            nPc := aF[F_PC]
            aSt[nSp] := xA
          Case nOp == OP_POP
            nSp--
          Case nOp == OP_STR
            nSp++
            aSt[nSp] := aIns[I_S]
          Case nOp == OP_NIL
            nSp++
            aSt[nSp] := Nil
          Case nOp == OP_METHOD
            nN := aIns[I_A]
            xB := aSt[nSp - nN]
            If ValType(xB) == "O" .And. AttIsMemberOf(xB, "xbcCls")
              // A module's class: the class it found last, and the method --
              // one class a call sees, as a rule --, its frame.
              aCls := xB:xbcCls
              If aIns[I_C] != Nil .And. aIns[I_C][1] == aCls
                aM := aIns[I_C][2]
              Else
                aM := ::MethodOf(aCls, aIns[I_S2])
                ::Fail("no method ${aIns[I_S]} of ${aCls[C_NAME]}") if aM == Nil
                aIns[I_C] := {aCls, aM}
              EndIf
              aFn := aM[1]
              If aIns[I_K] == K_FN
                xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
                nAt := nSp - nN
                nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
                For nK := 1 To nI
                  xA[nK] := aSt[nAt + nK]
                Next
                aF[F_SP] := nAt - 1
                aF[F_PC] := nPc
                ::Fail("stack overflow") if Len(aFrames) > 4000
                aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, xB, Nil}
                AAdd(aFrames, aF)
              Else
                aArgs := Array(nN)
                For nI := 1 To nN
                  aArgs[nI] := aSt[nSp - nN + nI]
                Next
                nSp -= nN + 1
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If aIns[I_K] == 0 .And. !lTrace
                  aIns[I_K] := If(XbcAnyRef(aArgs), K_SLOW, K_FN)
                EndIf
                ::Push(aFn, aArgs, Nil, xB)
                aF := aFrames[Len(aFrames)]
              EndIf
              aCode := aF[F_FN][FN_CODE]
              aLoc := aF[F_LOCALS]
              aSt := aF[F_LOCALS]
              nSp := aF[F_SP]
              nPc := aF[F_PC]
            Else
              // The AppServer's: the table's block for the method, found the
              // first time, when the call has no reference.
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN + 1
              If aIns[I_X] == Nil .And. !lTrace
                aIns[I_X] := .F.
                If !XbcAnyRef(aArgs)
                  nAt := ::hSys{"m:" + aIns[I_S2] + "/" + cValToChar(nN)}
                  aIns[I_X] := ::aSys[nAt] if nAt != Nil
                EndIf
              EndIf
              If ValType(aIns[I_X]) == "B"
                xA := Eval(aIns[I_X], xB, aArgs)
              Else
                xA := ::MethodCall(xB, aIns[I_S], aArgs)
              EndIf
              nSp++
              aSt[nSp] := xA
            EndIf
          Case nOp == OP_MEMBER
            xA := aSt[nSp]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              // A module's class: the place of the data, found once for the
              // class it sees.
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              aSt[nSp] := xA:aProps[aIns[I_C][2]]
            Else
              aSt[nSp] := ::MemberOf(xA, aIns[I_S])
            EndIf
          Case nOp == OP_SETMEMBER
            xA := aSt[nSp - 1]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              xA:aProps[aIns[I_C][2]] := aSt[nSp]
            Else
              ::SetMemberOf(xA, aIns[I_S], aSt[nSp])
            EndIf
            nSp -= 2
          Case nOp == OP_SETINDEX
            xA := aSt[nSp - 2]
            xA[aSt[nSp - 1]] := aSt[nSp]
            nSp -= 3
          Case nOp == OP_SELF
            nSp++
            aSt[nSp] := aF[F_SELF]
          Case nOp == OP_EXACT
            nSp--
            aSt[nSp] := (aSt[nSp] == aSt[nSp + 1])
          Case nOp == OP_TRUE
            nSp++
            aSt[nSp] := .T.
          Case nOp == OP_FALSE
            nSp++
            aSt[nSp] := .F.
          EndCase
        ElseIf nOp <= OP_JUMPT
          Do Case
          Case nOp == OP_SUB
            nSp--
            aSt[nSp] := aSt[nSp] - aSt[nSp + 1]
          Case nOp == OP_MUL
            nSp--
            aSt[nSp] := aSt[nSp] * aSt[nSp + 1]
          Case nOp == OP_DIV
            nSp--
            aSt[nSp] := aSt[nSp] / aSt[nSp + 1]
          Case nOp == OP_MOD
            nSp--
            aSt[nSp] := aSt[nSp] % aSt[nSp + 1]
          Case nOp == OP_NOT
            aSt[nSp] := !aSt[nSp]
          Case nOp == OP_EQ
            nSp--
            aSt[nSp] := (aSt[nSp] = aSt[nSp + 1])
          Case nOp == OP_NE
            nSp--
            aSt[nSp] := (aSt[nSp] != aSt[nSp + 1])
          Case nOp == OP_LT
            nSp--
            aSt[nSp] := (aSt[nSp] < aSt[nSp + 1])
          Case nOp == OP_GT
            nSp--
            aSt[nSp] := (aSt[nSp] > aSt[nSp + 1])
          Case nOp == OP_LE
            nSp--
            aSt[nSp] := (aSt[nSp] <= aSt[nSp + 1])
          Case nOp == OP_GE
            nSp--
            aSt[nSp] := (aSt[nSp] >= aSt[nSp + 1])
          Case nOp == OP_ANDJUMP
            If !aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_ORJUMP
            If aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_JUMPT
            If aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          EndCase
        ElseIf nOp <= OP_CONTAINS
          Do Case
          Case nOp == OP_ARRAY
            nN := aIns[I_A]
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI]
            Next
            nSp := nSp - nN + 1
            aSt[nSp] := xA
          Case nOp == OP_DUP
            nSp++
            aSt[nSp] := aSt[nSp - 1]
          Case nOp == OP_DUP2
            aSt[nSp + 1] := aSt[nSp - 1]
            aSt[nSp + 2] := aSt[nSp]
            nSp += 2
          Case nOp == OP_CELL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]][1]
          Case nOp == OP_SETCELL
            aLoc[aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_UPVAL
            nSp++
            aSt[nSp] := aF[F_CELLS][aIns[I_A]][1]
          Case nOp == OP_SETUPVAL
            aF[F_CELLS][aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_REFLOCAL
            nSp++
            aSt[nSp] := {scRef, aLoc, aIns[I_A]}
          Case nOp == OP_REFCELL
            nSp++
            aSt[nSp] := {scRef, aLoc[aIns[I_A]], 1}
          Case nOp == OP_REFUPVAL
            nSp++
            aSt[nSp] := {scRef, aF[F_CELLS][aIns[I_A]], 1}
          Case nOp == OP_BLOCK
            nN := aIns[I_B]
            If aIns[I_C] == Nil
              aIns[I_C] := aF[F_FN][FN_MOD][M_FNS]{Upper(aIns[I_S])}
            EndIf
            aFn := aIns[I_C]
            ::Fail("no block function ${aIns[I_S]}") if aFn == Nil
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI][2]
            Next
            nSp := nSp - nN + 1
            ::JitWhole(aFn) if aFn[FN_FAST] == Nil
            If ValType(aFn[FN_FAST]) == "L"
              aSt[nSp] := XbcMakeBlock(aFn[FN_ID], xA, aF[F_SELF])
            Else
              aSt[nSp] := XbcMakeFast(aFn[FN_FAST], xA, aF[F_SELF])
            EndIf
          Case nOp == OP_ISNIL
            aSt[nSp] := (ValType(aSt[nSp]) == "U")
          Case nOp == OP_NEG
            aSt[nSp] := -aSt[nSp]
          Case nOp == OP_POW
            nSp--
            aSt[nSp] := aSt[nSp] ** aSt[nSp + 1]
          Case nOp == OP_CONTAINS
            nSp--
            aSt[nSp] := (aSt[nSp] $ aSt[nSp + 1])
          EndCase
        ElseIf nOp <= OP_BOX
          Do Case
          Case nOp == OP_STATIC
            nSp++
            aSt[nSp] := aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]]
          Case nOp == OP_SETSTATIC
            aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_BOX
            aLoc[aIns[I_A]] := {aLoc[aIns[I_A]]}
          EndCase
        Else
          // The rare ones (Rare()): the frame's stack and place there, and
          // back from the frame on top -- a new one, for a call.
          aF[F_SP] := nSp
          aF[F_PC] := nPc
          ::Rare(aF, aIns)
          aF := aFrames[Len(aFrames)]
          aCode := aF[F_FN][FN_CODE]
          aLoc := aF[F_LOCALS]
          aSt := aF[F_LOCALS]
          nSp := aF[F_SP]
          nPc := aF[F_PC]
        EndIf
      EndDo
    Recover
      xCaught := XbcCaught()
      // An error in the frame this was running: the line of the instruction
      // it ran last.
      If ::aErrAt != Nil .And. ::aErrAt == aF
        ::cWhere := "${aF[F_FN][FN_NAME]}, line ${aCode[Max(nPc - 1, 1)][I_LINE]}"
        ::aErrAt := Nil
      EndIf
      ::lInErr := .F.
      If lTrace
        ::Note("  caught by the run from frame ${nBase}: " + ;
               If(XbcIsErr(xCaught), "error " + ::MemberOf(xCaught[2], "Description"), XbcShown(xCaught)))
      EndIf
    End Sequence
    If !lDone
      // The machine's own trouble -- a file it cannot read -- goes all the way
      // out, and so does what no region of this run takes.
      If (ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: ") .Or. ;
         !::Unwind(nBase, If(XbcIsErr(xCaught), xCaught[2], xCaught), XbcIsErr(xCaught))
        ::nRuns--
        XbcBreak(xCaught)
      EndIf
    EndIf
  EndDo
  ::nRuns--
Return xResult

Method Enter1(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12) Class XbcVM
  Local aFn := ::aFns[aClo[1]]
  Local nP := aFn[FN_PARAMS]
  Local aLoc := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
  Local xResult
  If nP > 0
    aLoc[1] := p1
    aLoc[2] := p2 if nP > 1
    aLoc[3] := p3 if nP > 2
    If nP > 3
      aLoc[4] := p4
      aLoc[5] := p5 if nP > 4
      aLoc[6] := p6 if nP > 5
      aLoc[7] := p7 if nP > 6
      aLoc[8] := p8 if nP > 7
      aLoc[9] := p9 if nP > 8
      aLoc[10] := p10 if nP > 9
      aLoc[11] := p11 if nP > 10
      aLoc[12] := p12 if nP > 11
    EndIf
  EndIf
  ::Fail("stack overflow") if Len(::aFrames) > 4000
  AAdd(::aFrames, {aFn, aLoc, aFn[FN_NLOCALS], 1, Min(nP, 12), aClo[2], aClo[3], Nil})
  xResult := ::Run1(Len(::aFrames))
  ::Note("  the block ${aFn[FN_NAME]} gave " + XbcShown(xResult)) if ::aTrace != Nil
Return xResult

Method Run2(nBase) Class XbcVM
  Local aFrames := ::aFrames
  Local aF
  Local aCode
  Local aLoc
  Local aSt
  Local nSp
  Local nPc
  Local lTrace := ::aTrace != Nil
  Local lDone := .F.
  Local xCaught
  Local aIns
  Local nOp
  Local aArgs
  Local xA
  Local xB
  Local nI
  Local nK
  Local nN
  Local nAt
  Local aCls
  Local aM
  Local aFn
  Local xResult
  ::nRuns++
  While !lDone
    aF := aFrames[Len(aFrames)]
    aCode := aF[F_FN][FN_CODE]
    aLoc := aF[F_LOCALS]
    aSt := aF[F_LOCALS]
    nSp := aF[F_SP]
    nPc := aF[F_PC]
    sxBroke := scNone
    Begin Sequence
      While .T.
        aIns := aCode[nPc]
        ::Trace(aF, nPc, aIns, nSp, aSt) if lTrace
        nPc++
        nOp := aIns[I_OP]
        If nOp <= OP_JUMP
          Do Case
          Case nOp == OP_JIT
            // A run as one block, made the first time, for the stack's height
            // then; at another height the run is interpreted.
            ::Jit(aF, aIns, nSp) if aIns[I_K] == 0
            If aIns[I_K] == 1 .And. aIns[I_D] == nSp
              xA := Eval(aIns[I_C], aLoc, aIns[I_S2], aF[F_CELLS], aF[F_FN][FN_MOD][M_STATICS], aF[F_SELF])
              nSp := aIns[I_E]
              Do Case
              Case aIns[I_N] == 0
                nPc := aIns[I_A]
              Case aIns[I_N] == 3
                nPc := aIns[I_B]
              Case aIns[I_N] == 1
                nPc := If(xA, aIns[I_A], aIns[I_B])
              Otherwise
                nPc := If(xA, aIns[I_B], aIns[I_A])
              EndCase
            EndIf
          Case nOp == OP_LOCAL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]]
          Case nOp == OP_SETLOCAL
            aLoc[aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_NUM
            nSp++
            aSt[nSp] := aIns[I_N]
          Case nOp == OP_LOCAL2
            aSt[nSp + 1] := aLoc[aIns[I_A]]
            nSp += 2
            aSt[nSp] := aLoc[aIns[I_B]]
          Case nOp == OP_CALL
            nN := aIns[I_A]
            nK := aIns[I_K]
            If nK == K_FN
              // A function of a module: its frame, its parameters from the
              // stack.
              aFn := aIns[I_X]
              xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
              nAt := nSp - nN
              nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
              For nK := 1 To nI
                xA[nK] := aSt[nAt + nK]
              Next
              aF[F_SP] := nAt
              aF[F_PC] := nPc
              ::Fail("stack overflow") if Len(aFrames) > 4000
              aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, Nil, Nil}
              AAdd(aFrames, aF)
              aCode := aFn[FN_CODE]
              aLoc := xA
              aSt := xA
              nSp := aFn[FN_NLOCALS]
              nPc := 1
            Else
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN
              Do Case
              Case nK == K_SYS
                xA := Eval(aIns[I_X], Nil, aArgs)
                nSp++
                aSt[nSp] := xA
              Case nK == K_PCOUNT
                nSp++
                aSt[nSp] := aF[F_ARGC]
              Case nK == K_EVAL .And. ValType(aArgs[1]) == "B"
                // Here, for the few arguments a block has as a rule: a
                // function between would be entered again by a block that
                // runs Eval() inside an Eval().
                Do Case
                Case nN == 1
                  xA := Eval(aArgs[1])
                Case nN == 2
                  xA := Eval(aArgs[1], aArgs[2])
                Case nN == 3
                  xA := Eval(aArgs[1], aArgs[2], aArgs[3])
                Otherwise
                  xA := XbcEvalArgs(aArgs[1], aArgs)
                EndCase
                nSp++
                aSt[nSp] := xA
              Case nK == K_MACRO
                xA := XbcEvalN(aIns[I_X], aArgs, Nil)
                nSp++
                aSt[nSp] := xA
              Otherwise
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If ::Invoke(aF, aIns[I_S], aArgs, .F., aIns)
                  // A function of a module: its frame runs on.
                  aF := aFrames[Len(aFrames)]
                  aCode := aF[F_FN][FN_CODE]
                  aLoc := aF[F_LOCALS]
                  aSt := aF[F_LOCALS]
                  nSp := aF[F_SP]
                  nPc := aF[F_PC]
                Else
                  nSp := aF[F_SP]
                EndIf
              EndCase
            EndIf
          Case nOp == OP_JUMPF
            If !aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          Case nOp == OP_ADD
            nSp--
            aSt[nSp] := aSt[nSp] + aSt[nSp + 1]
          Case nOp == OP_JUMP
            nPc := aIns[I_A]
          EndCase
        ElseIf nOp <= OP_EQJF
          Do Case
          // What is subscripted is a Local: the AppServer words an error of an
          // element subscripted again otherwise -- 'array out of bounds ( 2
          // of 0 )', not '[2] of [0]' (04-flow, on 24.3.1.9).
          Case nOp == OP_LOCALIDX
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_LOCALIDXL
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aLoc[aIns[I_B]]]
          Case nOp == OP_INDEX
            xA := aSt[nSp - 1]
            nSp--
            aSt[nSp] := xA[aSt[nSp + 1]]
          Case nOp == OP_NUMIDX
            xA := aSt[nSp]
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_INCLOCAL
            aLoc[aIns[I_A]] := aLoc[aIns[I_A]] + aIns[I_N]
          Case nOp == OP_ADDNUM
            aSt[nSp] := aSt[nSp] + aIns[I_N]
          Case nOp == OP_ADDSET
            aLoc[aIns[I_A]] := aSt[nSp - 1] + aSt[nSp]
            nSp -= 2
          Case nOp == OP_LEJF
            If !(aSt[nSp - 1] <= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_LTJF
            If !(aSt[nSp - 1] < aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GEJF
            If !(aSt[nSp - 1] >= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GTJF
            If !(aSt[nSp - 1] > aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EXACTJF
            If !(aSt[nSp - 1] == aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_NEJF
            If !(aSt[nSp - 1] != aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EQJF
            If !(aSt[nSp - 1] = aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          EndCase
        ElseIf nOp <= OP_FALSE
          Do Case
          Case nOp == OP_RET
            xA := aSt[nSp]
            If aF[F_MORE] != Nil
              xA := aF[F_SELF] if aF[F_MORE][X_CTOR]
              ::EndFrame(aF)
            EndIf
            ASize(aFrames, Len(aFrames) - 1)
            If Len(aFrames) < nBase
              xResult := xA
              lDone := .T.
              Exit
            EndIf
            aF := aFrames[Len(aFrames)]
            aCode := aF[F_FN][FN_CODE]
            aLoc := aF[F_LOCALS]
            aSt := aF[F_LOCALS]
            nSp := aF[F_SP] + 1
            nPc := aF[F_PC]
            aSt[nSp] := xA
          Case nOp == OP_POP
            nSp--
          Case nOp == OP_STR
            nSp++
            aSt[nSp] := aIns[I_S]
          Case nOp == OP_NIL
            nSp++
            aSt[nSp] := Nil
          Case nOp == OP_METHOD
            nN := aIns[I_A]
            xB := aSt[nSp - nN]
            If ValType(xB) == "O" .And. AttIsMemberOf(xB, "xbcCls")
              // A module's class: the class it found last, and the method --
              // one class a call sees, as a rule --, its frame.
              aCls := xB:xbcCls
              If aIns[I_C] != Nil .And. aIns[I_C][1] == aCls
                aM := aIns[I_C][2]
              Else
                aM := ::MethodOf(aCls, aIns[I_S2])
                ::Fail("no method ${aIns[I_S]} of ${aCls[C_NAME]}") if aM == Nil
                aIns[I_C] := {aCls, aM}
              EndIf
              aFn := aM[1]
              If aIns[I_K] == K_FN
                xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
                nAt := nSp - nN
                nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
                For nK := 1 To nI
                  xA[nK] := aSt[nAt + nK]
                Next
                aF[F_SP] := nAt - 1
                aF[F_PC] := nPc
                ::Fail("stack overflow") if Len(aFrames) > 4000
                aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, xB, Nil}
                AAdd(aFrames, aF)
              Else
                aArgs := Array(nN)
                For nI := 1 To nN
                  aArgs[nI] := aSt[nSp - nN + nI]
                Next
                nSp -= nN + 1
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If aIns[I_K] == 0 .And. !lTrace
                  aIns[I_K] := If(XbcAnyRef(aArgs), K_SLOW, K_FN)
                EndIf
                ::Push(aFn, aArgs, Nil, xB)
                aF := aFrames[Len(aFrames)]
              EndIf
              aCode := aF[F_FN][FN_CODE]
              aLoc := aF[F_LOCALS]
              aSt := aF[F_LOCALS]
              nSp := aF[F_SP]
              nPc := aF[F_PC]
            Else
              // The AppServer's: the table's block for the method, found the
              // first time, when the call has no reference.
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN + 1
              If aIns[I_X] == Nil .And. !lTrace
                aIns[I_X] := .F.
                If !XbcAnyRef(aArgs)
                  nAt := ::hSys{"m:" + aIns[I_S2] + "/" + cValToChar(nN)}
                  aIns[I_X] := ::aSys[nAt] if nAt != Nil
                EndIf
              EndIf
              If ValType(aIns[I_X]) == "B"
                xA := Eval(aIns[I_X], xB, aArgs)
              Else
                xA := ::MethodCall(xB, aIns[I_S], aArgs)
              EndIf
              nSp++
              aSt[nSp] := xA
            EndIf
          Case nOp == OP_MEMBER
            xA := aSt[nSp]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              // A module's class: the place of the data, found once for the
              // class it sees.
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              aSt[nSp] := xA:aProps[aIns[I_C][2]]
            Else
              aSt[nSp] := ::MemberOf(xA, aIns[I_S])
            EndIf
          Case nOp == OP_SETMEMBER
            xA := aSt[nSp - 1]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              xA:aProps[aIns[I_C][2]] := aSt[nSp]
            Else
              ::SetMemberOf(xA, aIns[I_S], aSt[nSp])
            EndIf
            nSp -= 2
          Case nOp == OP_SETINDEX
            xA := aSt[nSp - 2]
            xA[aSt[nSp - 1]] := aSt[nSp]
            nSp -= 3
          Case nOp == OP_SELF
            nSp++
            aSt[nSp] := aF[F_SELF]
          Case nOp == OP_EXACT
            nSp--
            aSt[nSp] := (aSt[nSp] == aSt[nSp + 1])
          Case nOp == OP_TRUE
            nSp++
            aSt[nSp] := .T.
          Case nOp == OP_FALSE
            nSp++
            aSt[nSp] := .F.
          EndCase
        ElseIf nOp <= OP_JUMPT
          Do Case
          Case nOp == OP_SUB
            nSp--
            aSt[nSp] := aSt[nSp] - aSt[nSp + 1]
          Case nOp == OP_MUL
            nSp--
            aSt[nSp] := aSt[nSp] * aSt[nSp + 1]
          Case nOp == OP_DIV
            nSp--
            aSt[nSp] := aSt[nSp] / aSt[nSp + 1]
          Case nOp == OP_MOD
            nSp--
            aSt[nSp] := aSt[nSp] % aSt[nSp + 1]
          Case nOp == OP_NOT
            aSt[nSp] := !aSt[nSp]
          Case nOp == OP_EQ
            nSp--
            aSt[nSp] := (aSt[nSp] = aSt[nSp + 1])
          Case nOp == OP_NE
            nSp--
            aSt[nSp] := (aSt[nSp] != aSt[nSp + 1])
          Case nOp == OP_LT
            nSp--
            aSt[nSp] := (aSt[nSp] < aSt[nSp + 1])
          Case nOp == OP_GT
            nSp--
            aSt[nSp] := (aSt[nSp] > aSt[nSp + 1])
          Case nOp == OP_LE
            nSp--
            aSt[nSp] := (aSt[nSp] <= aSt[nSp + 1])
          Case nOp == OP_GE
            nSp--
            aSt[nSp] := (aSt[nSp] >= aSt[nSp + 1])
          Case nOp == OP_ANDJUMP
            If !aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_ORJUMP
            If aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_JUMPT
            If aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          EndCase
        ElseIf nOp <= OP_CONTAINS
          Do Case
          Case nOp == OP_ARRAY
            nN := aIns[I_A]
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI]
            Next
            nSp := nSp - nN + 1
            aSt[nSp] := xA
          Case nOp == OP_DUP
            nSp++
            aSt[nSp] := aSt[nSp - 1]
          Case nOp == OP_DUP2
            aSt[nSp + 1] := aSt[nSp - 1]
            aSt[nSp + 2] := aSt[nSp]
            nSp += 2
          Case nOp == OP_CELL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]][1]
          Case nOp == OP_SETCELL
            aLoc[aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_UPVAL
            nSp++
            aSt[nSp] := aF[F_CELLS][aIns[I_A]][1]
          Case nOp == OP_SETUPVAL
            aF[F_CELLS][aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_REFLOCAL
            nSp++
            aSt[nSp] := {scRef, aLoc, aIns[I_A]}
          Case nOp == OP_REFCELL
            nSp++
            aSt[nSp] := {scRef, aLoc[aIns[I_A]], 1}
          Case nOp == OP_REFUPVAL
            nSp++
            aSt[nSp] := {scRef, aF[F_CELLS][aIns[I_A]], 1}
          Case nOp == OP_BLOCK
            nN := aIns[I_B]
            If aIns[I_C] == Nil
              aIns[I_C] := aF[F_FN][FN_MOD][M_FNS]{Upper(aIns[I_S])}
            EndIf
            aFn := aIns[I_C]
            ::Fail("no block function ${aIns[I_S]}") if aFn == Nil
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI][2]
            Next
            nSp := nSp - nN + 1
            ::JitWhole(aFn) if aFn[FN_FAST] == Nil
            If ValType(aFn[FN_FAST]) == "L"
              aSt[nSp] := XbcMakeBlock(aFn[FN_ID], xA, aF[F_SELF])
            Else
              aSt[nSp] := XbcMakeFast(aFn[FN_FAST], xA, aF[F_SELF])
            EndIf
          Case nOp == OP_ISNIL
            aSt[nSp] := (ValType(aSt[nSp]) == "U")
          Case nOp == OP_NEG
            aSt[nSp] := -aSt[nSp]
          Case nOp == OP_POW
            nSp--
            aSt[nSp] := aSt[nSp] ** aSt[nSp + 1]
          Case nOp == OP_CONTAINS
            nSp--
            aSt[nSp] := (aSt[nSp] $ aSt[nSp + 1])
          EndCase
        ElseIf nOp <= OP_BOX
          Do Case
          Case nOp == OP_STATIC
            nSp++
            aSt[nSp] := aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]]
          Case nOp == OP_SETSTATIC
            aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_BOX
            aLoc[aIns[I_A]] := {aLoc[aIns[I_A]]}
          EndCase
        Else
          // The rare ones (Rare()): the frame's stack and place there, and
          // back from the frame on top -- a new one, for a call.
          aF[F_SP] := nSp
          aF[F_PC] := nPc
          ::Rare(aF, aIns)
          aF := aFrames[Len(aFrames)]
          aCode := aF[F_FN][FN_CODE]
          aLoc := aF[F_LOCALS]
          aSt := aF[F_LOCALS]
          nSp := aF[F_SP]
          nPc := aF[F_PC]
        EndIf
      EndDo
    Recover
      xCaught := XbcCaught()
      // An error in the frame this was running: the line of the instruction
      // it ran last.
      If ::aErrAt != Nil .And. ::aErrAt == aF
        ::cWhere := "${aF[F_FN][FN_NAME]}, line ${aCode[Max(nPc - 1, 1)][I_LINE]}"
        ::aErrAt := Nil
      EndIf
      ::lInErr := .F.
      If lTrace
        ::Note("  caught by the run from frame ${nBase}: " + ;
               If(XbcIsErr(xCaught), "error " + ::MemberOf(xCaught[2], "Description"), XbcShown(xCaught)))
      EndIf
    End Sequence
    If !lDone
      // The machine's own trouble -- a file it cannot read -- goes all the way
      // out, and so does what no region of this run takes.
      If (ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: ") .Or. ;
         !::Unwind(nBase, If(XbcIsErr(xCaught), xCaught[2], xCaught), XbcIsErr(xCaught))
        ::nRuns--
        XbcBreak(xCaught)
      EndIf
    EndIf
  EndDo
  ::nRuns--
Return xResult

Method Enter2(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12) Class XbcVM
  Local aFn := ::aFns[aClo[1]]
  Local nP := aFn[FN_PARAMS]
  Local aLoc := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
  Local xResult
  If nP > 0
    aLoc[1] := p1
    aLoc[2] := p2 if nP > 1
    aLoc[3] := p3 if nP > 2
    If nP > 3
      aLoc[4] := p4
      aLoc[5] := p5 if nP > 4
      aLoc[6] := p6 if nP > 5
      aLoc[7] := p7 if nP > 6
      aLoc[8] := p8 if nP > 7
      aLoc[9] := p9 if nP > 8
      aLoc[10] := p10 if nP > 9
      aLoc[11] := p11 if nP > 10
      aLoc[12] := p12 if nP > 11
    EndIf
  EndIf
  ::Fail("stack overflow") if Len(::aFrames) > 4000
  AAdd(::aFrames, {aFn, aLoc, aFn[FN_NLOCALS], 1, Min(nP, 12), aClo[2], aClo[3], Nil})
  xResult := ::Run2(Len(::aFrames))
  ::Note("  the block ${aFn[FN_NAME]} gave " + XbcShown(xResult)) if ::aTrace != Nil
Return xResult

Method Run3(nBase) Class XbcVM
  Local aFrames := ::aFrames
  Local aF
  Local aCode
  Local aLoc
  Local aSt
  Local nSp
  Local nPc
  Local lTrace := ::aTrace != Nil
  Local lDone := .F.
  Local xCaught
  Local aIns
  Local nOp
  Local aArgs
  Local xA
  Local xB
  Local nI
  Local nK
  Local nN
  Local nAt
  Local aCls
  Local aM
  Local aFn
  Local xResult
  ::nRuns++
  While !lDone
    aF := aFrames[Len(aFrames)]
    aCode := aF[F_FN][FN_CODE]
    aLoc := aF[F_LOCALS]
    aSt := aF[F_LOCALS]
    nSp := aF[F_SP]
    nPc := aF[F_PC]
    sxBroke := scNone
    Begin Sequence
      While .T.
        aIns := aCode[nPc]
        ::Trace(aF, nPc, aIns, nSp, aSt) if lTrace
        nPc++
        nOp := aIns[I_OP]
        If nOp <= OP_JUMP
          Do Case
          Case nOp == OP_JIT
            // A run as one block, made the first time, for the stack's height
            // then; at another height the run is interpreted.
            ::Jit(aF, aIns, nSp) if aIns[I_K] == 0
            If aIns[I_K] == 1 .And. aIns[I_D] == nSp
              xA := Eval(aIns[I_C], aLoc, aIns[I_S2], aF[F_CELLS], aF[F_FN][FN_MOD][M_STATICS], aF[F_SELF])
              nSp := aIns[I_E]
              Do Case
              Case aIns[I_N] == 0
                nPc := aIns[I_A]
              Case aIns[I_N] == 3
                nPc := aIns[I_B]
              Case aIns[I_N] == 1
                nPc := If(xA, aIns[I_A], aIns[I_B])
              Otherwise
                nPc := If(xA, aIns[I_B], aIns[I_A])
              EndCase
            EndIf
          Case nOp == OP_LOCAL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]]
          Case nOp == OP_SETLOCAL
            aLoc[aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_NUM
            nSp++
            aSt[nSp] := aIns[I_N]
          Case nOp == OP_LOCAL2
            aSt[nSp + 1] := aLoc[aIns[I_A]]
            nSp += 2
            aSt[nSp] := aLoc[aIns[I_B]]
          Case nOp == OP_CALL
            nN := aIns[I_A]
            nK := aIns[I_K]
            If nK == K_FN
              // A function of a module: its frame, its parameters from the
              // stack.
              aFn := aIns[I_X]
              xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
              nAt := nSp - nN
              nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
              For nK := 1 To nI
                xA[nK] := aSt[nAt + nK]
              Next
              aF[F_SP] := nAt
              aF[F_PC] := nPc
              ::Fail("stack overflow") if Len(aFrames) > 4000
              aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, Nil, Nil}
              AAdd(aFrames, aF)
              aCode := aFn[FN_CODE]
              aLoc := xA
              aSt := xA
              nSp := aFn[FN_NLOCALS]
              nPc := 1
            Else
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN
              Do Case
              Case nK == K_SYS
                xA := Eval(aIns[I_X], Nil, aArgs)
                nSp++
                aSt[nSp] := xA
              Case nK == K_PCOUNT
                nSp++
                aSt[nSp] := aF[F_ARGC]
              Case nK == K_EVAL .And. ValType(aArgs[1]) == "B"
                // Here, for the few arguments a block has as a rule: a
                // function between would be entered again by a block that
                // runs Eval() inside an Eval().
                Do Case
                Case nN == 1
                  xA := Eval(aArgs[1])
                Case nN == 2
                  xA := Eval(aArgs[1], aArgs[2])
                Case nN == 3
                  xA := Eval(aArgs[1], aArgs[2], aArgs[3])
                Otherwise
                  xA := XbcEvalArgs(aArgs[1], aArgs)
                EndCase
                nSp++
                aSt[nSp] := xA
              Case nK == K_MACRO
                xA := XbcEvalN(aIns[I_X], aArgs, Nil)
                nSp++
                aSt[nSp] := xA
              Otherwise
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If ::Invoke(aF, aIns[I_S], aArgs, .F., aIns)
                  // A function of a module: its frame runs on.
                  aF := aFrames[Len(aFrames)]
                  aCode := aF[F_FN][FN_CODE]
                  aLoc := aF[F_LOCALS]
                  aSt := aF[F_LOCALS]
                  nSp := aF[F_SP]
                  nPc := aF[F_PC]
                Else
                  nSp := aF[F_SP]
                EndIf
              EndCase
            EndIf
          Case nOp == OP_JUMPF
            If !aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          Case nOp == OP_ADD
            nSp--
            aSt[nSp] := aSt[nSp] + aSt[nSp + 1]
          Case nOp == OP_JUMP
            nPc := aIns[I_A]
          EndCase
        ElseIf nOp <= OP_EQJF
          Do Case
          // What is subscripted is a Local: the AppServer words an error of an
          // element subscripted again otherwise -- 'array out of bounds ( 2
          // of 0 )', not '[2] of [0]' (04-flow, on 24.3.1.9).
          Case nOp == OP_LOCALIDX
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_LOCALIDXL
            xA := aLoc[aIns[I_A]]
            nSp++
            aSt[nSp] := xA[aLoc[aIns[I_B]]]
          Case nOp == OP_INDEX
            xA := aSt[nSp - 1]
            nSp--
            aSt[nSp] := xA[aSt[nSp + 1]]
          Case nOp == OP_NUMIDX
            xA := aSt[nSp]
            aSt[nSp] := xA[aIns[I_N]]
          Case nOp == OP_INCLOCAL
            aLoc[aIns[I_A]] := aLoc[aIns[I_A]] + aIns[I_N]
          Case nOp == OP_ADDNUM
            aSt[nSp] := aSt[nSp] + aIns[I_N]
          Case nOp == OP_ADDSET
            aLoc[aIns[I_A]] := aSt[nSp - 1] + aSt[nSp]
            nSp -= 2
          Case nOp == OP_LEJF
            If !(aSt[nSp - 1] <= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_LTJF
            If !(aSt[nSp - 1] < aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GEJF
            If !(aSt[nSp - 1] >= aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_GTJF
            If !(aSt[nSp - 1] > aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EXACTJF
            If !(aSt[nSp - 1] == aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_NEJF
            If !(aSt[nSp - 1] != aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          Case nOp == OP_EQJF
            If !(aSt[nSp - 1] = aSt[nSp])
              nPc := aIns[I_A]
            EndIf
            nSp -= 2
          EndCase
        ElseIf nOp <= OP_FALSE
          Do Case
          Case nOp == OP_RET
            xA := aSt[nSp]
            If aF[F_MORE] != Nil
              xA := aF[F_SELF] if aF[F_MORE][X_CTOR]
              ::EndFrame(aF)
            EndIf
            ASize(aFrames, Len(aFrames) - 1)
            If Len(aFrames) < nBase
              xResult := xA
              lDone := .T.
              Exit
            EndIf
            aF := aFrames[Len(aFrames)]
            aCode := aF[F_FN][FN_CODE]
            aLoc := aF[F_LOCALS]
            aSt := aF[F_LOCALS]
            nSp := aF[F_SP] + 1
            nPc := aF[F_PC]
            aSt[nSp] := xA
          Case nOp == OP_POP
            nSp--
          Case nOp == OP_STR
            nSp++
            aSt[nSp] := aIns[I_S]
          Case nOp == OP_NIL
            nSp++
            aSt[nSp] := Nil
          Case nOp == OP_METHOD
            nN := aIns[I_A]
            xB := aSt[nSp - nN]
            If ValType(xB) == "O" .And. AttIsMemberOf(xB, "xbcCls")
              // A module's class: the class it found last, and the method --
              // one class a call sees, as a rule --, its frame.
              aCls := xB:xbcCls
              If aIns[I_C] != Nil .And. aIns[I_C][1] == aCls
                aM := aIns[I_C][2]
              Else
                aM := ::MethodOf(aCls, aIns[I_S2])
                ::Fail("no method ${aIns[I_S]} of ${aCls[C_NAME]}") if aM == Nil
                aIns[I_C] := {aCls, aM}
              EndIf
              aFn := aM[1]
              If aIns[I_K] == K_FN
                xA := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
                nAt := nSp - nN
                nI := If(nN < aFn[FN_PARAMS], nN, aFn[FN_PARAMS])
                For nK := 1 To nI
                  xA[nK] := aSt[nAt + nK]
                Next
                aF[F_SP] := nAt - 1
                aF[F_PC] := nPc
                ::Fail("stack overflow") if Len(aFrames) > 4000
                aF := {aFn, xA, aFn[FN_NLOCALS], 1, nN, Nil, xB, Nil}
                AAdd(aFrames, aF)
              Else
                aArgs := Array(nN)
                For nI := 1 To nN
                  aArgs[nI] := aSt[nSp - nN + nI]
                Next
                nSp -= nN + 1
                aF[F_SP] := nSp
                aF[F_PC] := nPc
                If aIns[I_K] == 0 .And. !lTrace
                  aIns[I_K] := If(XbcAnyRef(aArgs), K_SLOW, K_FN)
                EndIf
                ::Push(aFn, aArgs, Nil, xB)
                aF := aFrames[Len(aFrames)]
              EndIf
              aCode := aF[F_FN][FN_CODE]
              aLoc := aF[F_LOCALS]
              aSt := aF[F_LOCALS]
              nSp := aF[F_SP]
              nPc := aF[F_PC]
            Else
              // The AppServer's: the table's block for the method, found the
              // first time, when the call has no reference.
              aArgs := Array(nN)
              For nI := 1 To nN
                aArgs[nI] := aSt[nSp - nN + nI]
              Next
              nSp -= nN + 1
              If aIns[I_X] == Nil .And. !lTrace
                aIns[I_X] := .F.
                If !XbcAnyRef(aArgs)
                  nAt := ::hSys{"m:" + aIns[I_S2] + "/" + cValToChar(nN)}
                  aIns[I_X] := ::aSys[nAt] if nAt != Nil
                EndIf
              EndIf
              If ValType(aIns[I_X]) == "B"
                xA := Eval(aIns[I_X], xB, aArgs)
              Else
                xA := ::MethodCall(xB, aIns[I_S], aArgs)
              EndIf
              nSp++
              aSt[nSp] := xA
            EndIf
          Case nOp == OP_MEMBER
            xA := aSt[nSp]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              // A module's class: the place of the data, found once for the
              // class it sees.
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              aSt[nSp] := xA:aProps[aIns[I_C][2]]
            Else
              aSt[nSp] := ::MemberOf(xA, aIns[I_S])
            EndIf
          Case nOp == OP_SETMEMBER
            xA := aSt[nSp - 1]
            If ValType(xA) == "O" .And. AttIsMemberOf(xA, "xbcCls")
              aCls := xA:xbcCls
              If aIns[I_C] == Nil .Or. !(aIns[I_C][1] == aCls)
                aIns[I_C] := {aCls, ::SlotOf(aCls, aIns[I_S])}
              EndIf
              xA:aProps[aIns[I_C][2]] := aSt[nSp]
            Else
              ::SetMemberOf(xA, aIns[I_S], aSt[nSp])
            EndIf
            nSp -= 2
          Case nOp == OP_SETINDEX
            xA := aSt[nSp - 2]
            xA[aSt[nSp - 1]] := aSt[nSp]
            nSp -= 3
          Case nOp == OP_SELF
            nSp++
            aSt[nSp] := aF[F_SELF]
          Case nOp == OP_EXACT
            nSp--
            aSt[nSp] := (aSt[nSp] == aSt[nSp + 1])
          Case nOp == OP_TRUE
            nSp++
            aSt[nSp] := .T.
          Case nOp == OP_FALSE
            nSp++
            aSt[nSp] := .F.
          EndCase
        ElseIf nOp <= OP_JUMPT
          Do Case
          Case nOp == OP_SUB
            nSp--
            aSt[nSp] := aSt[nSp] - aSt[nSp + 1]
          Case nOp == OP_MUL
            nSp--
            aSt[nSp] := aSt[nSp] * aSt[nSp + 1]
          Case nOp == OP_DIV
            nSp--
            aSt[nSp] := aSt[nSp] / aSt[nSp + 1]
          Case nOp == OP_MOD
            nSp--
            aSt[nSp] := aSt[nSp] % aSt[nSp + 1]
          Case nOp == OP_NOT
            aSt[nSp] := !aSt[nSp]
          Case nOp == OP_EQ
            nSp--
            aSt[nSp] := (aSt[nSp] = aSt[nSp + 1])
          Case nOp == OP_NE
            nSp--
            aSt[nSp] := (aSt[nSp] != aSt[nSp + 1])
          Case nOp == OP_LT
            nSp--
            aSt[nSp] := (aSt[nSp] < aSt[nSp + 1])
          Case nOp == OP_GT
            nSp--
            aSt[nSp] := (aSt[nSp] > aSt[nSp + 1])
          Case nOp == OP_LE
            nSp--
            aSt[nSp] := (aSt[nSp] <= aSt[nSp + 1])
          Case nOp == OP_GE
            nSp--
            aSt[nSp] := (aSt[nSp] >= aSt[nSp + 1])
          Case nOp == OP_ANDJUMP
            If !aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_ORJUMP
            If aSt[nSp]
              nPc := aIns[I_A]
            Else
              nSp--
            EndIf
          Case nOp == OP_JUMPT
            If aSt[nSp]
              nPc := aIns[I_A]
            EndIf
            nSp--
          EndCase
        ElseIf nOp <= OP_CONTAINS
          Do Case
          Case nOp == OP_ARRAY
            nN := aIns[I_A]
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI]
            Next
            nSp := nSp - nN + 1
            aSt[nSp] := xA
          Case nOp == OP_DUP
            nSp++
            aSt[nSp] := aSt[nSp - 1]
          Case nOp == OP_DUP2
            aSt[nSp + 1] := aSt[nSp - 1]
            aSt[nSp + 2] := aSt[nSp]
            nSp += 2
          Case nOp == OP_CELL
            nSp++
            aSt[nSp] := aLoc[aIns[I_A]][1]
          Case nOp == OP_SETCELL
            aLoc[aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_UPVAL
            nSp++
            aSt[nSp] := aF[F_CELLS][aIns[I_A]][1]
          Case nOp == OP_SETUPVAL
            aF[F_CELLS][aIns[I_A]][1] := aSt[nSp]
            nSp--
          Case nOp == OP_REFLOCAL
            nSp++
            aSt[nSp] := {scRef, aLoc, aIns[I_A]}
          Case nOp == OP_REFCELL
            nSp++
            aSt[nSp] := {scRef, aLoc[aIns[I_A]], 1}
          Case nOp == OP_REFUPVAL
            nSp++
            aSt[nSp] := {scRef, aF[F_CELLS][aIns[I_A]], 1}
          Case nOp == OP_BLOCK
            nN := aIns[I_B]
            If aIns[I_C] == Nil
              aIns[I_C] := aF[F_FN][FN_MOD][M_FNS]{Upper(aIns[I_S])}
            EndIf
            aFn := aIns[I_C]
            ::Fail("no block function ${aIns[I_S]}") if aFn == Nil
            xA := Array(nN)
            For nI := 1 To nN
              xA[nI] := aSt[nSp - nN + nI][2]
            Next
            nSp := nSp - nN + 1
            ::JitWhole(aFn) if aFn[FN_FAST] == Nil
            If ValType(aFn[FN_FAST]) == "L"
              aSt[nSp] := XbcMakeBlock(aFn[FN_ID], xA, aF[F_SELF])
            Else
              aSt[nSp] := XbcMakeFast(aFn[FN_FAST], xA, aF[F_SELF])
            EndIf
          Case nOp == OP_ISNIL
            aSt[nSp] := (ValType(aSt[nSp]) == "U")
          Case nOp == OP_NEG
            aSt[nSp] := -aSt[nSp]
          Case nOp == OP_POW
            nSp--
            aSt[nSp] := aSt[nSp] ** aSt[nSp + 1]
          Case nOp == OP_CONTAINS
            nSp--
            aSt[nSp] := (aSt[nSp] $ aSt[nSp + 1])
          EndCase
        ElseIf nOp <= OP_BOX
          Do Case
          Case nOp == OP_STATIC
            nSp++
            aSt[nSp] := aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]]
          Case nOp == OP_SETSTATIC
            aF[F_FN][FN_MOD][M_STATICS][aIns[I_A]] := aSt[nSp]
            nSp--
          Case nOp == OP_BOX
            aLoc[aIns[I_A]] := {aLoc[aIns[I_A]]}
          EndCase
        Else
          // The rare ones (Rare()): the frame's stack and place there, and
          // back from the frame on top -- a new one, for a call.
          aF[F_SP] := nSp
          aF[F_PC] := nPc
          ::Rare(aF, aIns)
          aF := aFrames[Len(aFrames)]
          aCode := aF[F_FN][FN_CODE]
          aLoc := aF[F_LOCALS]
          aSt := aF[F_LOCALS]
          nSp := aF[F_SP]
          nPc := aF[F_PC]
        EndIf
      EndDo
    Recover
      xCaught := XbcCaught()
      // An error in the frame this was running: the line of the instruction
      // it ran last.
      If ::aErrAt != Nil .And. ::aErrAt == aF
        ::cWhere := "${aF[F_FN][FN_NAME]}, line ${aCode[Max(nPc - 1, 1)][I_LINE]}"
        ::aErrAt := Nil
      EndIf
      ::lInErr := .F.
      If lTrace
        ::Note("  caught by the run from frame ${nBase}: " + ;
               If(XbcIsErr(xCaught), "error " + ::MemberOf(xCaught[2], "Description"), XbcShown(xCaught)))
      EndIf
    End Sequence
    If !lDone
      // The machine's own trouble -- a file it cannot read -- goes all the way
      // out, and so does what no region of this run takes.
      If (ValType(xCaught) == "C" .And. Left(xCaught, 7) == "xc-vm: ") .Or. ;
         !::Unwind(nBase, If(XbcIsErr(xCaught), xCaught[2], xCaught), XbcIsErr(xCaught))
        ::nRuns--
        XbcBreak(xCaught)
      EndIf
    EndIf
  EndDo
  ::nRuns--
Return xResult

Method Enter3(aClo, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12) Class XbcVM
  Local aFn := ::aFns[aClo[1]]
  Local nP := aFn[FN_PARAMS]
  Local aLoc := Array(aFn[FN_NLOCALS] + aFn[FN_STACK])
  Local xResult
  If nP > 0
    aLoc[1] := p1
    aLoc[2] := p2 if nP > 1
    aLoc[3] := p3 if nP > 2
    If nP > 3
      aLoc[4] := p4
      aLoc[5] := p5 if nP > 4
      aLoc[6] := p6 if nP > 5
      aLoc[7] := p7 if nP > 6
      aLoc[8] := p8 if nP > 7
      aLoc[9] := p9 if nP > 8
      aLoc[10] := p10 if nP > 9
      aLoc[11] := p11 if nP > 10
      aLoc[12] := p12 if nP > 11
    EndIf
  EndIf
  ::Fail("stack overflow") if Len(::aFrames) > 4000
  AAdd(::aFrames, {aFn, aLoc, aFn[FN_NLOCALS], 1, Min(nP, 12), aClo[2], aClo[3], Nil})
  xResult := ::Run3(Len(::aFrames))
  ::Note("  the block ${aFn[FN_NAME]} gave " + XbcShown(xResult)) if ::aTrace != Nil
Return xResult
// <<< the loop's copies
