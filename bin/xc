# xc -- compiles xtpl sources to TL++.
#
#   rakupp bin/xc file.xtpl                writes file.tlpp next to it
#   rakupp bin/xc file.xtpl out.tlpp       writes out.tlpp
#   rakupp bin/xc a.xtpl b.xtpl src/       each one next to itself -- a folder
#                                          stands for every .xtpl under it
#
#   --check             checks, and writes nothing: everything that would stop
#                       the compile is reported, the warnings too
#   --outdir=DIR        each .tlpp into DIR, not next to its source -- many
#                       sources in one run, as an AppServer compiles a folder
#   --includes=DIRS     where to look for the include files a source names,
#                       after its own folder ('a;b', as the AppServer's
#                       -includes): the commands and translations a plain-text
#                       one defines are known (TOTVS' own are compressed)
#   --dict sx3.csv      checks the fields used against an exported SX3
#   --dict-strict       and what it finds is an error, not a warning
#
# A source is windows-1252 (cp1252), as Protheus' are, and so is its .tlpp; a
# file in UTF-8 is refused.
#
# A file that does not parse, that the checks refuse, or that uses what xc
# cannot lower yet gets no .tlpp, and the others go on; the exit code is 1 if
# any failed. Warnings are printed, and stop nothing.

use lib $*PROGRAM.IO.absolute.IO.parent.parent.add('lib').Str;
use XC::Grammar;
use XC::Actions;
use XC::Emit;
use XC::Check;
use XC::Source;

sub usage-error(Str $message)
{
  note $message;
  exit 2;
}

my $usage = "usage: rakupp bin/xc [--check] [--includes=DIRS] [--dict sx3.csv [--dict-strict]] file.xtpl [out.tlpp]\n"
          ~ "       rakupp bin/xc [--check] [--outdir=DIR] [--includes=DIRS] [--dict sx3.csv [--dict-strict]] file-or-folder ...";
my @args = @*ARGS;
my ($dict-path, $strict, $check, $outdir) = Str, False, False, Str;
my @includes;
my @given;
while @args
{
  my $a = @args.shift;
  if    $a eq '--dict'        { $dict-path = @args.shift // usage-error($usage) }
  elsif $a eq '--dict-strict' { $strict = True }
  elsif $a eq '--check'       { $check = True }
  elsif $a ~~ / ^ '--outdir=' (.+) $ / { $outdir = ~$0 }
  elsif $a ~~ / ^ '--includes=' (.+) $ / { @includes.append((~$0).split(/ <[;,]> /).grep(*.chars)) }
  elsif $a.starts-with('--')  { usage-error("$a: no such option\n$usage") }
  else                        { @given.push($a) }
}
usage-error($usage) unless @given;
usage-error("--dict-strict needs --dict") if $strict && !$dict-path.defined;
usage-error("$dict-path: no such file") if $dict-path.defined && !$dict-path.IO.f;

# 'file.xtpl out.tlpp': the one form with an output named. Anything else is a
# list of sources, a folder standing for every .xtpl under it.
my $named-out = @given == 2 && @given[1] ~~ m:i/ '.tlpp' $ / && !@given[1].IO.d ?? @given.pop !! Str;
usage-error("--check writes nothing: no output to name") if $check && $named-out.defined;
usage-error("--outdir with an output named: one or the other") if $outdir.defined && $named-out.defined;
usage-error("$named-out: a .tlpp is named only for a single source") if $named-out.defined && @given[0].IO.d;

my %dictionary = $dict-path.defined ?? load-dictionary($dict-path) !! ();

sub sources-under(IO::Path $dir)
{
  $dir.dir.sort.map({ .d ?? |sources-under($_) !! (.extension.lc eq 'xtpl' ?? $_ !! Empty) })
}

my @sources;
my $missing = 0;
for @given -> $g
{
  if $g.IO.d
  {
    my @found = sources-under($g.IO);
    if @found { @sources.append(@found.map(~*)) }
    else      { note "$g: no .xtpl files in it"; $missing++ }
  }
  elsif $g.IO.f { @sources.push($g) }
  else          { note "$g: no such file"; $missing++ }
}

# The folder a path is in -- at '\\' too on Windows, where rakupp's IO::Path
# splits at '/' only.
sub folder-of(Str $p --> Str)
{
  my $cut = $*DISTRO.is-win ?? $p.rindex('\\') max ($p.rindex('/') // -1) !! $p.rindex('/') // -1;
  $cut = -1 without $cut;
  $cut >= 0 ?? $p.substr(0, $cut) !! '.'
}

# Why a source's bytes are UTF-8, not windows-1252 (cp1252) -- or Str when
# they are cp1252. They are UTF-8 when they start with its byte-order mark,
# or when what is beyond ASCII in them is valid UTF-8: cp1252 text with an
# accent almost never is ('é' is one byte, E9, and UTF-8 never has E9 before a
# letter). Pure ASCII is both, and fine. The five bytes cp1252 leaves
# undefined (81 8D 8F 90 9D) pass: Windows reads them as themselves, and so
# does xc -- they come out as they went in.
sub utf8-reason(Blob $b --> Str)
{
  my $fix = "Protheus' sources are windows-1252 (cp1252): save it so";
  return "it starts with UTF-8's byte-order mark. $fix" if $b.elems >= 3 && $b[0] == 0xEF && $b[1] == 0xBB && $b[2] == 0xBF;
  my $first = $b.list.first(* >= 0x80, :k);
  return Str without $first;
  return Str without try $b.decode('utf-8');
  my $line = 1 + $b.subbuf(0, $first).list.grep(10).elems;
  "it is UTF-8 -- the first character beyond ASCII is on line $line. $fix"
}

# One source: read, parsed, checked, lowered, and -- but with --check --
# written. What stops it is reported, and it returns False.
sub compile(Str $in, Str $out --> Bool)
{
  # Read as bytes, not with 'slurp': 'slurp' turns every "\r\n" into "\n", and
  # a CRLF source has to come out CRLF. Windows-1252 (cp1252), what Protheus'
  # sources are, and the output goes back so, with the same line ends. A file
  # in UTF-8 is refused: read as cp1252, each of its accents would be two
  # characters, and come out so.
  my $bytes = $in.IO.slurp(:bin);
  with utf8-reason($bytes) -> $why
  {
    note "$in: $why";
    return False;
  }
  my $src = $bytes.decode('windows-1252');

  # How far the parse got: the grammar records the end of every line it could
  # finish. The first line it could not is the one to show.
  my $*FURTHEST = 0;
  # For the include files it names: its folder, then --includes.
  my $*XC-DIR = folder-of($in);
  my $*XC-INCLUDES = @includes;
  my $m = XC::Grammar.parse($src, actions => XC::Actions.new(source => $src));
  unless $m
  {
    # The mark is a match offset; XC::Source turns it into characters and lines.
    my $pos = XC::Source.new(text => $src);
    # Everything up to the end parsed, and the file still did not match: a
    # block was left open.
    unless $src.substr($pos.char($*FURTHEST)).trim
    {
      note "$in: the file ends inside a block that was never closed";
      return False;
    }
    my $line = $pos.line($*FURTHEST);
    my $text = $src.lines[$line - 1].trim;
    # A name xc keeps for itself -- 'Local len', 'Local fo_0_0' -- is refused
    # by the grammar, which can only say the line does not parse. Read again
    # with any name allowed, the checks say which name and why, in xtpl's
    # words: when the file parses so, the names were all that was wrong; when
    # it does not -- the name used where it cannot be, 'return if' -- the line
    # it stopped at, if it is a declaration.
    my @names = do
    {
      my $*ANY-NAME = True;
      my $*FURTHEST = 0;
      my $again = XC::Grammar.parse($src, actions => XC::Actions.new(source => $src));
      if $again
      {
        check-names($again.made)
      }
      else
      {
        my $decl = XC::Grammar.parse($text, rule => 'declaration', actions => XC::Actions.new(source => $text));
        $decl ?? check-declared-names($decl.made).map({ $line => .value }).List !! ()
      }
    };
    if @names
    {
      note "$in:{.key}: {.value}" for @names;
      return False;
    }
    # A whole 'local' or 'static' declaration that does not parse where it is
    # fails for its place alone: say so.
    if late-declaration($text)
    {
      note "$in:$line: 'local' cannot be declared here: every local comes before the first statement of its "
         ~ "function or its block -- '$text'";
      return False;
    }
    note "$in:$line: cannot parse this line: $text";
    return False;
  }

  # What xtpl refuses although it parses -- scopes, <const>, the calls to this
  # file's functions, ... -- each with xtpl's message; and what it warns about,
  # a name nothing declares among them, which does not stop the compile.
  my %checked = check-all($m.made, lines => $src.lines.elems, :%dictionary, :$strict, source => $src);
  note "$in:{.key}: warning: {.value}" for %checked<warnings>.list;
  if %checked<errors>
  {
    note "$in:{.key}: {.value}" for %checked<errors>.list;
    return False;
  }

  # Lowered with --check too: what xc cannot lower yet would stop the compile.
  my $tlpp = try emit($m.made, $src);
  if $! ~~ X::XC::NotLowered
  {
    note "$in:{.key}: {.value} is not lowered yet" for $!.problems;
    return False;
  }
  if $!
  {
    note "$in: {$!.message}";
    return False;
  }

  if $check
  {
    say "$in: ok";
  }
  else
  {
    spurt($out, $tlpp.encode('windows-1252'));
    say "$in -> $out";
  }
  True
}

# Paths on Windows: a folder ends at '\' as much as at '/', and a drive is
# 'D:'. rakupp's IO::Path knows only '/' -- 'D:\x\a.xtpl'.IO.basename is the
# whole path -- so xc takes such a path apart itself.
my $windows = $*DISTRO.is-win;
my $sep = $windows ?? '\\' !! '/';

# The file a path names, the same however the path is written: on Windows,
# whole, with '/' throughout and in lower case, as the system takes it.
sub file-key(Str $p --> Str)
{
  return $p.IO.absolute.Str unless $windows;
  my $s = $p.subst('\\', '/', :g);
  $s = $*CWD.Str.subst('\\', '/', :g).subst(/ '/' $ /, '') ~ '/' ~ $s unless $s ~~ / ^ [ <[a..zA..Z]> ':' ]? '/' /;
  $s.subst(/ '/' [ '.' '/' ]+ /, '/', :g).lc
}

# A source given twice -- itself and in its folder -- is compiled once.
@sources = @sources.unique(:as({ file-key($_) }));

# --outdir: every .tlpp into one folder, named for its source -- two sources
# of the same name would write the same file.
sub stem(Str $in --> Str)
{
  my $name = $windows ?? $in.split(/ <[\\/:]> /).tail !! $in.IO.basename;
  $name.subst(/ '.' <-[.]>* $ /, '')
}
with $outdir
{
  my %seen;
  for @sources -> $in
  {
    usage-error("$in and {%seen{stem($in).lc}}: both would be {stem($in)}.tlpp in $outdir") if %seen{stem($in).lc}:exists;
    %seen{stem($in).lc} = $in;
  }
  mkdir $outdir unless $check;
}

# Whether a line is a 'local' declaration whole, its comment aside. (A
# 'static' may come after a statement: Protheus takes it, file-wide.)
sub late-declaration(Str $text --> Bool)
{
  return False unless $text ~~ m:i/ ^ 'local' >> /;
  my $code = split-comment($text)[0].trim;
  my $*FURTHEST = 0;
  so try XC::Grammar.parse($code, :rule<declaration>)
}

my $failed = $missing;
for @sources -> $in
{
  my $out = $named-out // ($outdir.defined ?? $outdir.subst(/ <[\\/]>+ $ /, '') ~ $sep ~ stem($in) ~ '.tlpp'
                                            !! $in.subst(/ '.' <-[./\\]>* $ /, '') ~ '.tlpp');
  $failed++ unless compile($in, $out);
}

# A word at the end when there was more than one.
my $total = @sources + $missing;
if $total > 1
{
  my $done = $total - $failed;
  say "xc: $total files, $done {$check ?? 'checked ok' !! 'compiled'}{$failed ?? ", $failed failed" !! ''}";
}
exit($failed ?? 1 !! 0);
