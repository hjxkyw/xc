# xc -- compiles xtpl sources to TL++.
#
#   rakupp bin/xc file.xtpl                writes file.tlpp next to it
#   rakupp bin/xc file.xtpl out.tlpp       writes out.tlpp
#   rakupp bin/xc a.xtpl b.xtpl src/       each one next to itself -- a folder
#                                          stands for every .xtpl under it
#
#   --check             checks, and writes nothing: everything that would stop
#                       the compile is reported, the warnings too
#   --dict sx3.csv      checks the fields used against an exported SX3
#   --dict-strict       and what it finds is an error, not a warning
#
# A file that does not parse, that the checks refuse, or that uses what xc
# cannot lower yet gets no .tlpp, and the others go on; the exit code is 1 if
# any failed. Warnings are printed, and stop nothing.

use lib $*PROGRAM.IO.absolute.IO.parent.parent.add('lib').Str;
use XC::Grammar;
use XC::Actions;
use XC::Emit;
use XC::Check;
use XC::Source;

sub usage-error(Str $message)
{
  note $message;
  exit 2;
}

my $usage = "usage: rakupp bin/xc [--check] [--dict sx3.csv [--dict-strict]] file.xtpl [out.tlpp]\n"
          ~ "       rakupp bin/xc [--check] [--dict sx3.csv [--dict-strict]] file-or-folder ...";
my @args = @*ARGS;
my ($dict-path, $strict, $check) = Str, False, False;
my @given;
while @args
{
  my $a = @args.shift;
  if    $a eq '--dict'        { $dict-path = @args.shift // usage-error($usage) }
  elsif $a eq '--dict-strict' { $strict = True }
  elsif $a eq '--check'       { $check = True }
  elsif $a.starts-with('--')  { usage-error("$a: no such option\n$usage") }
  else                        { @given.push($a) }
}
usage-error($usage) unless @given;
usage-error("--dict-strict needs --dict") if $strict && !$dict-path.defined;
usage-error("$dict-path: no such file") if $dict-path.defined && !$dict-path.IO.f;

# 'file.xtpl out.tlpp': the one form with an output named. Anything else is a
# list of sources, a folder standing for every .xtpl under it.
my $named-out = @given == 2 && @given[1] ~~ m:i/ '.tlpp' $ / && !@given[1].IO.d ?? @given.pop !! Str;
usage-error("--check writes nothing: no output to name") if $check && $named-out.defined;
usage-error("$named-out: a .tlpp is named only for a single source") if $named-out.defined && @given[0].IO.d;

my %dictionary = $dict-path.defined ?? load-dictionary($dict-path) !! ();

sub sources-under(IO::Path $dir)
{
  $dir.dir.sort.map({ .d ?? |sources-under($_) !! (.extension.lc eq 'xtpl' ?? $_ !! Empty) })
}

my @sources;
my $missing = 0;
for @given -> $g
{
  if $g.IO.d
  {
    my @found = sources-under($g.IO);
    if @found { @sources.append(@found.map(~*)) }
    else      { note "$g: no .xtpl files in it"; $missing++ }
  }
  elsif $g.IO.f { @sources.push($g) }
  else          { note "$g: no such file"; $missing++ }
}

# One source: read, parsed, checked, lowered, and -- but with --check --
# written. What stops it is reported, and it returns False.
sub compile(Str $in, Str $out --> Bool)
{
  # Read as bytes, not with 'slurp': 'slurp' turns every "\r\n" into "\n", and
  # a CRLF source has to come out CRLF. UTF-8 when the bytes are valid UTF-8,
  # windows-1252 otherwise -- what Protheus sources are, when they are not
  # UTF-8 -- and the output goes back in the same encoding, with the same line
  # ends and the same byte-order mark, as xtpl does.
  my $bytes = $in.IO.slurp(:bin);
  my $encoding = 'utf-8';
  my $src = try $bytes.decode('utf-8');
  without $src
  {
    $encoding = 'windows-1252';
    $src = $bytes.decode('windows-1252');
  }
  my $bom = '';
  if $src.starts-with("\x[FEFF]")
  {
    $bom = "\x[FEFF]";
    $src = $src.substr(1);
  }

  # How far the parse got: the grammar records the end of every line it could
  # finish. The first line it could not is the one to show.
  my $*FURTHEST = 0;
  my $m = XC::Grammar.parse($src, actions => XC::Actions.new(source => $src));
  unless $m
  {
    # The mark is a match offset; XC::Source turns it into characters and lines.
    my $pos = XC::Source.new(text => $src);
    # Everything up to the end parsed, and the file still did not match: a
    # block was left open.
    unless $src.substr($pos.char($*FURTHEST)).trim
    {
      note "$in: the file ends inside a block that was never closed";
      return False;
    }
    my $line = $pos.line($*FURTHEST);
    note "$in:$line: cannot parse this line: {$src.lines[$line - 1].trim}";
    return False;
  }

  # What xtpl refuses although it parses -- scopes, <const>, the calls to this
  # file's functions, ... -- each with xtpl's message; and what it warns about,
  # a name nothing declares among them, which does not stop the compile.
  my %checked = check-all($m.made, lines => $src.lines.elems, :%dictionary, :$strict);
  note "$in:{.key}: warning: {.value}" for %checked<warnings>.list;
  if %checked<errors>
  {
    note "$in:{.key}: {.value}" for %checked<errors>.list;
    return False;
  }

  # Lowered with --check too: what xc cannot lower yet would stop the compile.
  my $tlpp = try emit($m.made, $src);
  if $! ~~ X::XC::NotLowered
  {
    note "$in:{.key}: {.value} is not lowered yet" for $!.problems;
    return False;
  }
  if $!
  {
    note "$in: {$!.message}";
    return False;
  }

  if $check
  {
    say "$in: ok";
  }
  else
  {
    spurt($out, ($bom ~ $tlpp).encode($encoding));
    say "$in -> $out";
  }
  True
}

my $failed = $missing;
for @sources -> $in
{
  my $out = $named-out // $in.subst(/ '.' <-[./\\]>* $ /, '') ~ '.tlpp';
  $failed++ unless compile($in, $out);
}

# A word at the end when there was more than one.
my $total = @sources + $missing;
if $total > 1
{
  my $done = $total - $failed;
  say "xc: $total files, $done {$check ?? 'checked ok' !! 'compiled'}{$failed ?? ", $failed failed" !! ''}";
}
exit($failed ?? 1 !! 0);
