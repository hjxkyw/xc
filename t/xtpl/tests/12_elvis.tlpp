#include "totvs.ch"
#include "tlpp-core.th"

// 12_elvis.tlpp -- the '?:' operator
//
// 'a ?: b' yields a when a is not Nil, otherwise b. The left side is bound to
// a temp first, so it is evaluated exactly once even though the result
// mentions it twice.
// --------------------------------------------------------------------------------

user function testElvis(oUser)

  Local cName
  Local cPick
  Local nPort
  Local cCity
  Local aItems

  Local et_0_0  // o valor testado por '?:'

  // Two operands: compact form.
  et_0_0 := lookupName(1)
  cName := If(et_0_0 != Nil, et_0_0, "anonymous")

  conout("name: " + cName)

  // Chained: each fallback runs only if the one before came back Nil.
  et_0_0 := firstChoice()

  If et_0_0 == Nil
    et_0_0 := secondChoice()
    If et_0_0 == Nil
      et_0_0 := thirdChoice()
      If et_0_0 == Nil
        et_0_0 := "last resort"
      EndIf
    EndIf
  EndIf

  cPick := et_0_0

  conout("pick: " + cPick)

  // The fallback can be any expression, including a call with arguments.
  et_0_0 := readPort()
  nPort := If(et_0_0 != Nil, et_0_0, defaultPort(8080))

  conout("port: " + cValToChar(nPort))

  // Combines with optional chaining: a missing object yields the fallback.
  et_0_0 := If(oUser != Nil, oUser:cCity, Nil)
  cCity := If(et_0_0 != Nil, et_0_0, "unknown")

  conout("city: " + cCity)

  // Works as a plain expression too, not only on the right of ':='.
  aItems := {}
  et_0_0 := loadItem(1)

  If et_0_0 == Nil
    et_0_0 := "placeholder"
  EndIf

  aadd(aItems,et_0_0)

  conout("items: " + cValToChar(len(aItems)))

  return cName

// --------------------------------------------------------------------------------
// the end