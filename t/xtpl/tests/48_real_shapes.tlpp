#include "totvs.ch"
#include "tlpp-core.th"

// 48_real_shapes.tlpp -- formas que só apareceram num arquivo de verdade.
//
// Um método com parâmetro tipado, o tipo depois do inicializador, e uma
// expressão avaliada na área de trabalho de outro alias. Nenhuma delas tinha
// surgido em setenta e cinco fixtures.
// --------------------------------------------------------------------------------

class MinhaTool
  public method process(jPayLoad as json) as json
endclass

method process(jPayLoad as json) as json class MinhaTool

  Local jResp as json
  Local nMoeda := 1 as numeric  // tipo depois do inicializador
  Local cAlias as character


  jResp := JsonObject():New()

  DbSelectArea("SC9")

  if SC9->(MsSeek(xFilial("SC9") + jPayLoad["numero"]))
    // dentro de ALIAS->( ... ) um nome solto é campo daquele alias
    if SA1->(MsSeek(xFilial("SA1") + SC9->(C9_CLIENTE + C9_LOJA)))
      jResp["cliente"] := alltrim(SA1->A1_NOME)
    endif
    nMoeda := SC9->C9_PRCVEN
  endif

  cAlias := "SC9"
  jResp["moeda"] := nMoeda + len(cAlias)

return jResp

// --------------------------------------------------------------------------------
// the end