#include "totvs.ch"
#include "tlpp-core.th"

// 37_chunkby.tlpp -- grouping consecutive elements by a key.
//
// It cuts the sequence where the key changes rather than gathering scattered
// matches, which is what lets it run in one pass holding only one group at a
// time. Over unsorted input it will return the same key more than once --
// this is not GROUP BY.
//
// A flag marks whether a group is open, rather than comparing the key against
// Nil: Nil is a legitimate key, and the first element has to open the first
// group either way.
// --------------------------------------------------------------------------------

user function testChunkby(aRows, cNum)

  Local aPedidos := {}
  Local aGrupos := {}
  Local aTamanhos := {}

  Local b_0_r        // o local de bloco 'r', fixado: tem armazenamento so dele
  Local fch_0_0      // o pedaco atual de um chunkby
  Local fch_1_0      // o pedaco atual de um chunkby
  Local fi_0_0       // o indice do percurso
  Local fky_0_0      // a chave do pedaco atual de um chunkby
  Local fky_1_0      // a chave do pedaco atual de um chunkby
  Local fo_0_0       // o resultado da cadeia
  Local fo_1_0       // o resultado da cadeia
  Local fop_0_0      // se ha um pedaco aberto (chunkby)
  Local fop_1_0      // se ha um pedaco aberto (chunkby)
  Local frc_1_0      // o registro em que a area estava antes do percurso
  Local fsn_0_0      // a chave vista nesta volta (chunkby)
  Local fsn_1_0      // a chave vista nesta volta (chunkby)
  Local fv_0_0       // o elemento em percurso
  Local fv_1_0       // o elemento em percurso
  Local pt_0_0       // o resultado de uma etapa que nao fundiu
  Local s_1_usearea  // o local de bloco 'usearea'
  Local s_1_useord   // o local de bloco 'useord'
  Local s_1_userec   // o local de bloco 'userec'

  // one stage on its own stays a call
  pt_0_0 := u_xtpl_chunkby(aRows, {|b_0_r| b_0_r:cPedido})
  aPedidos := pt_0_0

  // the header/detail walk: seek to the range, group by the key, one pass
  s_1_usearea := Alias()
  DbSelectArea("SC6")
  s_1_userec := SC6->(RecNo())
  s_1_useord := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    frc_1_0 := SC6->(RecNo())
    SC6->(DbSeek(xFilial("SC6") + cNum))
    fch_1_0 := {}
    fky_1_0 := Nil
    fop_1_0 := .F.
    fsn_1_0 := Nil
    fo_1_0 := {}
    While !SC6->(Eof())
      fv_1_0 := {SC6->C6_NUM, SC6->C6_PRODUTO}
      fsn_1_0 := fv_1_0[1]
      If !fop_1_0
        fop_1_0 := .T.
        fky_1_0 := fsn_1_0
      ElseIf !(fsn_1_0 == fky_1_0)
        AAdd(fo_1_0, fch_1_0)
        fch_1_0 := {}
        fky_1_0 := fsn_1_0
      EndIf
      AAdd(fch_1_0, fv_1_0)
      SC6->(DbSkip())
    EndDo
    If fop_1_0
      AAdd(fo_1_0, fch_1_0)
    EndIf
    SC6->(DbGoto(frc_1_0))
    aGrupos := fo_1_0

  SC6->(DbSetOrder(s_1_useord))
  SC6->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

  // the key block reads the mapped value, not the record: after a map the
  // element is whatever the map produced
  fch_0_0 := {}
  fky_0_0 := Nil
  fop_0_0 := .F.
  fsn_0_0 := Nil
  fo_0_0 := {}

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:cPedido
    fsn_0_0 := fv_0_0
    If !fop_0_0
      fop_0_0 := .T.
      fky_0_0 := fsn_0_0
    ElseIf !(fsn_0_0 == fky_0_0)
      AAdd(fo_0_0, fch_0_0)
      fch_0_0 := {}
      fky_0_0 := fsn_0_0
    EndIf
    AAdd(fch_0_0, fv_0_0)
  Next

  If fop_0_0
    AAdd(fo_0_0, fch_0_0)
  EndIf

  aTamanhos := fo_0_0

  return len(aPedidos) + len(aGrupos) + len(aTamanhos)

// --------------------------------------------------------------------------------
// the end