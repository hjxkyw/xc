// A type from another: its fields after the other's, at their places; the
// other's methods; a value of it wherever one of the other goes.
type Item
  cCod <const> as Character
  nQtd as Numeric := 1
  nPreco as Numeric

  method Total() as Numeric
  Return .nQtd * .nPreco
endtype

type Line from Item
  nDesc as Numeric
  aTags as Array<c>

  method Net() as Numeric
  Return .Total() - .nDesc

  method Tag(cTag as Character) as Line
    AAdd(.aTags, cTag)
  Return Self
endtype

type Rush from Line
  lRush as Logical := .T.
endtype

Static Function Value(eIt as Item)
Return eIt.Total()

User Function Main()
  Local eLn := Line("A", 2, 10, nDesc => 3)
  Local eRu := Rush("B", nPreco => 4, nDesc => 1)
  Local aAll := { <Item> }
  AAdd(aAll, eLn)
  AAdd(aAll, eRu)
  AAdd(aAll, Item("C", nPreco => 1))
  eLn.nQtd += 1
  eRu.Tag("x").Tag("y")
  ConOut(eLn.Net(), Value(eLn), eRu.Net(), Len(eRu), eRu.lRush, Len(eRu.aTags), eRu.aTags[2])
  ConOut(aAll |> map([it] it.Total()) |> map([n] cValToChar(n)) |> join(","))
  ConOut(Len(eLn), eLn[1], eLn[4], ValType(eRu?.nDesc), eRu?.Net())
Return Nil
