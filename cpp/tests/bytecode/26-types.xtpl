// Types: arrays whose positions have names -- fields read and written,
// methods as static functions, values made by place and by name, what a
// field starts at, typed arrays and hashes of them, lambdas and code blocks
// walking them, '?.'.
type Item
  cCod <const> as Character
  nQtd as Numeric := 1
  nPreco as Numeric
  aTags as Array<c>

  method Total() as Numeric
  Return .nQtd * .nPreco

  method Add(nMais as Numeric) as Item
    .nQtd += nMais
    AAdd(Self.aTags, "+" + cValToChar(nMais))
  Return Self
endtype

type Order
  cId as Character
  aItems as Array<Item>
  hNotes as Hash<c, c>

  method Total() as Numeric
    Local nSum := 0
    for eIt in .aItems exec nSum += eIt.Total()
  Return nSum

  method Biggest() as Item
  Return .aItems |> maxby([it] it.Total())
endtype

User Function Main()
  Local eOrd := Order("P1")
  Local eIt := Item("A", nPreco => 2.5)
  Local eNone as Item
  AAdd(eOrd.aItems, eIt)
  AAdd(eOrd.aItems, Item("B", 3, 10))
  AAdd(eOrd.aItems, Item(nPreco => 1, cCod => "C"))
  eOrd.aItems[1].Add(3).Add(1)
  eOrd.aItems[2].nQtd++
  eOrd.hNotes{"rush"} := "yes"
  ConOut(eOrd.cId, Len(eOrd.aItems), eOrd.Total(), eOrd.Biggest().cCod, eOrd.hNotes{"rush"})
  ConOut(eIt.nQtd, Len(eIt.aTags), eIt.aTags[2], eIt.Total())
  ConOut(eOrd.aItems |> filter([it] it.nQtd > 1) |> map([it] it.cCod) |> join(","))
  ASort(eOrd.aItems,,, {|a, b| a.Total() < b.Total()})
  AEval(eOrd.aItems, {|it| ConOut(it.cCod + " " + cValToChar(it.Total()))})
  ConOut(ValType(eIt), Len(eIt), eIt[2], ValType(eNone?.nQtd), eIt?.Total())
Return Nil
