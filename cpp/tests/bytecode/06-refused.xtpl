// What cannot become bytecode yet: xc says so, and writes no .xbc.
#include "totvs.ch"

Class Conta
  Data nSaldo
  Method New() Constructor
EndClass

Method New() Class Conta
  ::nSaldo := 0
Return Self

User Function Refused(aNums)
  Local nTotal := 0
  raw @ 10, 5 SAY "Total"
  ConOut(aNums[1], @aNums[2])
Return nTotal
