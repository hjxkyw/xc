// Decimals with the DEC_ functions, as for TL++: a literal that meets one is
// DEC_CREATE of its text, an operator the DEC_ function, a Decimal that goes
// into a number DEC_TO_DBL of it, Empty() of one a comparison with 0.
User Function Main()
  Local fPreco := 40.1 as Decimal
  ConOut(Total(fPreco), Empty(fPreco), Empty(fPreco - fPreco))
Return Nil

Static Function Total(fPreco as Decimal)
  Local fTotal := 0 as Decimal
  Local fTaxa := 0.05 as Decimal
  Local nAprox as Numeric
  fTotal := fPreco * 3 + 1.5
  fTotal += fTotal * fTaxa
  fTotal++
  If fTotal > 100
    fTotal := Round(fTotal - 10, 2)
  EndIf
  nAprox := fTotal
Return nAprox
