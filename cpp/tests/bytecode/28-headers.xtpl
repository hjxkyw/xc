// Types from headers (.xth): those of a header and of the header it
// includes -- once, though both are included --, a type of the file's from
// one of theirs, and a header's #define.
#include "28-lines.xth"
#include "28-headers.xth"

type Sale from Line
  cWho as Character
endtype

Static Function Value(eIt as Item)
Return eIt.Total()

User Function Main()
  Local eLn := Line("A", 2, 10, nDesc => 3)
  Local eSa := Sale("B", nPreco => 4, nDesc => 1, cWho => "me")
  eLn.nQtd++
  ConOut(eLn.Net(), Value(eLn), eSa.Net(), eSa.cWho, Len(eSa), HEADERS_MAX)
  ConOut(Item("C", 2, 5).Total(), eSa?.Total())
Return Nil
