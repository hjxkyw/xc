// Ways out: 'defer', Begin Sequence and Break, errors, Try, 'fallback' --
// and an 'exit' or a 'return' from inside them. ('using alias' is 12-areas'.)
User Function Main()
  Local nGot := 0
  Local oErr
  Local bOld

  ConOut("-- defer")
  ConOut(Deferred(.F.))
  ConOut(Deferred(.T.))
  ConOut(InLoop())

  ConOut("-- sequences")
  Begin Sequence
    ConOut("before")
    Break "a reason"
    ConOut("not shown")
  Recover Using oErr
    ConOut("recovered: " + oErr)
  End Sequence
  Begin Sequence
    Deep(3)
  Recover Using oErr
    ConOut("from deep: ${oErr}")
  End Sequence
  For nGot := 1 To 5
    Begin Sequence
      Exit if nGot == 3
      ConOut("round ${nGot}")
    End Sequence
  Next
  ConOut("after the loop: ${nGot}")

  ConOut("-- errors")
  bOld := ErrorBlock({|e| Break(e)})
  Begin Sequence
    nGot := 1 + Space(1)
  Recover Using oErr
    ConOut("caught: " + oErr:Description)
  End Sequence
  ErrorBlock(bOld)
  Try
    nGot := {}[2]
  Catch oErr
    ConOut("try caught: " + oErr:Description)
  Finally
    ConOut("finally")
  EndTry
  ConOut(Guarded(), (Undefined() fallback "fell back"), (Twice(4) fallback 0))
Return Nil

// A defer runs at every return after it was reached, the last first.
Static Function Deferred(lEarly)
  Local cLog := "start"
  defer ConOut("first deferred, log " + cLog)
  If lEarly
    defer ConOut("only when early")
    cLog := "early"
    Return "returned early"
  EndIf
  cLog := "late"
Return "returned late"

// Reached many times, it runs once.
Static Function InLoop()
  Local nI
  For nI := 1 To 3
    defer ConOut("loop defer, nI = ${nI}")
  Next
Return "loop done"

Static Function Deep(nN)
  If nN == 0
    Break "the bottom"
  EndIf
  Deep(nN - 1)
Return Nil

// An error the AppServer raises too: 10 / 0 is 0 there.
Static Function Guarded()
  Local nX := 0
  Local aNone := {}
  nX := aNone[nX + 1] fallback -1
Return nX

Static Function Twice(nN)
Return nN * 2
