# The runtime's functions in the interpreter's table of the AppServer's
# well-known functions (interp/xbc.xtpl, XbcSyscalls()): a call of each User
# Function of runtime/xtpl_runtime.tlpp, of each public method of its
# classes and of each constructor, for each number of arguments up to its
# own -- one of them reads PCount() --, between the lines
# '// >>> the runtime's' and '// <<< the runtime's'. ctest's interp checks
# them; after a change of the runtime's functions, write them again:
#
#   cmake -DROOT=. -DUPDATE=1 -P cpp/tests/runtime-calls.cmake

cmake_policy(SET CMP0054 NEW)
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
set(table ${ROOT}/interp/xbc.xtpl)
file(STRINGS ${ROOT}/runtime/xtpl_runtime.tlpp heads
     REGEX "^([Uu][Ss][Ee][Rr] +[Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn] |[Cc][Ll][Aa][Ss][Ss] | +[Pp][Uu][Bb][Ll][Ii][Cc] +[Mm][Ee][Tt][Hh][Oo][Dd] )")
set(calls "")
set(class "")
foreach(head ${heads})
  string(REPLACE "\r" "" head "${head}")
  if(head MATCHES "^[Cc][Ll][Aa][Ss][Ss] +([A-Za-z0-9_]+)")
    set(class ${CMAKE_MATCH_1})
    continue()
  endif()
  if(NOT head MATCHES "^ *[A-Za-z]+ +[A-Za-z]+ +([A-Za-z0-9_]+)\\(([^)]*)\\)( +[Cc][Oo][Nn][Ss][Tt][Rr][Uu][Cc][Tt][Oo][Rr])?")
    message(FATAL_ERROR "  runtime/xtpl_runtime.tlpp: no name and parameters in '${head}'")
  endif()
  set(name ${CMAKE_MATCH_1})
  set(ctor "${CMAKE_MATCH_3}")
  string(REGEX REPLACE "[ \t]" "" params "${CMAKE_MATCH_2}")
  set(count 0)
  if(NOT params STREQUAL "")
    string(REGEX MATCHALL "," commas "${params}")
    list(LENGTH commas count)
    math(EXPR count "${count} + 1")
  endif()
  string(TOUPPER ${name} upper)
  string(TOUPPER "${class}" upclass)
  foreach(n RANGE 0 ${count})
    set(args "")
    if(n GREATER 0)
      foreach(k RANGE 1 ${n})
        if(k GREATER 1)
          string(APPEND args ", ")
        endif()
        string(APPEND args "a[${k}]")
      endforeach()
    endif()
    if(NOT head MATCHES "^ ")
      string(APPEND calls "  AAdd(aT, {\"f:U_${upper}/${n}\", {|o, a| u_${name}(${args})}})\n")
    elseif(ctor STREQUAL "")
      string(APPEND calls "  AAdd(aT, {\"m:${upper}/${n}\", {|o, a| o:${name}(${args})}})\n")
    else()
      string(APPEND calls "  AAdd(aT, {\"n:${upclass}:${upper}/${n}\", {|o, a| ${class}():${name}(${args})}})\n")
    endif()
  endforeach()
endforeach()

set(open "  // >>> the runtime's\n")
set(close "  // <<< the runtime's\n")
file(READ ${table} text)
string(REPLACE "\r\n" "\n" text "${text}")
string(FIND "${text}" "${open}" from)
string(FIND "${text}" "${close}" to)
if(from EQUAL -1 OR to EQUAL -1 OR to LESS from)
  message(FATAL_ERROR "  interp/xbc.xtpl: no lines '// >>> the runtime's' and '// <<< the runtime's' in XbcSyscalls()")
endif()
string(LENGTH "${open}" skip)
math(EXPR start "${from} + ${skip}")
math(EXPR length "${to} - ${start}")
string(SUBSTRING "${text}" ${start} ${length} have)
if(have STREQUAL calls)
  return()
endif()
if(UPDATE)
  string(SUBSTRING "${text}" 0 ${start} before)
  string(SUBSTRING "${text}" ${to} -1 after)
  file(WRITE ${table} "${before}${calls}${after}")
  message("  interp/xbc.xtpl: the runtime's calls written again")
else()
  message(FATAL_ERROR "  interp/xbc.xtpl: the runtime's calls in XbcSyscalls() are not runtime/xtpl_runtime.tlpp's; "
                      "write them again: cmake -DROOT=. -DUPDATE=1 -P cpp/tests/runtime-calls.cmake")
endif()
