#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP, cK)
  local x := 0
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fok_0_0 := File(cP)
  If fok_0_0
    FT_FUse(cP)
    FT_FGoTop()
  EndIf
  fo_0_0 := .T.
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    If !(empty(fv_0_0))
      If !(len(fv_0_0) > 3)
        fo_0_0 := .F.
        Exit
      EndIf
    EndIf
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  x := fo_0_0
return x
