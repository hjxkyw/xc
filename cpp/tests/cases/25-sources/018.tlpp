#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP, cK)
  local x := 0
  Local cL  // a block local
  Local nN  // a block local
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened
  fs_0_0 := cP
  fok_0_0 := File(fs_0_0)
  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf
  nN := 0
  While fok_0_0 .And. !FT_FEof()
    nN++
    cL := FT_FReadLn()
    FT_FSkip()
    If empty(cL)
      loop
    EndIf
    x := x + nN
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
return x
