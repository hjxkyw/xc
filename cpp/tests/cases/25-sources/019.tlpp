#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP, cK)
  local x := 0
  Local cL  // a block local
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened
  fs_0_0 := cP
  fok_0_0 := File(fs_0_0)
  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf
  While fok_0_0 .And. !FT_FEof()
    cL := FT_FReadLn()
    FT_FSkip()
    if empty(cL)
      If fok_0_0
        FT_FUse()
      EndIf
      return 0
    endif
    If cL = "x"
      If fok_0_0
        FT_FUse()
      EndIf
      return 1
    EndIf
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
return x
