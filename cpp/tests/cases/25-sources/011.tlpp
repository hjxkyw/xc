#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP, cK)
  local x := 0
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fo_0_0  // what a loop collected, for the stages after it
  Local fs_0_0  // the array walked
  Local fi_0_0  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  fok_0_0 := File(cP)
  If fok_0_0
    FT_FUse(cP)
    FT_FGoTop()
  EndIf
  fo_0_0 := {}
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    fv_0_0 := upper(fv_0_0)
    AAdd(fo_0_0, fv_0_0)
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  fs_0_0 := u_xtpl_sort(fo_0_0)
  fo_0_1 := {}
  For fi_0_0 := 1 To Len(fs_0_0)
    fv_0_1 := fs_0_0[fi_0_0]
    If !empty(fv_0_1)
      AAdd(fo_0_1, fv_0_1)
    EndIf
  Next
  x := fo_0_1
return x
