#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP, cK)
  local x := 0
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fo_0_0  // what a loop collected, for the stages after it
  fok_0_0 := File(cP)
  If fok_0_0
    FT_FUse(cP)
    FT_FGoTop()
  EndIf
  fo_0_0 := {}
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    fv_0_0 := upper(fv_0_0)
    AAdd(fo_0_0, fv_0_0)
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  save(u_xtpl_sort(fo_0_0))
return x
