#include "totvs.ch"
#include "tlpp-core.th"

// A name declared with a type: TL++ will not compare it with Nil, so '?:',
// '?.' and '?=' ask ValType().
user function typed(nIn as numeric, oIn)
  local nX as numeric
  local oJ as object
  local nA := If(ValType(nX) != "U", nX, 5)
  local cB := If(ValType(oJ) != "U", oJ:GetJsonText("a"), Nil)
  local nC := If(ValType(nIn) != "U", nIn, 7)
  local cD := If(oIn != Nil, oIn:cName, Nil)
  If ValType(nX) == "U"
    nX := 3
  EndIf
  If oIn == Nil
    oIn := nil
  EndIf
  nA := (nX >= 1 .And. nX <= 9)
  static sY := If(ValType(nX) != "U", nX, 1)
return {nA, cB, nC, cD, nX, oIn, sY}
