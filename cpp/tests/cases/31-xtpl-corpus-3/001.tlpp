#include "totvs.ch"
#include "tlpp-core.th"

// xc_selftest.xtpl -- runs, in Protheus, what xc added to xtpl.
//
// xtpl's 54_selftest.xtpl runs what xtpl's fixtures only compile; this is its
// companion for what xc brought: fusion over arrays and the stages it fuses,
// a loop that starts again after a stage that cannot fuse, aPick, aRoll and
// setMaxRoll, digit separators, hash writes inside expressions, chains as a
// private's value and under a postfix modifier, a defer that runs only if it
// was reached, the temps xc writes around the source's own code, each value
// of '?:', '?.' and 'in lo..hi' evaluated once, 'fallback' as a statement's
// whole value, verbs written as calls as loops, Clipper's comments, a name
// that starts with '__', 'End For' and '%exp:x%' outside BeginSql. Pure
// computation, as 54 is: no table, no file, no screen, so a right or wrong
// answer and not an environment.
//
// Compile it with runtime/xtpl_runtime.tlpp and call u_xc_selftest(): it
// prints a line per failure and a total, and returns how many failed.
//
//   xc_selftest: 99 ok, 0 failed
//
// 'rakupp run-protheus.raku' does all of that, for this and for 54.
// -----------------------------------------------------------------------------

user function xc_selftest()
  local nOk := 0
  local nBad := 0
  local aNums := {3, 1, 4, 1, 5, 9, 2, 6}
  local aRep := {1, 1, 2, 2, 2, 3, 1}
  local aPal := {"beta", "alfa", "gama"}
  local aDist := {10, 20, 30, 40, 50, 60, 70, 80}
  local aPeople := {{"ana", 30}, {"bia", 25}, {"caio", 30}}
  local aPairs := {{"x", 10}, {"y", 20}}
  local hCount := THashMap():New()
  local hMap := u_xtpl_hnew({{"a", 1}})
  local hKeep := THashMap():New()
  local jTmp := JsonObject():New()
  local aTmp := {}
  local aBig := {}
  local aSeen := {}
  local aCalls := {}
  local nTmp := 0
  local nSeen := 0
  local nOld := 0
  local cTmp := ""
  local lTmp := .F.
  local jKeys := u_xtpl_jnew({{"a", "x"}, {"v5", "cinco"}})
  local __v := 5            && a name that starts with '__', and a Clipper comment
  Local fbv_0_0  // a value read twice by '?.' or 'in lo..hi', evaluated once
  local bHi := {|x| iif(((fbv_0_0 := same(x)) >= 1 .And. fbv_0_0 <= 5), 10, 20)}
  local bOld
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
