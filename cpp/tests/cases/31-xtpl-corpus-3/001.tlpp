  Local fs_0_7  // the array walked
  Local fi_0_34  // the position in the array walked
  Local fv_0_34  // the element walked
  Local et_0_0  // the left side of a '?:', evaluated once
  Local fi_0_35  // the counter of a range
  Local fv_0_35  // the element walked
  Local fo_0_32  // the result of the chain
  Local fi_0_36  // the position in the array walked
  Local fv_0_36  // the element walked
  Local fo_0_33  // the result of the chain
  Local fi_0_37  // the counter of a 'for ... times'
  Local fi_0_38  // the position in the array walked
  Local fv_0_37  // the element walked
  Local fo_0_34  // the result of the chain
  Local fi_0_39  // the position in the array walked
  Local fv_0_38  // the element walked
  Local fo_0_35  // the result of the chain
  Local s_0_0  // a slot: the block locals 'nFill', 'xFresh'
  Local b_1_nKept  // the block local 'nKept'
  Local b_2_nKept  // the block local 'nKept'
  Local fbv_0_1  // a value read twice by '?.' or 'in lo..hi', evaluated once
  Local fbv_0_2  // a value read twice by '?.' or 'in lo..hi', evaluated once
  Local gt_0_0  // the error block a 'fallback' sets aside
  Local fi_0_40  // the position in the array walked
  Local fv_0_39  // the element walked
  Local fo_0_36  // the result of the chain
  Local fi_0_41  // the position in the array walked
  Local fv_0_40  // the element walked
  Local fo_0_37  // the result of the chain
  Local ht_0_0  // the value of a 'fallback', before it is assigned
  Local fi_0_42  // the position in the array walked
  Local fv_0_41  // the element walked
  Local fo_0_38  // the result of the chain
  Local fi_0_43  // the position in the array walked
  Local fv_0_42  // the element walked
  Local fo_0_39  // the result of the chain
  Local fi_0_44  // the position in the array walked
  Local fv_0_43  // the element walked
  Local fo_0_40  // the result of the chain
  Local fi_0_45  // the position in the array walked
  Local fv_0_44  // the element walked
  Local ffs_0_0  // the values distinct has seen
  Local fo_0_41  // the result of the chain
  Local fs_0_8  // the array walked
  Local fi_0_46  // the position in the array walked
  Local fv_0_45  // the element walked
  Local ffs_0_1  // the values distinct has seen
  Local fo_0_42  // the result of the chain
  Local fi_0_47  // the position in the array walked
  Local fv_0_46  // the element walked
  Local ffs_0_2  // the values distinct has seen
  Local fn_0_4  // how many elements have passed
  Local fo_0_43  // the result of the chain
  Local fs_0_9  // the array walked
  Local fi_0_48  // the position in the array walked
  Local fv_0_47  // the element walked
