#include "totvs.ch"
#include "tlpp-core.th"

// defined_or_expression.xtpl -- '?=' onde só '?:' serve.
//
// '?=' atribui a uma variável e só existe como comando isolado. Dentro de uma
// expressão nada o reescrevia, e ele chegava à saída como estava, que não é
// AdvPL.
// -----------------------------------------------------------------------------

user function definedOrExpression(cAlvo)

  Local fs_0_0  // the array walked
  Local et_0_0  // the left side of a '?:', evaluated once
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  fs_0_0 := If(ValType(et_0_0 := PtInternal(12, "COVERAGE")) != "U", et_0_0, {})
  For fi_0_0 := 1 To Len(fs_0_0)
    fv_0_0 := fs_0_0[fi_0_0]
    VarInfo("X", fv_0_0)
  Next

  return

// -----------------------------------------------------------------------------
// the end
