#include "totvs.ch"
#include "tlpp-core.th"

// feed_in_block.xtpl -- a chain inside a code block is refused.
//
// The block's body runs later. Lifting a stage into a statement ahead of the
// line would run it now, so there is no correct place to put it.
// -----------------------------------------------------------------------------

user function feedInBlock(aNums)
  local aOut := {}
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain

  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aNums)
    fv_0_0 := aNums[fi_0_0]
    fv_0_0 := triple(fv_0_0)
    AAdd(fo_0_0, fv_0_0)
  Next
  aOut := fo_0_0

  return aOut

// -----------------------------------------------------------------------------
// the end
