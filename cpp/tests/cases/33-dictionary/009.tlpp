#include "totvs.ch"
#include "tlpp-core.th"

user function f(cAl)
  local x := 0
  Local fal_0_0  // the alias of the area walked
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fal_0_0 := cAl
  far_0_0 := Alias()
  DbSelectArea(fal_0_0)
  frc_0_0 := (fal_0_0)->(RecNo())
  (fal_0_0)->(DbGoTop())
  fo_0_0 := {}
  While !(fal_0_0)->(Eof())
    fv_0_0 := (fal_0_0)->A1_NMOE
    AAdd(fo_0_0, fv_0_0)
    (fal_0_0)->(DbSkip())
  EndDo
  (fal_0_0)->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  x := fo_0_0
return x
