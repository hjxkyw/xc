#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, aH, aC)
  Local fdf_0_0 := .F.  // whether 'defer conout(nD)' was reached
  Local nD  // a block local
  Local nS  // a block local
  if a > 0
    nD := 1
    fdf_0_0 := .T.
  endif
  if a > 1
    nS := 1
    conout(nS)
  endif
  If fdf_0_0
    conout(nD)
  EndIf
return a
