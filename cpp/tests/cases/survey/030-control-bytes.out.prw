#include "protheus.ch"

// A control byte in a comment -- 0x01 in the corners of a DOS-era boxed
// header -- is the source's, kept as it came (117 of the survey's sources,
// Rafa-custodio/ADVPL-fontes and others).
User Function Boxed()
  Local nLin := 1
  //ÚÄÄÄÄÄÄÄÄÄÄ¿
  //³ Imprime ³
  //ÀÄÄÄÄÄÄÄÄÄÄÙ
  nLin += 1
Return nLin
