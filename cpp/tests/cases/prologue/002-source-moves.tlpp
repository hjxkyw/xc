#include "totvs.ch"
#include "tlpp-core.th"

// A chain from a source has no calls to be: its declaration, and those after
// it, give their values after the prologue, in order.
user function moves(nTop)
  local nOne := 1
  local nSum
  local nTwo
  Local fi_0_0  // the counter of a range
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fo_0_0 := 0
  For fi_0_0 := 1 To nTop
    fv_0_0 := fi_0_0
    fv_0_0 := fv_0_0 * fv_0_0
    fo_0_0 := fo_0_0 + fv_0_0
  Next
  nSum := fo_0_0
  nTwo := 2
return nOne + nSum + nTwo
