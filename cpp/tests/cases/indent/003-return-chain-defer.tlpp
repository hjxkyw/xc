#include "totvs.ch"
#include "tlpp-core.th"

// A 'return' whose value is a chain, after a defer: the defer runs first, as
// at any 'return', then the loop for the value.
user function total(aItens)
  local nSoma := 0
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  fo_0_0 := 0
  For fi_0_0 := 1 To Len(aItens)
    fv_0_0 := aItens[fi_0_0]
    If fv_0_0 > 0
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
  Next
  nSoma := fo_0_0
  conout(nSoma)
  conout("fim")
  fo_0_1 := 0
  For fi_0_1 := 1 To Len(aItens)
    fv_0_1 := aItens[fi_0_1]
    fv_0_1 := fv_0_1 * 2
    fo_0_1 := fo_0_1 + fv_0_1
  Next
return fo_0_1

user function nested(aItens, lTwo)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  if lTwo
    conout("fim")
    fo_0_0 := 0
    For fi_0_0 := 1 To Len(aItens)
      fv_0_0 := aItens[fi_0_0]
      fv_0_0 := fv_0_0 * 2
      fo_0_0 := fo_0_0 + fv_0_0
    Next
    return fo_0_0
  endif
  conout("fim")
return 0
