// A 'return' at the first column ends the function, as xtpl writes it: what
// xc puts before it -- a defer, at the natural end and at a 'return' -- goes
// with the body's lines.
user function total(aItens)
  local nSoma := 0
  defer conout("fim")
  nSoma := asum(aItens)
return nSoma

user function early(lStop)
  local nH := 1
  defer conout(nH)
  if lStop
    return -1
  endif
  nH := 2
return nH
