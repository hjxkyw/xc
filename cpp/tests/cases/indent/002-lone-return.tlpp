#include "totvs.ch"
#include "tlpp-core.th"

// A function whose body is only its 'return': the Locals and the loop for
// its value at two blanks, the 'return' where it is.
user function dobro(aItens)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aItens)
    fv_0_0 := aItens[fi_0_0]
    fv_0_0 := fv_0_0 * 2
    If fv_0_0 > 10
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
return fo_0_0

static function soma(aItens)
return u_xtpl_asum(aItens)
