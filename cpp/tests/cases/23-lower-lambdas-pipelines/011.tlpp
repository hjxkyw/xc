#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, b, o, aP)
  local x := 0
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local ffs_0_0  // the values distinct has seen
  Local fo_0_0  // the result of the chain
  ffs_0_0 := THashMap():New()
  fo_0_0 := 0
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    If !u_xtpl_seen(ffs_0_0, fv_0_0)
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
  Next
  x := fo_0_0
return x
