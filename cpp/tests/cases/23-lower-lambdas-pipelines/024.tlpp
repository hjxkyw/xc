#include "totvs.ch"
#include "tlpp-core.th"
user function f(a)
  local x := u_xtpl_asum(u_xtpl_filter(a, {|o| o > 1}))  // n
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_0  // the result of the chain
  For fi_0_0 := 1 To Len(aP)
    fv_0_0 := aP[fi_0_0]
    conout(fv_0_0)
  Next
fo_0_0 := {}
For fi_0_1 := 1 To Len(a)
  fv_0_1 := a[fi_0_1]
  fv_0_1 := fv_0_1 * 2
  AAdd(fo_0_0, fv_0_1)
Next
return fo_0_0
