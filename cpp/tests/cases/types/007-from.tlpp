#include "totvs.ch"
#include "tlpp-core.th"

// A type from another: its fields after the other's, the other's methods.
// type Item: an array of 3
#define Item_cCod 1  // [const]
#define Item_nQtd 2
#define Item_nPreco 3

Static Function Item_Total(eSelf as Array) as Numeric
Return eSelf[Item_nQtd] * eSelf[Item_nPreco]
// end type

// type Line from Item: an array of 5
#define Line_nDesc 4
#define Line_aTags 5

Static Function Line_Net(eSelf as Array) as Numeric
Return Item_Total(eSelf) - eSelf[Line_nDesc]
// endtype

Static Function Sum(eIt as Array)
Return Item_Total(eIt)

User Function Lines()
  Local eLn := {"A", 2, 10, 3, {}}
  Local aAll := {}
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  AAdd(aAll, eLn)
  AAdd(aAll, {"B", 1, 1})
  eLn[Item_nQtd] += 1
  eLn[Line_nDesc] := 1
  ConOut(Line_Net(eLn), Sum(eLn), Item_Total(eLn), Len(aAll))
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aAll)
    fv_0_0 := aAll[fi_0_0]
    fv_0_0 := Item_Total(fv_0_0)
    AAdd(fo_0_0, fv_0_0)
  Next
return fo_0_0
