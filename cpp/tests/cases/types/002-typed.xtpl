// A type as a type: of Locals, Statics, parameters, returns, a class's
// Data, another type's field, a typed array's and hash's; what xc knows a
// value to be of -- the elements walked, a lambda's and a code block's
// parameter --; '?.'.
type Customer
  cName as Character
  aTags as Array<c>
endtype

type Order
  cId as Character
  eCli as Customer := Customer("anon")
  aLines as Array<Line>
  hBy as Hash<c, Customer>

  method Who() as Character
  Return .eCli.cName

  method Cli() as Customer
  Return .eCli
endtype

type Line
  cCod as Character
  nQtd as Numeric
endtype

Static eFirst := Order("F")

Class Shop
  Data eLast as Order
  Method New() Constructor
  Method Last() as Order
EndClass

Method New() Class Shop
  ::eLast := Order("X")
Return Self

Method Last() Class Shop as Order
Return ::eLast

Static Function Mk(cId as Character) as Order
Return Order(cId)

User Function Typed(eIn as Order, aMany as Array<Order>)
  Local oShop := Shop():New()
  Local aOrders := { <Order> }
  Local aBig
  Local eKept as Order
  eIn.hBy{"x"} := Customer("y")
  ConOut(eIn.hBy{"x"}.cName, oShop:Last().Who(), eFirst.eCli.cName, Mk("M").Cli().cName)
  AAdd(aOrders, Mk("A"))
  ASort(aOrders,,, {|a, b| a.cId < b.cId})
  AEval(aOrders, {|o| ConOut(o.cId)})
  aBig := aMany |> filter([o] Len(o.aLines) > 1) |> map([o] o.cId)
  for eO in aMany exec AAdd(eO.eCli.aTags, "seen")
  eKept := aMany[1]
  ConOut(eIn?.Cli()?.cName)
  eKept := Nil
Return eIn?.eCli?.cName
