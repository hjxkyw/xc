#include "totvs.ch"
#include "tlpp-core.th"

// A type: its fields' positions as #defines, its methods as static
// functions, values made by place, by name, and with what fields start at.
// type Item: an array of 9
#define Item_cCod 1  // [const] -- the product
#define Item_nQtd 2
#define Item_nPreco 3
#define Item_lOk 4
#define Item_cNote 5
#define Item_dWhen 6
#define Item_aTags 7
#define Item_hSeen 8
#define Item_xAny 9

Static Function Item_Total(eSelf as Array) as Numeric
Return eSelf[Item_nQtd] * eSelf[Item_nPreco]

Static Function Item_Add(eSelf as Array, nMais as Numeric) as Array
  Local nWas := eSelf[Item_nQtd]
  eSelf[Item_nQtd] += nMais
  eSelf[Item_aTags] := {}
  AAdd(eSelf[Item_aTags], cValToChar(nWas))
Return eSelf

Static Function Item_Clear(eSelf as Array)
  eSelf[Item_nQtd] := 0
Return Item_Total(eSelf)
// end type

User Function Fields(cCod as Character)
  Local eIt := {cCod, 1, 2.5, .F., "", Nil, {}, THashMap():New(), Nil}
  Local eAll := {"B", 1, 10, .T., "x", Date(), {"a"}, u_xtpl_hnew({{"k", 1}}), Nil}
  Local eNone := {"", 1, 0, .F., "", Nil, {}, THashMap():New(), Nil}
  Item_Add(Item_Add(eIt, 3), 1)
  eIt[Item_nQtd]++
  eAll[Item_nPreco] *= 2
  ConOut(Item_Total(eIt), Item_Clear(eAll), Len(eNone), eIt[Item_nQtd])
Return eIt[Item_aTags][1]
