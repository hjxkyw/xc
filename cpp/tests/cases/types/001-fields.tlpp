#include "totvs.ch"
#include "tlpp-core.th"

// A type: its fields' positions as #defines, its methods as static
// functions, values made by place, by name, and with what fields start at.
// type Item: an array of 9
#define Item_cCod 1  // [const] -- the product
#define Item_nQtd 2
#define Item_nPreco 3
#define Item_lOk 4
#define Item_cNote 5
#define Item_dWhen 6
#define Item_aTags 7
#define Item_hSeen 8
#define Item_xAny 9

Static Function Item_Total(aSelf as Array) as Numeric
Return aSelf[Item_nQtd] * aSelf[Item_nPreco]

Static Function Item_Add(aSelf as Array, nMais as Numeric) as Array
  Local nWas := aSelf[Item_nQtd]
  aSelf[Item_nQtd] += nMais
  aSelf[Item_aTags] := {}
  AAdd(aSelf[Item_aTags], cValToChar(nWas))
Return aSelf

Static Function Item_Clear(aSelf as Array)
  aSelf[Item_nQtd] := 0
Return Item_Total(aSelf)
// end type

User Function Fields(cCod as Character)
  Local aIt := {cCod, 1, 2.5, .F., "", Nil, {}, THashMap():New(), Nil}
  Local aAll := {"B", 1, 10, .T., "x", Date(), {"a"}, u_xtpl_hnew({{"k", 1}}), Nil}
  Local aNone := {"", 1, 0, .F., "", Nil, {}, THashMap():New(), Nil}
  Item_Add(Item_Add(aIt, 3), 1)
  aIt[Item_nQtd]++
  aAll[Item_nPreco] *= 2
  ConOut(Item_Total(aIt), Item_Clear(aAll), Len(aNone), aIt[Item_nQtd])
Return aIt[Item_aTags][1]
