// What a type, its values, fields and methods refuse.
User Function Early(eIt as Item)
Return eIt.nQtd

type Item
  cCod <const> as Character
  nQtd as Numeric := nX
  aTags <contained> as Array<c>
  nQtd
  and
  method Total() as Numeric
  Return ::nQtd * .nPreco

  method aTags()
  Return Nil

  method Total()
  Return Nil
endtype

User Function Wrong(eAny, aNums as Array<n>, oObj)
  Local eIt := Item("A", 2, {}, 4)
  Local eOk := Item(nQtd => "x", cCod => "B", nQtd => 3)
  Local eBad := Item(nQtd => 1, "C")
  Local aLit as Item
  aLit := {"A", 1}
  aLit := aNums
  aLit := 5
  eOk.cCod := "C"
  eOk.nQtd := "y"
  eOk.Totl()
  eOk.nQtx := 1
  Foo(nQtd => 1)
  aNums.nQtd := 1
  eAny.Total()
  ConOut(eAny.aTags.cX, eIt, eBad)
  with object eOk
    :nQtd := 2
  end with
  oObj := Shop():New()
Return eAny.nQtd
