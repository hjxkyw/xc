// A type from another: its fields after the other's, the other's methods.
type Item
  cCod <const> as Character
  nQtd as Numeric := 1
  nPreco as Numeric

  method Total() as Numeric
  Return .nQtd * .nPreco
end type

type Line from Item
  nDesc as Numeric
  aTags as Array<c>

  method Net() as Numeric
  Return .Total() - .nDesc
endtype

Static Function Sum(eIt as Item)
Return eIt.Total()

User Function Lines()
  Local eLn := Line("A", 2, 10, nDesc => 3)
  Local aAll := { <Item> }
  AAdd(aAll, eLn)
  AAdd(aAll, Item("B", nPreco => 1))
  eLn.nQtd += 1
  eLn.nDesc := 1
  ConOut(eLn.Net(), Sum(eLn), eLn.Total(), Len(aAll))
Return aAll |> map([it] it.Total())
