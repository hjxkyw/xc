#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n)
  local x := 0
  Local s_0_x  // the block local 'x'
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  if n > 0
    s_0_x := 1  // x
    fo_0_0 := {}
    For fi_0_0 := 1 To Len(a)
      fv_0_0 := a[fi_0_0]
      fv_0_0 := fv_0_0 + 1
      AAdd(fo_0_0, fv_0_0)
    Next
    a := fo_0_0
    n := s_0_x
  endif
return n
