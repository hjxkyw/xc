#include "totvs.ch"
#include "tlpp-core.th"

// What stays a call: a verb inside an expression, one that does not fuse
// alone, one over a block held in a variable, and in a prologue's value.
user function left(a, b)
  local x := u_xtpl_map(a, {|v| v})
  x := len(u_xtpl_map(a, {|v| v * 2}))
  x := u_xtpl_sort(a)
  x := u_xtpl_join(a, ",")
  x := u_xtpl_map(a, b)
return x
