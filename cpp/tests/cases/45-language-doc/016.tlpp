#include "totvs.ch"
#include "tlpp-core.th"

User Function Defers(cFile)
  Local nH := FOpen(cFile)
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
    If SA1->(Eof())
      conout("saindo")
      FClose(nH)
      SA1->(DbGoto(frc_0_0))
      If !Empty(far_0_0)
        DbSelectArea(far_0_0)
      EndIf
      return -1
    EndIf
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
conout("saindo")
FClose(nH)
Return 1
