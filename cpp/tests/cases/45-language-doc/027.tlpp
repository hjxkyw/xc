#include "totvs.ch"
#include "tlpp-core.th"

User Function Saldo()
  Local nTotal
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
  SA1->(DbGoTop())
  fo_0_0 := 0
  While !SA1->(Eof())
    If SA1->A1_MSBLQL != "1"
      fv_0_0 := SA1->A1_SALDO
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
    SA1->(DbSkip())
  EndDo
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  nTotal := fo_0_0
Return nTotal
