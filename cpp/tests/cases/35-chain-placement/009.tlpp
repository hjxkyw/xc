#include "totvs.ch"
#include "tlpp-core.th"
user function f(cP, l, n)
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  While n > 0
    fok_0_0 := File(cP)
    If fok_0_0
      FT_FUse(cP)
      FT_FGoTop()
    EndIf
    While fok_0_0 .And. !FT_FEof()
      fv_0_0 := FT_FReadLn()
      conout(fv_0_0)
      FT_FSkip()
    EndDo
    If fok_0_0
      FT_FUse()
    EndIf
  EndDo
return n
