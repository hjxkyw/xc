// A source that includes headers: their types are its own, their includes
// TL++'s .th -- each between '#ifndef' and '#endif', so twice is once.
#include "totvs.ch"
#include "tlpp-core.th"
#include "line.th"
#include "item.th"

// type Sale from Line: an array of 5
#define Sale_cWho 5
// endtype

User Function Sell(eIt as Array)
  Local eLn := {"A", 2, 10, 3}
  Local eSa := {"B", 1, 4, 0, "me"}
  eLn[Item_nQtd]++
Return Line_Net(eLn) + Item_Total(eIt) + Line_Net(eSa) + ITEM_MAX
