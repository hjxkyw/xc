// A source that includes headers: their types are its own, their includes
// TL++'s .th -- each between '#ifndef' and '#endif', so twice is once.
#include "totvs.ch"
#include "line.xth"
#include "item.xth"

type Sale from Line
  cWho as Character
endtype

User Function Sell(eIt as Item)
  Local eLn := Line("A", 2, 10, nDesc => 3)
  Local eSa := Sale("B", nPreco => 4, cWho => "me")
  eLn.nQtd++
Return eLn.Net() + eIt.Total() + eSa.Net() + ITEM_MAX
