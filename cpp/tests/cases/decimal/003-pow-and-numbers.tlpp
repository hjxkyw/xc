#include "totvs.ch"
#include "tlpp-core.th"

// '**' and '^' with a Decimal are DEC_POW, its exponent made a Decimal; a
// Decimal that goes into a number -- a Numeric's value, a Numeric
// parameter's argument, a return of a function declared Numeric -- is
// DEC_TO_DBL of it. DEC_ROUND and DEC_POW give Decimals, DEC_TO_DBL a number.
user function f(fA as Decimal, nQ as Numeric)
  local nX := DEC_TO_DBL(fA) as Numeric
  local nY as Numeric
  local fP := DEC_POW(DEC_CREATE("1.5", 2, 1), DEC_CREATE("2", 1, 0)) as Decimal
  nY := DEC_TO_DBL(DEC_MUL(fA, DEC_CREATE("2", 1, 0)))
  nY := DEC_TO_DBL(fA) + nQ
  fP := DEC_ADD(DEC_POW(fA, DEC_CREATE("3", 1, 0)), DEC_POW(fP, DEC_CREATE("2", 1, 0)))
  nY := toNum(DEC_TO_DBL(DEC_ADD(fA, DEC_CREATE("1", 1, 0))))
  fP := DEC_ADD(DEC_ROUND(fA, 1), DEC_CREATE("1", 1, 0))
return {nX, nY, fP, num(fA)}

static function toNum(nV as Numeric) as Numeric
return nV

static function num(fV as Decimal) as Numeric
return DEC_TO_DBL(DEC_MUL(fV, DEC_CREATE("2", 1, 0)))
