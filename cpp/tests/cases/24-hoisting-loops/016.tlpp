#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n)
  local oI := 0
  Local s_0_oI  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_0  // the counter of a 'for ... in'
  fs_0_0 := a
  For fi_0_0 := 1 To Len(fs_0_0)
    s_0_oI := fs_0_0[fi_0_0]
    n := s_0_oI
  next
  n := oI
return n
