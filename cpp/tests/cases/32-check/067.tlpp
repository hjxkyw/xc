#include "totvs.ch"
#include "tlpp-core.th"

user function f(a)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // what a loop collected, for the stages after it
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    If fv_0_0 > 1
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  a := u_xtpl_take(u_xtpl_sort(fo_0_0), 3)
  a := u_xtpl_take(u_xtpl_sort(a), 3)
return 1
