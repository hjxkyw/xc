#include "totvs.ch"
#include "tlpp-core.th"

user function f(a)
  local x
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fs_0_1  // the path of the file walked
  Local fok_0_1  // whether the file opened
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local cL  // a block local
  Local fs_0_2  // the path of the file walked
  Local fok_0_2  // whether the file opened
  fs_0_0 := "a.txt"
  fok_0_0 := File(fs_0_0)
  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf
  fo_0_0 := {}
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    AAdd(fo_0_0, fv_0_0)
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  x := fo_0_0
  fs_0_1 := "b.txt"
  fok_0_1 := File(fs_0_1)
  If fok_0_1
    FT_FUse(fs_0_1)
    FT_FGoTop()
  EndIf
  fo_0_1 := {}
  While fok_0_1 .And. !FT_FEof()
    fv_0_1 := FT_FReadLn()
    AAdd(fo_0_1, fv_0_1)
    FT_FSkip()
  EndDo
  If fok_0_1
    FT_FUse()
  EndIf
  a := fo_0_1
  a := x
  fs_0_2 := "c.txt"
  fok_0_2 := File(fs_0_2)
  If fok_0_2
    FT_FUse(fs_0_2)
    FT_FGoTop()
  EndIf
  While fok_0_2 .And. !FT_FEof()
    cL := FT_FReadLn()
    FT_FSkip()
  EndDo
  If fok_0_2
    FT_FUse()
  EndIf
return 1
