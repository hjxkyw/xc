#include "totvs.ch"
#include "tlpp-core.th"

user function f(a)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  a := u_xtpl_map(a, {|__it| alltrim(__it)})
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    If isOk(fv_0_0)
      fv_0_0 := upper(fv_0_0)
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  a := fo_0_0
return 1
