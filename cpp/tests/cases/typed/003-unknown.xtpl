// A value whose type xc cannot tell: a warning, and the file is written --
// a method, a parameter with no type, a function it does not know.
User Function Unknown(oItem, cKey, nQtd as Numeric)
  Local aN := { <n> }
  Local hH as Hash<c, n>
  AAdd(aN, oItem:nQtd)
  AAdd(aN, nQtd)
  hH{cKey} := 1
  hH{"total"} := u_Total(aN)
  aN := u_LoadAll()
  aEval({1, 2}, {|x| AAdd(aN, x)})
Return aN
