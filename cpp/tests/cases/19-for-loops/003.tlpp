#include "totvs.ch"
#include "tlpp-core.th"

user function f(a, n)
  Local cLinha  // a block local
  Local nNum  // a block local
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened
  fs_0_0 := cPath
  fok_0_0 := File(fs_0_0)
  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf
  nNum := 0
  While fok_0_0 .And. !FT_FEof()
    nNum++
    cLinha := FT_FReadLn()
    FT_FSkip()
    conout(cLinha)
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
return 1
