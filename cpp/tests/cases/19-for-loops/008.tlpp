#include "totvs.ch"
#include "tlpp-core.th"

user function f(a, n)
  Local x  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_0  // the counter of a 'for ... in'
  Local nY  // a block local
  fs_0_0 := a
  For fi_0_0 := 1 To Len(fs_0_0)
    x := fs_0_0[fi_0_0]
    nY := x
    conout(nY)
  next
return 1
