#include "totvs.ch"
#include "tlpp-core.th"

user function f(a, n)
  Local cChave  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_0  // the counter of a 'for ... in'
  fs_0_0 := u_xtpl_keys(hCfg)
  For fi_0_0 := 1 To Len(fs_0_0)
    cChave := fs_0_0[fi_0_0]
    conout(cChave)
  next
return 1
