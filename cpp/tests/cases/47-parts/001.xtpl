User Function Primeira()
  Local cQ := ""
  BeginSql Alias "T"
    SELECT 1
    Function inside SQL
  EndSql
  cQ := "x" + ;
        "y"
Return cQ

Static Function Segunda()
Return nil

// annotations after a function are statements of its body: no part here
@Get("/a")
