#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, o)
  local x := 0
  Local fi_0_0  // the counter of a range
  Local fv_0_0  // the element walked
  Local fn_0_0  // how many elements have passed
  Local fo_0_0  // the result of the chain
  fn_0_0 := 0
  fo_0_0 := {}
  For fi_0_0 := 1 To 1000000
    fv_0_0 := fi_0_0
    If ((fv_0_0 % 3) == 0)
      If fn_0_0 >= 4
        Exit
      EndIf
      fn_0_0++
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  a := fo_0_0
return n
