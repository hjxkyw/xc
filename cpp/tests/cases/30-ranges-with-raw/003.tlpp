#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, o)
  local x := 0
  Local fhi_0_0  // the high end of a range
  Local fi_0_0  // the counter of a range
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fhi_0_0 := calc(n)
  fo_0_0 := 0
  For fi_0_0 := x To fhi_0_0
    fv_0_0 := fi_0_0
    fo_0_0++
  Next
  n := fo_0_0
return n
