#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP)
  Local aT  // a block local
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  if n > 0
    fok_0_0 := File(cP)
    If fok_0_0
      FT_FUse(cP)
      FT_FGoTop()
    EndIf
    fo_0_0 := 0
    While fok_0_0 .And. !FT_FEof()
      fv_0_0 := FT_FReadLn()
      fo_0_0++
      FT_FSkip()
    EndDo
    If fok_0_0
      FT_FUse()
    EndIf
    aT := fo_0_0
    n := aT
  endif
return n
