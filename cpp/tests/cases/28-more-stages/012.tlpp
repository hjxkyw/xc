#include "totvs.ch"
#include "tlpp-core.th"
user function f(cP)
  local aT
  local n
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fdr_0_0  // whether the leading run of a dropwhile is still on
  Local fo_0_0  // the result of the chain
  fok_0_0 := File(cP)
  If fok_0_0
    FT_FUse(cP)
    FT_FGoTop()
  EndIf
  fdr_0_0 := .T.
  fo_0_0 := {}
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    If !(fdr_0_0 .And. (empty(fv_0_0)))
      fdr_0_0 := .F.
      fv_0_0 := alltrim(fv_0_0)
      AAdd(fo_0_0, fv_0_0)
    EndIf
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  aT := fo_0_0
  n := len(aT)
return n
