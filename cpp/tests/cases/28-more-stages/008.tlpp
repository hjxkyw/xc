#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, n, cP)
  local x := {}
  local bOk := {|v| .T.}
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // what a loop collected, for the stages after it
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    fv_0_0 := alltrim(fv_0_0)
    AAdd(fo_0_0, fv_0_0)
  Next
  x := u_xtpl_filter(fo_0_0, bOk)
  x := u_xtpl_map(a, {|__it| upper(__it)})
return n
