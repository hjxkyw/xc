#include "totvs.ch"
#include "tlpp-core.th"

user function f()
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aPedidos)
    fv_0_0 := aPedidos[fi_0_0]
    If fv_0_0:nValor > 1000
      fv_0_0 := fv_0_0:cCodigo
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  aC := fo_0_0
return
