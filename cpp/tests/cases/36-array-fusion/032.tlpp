#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, b, n, l, cS, bOk)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fpv_0_0  // the element pairwise saw last
  Local fhd_0_0  // whether pairwise has seen an element
  Local fol_0_0  // the element before, for pairwise
  Local frd_0_0  // whether pairwise has a pair
  Local fo_0_0  // the result of the chain
  fpv_0_0 := Nil
  fhd_0_0 := .F.
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    fol_0_0 := fpv_0_0
    frd_0_0 := fhd_0_0
    fpv_0_0 := fv_0_0
    fhd_0_0 := .T.
    If frd_0_0
      fv_0_0 := {fol_0_0, fv_0_0}
      fv_0_0 := fv_0_0[2] - fv_0_0[1]
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  n := fo_0_0
return n
