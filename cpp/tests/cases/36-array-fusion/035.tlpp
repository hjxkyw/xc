#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, b, n, l, cS, bOk)
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
  SA1->(DbGoTop())
  fo_0_0 := Nil
  While !SA1->(Eof())
    fv_0_0 := SA1->A1_SALDO
    If fo_0_0 == Nil
      fo_0_0 := fv_0_0
    Else
      fo_0_0 := Max(fo_0_0, fv_0_0)
    EndIf
    SA1->(DbSkip())
  EndDo
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  n := fo_0_0
return n
