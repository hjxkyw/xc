#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, b, n, l, cS, bOk)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fa_0_0  // the running value of a scan
  Local fn_0_0  // how many elements have passed
  Local fo_0_0  // the result of the chain
  fa_0_0 := 0
  fn_0_0 := 0
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    fa_0_0 := fa_0_0 + fv_0_0
    fv_0_0 := fa_0_0
    If fn_0_0 >= 3
      Exit
    EndIf
    fn_0_0++
    AAdd(fo_0_0, fv_0_0)
  Next
  n := fo_0_0
return n
