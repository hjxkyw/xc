#include "totvs.ch"
#include "tlpp-core.th"
user function f(a, b, n, l, cS, bOk)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fbs_0_0  // the best key maxby/minby has seen
  Local fop_0_0  // whether maxby/minby has seen an element
  Local fpb_0_0  // the key of the element maxby/minby looks at
  fbs_0_0 := Nil
  fop_0_0 := .F.
  fpb_0_0 := Nil
  fo_0_0 := Nil
  For fi_0_0 := 1 To Len(a)
    fv_0_0 := a[fi_0_0]
    If fv_0_0:lOk
      fpb_0_0 := fv_0_0:nV
      If !fop_0_0 .Or. fpb_0_0 < fbs_0_0
        fop_0_0 := .T.
        fbs_0_0 := fpb_0_0
        fo_0_0 := fv_0_0
      EndIf
    EndIf
  Next
  n := fo_0_0
return n
