// using_unclosed.xtpl -- a 'using' that never closes.
//
// Left alone it swallows the rest of the function and the area is never put
// back, which is the bug the construct exists to prevent.
// --------------------------------------------------------------------------------

user function usingUnclosed()
  local nT := 0

  using alias SA1 do
    nT := 1

  return nT

// --------------------------------------------------------------------------------
// the end
