// consulta.xtpl -- uma tela de consulta simples, com a parte de dados em xtpl.
//
// Um caso comum de verdade: a rotina tem uma tela feita com comandos de
// Clipper-em-AdvPL -- '@ ... SAY ... GET', 'MsAguarde', 'MsgRun' -- e tem
// logica de dados em volta. A tela nao vai mudar, e nao precisa.
//
// ============================================================================
// O PROBLEMA
// ============================================================================
//
//    @ 10, 5 SAY "Total" GET nTotal PICTURE "@E 999,999.99"
//
// Esta linha NAO e AdvPL. 'SAY', 'GET' e 'PICTURE' nao sao funcoes nem
// variaveis -- sao palavras que um '#command' num header troca por chamadas
// de verdade. Ela so vira AdvPL depois que o pre-processador roda, e o
// pre-processador roda DEPOIS do xtpl.
//
// Para o xtpl, 'SAY' e um nome nao declarado. E ele esta certo: nao ha como
// saber o que e, porque a definicao esta num '.ch' que ele nao le.
//
// ============================================================================
// O QUE 'raw' FAZ
// ============================================================================
//
//    raw @ 10, 5 SAY "Total" GET nTotal PICTURE "@E 999,999.99"
//
// Diz: nao tente entender esta linha. Ha a forma em bloco, para telas
// inteiras:
//
//    raw
//      @ 12, 5 SAY "Nome" GET cNome PICTURE "@!"
//      @ 14, 5 SAY "Obs"  GET cObs  SIZE 60, 10
//    end raw
//
// ============================================================================
// O QUE 'raw' NAO DESLIGA
// ============================================================================
//
// **As variaveis declaradas continuam sendo renomeadas ali dentro.** Um local
// de bloco usado numa linha 'raw' sai com o nome gerado, como em qualquer
// outro lugar. So a verificacao de nomes NAO declarados e relaxada, porque
// 'SAY' e 'GET' sao comandos e nao variaveis.
//
// Isso importa: 'raw' e uma saida para a SINTAXE, nao para o escopo. Uma
// linha raw nao vira terra de ninguem.
//
// ============================================================================
// E O PRECO
// ============================================================================
//
// Uma variavel mencionada numa linha 'raw' e FIXADA -- ganha armazenamento
// proprio e nao divide slot com ninguem, do mesmo jeito que uma capturada por
// um code block.
//
// O motivo e o mesmo: o transpilador nao enxerga o que o comando faz com ela,
// e 'GET' em particular passa a variavel por REFERENCIA para um dialogo que
// sobrevive ao bloco. Se o slot fosse reaproveitado depois, o dialogo estaria
// escrevendo em cima de outra coisa.
//
// Entao 'raw' custa um slot por variavel citada. E o preco de nao poder ver.
//
// ============================================================================
// COMO USAR
// ============================================================================
//
// A tela em 'raw', os dados em xtpl. Nao ha ganho em converter a tela: ela ja
// esta escrita, funciona, e as linhas '@ ... SAY ... GET' nao ficam melhores
// de nenhum jeito.
//
// O ganho esta em volta dela -- na consulta, na validacao, no que se faz com
// o que o usuario digitou.
//
// Compare com consulta_mao.tlpp, que e quase a mesma coisa. Este exemplo e o
// unico da pasta em que a versao a mao quase nao perde: e de proposito.
// ============================================================================

#include "totvs.ch"
#include "rwmake.ch"
#include "tlpp-core.th"

// rwmake.ch traz os comandos da tela (DIALOG, SAY, GET, BMPBUTTON). Cada
// SAY e cada GET e um comando proprio, com a sua posicao: os dois na mesma
// linha, o AppServer nao compila.


user function consulta(cFilialDe, cFilialAte)
  local cNome := space(40)
  local nTotal := 0
  local nDias := 30
  local lOk := .F.
  local aResumo := {}
  local oDlg := nil
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local cFil  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_0  // the counter of a 'for ... in'
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local oLinha  // a block local
  Local nPos  // a block local
  Local fs_0_1  // the source of a 'for ... in'

  // ---- a tela: entregue ao pre-processador ---------------------------------
    @ 200, 010 TO 400, 600 DIALOG oDlg TITLE "Consulta de saldos"
    @ 012, 010 SAY "Cliente"
    @ 012, 040 GET cNome PICTURE "@!"
    @ 014, 010 SAY "Dias"
    @ 014, 040 GET nDias PICTURE "@E 999"
    @ 060, 200 BMPBUTTON TYPE 1 ACTION lOk := .T.
    @ 060, 240 BMPBUTTON TYPE 2 ACTION lOk := .F.

  ACTIVATE DIALOG oDlg CENTERED

  If !lOk
    return {}
  EndIf

  // ---- e daqui para baixo, xtpl comum --------------------------------------

  far_0_0 := Alias()
  DbSelectArea("SE1")
  frc_0_0 := SE1->(RecNo())
  fol_0_0 := SE1->(IndexOrd())
  SE1->(DbSetOrder(1))

    fs_0_0 := filiaisEntre(cFilialDe, cFilialAte)
    For fi_0_0 := 1 To Len(fs_0_0)
      cFil := fs_0_0[fi_0_0]

      SE1->(DbSeek(cFil))

      far_0_1 := Alias()
      DbSelectArea("SE1")
      frc_0_1 := SE1->(RecNo())
      SE1->(DbSeek(cFil))
      fo_0_0 := 0
      While !SE1->(Eof())
        If !(SE1->E1_FILIAL == cFil)
          Exit
        EndIf
        If SE1->E1_SALDO > 0
          If date() - SE1->E1_VENCTO <= nDias
            fv_0_0 := SE1->E1_SALDO
            fo_0_0 := fo_0_0 + fv_0_0
          EndIf
        EndIf
        SE1->(DbSkip())
      EndDo
      SE1->(DbGoto(frc_0_1))
      If !Empty(far_0_1)
        DbSelectArea(far_0_1)
      EndIf
      nTotal := fo_0_0

      aadd(aResumo, {cFil, nTotal})

    next

  SE1->(DbSetOrder(fol_0_0))
  SE1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  // ---- e de volta a tela, para mostrar o resultado --------------------------
  fs_0_1 := aResumo
  For nPos := 1 To Len(fs_0_1)
    oLinha := fs_0_1[nPos]
    MsgInfo(("Filial " + cValToChar(oLinha[1]) + ": " + cValToChar(oLinha[2])), ("Resumo " + cValToChar(nPos)))
  next

  return aResumo

// -----------------------------------------------------------------------------
// the end
