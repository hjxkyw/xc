#include "totvs.ch"
#include "tlpp-core.th"

// medias.tlpp -- limpar um arquivo e tirar a media de cada linha, numa passada.
//
// Cada linha deve ter tres campos numericos separados por virgula. As que
// tem, viram a media dos tres; as que nao tem sao descartadas e contadas.
//
//    12, 14, 16   ->  14
//    8,9,10       ->  9
//    1, x, 3      ->  descartada
//
// O 'tap' conta as linhas enquanto elas passam. Contar antes com um
// 'lines(cArquivo) |> count' separado leria o arquivo duas vezes.
//
// Separa PRIMEIRO, apara depois: 'split(alltrim(l), ",")' apara a linha, e
// entao so o primeiro e o ultimo campo ficam aparados -- '  100 ,  200  ' da
// '100 ' e '  200'. 'map(split(l, ","), alltrim)' apara cada campo, que e o
// que se queria, e ai o padrao nao precisa mais tolerar espacos nas pontas.
//
// Nao e uma cadeia dentro do lambda, que seria recusado, e sim os mesmos
// verbos chamados como funcoes comuns.
//
// Nao ha funcao auxiliar nenhuma aqui, alem de ehNumero, que existe so porque
// o padrao merece um nome. Uma CADEIA nao pode ficar dentro de um lambda --
// icar as etapas para fora do bloco as faria rodar antes dele --, mas todo
// verbo de cadeia tambem e uma funcao comum: 'allof(a, ehNumero)' e
// 'asum(map(a, val))' fazem o mesmo dentro do lambda, sem cadeia.
//
// A validacao usa a classe Regex do TLPP. 'matches' e estatico e exige a
// string INTEIRA -- verificado rodando, porque o exemplo do TDN diz que
// matches('^(abc)*$', 'abc123') e .T. e na verdade e .F.
// --------------------------------------------------------------------------------

using namespace tlpp.regex

user function medias(cArquivo)

  Local nLidas := 0
  Local aMedias

  Local b_0_it   // o local de bloco 'it', fixado: tem armazenamento so dele
  Local fo_0_0   // o resultado da cadeia
  Local fok_0_0  // se o arquivo abriu
  Local fv_0_0   // o elemento em percurso

  fok_0_0 := File(cArquivo)

  If fok_0_0
    FT_FUse(cArquivo)
    FT_FGoTop()
  EndIf

  fo_0_0 := {}

  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    nLidas += 1
    fv_0_0 := u_xtpl_map(u_xtpl_split(fv_0_0, ","), {|b_0_it| alltrim(b_0_it)})
    If len(fv_0_0) == 3 .and. u_xtpl_allof(fv_0_0, {|b_0_it| ehNumero(b_0_it)})
      fv_0_0 := u_xtpl_asum(u_xtpl_map(fv_0_0, {|b_0_it| val(b_0_it)})) / 3
      AAdd(fo_0_0, fv_0_0)
    EndIf
    FT_FSkip()
  EndDo

  If fok_0_0
    FT_FUse()
  EndIf

  aMedias := fo_0_0

  conout("linhas: " + cValToChar(nLidas) + "  boas: " + cValToChar(len(aMedias)) + "  descartadas: " + cValToChar(nLidas - len(aMedias)))

  return aMedias

static function ehNumero(cTexto)

  return Regex():matches("^-?[0-9]+(\.[0-9]+)?$", cTexto)

// --------------------------------------------------------------------------------
// the end