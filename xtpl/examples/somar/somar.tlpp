#include "totvs.ch"
#include "tlpp-core.th"

// somar.xtpl -- somar campo a campo as linhas correspondentes de dois arquivos.
//
// Cada arquivo tem linhas de campos numericos separados por virgula. A linha
// N de um e somada com a linha N do outro, campo a campo:
//
//    A:  10, 20, 30          ->   11, 22, 33
//    B:   1,  2,  3
//
// ----------------------------------------------------------------------------
// O QUE 'zip' FAZ
//
// 'zip' e um ziper. Recebe duas colecoes, encosta uma na outra e casa os
// elementos de mesma posicao:
//
//    zip({1, 2, 3}, {10, 20, 30})  ->  {{1, 10}, {2, 20}, {3, 30}}
//
// Sem mais nada, cada par sai como um array de dois. Com um bloco no fim, o
// bloco recebe os dois e decide o que sai no lugar do par:
//
//    zip({1, 2, 3}, {10, 20, 30}, [nA, nB] nA + nB)  ->  {11, 22, 33}
//
// Se uma colecao for mais curta, 'zip' para nela e o resto e descartado --
// EM SILENCIO. E por isso que este programa conta o que foi descartado e diz
// em voz alta: perder metade de um arquivo sem avisar nao e resultado, e um
// bug.
//
// ----------------------------------------------------------------------------
// POR QUE DOIS 'zip'
//
// Ha dois niveis de emparelhamento, entao ha dois zips.
//
//    O de FORA casa LINHA com LINHA:
//
//       linha 1 de A  com  linha 1 de B
//       linha 2 de A  com  linha 2 de B
//
//    O de DENTRO, para cada par de linhas, casa CAMPO com CAMPO:
//
//       "10" com "1"  ->  11
//       "20" com "2"  ->  22
//       "30" com "3"  ->  33
//
// Os nomes dizem em que nivel cada coisa esta:
//
//    aLinhasA   todas as linhas de A, cada uma ja separada -- array de arrays
//    aCamposA   os campos de UMA linha              -- array de strings
//    cCampoA    UM campo                            -- string
//
// O campo e string ate o 'val()' -- ele veio de um arquivo texto. E por isso
// que ele se chama 'cCampoA' e nao 'nNumeroA': o nome diz o que a coisa e,
// nao o que ela vai virar.
//
// Rode:  appserver.exe -env=SeuAmbiente -run=u_somar
// -----------------------------------------------------------------------------

using namespace tlpp.regex

user function somar(cArqA, cArqB)
  local nLinhasA := 0
  local nLinhasB := 0
  local aLinhasA
  local aLinhasB
  local aSomas
  local nDesiguais
  local nSujas
  local nX
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fok_0_1  // whether the file opened
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fs_0_0  // the array walked
  Local fi_0_0  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local fs_0_1  // the array walked
  Local fi_0_1  // the position in the array walked
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain
  fok_0_0 := File(cArqA)
  If fok_0_0
    FT_FUse(cArqA)
    FT_FGoTop()
  EndIf
  fo_0_0 := {}
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    nLinhasA += 1
    fv_0_0 := u_xtpl_split(alltrim(fv_0_0), ",")
    AAdd(fo_0_0, fv_0_0)
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  aLinhasA := fo_0_0
  fok_0_1 := File(cArqB)
  If fok_0_1
    FT_FUse(cArqB)
    FT_FGoTop()
  EndIf
  fo_0_1 := {}
  While fok_0_1 .And. !FT_FEof()
    fv_0_1 := FT_FReadLn()
    nLinhasB += 1
    fv_0_1 := u_xtpl_split(alltrim(fv_0_1), ",")
    AAdd(fo_0_1, fv_0_1)
    FT_FSkip()
  EndDo
  If fok_0_1
    FT_FUse()
  EndIf
  aLinhasB := fo_0_1
  aSomas := {}
  nDesiguais := 0
  nSujas := 0
  nX := 0

  // O zip de fora anda linha a linha; o de dentro, campo a campo.
  aSomas := u_xtpl_zip(aLinhasA, aLinhasB, {|aCamposA, aCamposB| u_xtpl_zip(aCamposA, aCamposB, {|cCampoA, cCampoB| val(cCampoA) + val(cCampoB)})})

  // O que o zip descartou em silencio, dito em voz alta. Os dois de novo
  // andam linha a linha, mas perguntam outra coisa de cada par.
  fs_0_0 := u_xtpl_zip(aLinhasA, aLinhasB, {|aCamposA, aCamposB| len(aCamposA) == len(aCamposB)})
  fo_0_2 := 0
  For fi_0_0 := 1 To Len(fs_0_0)
    fv_0_2 := fs_0_0[fi_0_0]
    If !fv_0_2
      fo_0_2++
    EndIf
  Next
  nDesiguais := fo_0_2

  fs_0_1 := u_xtpl_zip(aLinhasA, aLinhasB, {|aCamposA, aCamposB| tudoNumero(aCamposA) .and. tudoNumero(aCamposB)})
  fo_0_3 := 0
  For fi_0_1 := 1 To Len(fs_0_1)
    fv_0_3 := fs_0_1[fi_0_1]
    If !fv_0_3
      fo_0_3++
    EndIf
  Next
  nSujas := fo_0_3

  xconout("A: ", nLinhasA, " linhas   B: ", nLinhasB, " linhas")
  xconout("somadas: ", len(aSomas), ;
          "   linhas perdidas: ", max(nLinhasA, nLinhasB) - len(aSomas))
  xconout("com numero de campos diferente: ", nDesiguais, ;
          "   com campo nao numerico: ", nSujas)

  for nX := 1 to len(aSomas)
    conout(cValToChar(nX) + ": " + mostrar(aSomas[nX]))
  next

  return aSomas

// ---- auxiliares ----------------------------------------------------------

// 'allof' e o mesmo padrao de 'zip': um bloco que diz o que perguntar de
// cada elemento. Aqui, de cada campo de uma linha.
static function tudoNumero(aCampos)
  return u_xtpl_allof(aCampos, {|__it| ehNumero(__it)})

static function ehNumero(cTexto)
  return Regex():matches("^-?[0-9]+(\.[0-9]+)?$", alltrim(cTexto))

// Uma linha de numeros de volta em texto, para sair legivel.
static function mostrar(aValores)
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aValores)
    fv_0_0 := aValores[fi_0_0]
    fv_0_0 := alltrim(str(fv_0_0))
    AAdd(fo_0_0, fv_0_0)
  Next
  fo_0_0 := u_xtpl_join(fo_0_0, ", ")
  return fo_0_0

// -----------------------------------------------------------------------------
// the end
