#include "totvs.ch"
#include "tlpp-core.th"

// dicionario.xtpl -- listar os campos de uma tabela, lendo o SX3.
//
// ESTE EXEMPLO RODA. Os outros da pasta usam SA1, SE1, SC6 de mentira, para
// mostrar a forma; este le o dicionario de verdade, que existe em qualquer
// instalacao.
//
//    appserver.exe -compile -files=examples/dicionario/dicionario.tlpp ^
//                  -includes=... -env=SeuAmbiente
//    appserver.exe -env=SeuAmbiente -run=u_dicionario
//
// Sai algo como:
//
//    SA1 tem 90 campos, 1247 bytes por registro
//      A1_FILIAL      C   2    Filial
//      A1_COD         C   6    Codigo
//      A1_LOJA        C   2    Loja
//      ...
//
// ============================================================================
// ABRIR A TABELA
// ============================================================================
//
// Um job iniciado por '-run=' comeca SEM conexao com o banco e sem nenhuma
// area aberta. Entao este exemplo abre o que precisa:
//
//    TCLink()                    conecta
//    DbUseArea(.T., "TOPCONN", "SX3", "SX3", .F., .F.)
//
// Os 'defer' desfazem na ordem inversa, e valem para toda saida -- inclusive
// os dois 'return' antecipados la embaixo.
//
// ============================================================================
// POR QUE 'filter' E NAO 'takewhile'
// ============================================================================
//
// O exemplo 'pedido' usa 'takewhile' para parar no primeiro registro de outro
// pedido, e isso so vale porque a ordem garante que os registros de um pedido
// estao juntos.
//
// Aqui NAO ha essa garantia. Abrindo a SX3 com DbUseArea, sem indice, a ordem
// e a ordem fisica -- que na pratica agrupa por tabela, mas nada promete
// isso. Um 'takewhile' pararia no primeiro campo fora do grupo e devolveria
// uma lista PARCIAL, sem erro nenhum.
//
// Entao aqui e 'filter': le a SX3 inteira e fica com o que interessa. Mais
// lento e correto, contra mais rapido e talvez errado.
//
// Essa escolha e o assunto: 'takewhile' nao e uma versao melhor de 'filter',
// e uma versao que exige uma garantia. Sem a garantia, e 'filter'.
//
// ============================================================================
// E O 'using alias'
// ============================================================================
//
// Guarda a area selecionada e o registro corrente, e repoe na saida do bloco.
// Aqui isso importa pouco, porque a funcao abriu a SX3 sozinha e fecha no
// fim. Mas e o habito certo: uma funcao que mexe numa area e a devolve como
// achou pode ser chamada de qualquer lugar.
//
// Dentro de um 'using alias' da MESMA tabela, a cadeia nao guarda a area de
// novo: ela ja esta selecionada, e o 'end using' a repoe. Sobre outra tabela
// a cadeia guarda, porque ai a area muda mesmo.
//
// O REGISTRO continua sendo guardado pela cadeia, sempre. O 'using' repoe uma
// vez so, no fim do bloco, e o que estiver entre duas cadeias pode depender
// de onde o cursor estava -- um percurso deixa a area no Eof.
// ============================================================================

user function dicionario()
  local cTabela := "SA1"
  local nErro := 0
  local aCampos := {}
  local nBytes := 0
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_0  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local aLinha  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_1  // the counter of a 'for ... in'

  nErro := TCLink()
  if nErro < 0
    conout("dicionario: TCLink falhou com " + cValToChar(nErro))
    return 1
  endif


  if !TCCanOpen("SX3")
    conout("dicionario: SX3 nao pode ser aberta")
    TCUnlink()
    return 2
  endif

  DbUseArea(.T., "TOPCONN", "SX3", "SX3", .F., .F.)

  if select("SX3") == 0
    conout("dicionario: SX3 nao abriu")
    TCUnlink()
    return 3
  endif


  far_0_0 := Alias()
  DbSelectArea("SX3")
  frc_0_0 := SX3->(RecNo())

    // Uma passada pela SX3 inteira, ficando com os campos desta tabela.
    far_0_1 := Alias()
    DbSelectArea("SX3")
    frc_0_1 := SX3->(RecNo())
    SX3->(DbGoTop())
    fo_0_0 := {}
    While !SX3->(Eof())
      If alltrim(SX3->X3_ARQUIVO) == cTabela
        fv_0_0 := {alltrim(SX3->X3_CAMPO),                ;
                                SX3->X3_TIPO,                          ;
                                SX3->X3_TAMANHO,                       ;
                                alltrim(SX3->X3_TITULO)}
        AAdd(fo_0_0, fv_0_0)
      EndIf
      SX3->(DbSkip())
    EndDo
    SX3->(DbGoto(frc_0_1))
    If !Empty(far_0_1)
      DbSelectArea(far_0_1)
    EndIf
    aCampos := fo_0_0

  SX3->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  // A soma sai do array que a passada ja construiu, sem tocar no disco de
  // novo. Uma segunda cadeia sobre rows("SX3") daria o mesmo numero e leria
  // a tabela inteira outra vez -- e repetiria o filtro, que e a parte pior:
  // dois lugares para mudar quando a regra mudar, e o segundo e o que fica
  // para tras.
  fo_0_1 := 0
  For fi_0_0 := 1 To Len(aCampos)
    fv_0_1 := aCampos[fi_0_0]
    fv_0_1 := fv_0_1[3]
    fo_0_1 := fo_0_1 + fv_0_1
  Next
  nBytes := fo_0_1

  conout((cValToChar(cTabela) + " tem " + cValToChar(len(aCampos)) + " campos, " + cValToChar(nBytes) + " bytes por registro"))

  fs_0_0 := aCampos
  For fi_0_1 := 1 To Len(fs_0_0)
    aLinha := fs_0_0[fi_0_1]
    conout("  " + padr(aLinha[1], 15) + " " + aLinha[2] + " " +          ;
           padl(alltrim(str(aLinha[3])), 4) + "   " + aLinha[4])
  next

  SX3->(DbCloseArea())
  TCUnlink()
  return 0

// -----------------------------------------------------------------------------
// the end
