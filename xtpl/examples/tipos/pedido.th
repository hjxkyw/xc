#ifndef XTH_PEDIDO
#define XTH_PEDIDO
// Os tipos de um pedido, para todo fonte que vende: o item, e a linha, que
// é um item com desconto. Cada fonte que inclui este header tem os dois,
// e o xc faz dele o pedido.th que esses fontes incluem no TL++.
#define PEDIDO_MAXIMO 99

// type Item: an array of 3
#define Item_cCod 1  // [const] -- o produto
#define Item_nQtd 2
#define Item_nPreco 3

Static Function Item_Total(eSelf as Array) as Numeric
Return eSelf[Item_nQtd] * eSelf[Item_nPreco]
// endtype

// type Linha from Item: an array of 4
#define Linha_nDesc 4

Static Function Linha_Liquido(eSelf as Array) as Numeric
Return Item_Total(eSelf) - eSelf[Linha_nDesc]
// endtype
#endif
