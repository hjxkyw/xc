#include "totvs.ch"
#include "tlpp-core.th"

// 04_const.tlpp -- <const>, and what it does not promise
//
// <const> fixes the BINDING. For a scalar that is full immutability, because
// the value is the binding. For an array or object it is shallow: the name
// cannot be pointed somewhere else, but the contents are still open -- the
// same guarantee as const in JavaScript or final in Java.
// --------------------------------------------------------------------------------

user function testConst(aH)

  Local nLimite := 1000
  Local cAlias := "SA1"
  Local aTaxas := {10, 20, 30}
  // <const> fixes the name, not the contents: a callee given this array can still change its elements
  Local nTotal := 0

  Local s_1_nBase      // o local de bloco 'nBase'
  Local s_1_nContador  // o local de bloco 'nContador'

  // reading is what a const is for
  nTotal := nLimite * 2
  conout(cAlias + ": " + cValToChar(aTaxas[1]))

  // element assignment is allowed: the name is protected, not the contents
  aTaxas[1] := 15

  // passing is allowed too, and the callee could change the elements
  recalcula(aTaxas)

  // a code block may read a const -- only a write would be a violation,
  // and a write is visible in the source
  aadd(aH, {|| nLimite * 2})

  // an attribute list, and a const beside an ordinary declarator
  if nTotal > 0
    s_1_nBase := 50
    s_1_nContador := Nil
    s_1_nContador := s_1_nBase + 1
    conout(cValToChar(s_1_nContador))
  endif

  return nTotal

// --------------------------------------------------------------------------------
// Rejected at compile time:
//
//   nLimite := 2000            assignment
//   nLimite ?= 500             '?=' assigns too
//   recalcula(@nLimite)        the callee could write through the reference
//   local nOutro <const>       a const with no value can never be given one
//
// Warned about, because it cannot be checked:
//
//   raw @ 1,1 SAY "x" GET nLimite
//
// the end