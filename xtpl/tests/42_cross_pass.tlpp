#include "totvs.ch"
#include "tlpp-core.th"

// 42_cross_pass.xtpl -- constructs that meet each other on one line.
//
// Each pass was right on its own. These are the cases where an earlier pass
// changed the line out from under a later one.
// -----------------------------------------------------------------------------

user function testCrossPass(hCfg, aNums, lFlag, nX)
  local nA := 0
  local nB := 0
  local nC := 0

  // The hash read turns one line into three. 'fallback' has to be peeled
  // before that happens, or the assignment ends up inside the guard and a
  // failure leaves nA untouched.
  nA := u_xtpl_safe_pipe({|| u_xtpl_hget(hCfg, "k")}, {|| 0})

  // The modifier has to come off before the chain pass, which would take
  // 'asum if lFlag' as a stage name and keep only the name. Every line the
  // statement becomes belongs inside the If, not just the last.
  If lFlag
    nB := u_xtpl_asum(aNums)
  EndIf

  // A condition can lift statements of its own; they go above the block.
  If u_xtpl_hget(hCfg, "n") > 0
    nC := 1
  EndIf

  If lFlag
    return nA + nB + nC
  EndIf
  return 0


// -----------------------------------------------------------------------------
// the end
