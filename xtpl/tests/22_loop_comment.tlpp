#include "totvs.ch"
#include "tlpp-core.th"

// 22_loop_comment.xtpl -- a comment on a loop header.
//
// Masking turns a comment into one token, so a construct anchored to the end
// of its line stops seeing the end as soon as one is written. 'for N times'
// failed outright before this, reporting 'times' as an undeclared variable.
// -----------------------------------------------------------------------------

user function testLoopComment(aItems, oDoc)
  local nTotal := 0
  Local fi_0_0  // the counter of a 'for ... times'
  Local fi_0_1  // the counter of a 'for ... times'
  Local fn_0_0  // the count of a 'for ... times'
  Local oItem  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_2  // the counter of a 'for ... in'
  Local nIdx  // a block local
  Local fs_0_1  // the source of a 'for ... in'

  For fi_0_0 := 1 To 3  // a literal count
    nTotal := nTotal + 1
  next

  fn_0_0 := contaLinhas(oDoc)
  For fi_0_1 := 1 To fn_0_0  // a bound count
    nTotal := nTotal + 1
  next

  fs_0_0 := aItems
  For fi_0_2 := 1 To Len(fs_0_0)  // the element alone
    oItem := fs_0_0[fi_0_2]
    nTotal := nTotal + oItem:nValor
  next

  fs_0_1 := aItems
  For nIdx := 1 To Len(fs_0_1)  // element and index
    oItem := fs_0_1[nIdx]
    nTotal := nTotal + nIdx
  next

  return nTotal

// -----------------------------------------------------------------------------
// the end
