#include "totvs.ch"
#include "tlpp-core.th"

// 03_pinning.xtpl -- handing on a value pins nothing
//
// Two blocks may each declare a variable called aTmp: different variables
// that never coexist. Handing on a value -- to a function that may keep it --
// pins neither: the array goes, the variable stays, so all of them share
// slots. Only what reaches the variable itself (a code block, '@', a defer,
// raw text) pins one, and only that declaration (see 02_reuse; t/42 too).
// -----------------------------------------------------------------------------

user function testPinning(lFlag)
  local aKeep := {}
  local nTotal := 0
  Local s_0_0  // a slot: the block locals 'aTmp', 'aOther', 'i', 'cTmp'
  Local aTmp  // a block local

  // NOT pinned -- keepIt receives this aTmp's array and may hold it past the
  // block; it holds the array, not the variable, so the slot is still shared.
  if nTotal > 0
    s_0_0 := {}  // aTmp
    aadd(s_0_0, "handed over")
    keepIt(aKeep, s_0_0)
  endif

  // CONTAINED -- a different variable that happens to share the name.
  // Built and read in place, so it takes a shared slot.
  if nTotal > 0
    s_0_0 := {}  // aTmp
    aadd(s_0_0, "stays home")
    conout("rows: " + cValToChar(len(s_0_0)))
  endif

  // CONTAINED -- same usage under a different name, to show the two agree.
  if nTotal > 0
    s_0_0 := {}  // aOther
    aadd(s_0_0, "stays home")
    conout("rows: " + cValToChar(len(s_0_0)))
  endif

  // The name is reused a third time inside a loop, still contained.
  For s_0_0 := 1 To 3
    aTmp := {}
    aadd(aTmp, s_0_0)
    conout("pass " + cValToChar(len(aTmp)))
  next

  // A text handed on: the same -- a copy goes, the slot stays shared.
  if nTotal > 0
    s_0_0 := "value"  // cTmp
    keepIt(aKeep, s_0_0)
  endif

  return aKeep

// -----------------------------------------------------------------------------
// the end
