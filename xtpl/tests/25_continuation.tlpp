#include "totvs.ch"
#include "tlpp-core.th"

// 25_continuation.xtpl -- ';' continuations meeting the other passes.
//
// The lines are folded into one before any pass runs, so a construct may be
// split across them. A comment on a continued line has nowhere to sit once
// they are joined, so it moves to the end of the statement.
// -----------------------------------------------------------------------------

user function testContinuation(cUrl, cBody, aNums, hCfg)
  local nTimeout := 30
  local cReply := ""
  local aBig := {}
  local nT := 0
  local nA := 1, ;
        nB := 2
  Local gt_0_0  // the error block a 'fallback' sets aside
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local ffs_0_0  // the values distinct has seen
  Local fo_0_0  // the result of the chain

  gt_0_0 := ErrorBlock({|e| Break(e)})
  Begin Sequence
    cReply := HttpPost(cUrl, "", cBody, nTimeout, ;
                     {"Content-Type: application/json"})
  Recover
    cReply := ""
  End Sequence
  ErrorBlock(gt_0_0)

  ffs_0_0 := THashMap():New()
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aNums)
    fv_0_0 := aNums[fi_0_0]
    If fv_0_0 > 10
      If !u_xtpl_seen(ffs_0_0, fv_0_0)
        AAdd(fo_0_0, fv_0_0)
      EndIf
    EndIf
  Next
  aBig := fo_0_0                      // a comment on a continued line

  nT := u_xtpl_hget(hCfg, "a") + ;
        u_xtpl_hget(hCfg, "b")

  conout(cReply + cValToChar(len(aBig)))

  return nT + nA + nB

// -----------------------------------------------------------------------------
// the end
