#include "totvs.ch"
#include "tlpp-core.th"

// 55_envtest.tlpp -- rows(), lines(), using alias e raw, contra dados proprios.
//
// 54_selftest cobre o que e computacao pura. Estas quatro precisam de
// ambiente: uma area de trabalho, um arquivo, o pre-processador. Em vez de
// depender de uma tabela do dicionario, este arquivo CRIA o que precisa, usa,
// e apaga no fim.
//
// Rode com:  appserver.exe -env=SeuAmbiente -run=u_envtest
//
//    envtest: 23 ok, 0 falhas
//
// Cada bloco e guardado por si, entao uma parte que falhe nao impede as
// outras de rodar -- a fila no 54_selftest ensinou isso.
//
// A tabela se chama ZXTPL e o texto ZXTPL.TXT, nomes que nao devem colidir
// com nada. Os dois sao apagados no fim, inclusive se algo falhar no meio.
// --------------------------------------------------------------------------------

#xtranslate ANOTE <x> => envNota(<x>)


// A tabela e aberta por envTabela() e usada pelas outras: e exatamente para
// isto que 'external alias' existe.

user function envtest()

  Local nOk := 0
  Local nBad := 0
  Local aEstr := {}
  Local cDir := ""
  Local nTmp := 0
  Local cTmp := ""
  Local aTmp := {}
  Local lTmp := .F.

  Local b_2_cDentro  // o local de bloco 'cDentro', fixado: tem armazenamento so dele
  Local far_0_0      // a area que estava selecionada antes do percurso
  Local fn_0_0       // quantos elementos ja passaram
  Local fn_1_0       // quantos elementos ja passaram
  Local fo_0_0       // o resultado da cadeia
  Local fo_1_0       // o resultado da cadeia
  Local fok_1_0      // se o arquivo abriu
  Local frc_0_0      // o registro em que a area estava antes do percurso
  Local fs_1_0       // a colecao ou o caminho percorrido
  Local fv_0_0       // o elemento em percurso
  Local fv_1_0       // o elemento em percurso
  Local s_1_usearea  // o local de bloco 'usearea'
  Local s_1_userec   // o local de bloco 'userec'
  Local s_2_cLinha   // o local de bloco 'cLinha'
  Local s_2_each     // o local de bloco 'each'
  Local s_2_eachi    // o local de bloco 'eachi'
  Local s_2_opened   // o local de bloco 'opened'
  Private cEnvNota := ""

  // O comando raw escreve aqui. Uma PRIVATE vive enquanto a funcao que a
  // declarou estiver na pilha -- declarada num auxiliar que retorna na hora,
  // ela some antes de alguem ler. Entao e declarada AQUI.

  cDir := ""

  if !envConecta()
    return 1
  endif

  // ---- monta a tabela ----------------------------------------------------
  aadd(aEstr, {"ZX_COD", "C", 3, 0})
  aadd(aEstr, {"ZX_NOME", "C", 20, 0})
  aadd(aEstr, {"ZX_VALOR", "N", 10, 2})

  if !envTabela(aEstr)
    conout("envtest: nao consegui criar a tabela, nada mais pode rodar")
    envLimpa(cDir)
    return 1

  endif

  // ---- rows(): percorrer, filtrar, somar ---------------------------------
  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := 0

  While !ZXTPL->(Eof())
    fv_0_0 := ZXTPL->ZX_VALOR
    fo_0_0 := fo_0_0 + fv_0_0
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  nTmp := fo_0_0

  check("rows soma tudo", nTmp == 60, nTmp, @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := 0

  While !ZXTPL->(Eof())
    If ZXTPL->ZX_VALOR > 15
      fv_0_0 := ZXTPL->ZX_VALOR
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  nTmp := fo_0_0

  check("rows filtra", nTmp == 45, nTmp, @nOk, @nBad)  // 20 + 25

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := 0

  While !ZXTPL->(Eof())
    fo_0_0 := fo_0_0 + 1
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  nTmp := fo_0_0

  check("rows conta", nTmp == 4, nTmp, @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := 0

  While !ZXTPL->(Eof())
    If ZXTPL->ZX_COD == "002"
      fo_0_0 := fo_0_0 + 1
    EndIf
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  nTmp := fo_0_0

  check("rows conta com teste", nTmp == 1, nTmp, @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := {}

  While !ZXTPL->(Eof())
    fv_0_0 := alltrim(ZXTPL->ZX_COD)
    AAdd(fo_0_0, fv_0_0)
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  aTmp := fo_0_0

  check("rows na ordem", len(aTmp) == 4 .and. aTmp[1] == "001", len(aTmp), @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := .F.

  While !ZXTPL->(Eof())
    If ZXTPL->ZX_VALOR > 20
      fo_0_0 := .T.
      Exit
    EndIf
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  lTmp := fo_0_0  // o maior e 25

  check("rows anyof acha", lTmp, 0, @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := .F.

  While !ZXTPL->(Eof())
    If ZXTPL->ZX_VALOR > 999
      fo_0_0 := .T.
      Exit
    EndIf
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  lTmp := fo_0_0

  check("rows anyof nao acha", !lTmp, 0, @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fn_0_0 := 0
  fo_0_0 := 0

  While !ZXTPL->(Eof())
    fv_0_0 := ZXTPL->ZX_VALOR
    If fn_0_0 >= 2
      Exit
    EndIf
    fn_0_0 := fn_0_0 + 1
    fo_0_0 := fo_0_0 + fv_0_0
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  nTmp := fo_0_0

  check("rows para cedo", nTmp == 15, nTmp, @nOk, @nBad)

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := 0

  While !ZXTPL->(Eof())
    If !(ZXTPL->ZX_VALOR < 20)
      Exit
    EndIf
    fo_0_0 := fo_0_0 + 1
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  nTmp := fo_0_0

  check("rows takewhile", nTmp == 2, nTmp, @nOk, @nBad)

  // ---- rows() deixa a area como achou ------------------------------------
  DbSelectArea("ZXTPL")
  ZXTPL->(DbGoTop())
  ZXTPL->(DbSkip())
  nTmp := ZXTPL->(RecNo())
  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := {}

  While !ZXTPL->(Eof())
    fv_0_0 := ZXTPL->ZX_COD
    AAdd(fo_0_0, fv_0_0)
    ZXTPL->(DbSkip())
  EndDo

  ZXTPL->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  aTmp := fo_0_0

  check("rows devolve o registro", ZXTPL->(RecNo()) == nTmp, ZXTPL->(RecNo()), @nOk, @nBad)

  // ---- using alias -------------------------------------------------------
  ZXTPL->(DbGoTop())
  nTmp := ZXTPL->(RecNo())
  s_1_usearea := Alias()
  DbSelectArea("ZXTPL")
  s_1_userec := ZXTPL->(RecNo())
    ZXTPL->(DbSkip())
    ZXTPL->(DbSkip())
  ZXTPL->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

  check("using devolve o registro", ZXTPL->(RecNo()) == nTmp, ZXTPL->(RecNo()), @nOk, @nBad)

  cTmp := envUsingSai()
  check("using devolve no return", cTmp == "ZXTPL", cTmp, @nOk, @nBad)

  // ---- lines(): o arquivo texto ------------------------------------------
  if !envTexto(cDir)
    conout("envtest: nao consegui escrever o texto")
  else
    fs_1_0 := cDir + "ZXTPL.TXT"
    fok_1_0 := File(fs_1_0)
    If fok_1_0
      FT_FUse(fs_1_0)
      FT_FGoTop()
    EndIf
    fo_1_0 := {}
    While fok_1_0 .And. !FT_FEof()
      fv_1_0 := FT_FReadLn()
      AAdd(fo_1_0, fv_1_0)
      FT_FSkip()
    EndDo
    If fok_1_0
      FT_FUse()
    EndIf
    aTmp := fo_1_0

    check("lines le tudo", len(aTmp) == 5, len(aTmp), @nOk, @nBad)

    fs_1_0 := cDir + "ZXTPL.TXT"
    fok_1_0 := File(fs_1_0)
    If fok_1_0
      FT_FUse(fs_1_0)
      FT_FGoTop()
    EndIf
    fo_1_0 := 0
    While fok_1_0 .And. !FT_FEof()
      FT_FReadLn()
      fo_1_0 := fo_1_0 + 1
      FT_FSkip()
    EndDo
    If fok_1_0
      FT_FUse()
    EndIf
    nTmp := fo_1_0

    check("lines conta", nTmp == 5, nTmp, @nOk, @nBad)

    fs_1_0 := cDir + "ZXTPL.TXT"
    fok_1_0 := File(fs_1_0)
    If fok_1_0
      FT_FUse(fs_1_0)
      FT_FGoTop()
    EndIf
    fo_1_0 := {}
    While fok_1_0 .And. !FT_FEof()
      fv_1_0 := FT_FReadLn()
      If !empty(fv_1_0)
        fv_1_0 := alltrim(fv_1_0)
        AAdd(fo_1_0, fv_1_0)
      EndIf
      FT_FSkip()
    EndDo
    If fok_1_0
      FT_FUse()
    EndIf
    aTmp := fo_1_0

    check("lines filtra vazias", len(aTmp) == 4, len(aTmp), @nOk, @nBad)

    fs_1_0 := cDir + "ZXTPL.TXT"
    fok_1_0 := File(fs_1_0)
    If fok_1_0
      FT_FUse(fs_1_0)
      FT_FGoTop()
    EndIf
    fn_1_0 := 0
    fo_1_0 := {}
    While fok_1_0 .And. !FT_FEof()
      fv_1_0 := FT_FReadLn()
      If fn_1_0 >= 2
        Exit
      EndIf
      fn_1_0 := fn_1_0 + 1
      AAdd(fo_1_0, fv_1_0)
      FT_FSkip()
    EndDo
    If fok_1_0
      FT_FUse()
    EndIf
    aTmp := fo_1_0

    check("lines para cedo", len(aTmp) == 2 .and. alltrim(aTmp[1]) == "um", len(aTmp), @nOk, @nBad)

    fs_1_0 := cDir + "ZXTPL.TXT"
    fok_1_0 := File(fs_1_0)
    If fok_1_0
      FT_FUse(fs_1_0)
      FT_FGoTop()
    EndIf
    fo_1_0 := Nil
    While fok_1_0 .And. !FT_FEof()
      fv_1_0 := FT_FReadLn()
      fv_1_0 := alltrim(fv_1_0)
      If fv_1_0 == "tres"
        fo_1_0 := fv_1_0
        Exit
      EndIf
      FT_FSkip()
    EndDo
    If fok_1_0
      FT_FUse()
    EndIf
    cTmp := fo_1_0

    check("lines first", cTmp == "tres", cTmp, @nOk, @nBad)

    // for sobre lines, com loop e return antecipado
    nTmp := 0
    s_2_each := cDir + "ZXTPL.TXT"
    s_2_opened := File(s_2_each)
    If s_2_opened
      FT_FUse(s_2_each)
      FT_FGoTop()
    EndIf
    s_2_eachi := 0
    While s_2_opened .And. !FT_FEof()
      s_2_eachi := s_2_eachi + 1
      s_2_cLinha := FT_FReadLn()
      FT_FSkip()
      if empty(s_2_cLinha)
        loop
      endif
      nTmp := nTmp + 1
    EndDo
    If s_2_opened
      FT_FUse()
    EndIf
    check("for sobre lines, com loop", nTmp == 4, nTmp, @nOk, @nBad)

    nTmp := envLinhaAte(cDir, "tres")
    check("for sobre lines, return", nTmp == 4, nTmp, @nOk, @nBad)  // a vazia conta

    fs_1_0 := cDir + "NAOEXISTE.TXT"
    fok_1_0 := File(fs_1_0)
    If fok_1_0
      FT_FUse(fs_1_0)
      FT_FGoTop()
    EndIf
    fo_1_0 := {}
    While fok_1_0 .And. !FT_FEof()
      fv_1_0 := FT_FReadLn()
      AAdd(fo_1_0, fv_1_0)
      FT_FSkip()
    EndDo
    If fok_1_0
      FT_FUse()
    EndIf
    aTmp := fo_1_0

    check("lines de arquivo ausente", len(aTmp) == 0, len(aTmp), @nOk, @nBad)
  endif

  // ---- raw ---------------------------------------------------------------
  envZeraNota()
  ANOTE "de uma linha raw"
  check("raw de uma linha", envNotaFoi() == "de uma linha raw", envNotaFoi(), @nOk, @nBad)

  envZeraNota()
    ANOTE "de um bloco raw"
  check("raw em bloco", envNotaFoi() == "de um bloco raw", envNotaFoi(), @nOk, @nBad)

  // uma variavel declarada continua renomeada dentro do raw
  if .T.
    b_2_cDentro := "vem do bloco"
    envZeraNota()
    ANOTE b_2_cDentro
    check("raw renomeia o que e declarado", envNotaFoi() == "vem do bloco", envNotaFoi(), @nOk, @nBad)

  endif

  conout("envtest: " + cValToChar(nOk) + " ok, " + cValToChar(nBad) + " falhas")

envLimpa(cDir)
return nBad

// --------------------------------------------------------------------------------

static function check(cNome, lOk, xVisto, nOk, nBad)

  if lOk
    nOk := nOk + 1
  else
    nBad := nBad + 1
    conout("FALHA  " + cNome + "  (visto: " + cValToChar(xVisto) + ")")
  endif

return nil

// A conexao com o banco. Um job iniciado por '-run=' comeca sem nenhuma, e
// tudo que toca uma tabela falha ate isto rodar.
static function envConecta()

  Local nErro


  nErro := TCLink()

  if nErro < 0
    conout("envtest: TCLink falhou com " + cValToChar(nErro))
    return .F.
  endif

return .T.

// Cria a tabela se nao existir, esvazia, e poe quatro linhas em ordem
// crescente de valor. 'TOPCONN' e obrigatorio no DbCreate; sem ele erra.
static function envTabela(aEstr)

  if !TCCanOpen("ZXTPL")
    DbCreate("ZXTPL", aEstr, "TOPCONN")
  endif

  if !TCCanOpen("ZXTPL")
    conout("envtest: nao consegui criar ZXTPL")
    return .F.
  endif

  DbUseArea(.T., "TOPCONN", "ZXTPL", "ZXTPL", .F., .F.)

  if select("ZXTPL") == 0
    conout("envtest: ZXTPL nao abriu")
    return .F.
  endif

  __DbZap()

  envPoe("001", "primeiro", 5)
  envPoe("002", "segundo", 10)
  envPoe("003", "terceiro", 20)
  envPoe("004", "quarto", 25)

  ZXTPL->(DbGoTop())

return .T.

// DbAppend(.F.) e a forma que funciona aqui; RecLock e do ERP.
static function envPoe(cCod, cNome, nValor)

  ZXTPL->(DbAppend(.F.))
  ZXTPL->ZX_COD := cCod
  ZXTPL->ZX_NOME := cNome
  ZXTPL->ZX_VALOR := nValor
  ZXTPL->(DbCommit())
return nil

// Cinco linhas, uma delas vazia.
static function envTexto(cDir)

  Local cTexto


  cTexto := "um" + CRLF + "dois" + CRLF + "" + CRLF + "tres" + CRLF + "quatro"
return MemoWrite(cDir + "ZXTPL.TXT", cTexto)

// Um return antecipado de dentro de um for sobre lines: o arquivo tem de
// fechar na saida.
static function envLinhaAte(cDir, cProcurado)

  Local nOnde := 0

  Local s_1_cLinha  // o local de bloco 'cLinha'
  Local s_1_each    // o local de bloco 'each'
  Local s_1_nNum    // o local de bloco 'nNum'
  Local s_1_opened  // o local de bloco 'opened'

  s_1_each := cDir + "ZXTPL.TXT"
  s_1_opened := File(s_1_each)

  If s_1_opened
    FT_FUse(s_1_each)
    FT_FGoTop()
  EndIf

  s_1_nNum := 0

  While s_1_opened .And. !FT_FEof()
    s_1_nNum := s_1_nNum + 1
    s_1_cLinha := FT_FReadLn()
    FT_FSkip()
    If alltrim(s_1_cLinha) == cProcurado
      If s_1_opened
        FT_FUse()
      EndIf
      Return s_1_nNum
    EndIf

  EndDo

  If s_1_opened
    FT_FUse()
  EndIf

return nOnde

// Um return antecipado de dentro de um using: a area tem de voltar.
static function envUsingSai()

  Local cAntes

  Local s_1_usearea  // o local de bloco 'usearea'
  Local s_1_userec   // o local de bloco 'userec'

  cAntes := alias()

  s_1_usearea := Alias()
  DbSelectArea("ZXTPL")
  s_1_userec := ZXTPL->(RecNo())
    ZXTPL->(DbGoTop())
    ZXTPL->(DbGoto(s_1_userec))
    If !Empty(s_1_usearea)
      DbSelectArea(s_1_usearea)
    EndIf
    return alias()

  ZXTPL->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

return cAntes

// A nota que o comando raw escreve, guardada numa PRIVATE para o comando
// poder alcanca-la de onde for.
// A PRIVATE e de envtest(); aqui so se limpa o que ela guarda.
static function envZeraNota()

  cEnvNota := ""
return nil

// Um 'private' e conhecido no arquivo inteiro, entao nada aqui precisa de
// 'external' -- e 'external' recusaria a atribuicao de qualquer jeito.
static function envNota(cTexto)

  cEnvNota := cTexto
return nil

static function envNotaFoi()

return cEnvNota

// Fecha, apaga e desconecta, mesmo se algo falhou no meio.
static function envLimpa(cDir)

  if select("ZXTPL") > 0
    ZXTPL->(DbCloseArea())
  endif

  TCDelFile("ZXTPL")
  FErase(cDir + "ZXTPL.TXT")
  TCUnlink()
return nil

// --------------------------------------------------------------------------------
// the end