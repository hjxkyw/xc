#include "totvs.ch"
#include "tlpp-core.th"

// 55_envtest.xtpl -- rows(), lines(), using alias e raw, contra dados proprios.
//
// 54_selftest cobre o que e computacao pura. Estas quatro precisam de
// ambiente: uma area de trabalho, um arquivo, o pre-processador. Em vez de
// depender de uma tabela do dicionario, este arquivo CRIA o que precisa, usa,
// e apaga no fim.
//
// Rode com:  appserver.exe -env=SeuAmbiente -run=u_envtest
//
//    envtest: 23 ok, 0 falhas
//
// Cada bloco e guardado por si, entao uma parte que falhe nao impede as
// outras de rodar -- a fila no 54_selftest ensinou isso.
//
// A tabela se chama ZXTPL e o texto ZXTPL.TXT, nomes que nao devem colidir
// com nada. Os dois sao apagados no fim, inclusive se algo falhar no meio.
// -----------------------------------------------------------------------------

#xtranslate ANOTE <x> => envNota(<x>)

// vem de totvs.ch

// A tabela e aberta por envTabela() e usada pelas outras: e exatamente para
// isto que 'external alias' existe.

user function envtest()
  local nOk := 0
  local nBad := 0
  local aEstr := {}
  local cDir := ""
  local nTmp := 0
  local cTmp := ""
  local aTmp := {}
  local lTmp := .F.
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local far_0_2  // the area selected before the walk
  Local frc_0_2  // the record the area was on before the walk
  Local fo_0_2  // the result of the chain
  Local far_0_3  // the area selected before the walk
  Local frc_0_3  // the record the area was on before the walk
  Local fo_0_3  // the result of the chain
  Local far_0_4  // the area selected before the walk
  Local frc_0_4  // the record the area was on before the walk
  Local fv_0_2  // the element walked
  Local fo_0_4  // the result of the chain
  Local far_0_5  // the area selected before the walk
  Local frc_0_5  // the record the area was on before the walk
  Local fo_0_5  // the result of the chain
  Local far_0_6  // the area selected before the walk
  Local frc_0_6  // the record the area was on before the walk
  Local fo_0_6  // the result of the chain
  Local far_0_7  // the area selected before the walk
  Local frc_0_7  // the record the area was on before the walk
  Local fv_0_3  // the element walked
  Local fn_0_0  // how many elements have passed
  Local fo_0_7  // the result of the chain
  Local far_0_8  // the area selected before the walk
  Local frc_0_8  // the record the area was on before the walk
  Local fo_0_8  // the result of the chain
  Local far_0_9  // the area selected before the walk
  Local frc_0_9  // the record the area was on before the walk
  Local fv_0_4  // the element walked
  Local fo_0_9  // the result of the chain
  Local far_0_10  // the area selected before a 'using alias'
  Local frc_0_10  // the record the area was on before a 'using alias'
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened
  Local fv_0_5  // the element walked
  Local fo_0_10  // the result of the chain
  Local fs_0_1  // the path of the file walked
  Local fok_0_1  // whether the file opened
  Local fv_0_6  // the element walked
  Local fo_0_11  // the result of the chain
  Local fs_0_2  // the path of the file walked
  Local fok_0_2  // whether the file opened
  Local fv_0_7  // the element walked
  Local fo_0_12  // the result of the chain
  Local fs_0_3  // the path of the file walked
  Local fok_0_3  // whether the file opened
  Local fv_0_8  // the element walked
  Local fn_0_1  // how many elements have passed
  Local fo_0_13  // the result of the chain
  Local fs_0_4  // the path of the file walked
  Local fok_0_4  // whether the file opened
  Local fv_0_9  // the element walked
  Local fo_0_14  // the result of the chain
  Local cLinha  // a block local
  Local fs_0_5  // the path of the file walked
  Local fok_0_5  // whether the file opened
  Local fs_0_6  // the path of the file walked
  Local fok_0_6  // whether the file opened
  Local fv_0_10  // the element walked
  Local fo_0_15  // the result of the chain
  Local cDentro  // a block local

  // O comando raw escreve aqui. Uma PRIVATE vive enquanto a funcao que a
  // declarou estiver na pilha -- declarada num auxiliar que retorna na hora,
  // ela some antes de alguem ler. Entao e declarada AQUI.
  private cEnvNota := ""

  cDir := ""

  if !envConecta()
    return 1
  endif


  // ---- monta a tabela ----------------------------------------------------
  aadd(aEstr, {"ZX_COD", "C", 3, 0})
  aadd(aEstr, {"ZX_NOME", "C", 20, 0})
  aadd(aEstr, {"ZX_VALOR", "N", 10, 2})

  if !envTabela(aEstr)
    conout("envtest: nao consegui criar a tabela, nada mais pode rodar")
    envLimpa(cDir)
    return 1
  endif

  // ---- rows(): percorrer, filtrar, somar ---------------------------------
  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_0 := 0
  While !ZXTPL->(Eof())
    fv_0_0 := ZXTPL->ZX_VALOR
    fo_0_0 := fo_0_0 + fv_0_0
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  nTmp := fo_0_0
  check("rows soma tudo", nTmp == 60, nTmp, @nOk, @nBad)

  far_0_1 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_1 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_1 := 0
  While !ZXTPL->(Eof())
    If ZXTPL->ZX_VALOR > 15
      fv_0_1 := ZXTPL->ZX_VALOR
      fo_0_1 := fo_0_1 + fv_0_1
    EndIf
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_1))
  If !Empty(far_0_1)
    DbSelectArea(far_0_1)
  EndIf
  nTmp := fo_0_1
  check("rows filtra", nTmp == 45, nTmp, @nOk, @nBad)   // 20 + 25

  far_0_2 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_2 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_2 := 0
  While !ZXTPL->(Eof())
    fo_0_2++
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_2))
  If !Empty(far_0_2)
    DbSelectArea(far_0_2)
  EndIf
  nTmp := fo_0_2
  check("rows conta", nTmp == 4, nTmp, @nOk, @nBad)

  far_0_3 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_3 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_3 := 0
  While !ZXTPL->(Eof())
    If ZXTPL->ZX_COD == "002"
      fo_0_3++
    EndIf
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_3))
  If !Empty(far_0_3)
    DbSelectArea(far_0_3)
  EndIf
  nTmp := fo_0_3
  check("rows conta com teste", nTmp == 1, nTmp, @nOk, @nBad)

  far_0_4 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_4 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_4 := {}
  While !ZXTPL->(Eof())
    fv_0_2 := alltrim(ZXTPL->ZX_COD)
    AAdd(fo_0_4, fv_0_2)
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_4))
  If !Empty(far_0_4)
    DbSelectArea(far_0_4)
  EndIf
  aTmp := fo_0_4
  check("rows na ordem", len(aTmp) == 4 .and. aTmp[1] == "001", len(aTmp), @nOk, @nBad)

  far_0_5 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_5 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_5 := .F.
  While !ZXTPL->(Eof())
    If ZXTPL->ZX_VALOR > 20
      fo_0_5 := .T.
      Exit
    EndIf
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_5))
  If !Empty(far_0_5)
    DbSelectArea(far_0_5)
  EndIf
  lTmp := fo_0_5                                        // o maior e 25
  check("rows anyof acha", lTmp, 0, @nOk, @nBad)

  far_0_6 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_6 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_6 := .F.
  While !ZXTPL->(Eof())
    If ZXTPL->ZX_VALOR > 999
      fo_0_6 := .T.
      Exit
    EndIf
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_6))
  If !Empty(far_0_6)
    DbSelectArea(far_0_6)
  EndIf
  lTmp := fo_0_6
  check("rows anyof nao acha", !lTmp, 0, @nOk, @nBad)

  far_0_7 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_7 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fn_0_0 := 0
  fo_0_7 := 0
  While !ZXTPL->(Eof())
    fv_0_3 := ZXTPL->ZX_VALOR
    If fn_0_0 >= 2
      Exit
    EndIf
    fn_0_0++
    fo_0_7 := fo_0_7 + fv_0_3
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_7))
  If !Empty(far_0_7)
    DbSelectArea(far_0_7)
  EndIf
  nTmp := fo_0_7
  check("rows para cedo", nTmp == 15, nTmp, @nOk, @nBad)

  far_0_8 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_8 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_8 := 0
  While !ZXTPL->(Eof())
    If !(ZXTPL->ZX_VALOR < 20)
      Exit
    EndIf
    fo_0_8++
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_8))
  If !Empty(far_0_8)
    DbSelectArea(far_0_8)
  EndIf
  nTmp := fo_0_8
  check("rows takewhile", nTmp == 2, nTmp, @nOk, @nBad)

  // ---- rows() deixa a area como achou ------------------------------------
  DbSelectArea("ZXTPL")
  ZXTPL->(DbGoTop())
  ZXTPL->(DbSkip())
  nTmp := ZXTPL->(RecNo())
  far_0_9 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_9 := ZXTPL->(RecNo())
  ZXTPL->(DbGoTop())
  fo_0_9 := {}
  While !ZXTPL->(Eof())
    fv_0_4 := ZXTPL->ZX_COD
    AAdd(fo_0_9, fv_0_4)
    ZXTPL->(DbSkip())
  EndDo
  ZXTPL->(DbGoto(frc_0_9))
  If !Empty(far_0_9)
    DbSelectArea(far_0_9)
  EndIf
  aTmp := fo_0_9
  check("rows devolve o registro", ZXTPL->(RecNo()) == nTmp, ZXTPL->(RecNo()), @nOk, @nBad)

  // ---- using alias -------------------------------------------------------
  ZXTPL->(DbGoTop())
  nTmp := ZXTPL->(RecNo())
  far_0_10 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_10 := ZXTPL->(RecNo())
    ZXTPL->(DbSkip())
    ZXTPL->(DbSkip())
  ZXTPL->(DbGoto(frc_0_10))
  If !Empty(far_0_10)
    DbSelectArea(far_0_10)
  EndIf
  check("using devolve o registro", ZXTPL->(RecNo()) == nTmp, ZXTPL->(RecNo()), @nOk, @nBad)

  cTmp := envUsingSai()
  check("using devolve no return", cTmp == "ZXTPL", cTmp, @nOk, @nBad)

  // ---- lines(): o arquivo texto ------------------------------------------
  if !envTexto(cDir)
    conout("envtest: nao consegui escrever o texto")
  else
    fs_0_0 := cDir + "ZXTPL.TXT"
    fok_0_0 := File(fs_0_0)
    If fok_0_0
      FT_FUse(fs_0_0)
      FT_FGoTop()
    EndIf
    fo_0_10 := {}
    While fok_0_0 .And. !FT_FEof()
      fv_0_5 := FT_FReadLn()
      AAdd(fo_0_10, fv_0_5)
      FT_FSkip()
    EndDo
    If fok_0_0
      FT_FUse()
    EndIf
    aTmp := fo_0_10
    check("lines le tudo", len(aTmp) == 5, len(aTmp), @nOk, @nBad)

    fs_0_1 := cDir + "ZXTPL.TXT"
    fok_0_1 := File(fs_0_1)
    If fok_0_1
      FT_FUse(fs_0_1)
      FT_FGoTop()
    EndIf
    fo_0_11 := 0
    While fok_0_1 .And. !FT_FEof()
      fv_0_6 := FT_FReadLn()
      fo_0_11++
      FT_FSkip()
    EndDo
    If fok_0_1
      FT_FUse()
    EndIf
    nTmp := fo_0_11
    check("lines conta", nTmp == 5, nTmp, @nOk, @nBad)

    fs_0_2 := cDir + "ZXTPL.TXT"
    fok_0_2 := File(fs_0_2)
    If fok_0_2
      FT_FUse(fs_0_2)
      FT_FGoTop()
    EndIf
    fo_0_12 := {}
    While fok_0_2 .And. !FT_FEof()
      fv_0_7 := FT_FReadLn()
      If !empty(fv_0_7)
        fv_0_7 := alltrim(fv_0_7)
        AAdd(fo_0_12, fv_0_7)
      EndIf
      FT_FSkip()
    EndDo
    If fok_0_2
      FT_FUse()
    EndIf
    aTmp := fo_0_12
    check("lines filtra vazias", len(aTmp) == 4, len(aTmp), @nOk, @nBad)

    fs_0_3 := cDir + "ZXTPL.TXT"
    fok_0_3 := File(fs_0_3)
    If fok_0_3
      FT_FUse(fs_0_3)
      FT_FGoTop()
    EndIf
    fn_0_1 := 0
    fo_0_13 := {}
    While fok_0_3 .And. !FT_FEof()
      fv_0_8 := FT_FReadLn()
      If fn_0_1 >= 2
        Exit
      EndIf
      fn_0_1++
      AAdd(fo_0_13, fv_0_8)
      FT_FSkip()
    EndDo
    If fok_0_3
      FT_FUse()
    EndIf
    aTmp := fo_0_13
    check("lines para cedo", len(aTmp) == 2 .and. alltrim(aTmp[1]) == "um", len(aTmp), @nOk, @nBad)

    fs_0_4 := cDir + "ZXTPL.TXT"
    fok_0_4 := File(fs_0_4)
    If fok_0_4
      FT_FUse(fs_0_4)
      FT_FGoTop()
    EndIf
    fo_0_14 := Nil
    While fok_0_4 .And. !FT_FEof()
      fv_0_9 := FT_FReadLn()
      fv_0_9 := alltrim(fv_0_9)
      If fv_0_9 == "tres"
        fo_0_14 := fv_0_9
        Exit
      EndIf
      FT_FSkip()
    EndDo
    If fok_0_4
      FT_FUse()
    EndIf
    cTmp := fo_0_14
    check("lines first", cTmp == "tres", cTmp, @nOk, @nBad)

    // for sobre lines, com loop e return antecipado
    nTmp := 0
    fs_0_5 := cDir + "ZXTPL.TXT"
    fok_0_5 := File(fs_0_5)
    If fok_0_5
      FT_FUse(fs_0_5)
      FT_FGoTop()
    EndIf
    While fok_0_5 .And. !FT_FEof()
      cLinha := FT_FReadLn()
      FT_FSkip()
      if empty(cLinha)
        loop
      endif
      nTmp := nTmp + 1
    EndDo
    If fok_0_5
      FT_FUse()
    EndIf
    check("for sobre lines, com loop", nTmp == 4, nTmp, @nOk, @nBad)

    nTmp := envLinhaAte(cDir, "tres")
    check("for sobre lines, return", nTmp == 4, nTmp, @nOk, @nBad)  // a vazia conta

    fs_0_6 := cDir + "NAOEXISTE.TXT"
    fok_0_6 := File(fs_0_6)
    If fok_0_6
      FT_FUse(fs_0_6)
      FT_FGoTop()
    EndIf
    fo_0_15 := {}
    While fok_0_6 .And. !FT_FEof()
      fv_0_10 := FT_FReadLn()
      AAdd(fo_0_15, fv_0_10)
      FT_FSkip()
    EndDo
    If fok_0_6
      FT_FUse()
    EndIf
    aTmp := fo_0_15
    check("lines de arquivo ausente", len(aTmp) == 0, len(aTmp), @nOk, @nBad)
  endif

  // ---- raw ---------------------------------------------------------------
  envZeraNota()
  ANOTE "de uma linha raw"
  check("raw de uma linha", envNotaFoi() == "de uma linha raw", envNotaFoi(), @nOk, @nBad)

  envZeraNota()
    ANOTE "de um bloco raw"
  check("raw em bloco", envNotaFoi() == "de um bloco raw", envNotaFoi(), @nOk, @nBad)

  // uma variavel declarada continua renomeada dentro do raw
  if .T.
    cDentro := "vem do bloco"
    envZeraNota()
    ANOTE cDentro
    check("raw renomeia o que e declarado", envNotaFoi() == "vem do bloco", ;
          envNotaFoi(), @nOk, @nBad)
  endif

  conout("envtest: " + cValToChar(nOk) + " ok, " + cValToChar(nBad) + " falhas")

  envLimpa(cDir)
return nBad

// -----------------------------------------------------------------------------

static function check(cNome, lOk, xVisto, nOk, nBad)
  if lOk
    nOk := nOk + 1
  else
    nBad := nBad + 1
    conout("FALHA  " + cNome + "  (visto: " + cValToChar(xVisto) + ")")
  endif
return nil

// A conexao com o banco. Um job iniciado por '-run=' comeca sem nenhuma, e
// tudo que toca uma tabela falha ate isto rodar.
static function envConecta()
  local nErro := TCLink()

  if nErro < 0
    conout("envtest: TCLink falhou com " + cValToChar(nErro))
    return .F.
  endif

return .T.

// Cria a tabela se nao existir, esvazia, e poe quatro linhas em ordem
// crescente de valor. 'TOPCONN' e obrigatorio no DbCreate; sem ele erra.
static function envTabela(aEstr)

  if !TCCanOpen("ZXTPL")
    DbCreate("ZXTPL", aEstr, "TOPCONN")
  endif

  if !TCCanOpen("ZXTPL")
    conout("envtest: nao consegui criar ZXTPL")
    return .F.
  endif

  DbUseArea(.T., "TOPCONN", "ZXTPL", "ZXTPL", .F., .F.)

  if select("ZXTPL") == 0
    conout("envtest: ZXTPL nao abriu")
    return .F.
  endif

  __DbZap()

  envPoe("001", "primeiro", 5)
  envPoe("002", "segundo", 10)
  envPoe("003", "terceiro", 20)
  envPoe("004", "quarto", 25)

  ZXTPL->(DbGoTop())

return .T.

// DbAppend(.F.) e a forma que funciona aqui; RecLock e do ERP.
static function envPoe(cCod, cNome, nValor)
  ZXTPL->(DbAppend(.F.))
  ZXTPL->ZX_COD := cCod
  ZXTPL->ZX_NOME := cNome
  ZXTPL->ZX_VALOR := nValor
  ZXTPL->(DbCommit())
return nil

// Cinco linhas, uma delas vazia.
static function envTexto(cDir)
  local cTexto := "um" + CRLF + "dois" + CRLF + "" + CRLF + "tres" + CRLF + "quatro"
return MemoWrite(cDir + "ZXTPL.TXT", cTexto)

// Um return antecipado de dentro de um for sobre lines: o arquivo tem de
// fechar na saida.
static function envLinhaAte(cDir, cProcurado)
  local nOnde := 0
  Local cLinha  // a block local
  Local nNum  // a block local
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened

  fs_0_0 := cDir + "ZXTPL.TXT"
  fok_0_0 := File(fs_0_0)
  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf
  nNum := 0
  While fok_0_0 .And. !FT_FEof()
    nNum++
    cLinha := FT_FReadLn()
    FT_FSkip()
    If alltrim(cLinha) == cProcurado
      If fok_0_0
        FT_FUse()
      EndIf
      return nNum
    EndIf
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf

return nOnde

// Um return antecipado de dentro de um using: a area tem de voltar.
static function envUsingSai()
  local cAntes := alias()
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'

  far_0_0 := Alias()
  DbSelectArea("ZXTPL")
  frc_0_0 := ZXTPL->(RecNo())
    ZXTPL->(DbGoTop())
    ZXTPL->(DbGoto(frc_0_0))
    If !Empty(far_0_0)
      DbSelectArea(far_0_0)
    EndIf
    return alias()
  ZXTPL->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

return cAntes

// A nota que o comando raw escreve, guardada numa PRIVATE para o comando
// poder alcanca-la de onde for.
// A PRIVATE e de envtest(); aqui so se limpa o que ela guarda.
static function envZeraNota()
  cEnvNota := ""
return nil

// Um 'private' e conhecido no arquivo inteiro, entao nada aqui precisa de
// 'external' -- e 'external' recusaria a atribuicao de qualquer jeito.
static function envNota(cTexto)
  cEnvNota := cTexto
return nil

static function envNotaFoi()
return cEnvNota

// Fecha, apaga e desconecta, mesmo se algo falhou no meio.
static function envLimpa(cDir)
  if select("ZXTPL") > 0
    ZXTPL->(DbCloseArea())
  endif
  TCDelFile("ZXTPL")
  FErase(cDir + "ZXTPL.TXT")
  TCUnlink()
return nil

// -----------------------------------------------------------------------------
// the end
