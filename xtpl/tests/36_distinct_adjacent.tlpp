#include "totvs.ch"
#include "tlpp-core.th"

// 36_distinct_adjacent.xtpl -- adjacent dedup, and the largest element.
//
// distinctAdjacent drops ADJACENT duplicates -- 'distinctAdjacent' in the Unix sense, not 'distinct'
// in the SQL one. It compares each element against the previous, so it is one
// pass holding one value, where distinct compares against everything kept so
// far and blocks fusion. Over unsorted input they give different answers.
//
// maxby gives the largest ELEMENT by a key, where amax gives the largest key
// and loses the row it came from. Otherwise you sort everything to look at
// one of them.
// -----------------------------------------------------------------------------

user function testUniqMaxby(aRows)
  local aPedidos := {}
  local oMaior := Nil
  local oMenor := Nil
  local aNumeros := {}
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fop_0_0  // whether distinctAdjacent has seen an element
  Local fls_0_0  // the key distinctAdjacent saw last
  Local fpb_0_0  // the key of the element distinctAdjacent looks at
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fbs_0_0  // the best key maxby/minby has seen
  Local fop_0_1  // whether maxby/minby has seen an element
  Local fpb_0_1  // the key of the element maxby/minby looks at
  Local fi_0_2  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local fbs_0_1  // the best key maxby/minby has seen
  Local fop_0_2  // whether maxby/minby has seen an element
  Local fpb_0_2  // the key of the element maxby/minby looks at
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fop_0_3  // whether distinctAdjacent has seen an element
  Local fls_0_1  // the key distinctAdjacent saw last
  Local fpb_0_3  // the key of the element distinctAdjacent looks at
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain

  // no key: compares the element itself
  fop_0_0 := .F.
  fls_0_0 := Nil
  fpb_0_0 := Nil
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:cPedido
    fpb_0_0 := fv_0_0
    If !(fop_0_0 .And. (fpb_0_0 == fls_0_0))
      fop_0_0 := .T.
      fls_0_0 := fpb_0_0
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  aPedidos := fo_0_0

  fbs_0_0 := Nil
  fop_0_1 := .F.
  fpb_0_1 := Nil
  fo_0_1 := Nil
  For fi_0_1 := 1 To Len(aRows)
    fv_0_1 := aRows[fi_0_1]
    fv_0_1 := fv_0_1:oPed
    fpb_0_1 := fv_0_1:nValor
    If !fop_0_1 .Or. fpb_0_1 > fbs_0_0
      fop_0_1 := .T.
      fbs_0_0 := fpb_0_1
      fo_0_1 := fv_0_1
    EndIf
  Next
  oMaior := fo_0_1
  fbs_0_1 := Nil
  fop_0_2 := .F.
  fpb_0_2 := Nil
  fo_0_2 := Nil
  For fi_0_2 := 1 To Len(aRows)
    fv_0_2 := aRows[fi_0_2]
    fv_0_2 := fv_0_2:oPed
    fpb_0_2 := fv_0_2:nValor
    If !fop_0_2 .Or. fpb_0_2 < fbs_0_1
      fop_0_2 := .T.
      fbs_0_1 := fpb_0_2
      fo_0_2 := fv_0_2
    EndIf
  Next
  oMenor := fo_0_2

  // over an ordered table: the distinct order numbers, in one pass
  far_0_0 := Alias()
  DbSelectArea("SC6")
  frc_0_0 := SC6->(RecNo())
  fol_0_0 := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    far_0_1 := Alias()
    DbSelectArea("SC6")
    frc_0_1 := SC6->(RecNo())
    SC6->(DbGoTop())
    fop_0_3 := .F.
    fls_0_1 := Nil
    fpb_0_3 := Nil
    fo_0_3 := {}
    While !SC6->(Eof())
      fpb_0_3 := SC6->C6_NUM
      If !(fop_0_3 .And. (fpb_0_3 == fls_0_1))
        fop_0_3 := .T.
        fls_0_1 := fpb_0_3
        fv_0_3 := SC6->C6_NUM
        AAdd(fo_0_3, fv_0_3)
      EndIf
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_0_1))
    If !Empty(far_0_1)
      DbSelectArea(far_0_1)
    EndIf
    aNumeros := fo_0_3
  SC6->(DbSetOrder(fol_0_0))
  SC6->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  conout(cValToChar(oMaior != Nil) + cValToChar(oMenor != Nil))

  return len(aPedidos) + len(aNumeros)

// -----------------------------------------------------------------------------
// the end
