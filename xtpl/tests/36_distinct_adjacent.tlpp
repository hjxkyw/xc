#include "totvs.ch"
#include "tlpp-core.th"

// 36_distinct_adjacent.tlpp -- adjacent dedup, and the largest element.
//
// distinctAdjacent drops ADJACENT duplicates -- 'distinctAdjacent' in the Unix sense, not 'distinct'
// in the SQL one. It compares each element against the previous, so it is one
// pass holding one value, where distinct compares against everything kept so
// far and blocks fusion. Over unsorted input they give different answers.
//
// maxby gives the largest ELEMENT by a key, where amax gives the largest key
// and loses the row it came from. Otherwise you sort everything to look at
// one of them.
// --------------------------------------------------------------------------------

user function testUniqMaxby(aRows)

  Local aPedidos := {}
  Local oMaior := Nil
  Local oMenor := Nil
  Local aNumeros := {}

  Local fbs_0_0      // o melhor encontrado ate agora (maxby/minby)
  Local fi_0_0       // o indice do percurso
  Local fls_0_0      // o elemento anterior (pairwise)
  Local fls_1_0      // o elemento anterior (pairwise)
  Local fo_0_0       // o resultado da cadeia
  Local fo_1_0       // o resultado da cadeia
  Local fop_0_0      // se ha um pedaco aberto (chunkby)
  Local fop_1_0      // se ha um pedaco aberto (chunkby)
  Local fpb_0_0      // o valor testado a cada volta
  Local fpb_1_0      // o valor testado a cada volta
  Local frc_1_0      // o registro em que a area estava antes do percurso
  Local fv_0_0       // o elemento em percurso
  Local fv_1_0       // o elemento em percurso
  Local s_1_usearea  // o local de bloco 'usearea'
  Local s_1_useord   // o local de bloco 'useord'
  Local s_1_userec   // o local de bloco 'userec'

  // no key: compares the element itself
  fop_0_0 := .F.
  fls_0_0 := Nil
  fpb_0_0 := Nil
  fo_0_0 := {}

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:cPedido
    fpb_0_0 := fv_0_0
    If !(fop_0_0 .And. (fpb_0_0 == fls_0_0))
      fop_0_0 := .T.
      fls_0_0 := fpb_0_0
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next

  aPedidos := fo_0_0

  fbs_0_0 := Nil
  fop_0_0 := .F.
  fpb_0_0 := Nil
  fo_0_0 := Nil

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:oPed
    fpb_0_0 := fv_0_0:nValor
    If !fop_0_0 .Or. fpb_0_0 > fbs_0_0
      fop_0_0 := .T.
      fbs_0_0 := fpb_0_0
      fo_0_0 := fv_0_0
    EndIf
  Next

  oMaior := fo_0_0

  fbs_0_0 := Nil
  fop_0_0 := .F.
  fpb_0_0 := Nil
  fo_0_0 := Nil

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:oPed
    fpb_0_0 := fv_0_0:nValor
    If !fop_0_0 .Or. fpb_0_0 < fbs_0_0
      fop_0_0 := .T.
      fbs_0_0 := fpb_0_0
      fo_0_0 := fv_0_0
    EndIf
  Next

  oMenor := fo_0_0

  // over an ordered table: the distinct order numbers, in one pass
  s_1_usearea := Alias()
  DbSelectArea("SC6")
  s_1_userec := SC6->(RecNo())
  s_1_useord := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    frc_1_0 := SC6->(RecNo())
    SC6->(DbGoTop())
    fop_1_0 := .F.
    fls_1_0 := Nil
    fpb_1_0 := Nil
    fo_1_0 := {}
    While !SC6->(Eof())
      fpb_1_0 := SC6->C6_NUM
      If !(fop_1_0 .And. (fpb_1_0 == fls_1_0))
        fop_1_0 := .T.
        fls_1_0 := fpb_1_0
        fv_1_0 := SC6->C6_NUM
        AAdd(fo_1_0, fv_1_0)
      EndIf
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_1_0))
    aNumeros := fo_1_0

  SC6->(DbSetOrder(s_1_useord))
  SC6->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

  conout(cValToChar(oMaior != Nil) + cValToChar(oMenor != Nil))

  return len(aPedidos) + len(aNumeros)

// --------------------------------------------------------------------------------
// the end