#include "totvs.ch"
#include "tlpp-core.th"

// 10_operators.xtpl -- in, %%, the folds, and external
// -----------------------------------------------------------------------------

// CRLF and the STR constants come from headers this transpiler cannot read

user function testOperators(nValor, cCodigo, aCodigos, aNums)
  local nTotal := 0
  local lAchou := .F.
  local cMsg := ""
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain

  // folds: named functions, not operators, so they chain too
  nTotal := u_xtpl_asum(aNums)
  nTotal := u_xtpl_aprod(aNums)
  nTotal := u_xtpl_amax(aNums)
  nTotal := u_xtpl_amin(aNums)
  fo_0_0 := 0
  For fi_0_0 := 1 To Len(aNums)
    fv_0_0 := aNums[fi_0_0]
    If fv_0_0 > 10
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
  Next
  nTotal := fo_0_0

  // fold() for anything the four do not cover
  fo_0_1 := Nil
  For fi_0_1 := 1 To Len(aNums)
    fv_0_1 := aNums[fi_0_1]
    If fo_0_1 == Nil
      fo_0_1 := fv_0_1
    Else
      fo_0_1 := Max(fo_0_1, fv_0_1 * 2)
    EndIf
  Next
  nTotal := fo_0_1

  // membership: '$' searches a string only, so an array needs aScan
  lAchou := u_xtpl_in(cCodigo, aCodigos)

  // a range is two comparisons and needs no runtime
  lAchou := (nValor >= 1 .And. nValor <= 100)

  // o lado esquerdo pode ser um literal, nao so um nome -- vale para os dois
  lAchou := ((9 % 3) == 0)
  lAchou := u_xtpl_in(5, aNums)
  lAchou := u_xtpl_in("ABC", aCodigos)
  lAchou := (7 >= 1 .And. 7 <= 100)

  if u_xtpl_in(cCodigo, aCodigos) .and. (nValor >= 1 .And. nValor <= 100)
    cMsg := dtoc(dDataBase)
  endif

  // divisible by
  if ((nValor % 3) == 0)
    nTotal := nTotal + 1
  endif

  if ((nTotal % 2) == 0) .and. u_xtpl_in(nValor, aNums)
    nTotal := nTotal + 2
  endif

  // '%' itself is AdvPL's own modulo and passes through
  nTotal := nTotal + (nValor % 7)

  conout(cMsg + CRLF + cValToChar(lAchou))

  return nTotal

// -----------------------------------------------------------------------------
// the end
