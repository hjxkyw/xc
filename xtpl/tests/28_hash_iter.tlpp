#include "totvs.ch"
#include "tlpp-core.th"

// 28_hash_iter.xtpl -- keys, values and pairs.
//
// 'for' walks arrays, so a hash could not be iterated at all -- it was
// invisible to the whole pipeline. These return arrays, so nothing else
// needed changing: 'for', the chain, the verbs and interpolation all compose
// with them as they stand.
//
// They go through THashMap:List(), which fills an array with one row per
// entry, key in column 1 and value in column 2.
// -----------------------------------------------------------------------------

user function testHashIter(hCfg, hSaldos)
  local aMv := {}
  local nTotal := 0
  local cLista := ""
  local lVazio := .F.
  local aPares := {}
  Local cChave  // a block local
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_0  // the counter of a 'for ... in'
  Local fs_0_1  // the array walked
  Local fi_0_1  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fs_0_2  // the array walked
  Local fi_0_2  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fs_0_3  // the array walked
  Local fi_0_3  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain

  // a hash can be walked now
  fs_0_0 := u_xtpl_keys(hCfg)
  For fi_0_0 := 1 To Len(fs_0_0)
    cChave := fs_0_0[fi_0_0]
    conout((cValToChar(cChave) + " = " + cValToChar(u_xtpl_hget(hCfg, cChave))))
  next

  nTotal := u_xtpl_asum(u_xtpl_values(hSaldos))
  fs_0_1 := u_xtpl_keys(hCfg)
  fo_0_0 := {}
  For fi_0_1 := 1 To Len(fs_0_1)
    fv_0_0 := fs_0_1[fi_0_1]
    If u_xtpl_starts(fv_0_0, "MV_")
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  aMv := fo_0_0
  cLista := u_xtpl_join(u_xtpl_sort(u_xtpl_keys(hCfg)), ", ")
  fs_0_2 := u_xtpl_keys(hCfg)
  fo_0_1 := .T.
  For fi_0_2 := 1 To Len(fs_0_2)
    fv_0_1 := fs_0_2[fi_0_2]
    If .T.
      fo_0_1 := .F.
      Exit
    EndIf
  Next
  lVazio := fo_0_1

  // pairs keeps them together: {chave, valor} per row
  fs_0_3 := u_xtpl_pairs(hCfg)
  fo_0_2 := {}
  For fi_0_3 := 1 To Len(fs_0_3)
    fv_0_2 := fs_0_3[fi_0_3]
    If !(fv_0_2[2] == Nil)
      AAdd(fo_0_2, fv_0_2)
    EndIf
  Next
  aPares := fo_0_2

  return nTotal + len(aMv) + len(cLista) + len(aPares) + iif(lVazio, 1, 0)

// -----------------------------------------------------------------------------
// the end
