#include "totvs.ch"
#include "tlpp-core.th"

// 31_feed.xtpl -- '=>' chaining, the fold operators, and 'fallback'
//
// '=>' has exactly one rule: the value on the left becomes the first
// argument of the stage on the right. It knows nothing about the runtime,
// so it composes runtime functions and your own helpers identically.
// -----------------------------------------------------------------------------

user function testFeed(aOrders, aNums)
  local aCodes := {}
  local aTop := {}
  local nTotal := 0
  local nMax := 0
  local nSafe := 0
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fi_0_2  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local gt_0_0  // the error block a 'fallback' sets aside
  Local fi_0_3  // the position in the array walked
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain

  // chaining runtime functions
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aOrders)
    fv_0_0 := aOrders[fi_0_0]
    If fv_0_0:nValue > 1000
      fv_0_0 := fv_0_0:cCode
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  aCodes := fo_0_0
  aTop := u_xtpl_take(u_xtpl_sortby(aOrders, {|o| o:nValue}, .T.), 10)

  // a stage with no arguments needs no parentheses
  aCodes := u_xtpl_reverse(u_xtpl_distinct(aNums))

  // the same rule covers a function of your own
  aCodes := sortRows(myOwnHelper(aOrders, 3))

  // folding: named functions, not operators. The 'a' prefix keeps amax and
  // amin clear of AdvPL's own two-argument Max and Min.
  nTotal := u_xtpl_asum(aNums)
  nMax := u_xtpl_amax(aNums)
  nTotal := u_xtpl_asum(u_xtpl_map(aOrders, {|o| o:nValue}))

  // and as a chain stage, since they are ordinary calls
  fo_0_1 := 0
  For fi_0_1 := 1 To Len(aOrders)
    fv_0_1 := aOrders[fi_0_1]
    If fv_0_1:lPaid
      fv_0_1 := fv_0_1:nValue
      fo_0_1 := fo_0_1 + fv_0_1
    EndIf
  Next
  nTotal := fo_0_1

  // a chain inside an expression is lifted into its own statement first
  nTotal := len(u_xtpl_distinct(aNums))
  nTotal := len(u_xtpl_filter(aNums, {|x| x > 100})) + len(aOrders)

  // reduce chains like any other call, so no parentheses are needed
  fo_0_2 := 0
  For fi_0_2 := 1 To Len(aOrders)
    fv_0_2 := aOrders[fi_0_2]
    fv_0_2 := fv_0_2:nValue
    fo_0_2 := fo_0_2 + fv_0_2
  Next
  nTotal := fo_0_2

  // the lifted result can be indexed like any other expression
  nTotal := len(aNums) + (u_xtpl_distinct(aNums))[1]

  // run for its effects: no assignment, so no result is kept
  sortRows(myOwnHelper(aOrders, 3))

  // fallback guards a bare call, a chain, or a return
  gt_0_0 := ErrorBlock({|e| Break(e)})
  Begin Sequence
    nSafe := riskyCall(1)
  Recover
    nSafe := 0
  End Sequence
  ErrorBlock(gt_0_0)
  gt_0_0 := ErrorBlock({|e| Break(e)})
  Begin Sequence
    fo_0_3 := 0
    For fi_0_3 := 1 To Len(aNums)
      fv_0_3 := aNums[fi_0_3]
      If fv_0_3 > 100
        fo_0_3 := fo_0_3 + fv_0_3
      EndIf
    Next
    nSafe := fo_0_3
  Recover
    nSafe := 0
  End Sequence
  ErrorBlock(gt_0_0)

  conout(cValToChar(nMax) + cValToChar(nSafe))

  return nTotal

// -----------------------------------------------------------------------------
// the end
