#include "totvs.ch"
#include "tlpp-core.th"

// 37_chunkby.xtpl -- grouping consecutive elements by a key.
//
// It cuts the sequence where the key changes rather than gathering scattered
// matches, which is what lets it run in one pass holding only one group at a
// time. Over unsorted input it will return the same key more than once --
// this is not GROUP BY.
//
// A flag marks whether a group is open, rather than comparing the key against
// Nil: Nil is a legitimate key, and the first element has to open the first
// group either way.
// -----------------------------------------------------------------------------

user function testChunkby(aRows, cNum)
  local aPedidos := {}
  local aGrupos := {}
  local aTamanhos := {}
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fch_0_0  // the chunk chunkby is filling
  Local fky_0_0  // the key of the chunk chunkby is filling
  Local fop_0_0  // whether chunkby has seen an element
  Local fsn_0_0  // the key of the element chunkby looks at
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fch_0_1  // the chunk chunkby is filling
  Local fky_0_1  // the key of the chunk chunkby is filling
  Local fop_0_1  // whether chunkby has seen an element
  Local fsn_0_1  // the key of the element chunkby looks at
  Local fi_0_1  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local fch_0_2  // the chunk chunkby is filling
  Local fky_0_2  // the key of the chunk chunkby is filling
  Local fop_0_2  // whether chunkby has seen an element
  Local fsn_0_2  // the key of the element chunkby looks at

  // one stage on its own stays a call
  fch_0_0 := {}
  fky_0_0 := Nil
  fop_0_0 := .F.
  fsn_0_0 := Nil
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fsn_0_0 := fv_0_0:cPedido
    If !fop_0_0
      fop_0_0 := .T.
      fky_0_0 := fsn_0_0
    ElseIf !(fsn_0_0 == fky_0_0)
      AAdd(fo_0_0, fch_0_0)
      fch_0_0 := {}
      fky_0_0 := fsn_0_0
    EndIf
    AAdd(fch_0_0, fv_0_0)
  Next
  If fop_0_0
    AAdd(fo_0_0, fch_0_0)
  EndIf
  aPedidos := fo_0_0

  // the header/detail walk: seek to the range, group by the key, one pass
  far_0_0 := Alias()
  DbSelectArea("SC6")
  frc_0_0 := SC6->(RecNo())
  fol_0_0 := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    far_0_1 := Alias()
    DbSelectArea("SC6")
    frc_0_1 := SC6->(RecNo())
    SC6->(DbSeek(xFilial("SC6") + cNum))
    fch_0_1 := {}
    fky_0_1 := Nil
    fop_0_1 := .F.
    fsn_0_1 := Nil
    fo_0_1 := {}
    While !SC6->(Eof())
      fv_0_1 := {SC6->C6_NUM, SC6->C6_PRODUTO}
      fsn_0_1 := fv_0_1[1]
      If !fop_0_1
        fop_0_1 := .T.
        fky_0_1 := fsn_0_1
      ElseIf !(fsn_0_1 == fky_0_1)
        AAdd(fo_0_1, fch_0_1)
        fch_0_1 := {}
        fky_0_1 := fsn_0_1
      EndIf
      AAdd(fch_0_1, fv_0_1)
      SC6->(DbSkip())
    EndDo
    If fop_0_1
      AAdd(fo_0_1, fch_0_1)
    EndIf
    SC6->(DbGoto(frc_0_1))
    If !Empty(far_0_1)
      DbSelectArea(far_0_1)
    EndIf
    aGrupos := fo_0_1
  SC6->(DbSetOrder(fol_0_0))
  SC6->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  // the key block reads the mapped value, not the record: after a map the
  // element is whatever the map produced
  fch_0_2 := {}
  fky_0_2 := Nil
  fop_0_2 := .F.
  fsn_0_2 := Nil
  fo_0_2 := {}
  For fi_0_1 := 1 To Len(aRows)
    fv_0_2 := aRows[fi_0_1]
    fv_0_2 := fv_0_2:cPedido
    fsn_0_2 := fv_0_2
    If !fop_0_2
      fop_0_2 := .T.
      fky_0_2 := fsn_0_2
    ElseIf !(fsn_0_2 == fky_0_2)
      AAdd(fo_0_2, fch_0_2)
      fch_0_2 := {}
      fky_0_2 := fsn_0_2
    EndIf
    AAdd(fch_0_2, fv_0_2)
  Next
  If fop_0_2
    AAdd(fo_0_2, fch_0_2)
  EndIf
  aTamanhos := fo_0_2

  return len(aPedidos) + len(aGrupos) + len(aTamanhos)

// -----------------------------------------------------------------------------
// the end
