#include "totvs.ch"
#include "tlpp-core.th"

// 14_strings.xtpl -- string verbs and interpolation.
//
// The runtime only carries what AdvPL lacks. Upper, AllTrim, PadL and the
// rest already take their subject first, so they compose with '|>' as they
// stand -- wrapping them would shadow the originals on every existing call.
// -----------------------------------------------------------------------------

user function testStrings(cNome, nTotal, hCfg, aLinhas)
  local aPartes := {}
  local cOut := ""
  local lHit := .F.
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain

  aPartes := u_xtpl_split(cNome, ",")
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aPartes)
    fv_0_0 := aPartes[fi_0_0]
    fv_0_0 := alltrim(fv_0_0)
    AAdd(fo_0_0, fv_0_0)
  Next
  fo_0_0 := u_xtpl_join(fo_0_0, "; ")
  cOut := fo_0_0

  // AdvPL's own functions need nothing from the runtime
  cOut := upper(alltrim(cNome))

  lHit := u_xtpl_starts(cNome, "SA") .or. u_xtpl_ends(cNome, "01") .or. u_xtpl_contains(cNome, "X")

  // interpolation: the literal becomes a concatenation before anything else
  // sees it, so a hash read inside one is an ordinary subscript
  cOut := ("total = " + cValToChar(nTotal) + " itens")
  cOut := ("ola " + cValToChar(cNome))
  cOut := cValToChar(cNome)
  cOut := ("taxa " + cValToChar(u_xtpl_hget(hCfg, 't')) + " fim")
  cOut := "nada para trocar"

  conout(("a " + cValToChar(nTotal) + " b"))

  return cOut + cValToChar(lHit) + cValToChar(len(aLinhas))

// -----------------------------------------------------------------------------
// the end
