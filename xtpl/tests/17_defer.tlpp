#include "totvs.ch"
#include "tlpp-core.th"

// 17_defer.tlpp -- deferred bodies are ordinary statements.
//
// A body runs through the same passes as any other line, so a chain, a hash
// read or an xconout in one is translated. It may become several physical
// lines, and they stay together wherever the block is spliced.
//
// It is also resolved once, at the point it is written, so the same names
// appear whether the exit is a 'return' or the end of the body -- and a
// variable read only by a defer counts as read.
// --------------------------------------------------------------------------------

user function testDefer(aRows, nX, hCfg)

  Local nCount := 0

  Local ht_0_0  // o valor lido de um hash
  Local pt_0_0  // o resultado de uma etapa que nao fundiu

  nCount := 99

  If nX > 100
    pt_0_0 := validate(aRows)
    flush(pt_0_0)  // a chain becomes one line per stage
    ht_0_0 := Nil
    hCfg:Get("id", @ht_0_0)
    closeItem(ht_0_0)  // a hash read lifts a Get above it
    conout("rows=" + cValToChar(nX))  // translated, not spliced as written
    reportTotal(nCount)  // read only here: not 'never read'
    Return nCount
  EndIf

  pt_0_0 := validate(aRows)
  flush(pt_0_0)  // a chain becomes one line per stage
  ht_0_0 := Nil
  hCfg:Get("id", @ht_0_0)
  closeItem(ht_0_0)  // a hash read lifts a Get above it
  conout("rows=" + cValToChar(nX))  // translated, not spliced as written
  reportTotal(nCount)  // read only here: not 'never read'
  return 0

// --------------------------------------------------------------------------------
// the end