#include "totvs.ch"
#include "tlpp-core.th"

// 17_defer.xtpl -- deferred bodies are ordinary statements.
//
// A body runs through the same passes as any other line, so a chain, a hash
// read or an xconout in one is translated. It may become several physical
// lines, and they stay together wherever the block is spliced.
//
// It is also resolved once, at the point it is written, so the same names
// appear whether the exit is a 'return' or the end of the body -- and a
// variable read only by a defer counts as read.
// -----------------------------------------------------------------------------

user function testDefer(aRows, nX, hCfg)
  local nCount := 0


  nCount := 99

  If nX > 100
    flush(validate(aRows))  // a chain becomes one line per stage
    closeItem(u_xtpl_hget(hCfg, "id"))  // a hash read lifts a Get above it
    xconout("rows=", nX)  // translated, not spliced as written
    reportTotal(nCount)  // read only here: not 'never read'
    return nCount
  EndIf
  flush(validate(aRows))  // a chain becomes one line per stage
  closeItem(u_xtpl_hget(hCfg, "id"))  // a hash read lifts a Get above it
  xconout("rows=", nX)  // translated, not spliced as written
  reportTotal(nCount)  // read only here: not 'never read'
  return 0


// -----------------------------------------------------------------------------
// the end
