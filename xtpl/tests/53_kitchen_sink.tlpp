#include "totvs.ch"
#include "tlpp-core.th"

// 53_kitchen_sink.xtpl
// -----------------------------------------------------------------------------

user function testKitchenSink()
  // 1. Function-level initialization (Unmangled, native declarations)
  local nTotal := 100
  local aHandlers := {}
  local nCount := 0
  local i
  local aList
  local aLoopList
  local cCache
  local cName
  local cPick
  Local s_0_0  // a slot: the block locals 'idx', 'nDiscount', 'lSuccess', 'cNode', 'subList', 'conditionalList', 'k', 'nSlotA', 'cSlotB', 'nCount', 'nOuter', 'j', 'lReady', 'nScratch', 'aRows', 'aLocalOnly', 'aInner', 'nRowCount', 'nPlain'
  Local s_0_1  // a slot: the block locals 'nInner', 'nSquare', 'aBatch', 'aCarrier'
  Local nFactor  // a block local
  Local cBuffer  // a block local

  // 2. Traditional for loop (Passes safety check because 'i' is declared above)
  for i := 1 to 3
    nCount := nCount + i
  next

  // 3. Block-scoped for loop (loop counter takes a depth-1 stack slot)
  For s_0_0 := 1 To 5
    conout("Index: " + cValToChar(s_0_0))
  next

  // 4. Block-scoped shadowing (First block)
  if nTotal > 50
    s_0_0 := 10  // nDiscount
    nTotal := nTotal - s_0_0
    conout("Discount A: " + cValToChar(s_0_0))
  endif

  // 5. Block-scoped shadowing (Second block - isolated from the first)
  if nTotal > 20
    s_0_0 := 5  // nDiscount
    nTotal := nTotal - s_0_0
    conout("Discount B: " + cValToChar(s_0_0))
  endif

  // 6. 'if local' conditional binding with explicit condition after comma
  s_0_0 := myAction("param1, with comma")
  If s_0_0 == .T.
    conout("Action succeeded!")
  endif

  // 7. 'while local' loop binding with explicit condition after comma
  While .T.
    s_0_0 := getNextNode()
    If !(s_0_0 != Nil)
      Exit
    EndIf
    conout("Processing: " + s_0_0)
  enddo

  // 8. Block-scoped array built in place
  if nTotal > 10
    s_0_0 := {}  // subList
    aadd(s_0_0, "X")
    aadd(s_0_0, "Y")
  endif

  // 9. Function-level array (depth 0, so private storage)
  aList := {}
  aadd(aList, "A")
  aadd(aList, "B")
  if nTotal > 80
    aadd(aList, "C")
  endif

  // 10. Conditional appends inside an 'if' block
  if nTotal > 50
    s_0_0 := {}  // conditionalList
    aadd(s_0_0, "DefaultItem")
    if nTotal > 75
      aadd(s_0_0, "HighValueItem")
    endif
  endif

  // 11. Appends from inside a 'for' loop, some behind an inner 'if'
  aLoopList := {}
  For s_0_0 := 1 To 4
    aadd(aLoopList, "Item_" + cValToChar(s_0_0))
    if s_0_0 % 2 == 0
      aadd(aLoopList, "EvenBonus_" + cValToChar(s_0_0))
    endif
  next

  // 12. Block locals: two sibling blocks share one slot
  if nTotal > 0
    s_0_0 := 1  // nSlotA
    conout("Slot A: " + cValToChar(s_0_0))
  endif

  if nTotal > 0
    s_0_0 := "reuses the same storage"  // cSlotB
    conout("Slot B: " + s_0_0)
  endif

  // 13. Shadowing: 'local' hides the function-level nCount inside the block only
  if nTotal > 0
    s_0_0 := 999  // nCount
    conout("Shadowed: " + cValToChar(s_0_0))
  endif
  conout("Restored: " + cValToChar(nCount))

  // 14. Nesting: the inner block sits one level deeper, so it gets its own slot
  if nTotal > 0
    s_0_0 := 1  // nOuter
    if nTotal > 1
      s_0_1 := 2  // nInner
      conout("Sum: " + cValToChar(s_0_0 + s_0_1))
    endif
  endif

  // 15. 'for local' counter, plus a body slot recycled on every iteration
  For s_0_0 := 1 To 3
    s_0_1 := s_0_0 * s_0_0  // nSquare
    conout("Square: " + cValToChar(s_0_1))
  next

  // 16. 'if local' binding, with an array built inside the block
  s_0_0 := checkReady()
  If s_0_0
    s_0_1 := {}  // aBatch
    aadd(s_0_1, "batch1")
    aadd(s_0_1, "batch2")
    conout("Batch: " + cValToChar(len(s_0_1)))
  endif

  // 17. Bare 'local' is cleared on entry so no sibling value leaks in
  if nTotal > 0
    s_0_0 := Nil  // nScratch
    s_0_0 := nTotal * 2
    conout("Scratch: " + cValToChar(s_0_0))
  endif

  // 18. Captured by a code block: nFactor outlives the block, so it keeps
  //     private storage instead of a recycled slot
  if nTotal > 0
    nFactor := 10
    aadd(aHandlers, {|| nFactor * 2})
  endif

  // 19. Value variable passed with @: the callee writes back during the call
  //     and cannot keep the binding, so it still shares a slot
  if nTotal > 0
    cBuffer := ""
    fillBuffer(@cBuffer)
    conout("Buffer: " + cBuffer)
  endif

  // 20. Escapes: aRows is an array handed to a user function, which may keep it
  if nTotal > 0
    s_0_0 := {}  // aRows
    processRows(s_0_0)
  endif

  // 21. Contained: built up and read in place, so it still shares a slot
  if nTotal > 0
    s_0_0 := {}  // aLocalOnly
    aadd(s_0_0, "kept in the block")
    conout("Rows: " + cValToChar(len(s_0_0)))
  endif

  // 22. Escapes transitively: aInner never reaches processRows directly, but
  //     storing it into aCarrier is itself the escape -- no need to prove
  //     where aCarrier goes afterwards
  if nTotal > 0
    s_0_0 := {}  // aInner
    s_0_1 := {}  // aCarrier
    aadd(s_0_1, s_0_0)
    processRows(s_0_1)
  endif

  // 23. Scalar passed to a user function: copied, so sharing is safe
  if nTotal > 0
    s_0_0 := 5  // nRowCount
    processRows(s_0_0)
  endif

  // 24. Value variable, never captured, so it shares a slot
  if nTotal > 0
    s_0_0 := 42  // nPlain
    conout("Plain: " + cValToChar(s_0_0))
  endif

  // 25. '?=' as an operator: fill in a value only if nothing landed there.
  //     Not a declaration form -- a fresh local is always Nil.
  if nTotal > 90
    cCache := loadFromCache()
  endif
  If cCache == Nil
    cCache := "empty"
  EndIf
  conout("Cache: " + cCache)

  // 26. Elvis: same idea inline, with the left side evaluated exactly once
  cName := u_xtpl_elvis(lookupName(nTotal), {|| "anonymous"})

  // 27. Chained elvis: each fallback runs only if the one before came back Nil
  cPick := u_xtpl_elvis(firstChoice(), {|| u_xtpl_elvis(secondChoice(), {|| "last resort"})})

  return nTotal

// -----------------------------------------------------------------------------
// the end