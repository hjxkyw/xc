#include "totvs.ch"
#include "tlpp-core.th"

// 35_while_stages.xtpl -- takewhile and dropwhile.
//
// takewhile stops at the first element that fails and looks no further, which
// is what separates it from filter: filter keeps every match anywhere,
// takewhile keeps the matching run at the front. Over an ordered source that
// is the point -- the rest is known not to match.
//
// dropwhile skips the leading run and then passes everything, including
// elements that would have matched. Hence the flag.
//
// rows() starts at the top unless given a key to seek. With one it is
// positioned by the index, which is what makes takewhile worth having on a
// large table: reach the group in one jump, then stop at its end.
// -----------------------------------------------------------------------------

user function testWhileStages(aRows, cNum)
  local aItens := {}
  local aDepois := {}
  local aFrente := {}
  local aGrupo := {}
  local aSeek := {}
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_0  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fdr_0_0  // whether the leading run of a dropwhile is still on
  Local fo_0_1  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fdr_0_1  // whether the leading run of a dropwhile is still on
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain
  Local far_0_2  // the area selected before a 'using alias'
  Local frc_0_2  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local far_0_3  // the area selected before the walk
  Local frc_0_3  // the record the area was on before the walk
  Local fv_0_4  // the element walked
  Local fo_0_4  // the result of the chain

  // over an ordered work area: stops when the key changes
  far_0_0 := Alias()
  DbSelectArea("SC6")
  frc_0_0 := SC6->(RecNo())
  SC6->(DbGoTop())
  fo_0_0 := {}
  While !SC6->(Eof())
    If !(SC6->C6_NUM == cNum)
      Exit
    EndIf
    fv_0_0 := SC6->C6_PRODUTO
    AAdd(fo_0_0, fv_0_0)
    SC6->(DbSkip())
  EndDo
  SC6->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  aItens := fo_0_0

  // skip the leading zeros, keep everything after -- zeros included
  fdr_0_0 := .T.
  fo_0_1 := {}
  For fi_0_0 := 1 To Len(aRows)
    fv_0_1 := aRows[fi_0_0]
    If !(fdr_0_0 .And. (fv_0_1:nSaldo == 0))
      fdr_0_0 := .F.
      fv_0_1 := fv_0_1:cCod
      AAdd(fo_0_1, fv_0_1)
    EndIf
  Next
  aDepois := fo_0_1

  // one stage stays a call; the runtime version stops early too
  fo_0_2 := {}
  For fi_0_1 := 1 To Len(aRows)
    fv_0_2 := aRows[fi_0_1]
    If !(fv_0_2:nSaldo > 0)
      Exit
    EndIf
    AAdd(fo_0_2, fv_0_2)
  Next
  aFrente := fo_0_2

  // the two compose: skip to the group, take it, stop at its end. rows()
  // starts at the top, so this reaches the group by reading rather than by
  // seeking -- but it never reads past the group.
  far_0_1 := Alias()
  DbSelectArea("SC6")
  frc_0_1 := SC6->(RecNo())
  SC6->(DbGoTop())
  fdr_0_1 := .T.
  fo_0_3 := {}
  While !SC6->(Eof())
    If !(fdr_0_1 .And. (SC6->C6_NUM != cNum))
      fdr_0_1 := .F.
      If !(SC6->C6_NUM == cNum)
        Exit
      EndIf
      fv_0_3 := SC6->C6_PRODUTO
      AAdd(fo_0_3, fv_0_3)
    EndIf
    SC6->(DbSkip())
  EndDo
  SC6->(DbGoto(frc_0_1))
  If !Empty(far_0_1)
    DbSelectArea(far_0_1)
  EndIf
  aGrupo := fo_0_3

  // the way to actually do it: 'using alias' fixes the order, rows() seeks
  // by the index rather than reading up to the group, and takewhile ends it
  far_0_2 := Alias()
  DbSelectArea("SC6")
  frc_0_2 := SC6->(RecNo())
  fol_0_0 := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    far_0_3 := Alias()
    DbSelectArea("SC6")
    frc_0_3 := SC6->(RecNo())
    SC6->(DbSeek(xFilial("SC6") + cNum))
    fo_0_4 := {}
    While !SC6->(Eof())
      If !(SC6->C6_NUM == cNum)
        Exit
      EndIf
      fv_0_4 := SC6->C6_PRODUTO
      AAdd(fo_0_4, fv_0_4)
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_0_3))
    If !Empty(far_0_3)
      DbSelectArea(far_0_3)
    EndIf
    aSeek := fo_0_4
  SC6->(DbSetOrder(fol_0_0))
  SC6->(DbGoto(frc_0_2))
  If !Empty(far_0_2)
    DbSelectArea(far_0_2)
  EndIf

  return len(aItens) + len(aDepois) + len(aFrente) + len(aGrupo) + len(aSeek)

// -----------------------------------------------------------------------------
// the end
