#include "totvs.ch"
#include "tlpp-core.th"

// 35_while_stages.tlpp -- takewhile and dropwhile.
//
// takewhile stops at the first element that fails and looks no further, which
// is what separates it from filter: filter keeps every match anywhere,
// takewhile keeps the matching run at the front. Over an ordered source that
// is the point -- the rest is known not to match.
//
// dropwhile skips the leading run and then passes everything, including
// elements that would have matched. Hence the flag.
//
// rows() starts at the top unless given a key to seek. With one it is
// positioned by the index, which is what makes takewhile worth having on a
// large table: reach the group in one jump, then stop at its end.
// --------------------------------------------------------------------------------

user function testWhileStages(aRows, cNum)

  Local aItens := {}
  Local aDepois := {}
  Local aFrente := {}
  Local aGrupo := {}
  Local aSeek := {}

  Local b_0_r        // o local de bloco 'r', fixado: tem armazenamento so dele
  Local far_0_0      // a area que estava selecionada antes do percurso
  Local fdr_0_0      // quantos elementos um drop ja descartou
  Local fi_0_0       // o indice do percurso
  Local fo_0_0       // o resultado da cadeia
  Local fo_1_0       // o resultado da cadeia
  Local frc_0_0      // o registro em que a area estava antes do percurso
  Local frc_1_0      // o registro em que a area estava antes do percurso
  Local fv_0_0       // o elemento em percurso
  Local fv_1_0       // o elemento em percurso
  Local pt_0_0       // o resultado de uma etapa que nao fundiu
  Local s_1_usearea  // o local de bloco 'usearea'
  Local s_1_useord   // o local de bloco 'useord'
  Local s_1_userec   // o local de bloco 'userec'

  // over an ordered work area: stops when the key changes
  far_0_0 := Alias()
  DbSelectArea("SC6")
  frc_0_0 := SC6->(RecNo())
  SC6->(DbGoTop())
  fo_0_0 := {}

  While !SC6->(Eof())
    If !(SC6->C6_NUM == cNum)
      Exit
    EndIf
    fv_0_0 := SC6->C6_PRODUTO
    AAdd(fo_0_0, fv_0_0)
    SC6->(DbSkip())
  EndDo

  SC6->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  aItens := fo_0_0

  // skip the leading zeros, keep everything after -- zeros included
  fdr_0_0 := .T.
  fo_0_0 := {}

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    If !(fdr_0_0 .And. (fv_0_0:nSaldo == 0))
      fdr_0_0 := .F.
      fv_0_0 := fv_0_0:cCod
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next

  aDepois := fo_0_0

  // one stage stays a call; the runtime version stops early too
  pt_0_0 := u_xtpl_takewhile(aRows, {|b_0_r| b_0_r:nSaldo > 0})
  aFrente := pt_0_0

  // the two compose: skip to the group, take it, stop at its end. rows()
  // starts at the top, so this reaches the group by reading rather than by
  // seeking -- but it never reads past the group.
  far_0_0 := Alias()
  DbSelectArea("SC6")
  frc_0_0 := SC6->(RecNo())
  SC6->(DbGoTop())
  fdr_0_0 := .T.
  fo_0_0 := {}

  While !SC6->(Eof())
    If !(fdr_0_0 .And. (SC6->C6_NUM != cNum))
      fdr_0_0 := .F.
      If !(SC6->C6_NUM == cNum)
        Exit
      EndIf
      fv_0_0 := SC6->C6_PRODUTO
      AAdd(fo_0_0, fv_0_0)
    EndIf
    SC6->(DbSkip())
  EndDo

  SC6->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  aGrupo := fo_0_0

  // the way to actually do it: 'using alias' fixes the order, rows() seeks
  // by the index rather than reading up to the group, and takewhile ends it
  s_1_usearea := Alias()
  DbSelectArea("SC6")
  s_1_userec := SC6->(RecNo())
  s_1_useord := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    frc_1_0 := SC6->(RecNo())
    SC6->(DbSeek(xFilial("SC6") + cNum))
    fo_1_0 := {}
    While !SC6->(Eof())
      If !(SC6->C6_NUM == cNum)
        Exit
      EndIf
      fv_1_0 := SC6->C6_PRODUTO
      AAdd(fo_1_0, fv_1_0)
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_1_0))
    aSeek := fo_1_0

  SC6->(DbSetOrder(s_1_useord))
  SC6->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

  return len(aItens) + len(aDepois) + len(aFrente) + len(aGrupo) + len(aSeek)

// --------------------------------------------------------------------------------
// the end