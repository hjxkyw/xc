#include "totvs.ch"
#include "tlpp-core.th"

// 29_array.xtpl -- the runtime's array functions, as ordinary calls
//
// Collection first, matching aEval and aScan. A lambda is '[name] body',
// with up to six names. Every function returns a new array and leaves its
// input alone. Chaining them is a separate feature; see test_feed.xtpl.
// -----------------------------------------------------------------------------

user function testArray(aOrders, aNums, aCodes, aDesc)
  local aVals := {}
  local aBig := {}
  local aLive := {}
  local aPairs := {}
  local nTotal := 0
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fi_0_2  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local fi_0_3  // the position in the array walked
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain
  Local fi_0_4  // the position in the array walked
  Local fv_0_4  // the element walked
  Local fo_0_4  // the result of the chain

  // transform, keep, discard
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aOrders)
    fv_0_0 := aOrders[fi_0_0]
    fv_0_0 := fv_0_0:nValue
    AAdd(fo_0_0, fv_0_0)
  Next
  aVals := fo_0_0
  fo_0_1 := {}
  For fi_0_1 := 1 To Len(aOrders)
    fv_0_1 := aOrders[fi_0_1]
    If fv_0_1:nValue > 1000
      AAdd(fo_0_1, fv_0_1)
    EndIf
  Next
  aBig := fo_0_1
  fo_0_2 := {}
  For fi_0_2 := 1 To Len(aOrders)
    fv_0_2 := aOrders[fi_0_2]
    If !(fv_0_2:lCancelled)
      AAdd(fo_0_2, fv_0_2)
    EndIf
  Next
  aLive := fo_0_2

  // fold with an explicit seed; fold() starts from the first element instead
  fo_0_3 := 0
  For fi_0_3 := 1 To Len(aNums)
    fv_0_3 := aNums[fi_0_3]
    fo_0_3 := fo_0_3 + fv_0_3
  Next
  nTotal := fo_0_3
  fo_0_4 := Nil
  For fi_0_4 := 1 To Len(aNums)
    fv_0_4 := aNums[fi_0_4]
    If fo_0_4 == Nil
      fo_0_4 := fv_0_4
    Else
      fo_0_4 := Max(fo_0_4, fv_0_4)
    EndIf
  Next
  nTotal := fo_0_4

  // slicing and reshaping
  aVals := u_xtpl_take(aNums, 5)
  aVals := u_xtpl_drop(aNums, 2)
  aVals := u_xtpl_chunks(aNums, 3)
  aVals := u_xtpl_reverse(aNums)
  aVals := u_xtpl_flatten(aVals)
  aVals := u_xtpl_enumerate(aNums)

  // distinct keeps the first occurrence and the original order
  aVals := u_xtpl_distinct(aNums)

  // sorting copies first, so aOrders keeps its own order
  aVals := u_xtpl_sort(aNums)
  aVals := u_xtpl_sort(aOrders, {|a, b| a:nValue < b:nValue})
  aVals := u_xtpl_sortby(aOrders, {|o| o:nValue})
  aVals := u_xtpl_sortby(aOrders, {|o| o:nValue}, .T.)

  // zip takes two to six arrays; a block in any position is the combiner
  aPairs := u_xtpl_zip(aCodes, aDesc)
  aPairs := u_xtpl_zip(aCodes, aDesc, aNums)
  aPairs := u_xtpl_zip(aCodes, aDesc, {|c, d| c + " " + d})
  aPairs := u_xtpl_zip(aCodes, aDesc, aNums, {|c, d, n| c + d + cValToChar(n)})

  conout(cValToChar(len(aBig)) + cValToChar(len(aLive)) + cValToChar(len(aPairs)))

  return nTotal

// -----------------------------------------------------------------------------
// the end
