#include "totvs.ch"
#include "tlpp-core.th"

// 02_reuse.tlpp -- when a block local shares a slot and when it cannot
// -----------------------------------------------------------------------------

user function testReuse(lFlag)

  Local nTotal := 100
  Local aHandlers := {}
  Local aCarrier := {}

  Local s_1_0        // um slot, dividido por aGiven, aInner, aLent, aRows, aScratch, aWork, cSecond, i, nFirst, nOuter
  Local b_1_nFactor  // o local de bloco 'nFactor', fixado: tem armazenamento so dele
  Local b_2_cBuffer  // o local de bloco 'cBuffer', fixado: tem armazenamento so dele
  Local s_1_nSquare  // o local de bloco 'nSquare'
  Local s_2_nInner   // o local de bloco 'nInner'

  // Sibling blocks reuse one slot: each writes before it reads, so nothing
  // can leak across.
  if nTotal > 0
    s_1_0 := 1
    conout("first: " + cValToChar(s_1_0))
  endif

  if nTotal > 0
    s_1_0 := "same storage, different type"
    conout("second: " + s_1_0)
  endif

  // Nesting is not sharing: the inner block is one level deeper.
  if nTotal > 0
    s_1_0 := 1
    if nTotal > 1
      s_2_nInner := 2
      conout("sum: " + cValToChar(s_1_0 + s_2_nInner))
    endif
  endif

  // A loop body re-enters its block on every pass, so the slot is cleared
  // each time rather than carrying the previous iteration's value.
  for s_1_0 := 1 to 3
    s_1_nSquare := Nil
    s_1_nSquare := s_1_0 * s_1_0
    conout("square: " + cValToChar(s_1_nSquare))
  next

  // PINNED 1 -- captured by a code block, which outlives the block.
  if nTotal > 0
    b_1_nFactor := 10
    aadd(aHandlers, {|| b_1_nFactor * 2})
  endif

  // NOT pinned -- its value handed to a function we cannot see into: what
  // processRows may keep is the array, not the variable, and the next block
  // in the slot gives the slot a new array.
  if nTotal > 0
    s_1_0 := {}
    processRows(s_1_0)
  endif

  // NOT pinned -- stored in aCarrier: the array is stored, not the variable.
  if nTotal > 0
    s_1_0 := {}
    aadd(aCarrier, s_1_0)
  endif

  // NOT pinned, and CHECKED -- <contained> is a promise the compiler checks:
  // aWork cannot leave its block -- not captured by a code block, passed by
  // reference or read by a defer. Breaking it is a compile error, not a
  // silent risk.
  if nTotal > 0
    s_1_0 := {}
    aadd(s_1_0, "contained")
    conout("first row: " + s_1_0[1])
  endif

  // NOT pinned -- a reference built and read entirely in place.
  if nTotal > 0
    s_1_0 := {}
    aadd(s_1_0, "stays home")
    conout("kept: " + cValToChar(len(s_1_0)))
  endif

  // NOT pinned -- handed to processRows and used after: processRows gets the
  // array, not the variable, so the slot can be shared. aLent stays usable to
  // the end of the block.
  if nTotal > 0
    s_1_0 := {}
    aadd(s_1_0, "borrowed")
    processRows(s_1_0)
    conout("still ours: " + cValToChar(len(s_1_0)))
  endif

  // NOT pinned -- built and left: nothing reaches aGiven after its block.
  if nTotal > 0
    s_1_0 := {}
    aadd(s_1_0, "handed off")
  endif

  // PINNED 2 -- passed by reference ('@'): the callee gets the variable
  // itself, and xc does not assume it lets go, so it keeps a Local of its own.
  if nTotal > 0
    b_2_cBuffer := ""
    fillBuffer(@b_2_cBuffer)
    conout("buffer: " + b_2_cBuffer)
  endif

  return nTotal

// -----------------------------------------------------------------------------
// the end