#include "totvs.ch"
#include "tlpp-core.th"

// 38_first_count.xtpl -- the first match, and how many match.
//
// Both replace 'filter(...) then look at the result', which builds an array
// to answer a question that does not need one -- and in first's case keeps
// searching after the answer is known.
//
// count reads the element, so a chain over rows() needs no map before it.
// first does not: it hands the element back, and a work-area record is not a
// value, so it needs something a map has made.
// -----------------------------------------------------------------------------

user function testFirstCount(aRows, cNum)
  local oAtrasado := Nil
  local nGrandes := 0
  local nItens := 0
  local nComSaldo := 0
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local far_0_1  // the area selected before the walk
  Local frc_0_1  // the record the area was on before the walk
  Local fo_0_2  // the result of the chain
  Local far_0_2  // the area selected before the walk
  Local frc_0_2  // the record the area was on before the walk
  Local fo_0_3  // the result of the chain

  // stops at the first match instead of collecting every one
  fo_0_0 := Nil
  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:oPed
    If fv_0_0:lAtraso
      fo_0_0 := fv_0_0
      Exit
    EndIf
  Next
  oAtrasado := fo_0_0

  fo_0_1 := 0
  For fi_0_1 := 1 To Len(aRows)
    fv_0_1 := aRows[fi_0_1]
    fv_0_1 := fv_0_1:nValor
    If fv_0_1 > 100
      fo_0_1++
    EndIf
  Next
  nGrandes := fo_0_1

  far_0_0 := Alias()
  DbSelectArea("SC6")
  frc_0_0 := SC6->(RecNo())
  fol_0_0 := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    // how many items in this order, without building the array of them
    far_0_1 := Alias()
    DbSelectArea("SC6")
    frc_0_1 := SC6->(RecNo())
    SC6->(DbSeek(xFilial("SC6") + cNum))
    fo_0_2 := 0
    While !SC6->(Eof())
      If !(SC6->C6_NUM == cNum)
        Exit
      EndIf
      fo_0_2++
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_0_1))
    If !Empty(far_0_1)
      DbSelectArea(far_0_1)
    EndIf
    nItens := fo_0_2

    // a predicate reads the record directly
    far_0_2 := Alias()
    DbSelectArea("SC6")
    frc_0_2 := SC6->(RecNo())
    SC6->(DbGoTop())
    fo_0_3 := 0
    While !SC6->(Eof())
      If SC6->C6_QUANT > 0
        fo_0_3++
      EndIf
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_0_2))
    If !Empty(far_0_2)
      DbSelectArea(far_0_2)
    EndIf
    nComSaldo := fo_0_3
  SC6->(DbSetOrder(fol_0_0))
  SC6->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  conout(cValToChar(oAtrasado != Nil))

  return nGrandes + nItens + nComSaldo

// -----------------------------------------------------------------------------
// the end
