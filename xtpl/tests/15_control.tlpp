#include "totvs.ch"
#include "tlpp-core.th"

// 15_control.xtpl -- constructs that lower to plain AdvPL, no runtime needed
// -----------------------------------------------------------------------------

user function testControl(oUser, nLimit, aItens)
  local nTotal := 0
  local cCity
  local lDone
  Local s_0_0  // a slot: the block locals 'lReady', 'cNode', 'i', 'oItem', 'nSubject'
  Local fs_0_0  // the source of a 'for ... in'
  Local fi_0_0  // the counter of a 'for ... in'
  Local nIndice  // a block local
  Local fs_0_1  // the source of a 'for ... in'
  Local fi_0_1  // the counter of a 'for ... times'
  Local fi_0_2  // the counter of a 'for ... times'
  Local fn_0_0  // the count of a 'for ... times'


  // conditional binding: the value is bound, then tested
  s_0_0 := checkReady()
  If s_0_0
    conout("ready")
  endif

  While .T.
    s_0_0 := nextNode()
    If !(s_0_0 != Nil)
      Exit
    EndIf
    conout("node: " + s_0_0)
  enddo

  For s_0_0 := 1 To 3
    nTotal := nTotal + s_0_0
  next

  // 'for' binds the element; the index is optional and only generated
  // when you name it. Both are ordinary block locals of the loop.
  fs_0_0 := aItens
  For fi_0_0 := 1 To Len(fs_0_0)
    s_0_0 := fs_0_0[fi_0_0]
    nTotal := nTotal + s_0_0:nValor
  next

  fs_0_1 := aItens
  For nIndice := 1 To Len(fs_0_1)
    s_0_0 := fs_0_1[nIndice]
    conout(cValToChar(nIndice) + ": " + s_0_0:cCodigo)
  next

  // 'for <n> times' repeats without inventing a counter you never read
  For fi_0_1 := 1 To 3
    conout("linha")
  next

  fn_0_0 := len(aItens)
  For fi_0_2 := 1 To fn_0_0
    nTotal := nTotal + 1
  next

  // 'do case with' names the subject and evaluates it once. The conditions
  // are ordinary AdvPL, and the variable is an ordinary block local.
  s_0_0 := calcTotal(nTotal)
  Do Case
    case s_0_0 == 6
      conout("exactly six")
    case s_0_0 > 3
      conout("more than three: " + cValToChar(s_0_0))
    case isReady(s_0_0)
      conout("ready")
    otherwise
      conout("small")
  endcase

  // plain 'do case' is untouched
  do case
    case nTotal == 0
      conout("zero")
  endcase

  // optional chaining: a missing link yields Nil rather than crashing
  cCity := Eval({|fbv_0_0| If(fbv_0_0 != Nil, fbv_0_0:cCity, Nil)}, If(oUser != Nil, oUser:oAddress, Nil))

  // postfix modifiers
  If nTotal > 5
    lDone := .T.
  EndIf
  If nTotal == 0
    resetAll()
  EndIf
  While nTotal < 0
    conout("counting")
  EndDo

  If nTotal > 100
    logExit("finished")
    closeCursor()
    return nTotal
  EndIf

  logExit("finished")
  closeCursor()
  return nTotal

// -----------------------------------------------------------------------------
// the end
