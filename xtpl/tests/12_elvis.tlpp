#include "totvs.ch"
#include "tlpp-core.th"

// 12_elvis.xtpl -- the '?:' operator
//
// 'a ?: b' yields a when a is not Nil, otherwise b. The left side is bound to
// a temp first, so it is evaluated exactly once even though the result
// mentions it twice.
// -----------------------------------------------------------------------------

user function testElvis(oUser)
  local cName
  local cPick
  local nPort
  local cCity
  local aItems
  Local et_0_0  // the left side of a '?:', evaluated once

  // Two operands: compact form.
  cName := If(ValType(et_0_0 := lookupName(1)) != "U", et_0_0, "anonymous")
  conout("name: " + cName)

  // Chained: each fallback runs only if the one before came back Nil.
  cPick := If(ValType(et_0_0 := firstChoice()) != "U", et_0_0, If(ValType(et_0_0 := secondChoice()) != "U", et_0_0, If(ValType(et_0_0 := thirdChoice()) != "U", et_0_0, "last resort")))
  conout("pick: " + cPick)

  // The fallback can be any expression, including a call with arguments.
  nPort := If(ValType(et_0_0 := readPort()) != "U", et_0_0, defaultPort(8080))
  conout("port: " + cValToChar(nPort))

  // Combines with optional chaining: a missing object yields the fallback.
  cCity := If(ValType(et_0_0 := If(oUser != Nil, oUser:cCity, Nil)) != "U", et_0_0, "unknown")
  conout("city: " + cCity)

  // Works as a plain expression too, not only on the right of ':='.
  aItems := {}
  aadd(aItems, If(ValType(et_0_0 := loadItem(1)) != "U", et_0_0, "placeholder"))
  conout("items: " + cValToChar(len(aItems)))

  return cName

// -----------------------------------------------------------------------------
// the end
