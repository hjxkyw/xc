#include "totvs.ch"
#include "tlpp-core.th"

// 21_using.xtpl -- scoped work areas.
//
// Forgetting to restore an alias is a classic Protheus bug, and its damage
// appears somewhere else entirely. The area, the index order and the record
// pointer are put back at every way out of the block, early returns included
// -- which is the defer machinery, so the two have to agree on order:
// deferred statements first, since they may still want the area, then the
// work areas, innermost block first.
// -----------------------------------------------------------------------------

user function testUsing(cAlias, nX)
  local nT := 0
  local aC := {}
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local fal_0_0  // the alias of a 'using alias', from a variable
  Local far_0_1  // the area selected before a 'using alias'
  Local frc_0_1  // the record the area was on before a 'using alias'
  Local far_0_2  // the area selected before the walk
  Local frc_0_2  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain

  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
  fol_0_0 := SA1->(IndexOrd())
  SA1->(DbSetOrder(1))
    nT := SA1->A1_SALDO
    If nX > 100  // restored before the return
      SA1->(DbSetOrder(fol_0_0))
      SA1->(DbGoto(frc_0_0))
      If !Empty(far_0_0)
        DbSelectArea(far_0_0)
      EndIf
      return nT
    EndIf
    nT := nT + 1

    fal_0_0 := cAlias
    far_0_1 := Alias()
    DbSelectArea(fal_0_0)  // a variable holds the alias here
    frc_0_1 := (fal_0_0)->(RecNo())
      nT := nT + 1
    (fal_0_0)->(DbGoto(frc_0_1))
    If !Empty(far_0_1)
      DbSelectArea(far_0_1)
    EndIf
  SA1->(DbSetOrder(fol_0_0))
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  // a chain walks its own area and restores it the same way
  far_0_2 := Alias()
  DbSelectArea("SA1")
  frc_0_2 := SA1->(RecNo())
  SA1->(DbGoTop())
  fo_0_0 := {}
  While !SA1->(Eof())
    If SA1->A1_SALDO > 0
      fv_0_0 := SA1->A1_COD
      AAdd(fo_0_0, fv_0_0)
    EndIf
    SA1->(DbSkip())
  EndDo
  SA1->(DbGoto(frc_0_2))
  If !Empty(far_0_2)
    DbSelectArea(far_0_2)
  EndIf
  aC := fo_0_0

  return nT + len(aC)

// -----------------------------------------------------------------------------
// the end
