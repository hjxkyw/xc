#include "totvs.ch"
#include "tlpp-core.th"

// 39_predicates.xtpl -- does any / do all / does none of them match.
//
// There was no way to ask this without building a filtered array and testing
// its length, which reads the whole collection to answer a question that is
// usually settled by the first element.
//
// Fused, the loop leaves as soon as it knows -- and over rows() that means
// the walk stops rather than reading the rest of the table.
// -----------------------------------------------------------------------------

user function testPredicates(aRows, aNums)
  local lAlguem := .F.
  local lTodos := .F.
  local lNenhum := .F.
  local lNegativo := .F.
  local lOrdenado := .F.
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fi_0_2  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fo_0_3  // the result of the chain
  Local fs_0_0  // the array walked
  Local fi_0_3  // the position in the array walked
  Local fv_0_3  // the element walked
  Local fo_0_4  // the result of the chain

  // one stage on its own stays a call -- the runtime version stops early too
  fo_0_0 := .F.
  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    If !fv_0_0:lPago
      fo_0_0 := .T.
      Exit
    EndIf
  Next
  lAlguem := fo_0_0

  // fused: map then the predicate, leaving at the first answer
  fo_0_1 := .T.
  For fi_0_1 := 1 To Len(aRows)
    fv_0_1 := aRows[fi_0_1]
    fv_0_1 := fv_0_1:nValor
    If !(fv_0_1 > 0)
      fo_0_1 := .F.
      Exit
    EndIf
  Next
  lTodos := fo_0_1
  fo_0_2 := .T.
  For fi_0_2 := 1 To Len(aRows)
    fv_0_2 := aRows[fi_0_2]
    fv_0_2 := fv_0_2:cCod
    If empty(fv_0_2)
      fo_0_2 := .F.
      Exit
    EndIf
  Next
  lNenhum := fo_0_2

  // over a work area, and no map is needed: a predicate reads the record
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
  SA1->(DbGoTop())
  fo_0_3 := .F.
  While !SA1->(Eof())
    If SA1->A1_SALDO < 0
      fo_0_3 := .T.
      Exit
    EndIf
    SA1->(DbSkip())
  EndDo
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  lNegativo := fo_0_3

  // sort cannot be fused, so the predicate runs as an ordinary call
  fs_0_0 := u_xtpl_sort(aNums)
  fo_0_4 := .T.
  For fi_0_3 := 1 To Len(fs_0_0)
    fv_0_3 := fs_0_0[fi_0_3]
    If fv_0_3 == 0
      fo_0_4 := .F.
      Exit
    EndIf
  Next
  lOrdenado := fo_0_4

  return lAlguem .and. lTodos .and. lNenhum .and. lNegativo .and. lOrdenado

// -----------------------------------------------------------------------------
// the end
