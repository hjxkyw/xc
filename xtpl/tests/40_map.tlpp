#include "totvs.ch"
#include "tlpp-core.th"

// 40_map.xtpl -- --map: every emitted line says where it came from.
//
// One source line often becomes a dozen, so the marker goes on all of them.
// Scanning upwards for the nearest one is exactly the work this removes.
// -----------------------------------------------------------------------------

user function testMap(aNums, hCfg)
  local nT := 0
  local cOut := ""
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain

  fo_0_0 := 0
  For fi_0_0 := 1 To Len(aNums)
    fv_0_0 := aNums[fi_0_0]
    If fv_0_0 > 1
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
  Next
  nT := fo_0_0
  cOut := ("total " + cValToChar(nT))
  nT := nT + u_xtpl_hget(hCfg, "extra")

  return nT

// -----------------------------------------------------------------------------
// the end
