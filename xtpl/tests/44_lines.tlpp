#include "totvs.ch"
#include "tlpp-core.th"

// 44_lines.tlpp -- a chain over the lines of a file.
//
// The same source protocol as rows(), over text: FT_FUse opens, FT_FReadLn
// reads one line, FT_FSkip advances, FT_FUse() with no argument closes. The
// file is never held in memory, so a 'take' really does stop the read rather
// than trimming something already loaded.
//
// Unlike rows(), the element here IS a value -- the line -- so a lambda
// parameter binds to it in the ordinary way.
// --------------------------------------------------------------------------------

user function testLines(cPath)

  Local aTop := {}
  Local aAll := {}
  Local nBytes := 0
  Local aSorted := {}

  Local fn_0_0   // quantos elementos ja passaram
  Local fo_0_0   // o resultado da cadeia
  Local fok_0_0  // se o arquivo abriu
  Local fs_0_0   // a colecao ou o caminho percorrido
  Local fv_0_0   // o elemento em percurso
  Local pt_0_0   // o resultado de uma etapa que nao fundiu

  // filter, map and take: one pass, and it stops after ten lines
  fs_0_0 := "dados.txt"
  fok_0_0 := File(fs_0_0)

  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf

  fn_0_0 := 0
  fo_0_0 := {}

  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    If !empty(fv_0_0)
      fv_0_0 := alltrim(fv_0_0)
      If fn_0_0 >= 10
        Exit
      EndIf
      fn_0_0 := fn_0_0 + 1
      AAdd(fo_0_0, fv_0_0)
    EndIf
    FT_FSkip()
  EndDo

  If fok_0_0
    FT_FUse()
  EndIf

  aTop := fo_0_0

  // no stages at all is still a chain: every line of the file
  fok_0_0 := File(cPath)

  If fok_0_0
    FT_FUse(cPath)
    FT_FGoTop()
  EndIf

  fo_0_0 := {}

  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    AAdd(fo_0_0, fv_0_0)
    FT_FSkip()
  EndDo

  If fok_0_0
    FT_FUse()
  EndIf

  aAll := fo_0_0

  // a fold as the last stage builds no array
  fok_0_0 := File(cPath)

  If fok_0_0
    FT_FUse(cPath)
    FT_FGoTop()
  EndIf

  fo_0_0 := 0

  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    fv_0_0 := len(fv_0_0)
    fo_0_0 := fo_0_0 + fv_0_0
    FT_FSkip()
  EndDo

  If fok_0_0
    FT_FUse()
  EndIf

  nBytes := fo_0_0

  // sort cannot be fused, so the walk collects and sort carries on from there
  fok_0_0 := File(cPath)

  If fok_0_0
    FT_FUse(cPath)
    FT_FGoTop()
  EndIf

  fo_0_0 := {}

  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    AAdd(fo_0_0, fv_0_0)
    FT_FSkip()
  EndDo

  If fok_0_0
    FT_FUse()
  EndIf

  pt_0_0 := u_xtpl_sort(fo_0_0)
  aSorted := pt_0_0

  return nBytes + len(aTop) + len(aAll) + len(aSorted)

// --------------------------------------------------------------------------------
// the end