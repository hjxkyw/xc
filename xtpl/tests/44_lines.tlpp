#include "totvs.ch"
#include "tlpp-core.th"

// 44_lines.xtpl -- a chain over the lines of a file.
//
// The same source protocol as rows(), over text: FT_FUse opens, FT_FReadLn
// reads one line, FT_FSkip advances, FT_FUse() with no argument closes. The
// file is never held in memory, so a 'take' really does stop the read rather
// than trimming something already loaded.
//
// Unlike rows(), the element here IS a value -- the line -- so a lambda
// parameter binds to it in the ordinary way.
// -----------------------------------------------------------------------------

user function testLines(cPath)
  local aTop := {}
  local aAll := {}
  local nBytes := 0
  local aSorted := {}
  Local fs_0_0  // the path of the file walked
  Local fok_0_0  // whether the file opened
  Local fv_0_0  // the element walked
  Local fn_0_0  // how many elements have passed
  Local fo_0_0  // the result of the chain
  Local fok_0_1  // whether the file opened
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fok_0_2  // whether the file opened
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local fok_0_3  // whether the file opened
  Local fv_0_3  // the element walked
  Local fo_0_3  // what a loop collected, for the stages after it

  // filter, map and take: one pass, and it stops after ten lines
  fs_0_0 := "dados.txt"
  fok_0_0 := File(fs_0_0)
  If fok_0_0
    FT_FUse(fs_0_0)
    FT_FGoTop()
  EndIf
  fn_0_0 := 0
  fo_0_0 := {}
  While fok_0_0 .And. !FT_FEof()
    fv_0_0 := FT_FReadLn()
    If !empty(fv_0_0)
      fv_0_0 := alltrim(fv_0_0)
      If fn_0_0 >= 10
        Exit
      EndIf
      fn_0_0++
      AAdd(fo_0_0, fv_0_0)
    EndIf
    FT_FSkip()
  EndDo
  If fok_0_0
    FT_FUse()
  EndIf
  aTop := fo_0_0

  // no stages at all is still a chain: every line of the file
  fok_0_1 := File(cPath)
  If fok_0_1
    FT_FUse(cPath)
    FT_FGoTop()
  EndIf
  fo_0_1 := {}
  While fok_0_1 .And. !FT_FEof()
    fv_0_1 := FT_FReadLn()
    AAdd(fo_0_1, fv_0_1)
    FT_FSkip()
  EndDo
  If fok_0_1
    FT_FUse()
  EndIf
  aAll := fo_0_1

  // a fold as the last stage builds no array
  fok_0_2 := File(cPath)
  If fok_0_2
    FT_FUse(cPath)
    FT_FGoTop()
  EndIf
  fo_0_2 := 0
  While fok_0_2 .And. !FT_FEof()
    fv_0_2 := FT_FReadLn()
    fv_0_2 := len(fv_0_2)
    fo_0_2 := fo_0_2 + fv_0_2
    FT_FSkip()
  EndDo
  If fok_0_2
    FT_FUse()
  EndIf
  nBytes := fo_0_2

  // sort cannot be fused, so the walk collects and sort carries on from there
  fok_0_3 := File(cPath)
  If fok_0_3
    FT_FUse(cPath)
    FT_FGoTop()
  EndIf
  fo_0_3 := {}
  While fok_0_3 .And. !FT_FEof()
    fv_0_3 := FT_FReadLn()
    AAdd(fo_0_3, fv_0_3)
    FT_FSkip()
  EndDo
  If fok_0_3
    FT_FUse()
  EndIf
  aSorted := u_xtpl_sort(fo_0_3)

  return nBytes + len(aTop) + len(aAll) + len(aSorted)

// -----------------------------------------------------------------------------
// the end
