#include "totvs.ch"
#include "tlpp-core.th"

// 23_comments.xtpl -- a trailing comment on a transformed line.
//
// Masking turns a comment into one token that travels with the tail of the
// line. Every pass here wraps that tail in generated syntax, so a comment
// left in place lands inside it and comments out the closing bracket:
// '... fallback 0  // note' produced '{|| 0  // note})'. The comment is
// peeled once before the rewrites and put back once after.
// -----------------------------------------------------------------------------

user function testComments(aNums, nX, hCfg, oUser)
  local nSafe := 0
  local cOut := ""
  local nT := 0
  Local gt_0_0  // the error block a 'fallback' sets aside
  Local et_0_0  // the left side of a '?:', evaluated once
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local ffs_0_0  // the values distinct has seen
  Local fo_0_0  // the result of the chain
  Local fbv_0_0  // a value read twice by '?.' or 'in lo..hi', evaluated once
  Local fi_0_1  // the counter of a 'for ... times'

  gt_0_0 := ErrorBlock({|e| Break(e)})
  Begin Sequence
    nSafe := riskyCall(1)
  Recover
    nSafe := 0
  End Sequence
  ErrorBlock(gt_0_0)                      // fallback wraps the tail in a block
  cOut := If(ValType(et_0_0 := lookupName(1)) != "U", et_0_0, "anonymous")  // elvis wraps it in an If()
  ffs_0_0 := THashMap():New()
  fo_0_0 := 0
  For fi_0_0 := 1 To Len(aNums)
    fv_0_0 := aNums[fi_0_0]
    If !u_xtpl_seen(ffs_0_0, fv_0_0)
      fo_0_0 := fo_0_0 + fv_0_0
    EndIf
  Next
  nT := fo_0_0                            // a chain lands in a temp
  nT := Nil
  hCfg:Get("taxa", @nT)                   // a hash read lifts to a Get
  nT := ((nX % 3) == 0)                   // divisible-by
  cOut := If(oUser != Nil .And. ValType(fbv_0_0 := oUser:oAddr) != "U", fbv_0_0:cCity, Nil)  // optional chaining
  xconout("total=", nT)                   // xconout

  For fi_0_1 := 1 To 3                    // a loop header
    nT := nT + 1
  next

  conout(cOut + cValToChar(nSafe))

  If nT > 5                               // a postfix modifier
    return nT
  EndIf
  return 0


// -----------------------------------------------------------------------------
// the end
