#include "totvs.ch"
#include "tlpp-core.th"

// 19_defer_pinning.xtpl -- a defer keeps its variable alive.
//
// A deferred body runs at an exit from the function, long after the block
// holding the variable has gone. Recycling that slot to a sibling block in
// between left the defer reading whatever the sibling had put there -- and
// the origin comment still said the original name.
// -----------------------------------------------------------------------------

user function testDeferPinning(nX)
  local nT := 0
  Local fdf_0_0 := .F.  // whether 'defer logIt(nA)' was reached
  Local nA  // a block local
  Local cB  // a block local

  if nX > 0
    nA := 5
    fdf_0_0 := .T.
  endif

  if nX > 0
    cB := "sibling"                   // would have taken the same slot
    nT := len(cB)
  endif

  If fdf_0_0
    logIt(nA)  // captured: nA gets private storage
  EndIf
  return nT

// -----------------------------------------------------------------------------
// the end
