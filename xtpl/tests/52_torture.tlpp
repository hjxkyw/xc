#include "totvs.ch"
#include "tlpp-core.th"

// 52_torture.xtpl -- constructs that meet each other in unusual ways.
//
// Written adversarially rather than to demonstrate anything: nested walks,
// chains inside arguments and conditions, comments and continuations cutting
// constructs in half, and a source inside a defer. Six bugs came out of
// writing it, and each line below is one of the shapes that found one.
// -----------------------------------------------------------------------------

user function testTorture(hCfg, cNum, aRows, cPath, nX)
  local nT := 0
  local aOut := {}
  local cMsg := ""
  local aQ := {}
  local aX := {}
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'
  Local fol_0_0  // the index order before a 'using alias'
  Local far_0_1  // the area selected before a 'using alias'
  Local frc_0_1  // the record the area was on before a 'using alias'
  Local fol_0_1  // the index order before a 'using alias'
  Local far_0_2  // the area selected before the walk
  Local frc_0_2  // the record the area was on before the walk
  Local fv_0_0  // the element walked
  Local fop_0_0  // whether distinctAdjacent has seen an element
  Local fls_0_0  // the key distinctAdjacent saw last
  Local fpb_0_0  // the key of the element distinctAdjacent looks at
  Local fo_0_0  // the result of the chain
  Local fi_0_0  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fn_0_0  // how many elements have passed
  Local flm_0_0  // the limit of a take
  Local fo_0_1  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fbg_0_0  // the inner array of an expand
  Local fj_0_0  // the position in the inner array of an expand
  Local fo_0_2  // what a loop collected, for the stages after it
  Local fch_0_0  // the chunk chunkby is filling
  Local fky_0_0  // the key of the chunk chunkby is filling
  Local fop_0_1  // whether chunkby has seen an element
  Local fsn_0_0  // the key of the element chunkby looks at
  Local fi_0_2  // the position in the array walked
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain


  // a string literal inside an interpolated expression
  cMsg := ("moeda " + cValToChar(u_xtpl_hget(hCfg, 'moeda')) + " fim")

  // nested using, both restored at an early return, with a hash in the key
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
  fol_0_0 := SA1->(IndexOrd())
  SA1->(DbSetOrder(1))
    far_0_1 := Alias()
    DbSelectArea("SC6")
    frc_0_1 := SC6->(RecNo())
    fol_0_1 := SC6->(IndexOrd())
    SC6->(DbSetOrder(2))
      far_0_2 := Alias()
      DbSelectArea("SC6")
      frc_0_2 := SC6->(RecNo())
      SC6->(DbSeek(u_xtpl_hget(hCfg, "chave")))
      fop_0_0 := .F.
      fls_0_0 := Nil
      fpb_0_0 := Nil
      fo_0_0 := {}
      While !SC6->(Eof())
        If !(SC6->C6_NUM == cNum)
          Exit
        EndIf
        fv_0_0 := SC6->C6_PRODUTO
        fpb_0_0 := fv_0_0
        If !(fop_0_0 .And. (fpb_0_0 == fls_0_0))
          fop_0_0 := .T.
          fls_0_0 := fpb_0_0
          AAdd(fo_0_0, fv_0_0)
        EndIf
        SC6->(DbSkip())
      EndDo
      SC6->(DbGoto(frc_0_2))
      If !Empty(far_0_2)
        DbSelectArea(far_0_2)
      EndIf
      aOut := fo_0_0  // split mid-chain // and a block comment
      If u_xtpl_hget(hCfg, "parar")
        conout("saindo")
        SC6->(DbSetOrder(fol_0_1))
        SC6->(DbGoto(frc_0_1))
        If !Empty(far_0_1)
          DbSelectArea(far_0_1)
        EndIf
        SA1->(DbSetOrder(fol_0_0))
        SA1->(DbGoto(frc_0_0))
        If !Empty(far_0_0)
          DbSelectArea(far_0_0)
        EndIf
        return len(aOut)
      EndIf
      nT := SA1->A1_SALDO + SC6->C6_QUANT
    SC6->(DbSetOrder(fol_0_1))
    SC6->(DbGoto(frc_0_1))
    If !Empty(far_0_1)
      DbSelectArea(far_0_1)
    EndIf
  SA1->(DbSetOrder(fol_0_0))
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  // a chain inside a stage's own argument
  flm_0_0 := len(u_xtpl_distinct(aRows))
  fn_0_0 := 0
  fo_0_1 := {}
  For fi_0_0 := 1 To Len(aRows)
    fv_0_1 := aRows[fi_0_0]
    If fn_0_0 >= flm_0_0
      Exit
    EndIf
    fn_0_0++
    fv_0_1 := fv_0_1:cCod
    AAdd(fo_0_1, fv_0_1)
  Next
  aX := fo_0_1

  // a terminal that is not the last stage
  fch_0_0 := {}
  fky_0_0 := Nil
  fop_0_1 := .F.
  fsn_0_0 := Nil
  fo_0_2 := {}
  For fi_0_1 := 1 To Len(aRows)
    fv_0_2 := aRows[fi_0_1]
    fbg_0_0 := fv_0_2:aItens
    For fj_0_0 := 1 To Len(fbg_0_0)
      fv_0_2 := fbg_0_0[fj_0_0]
      fsn_0_0 := fv_0_2:cGrupo
      If !fop_0_1
        fop_0_1 := .T.
        fky_0_0 := fsn_0_0
      ElseIf !(fsn_0_0 == fky_0_0)
        AAdd(fo_0_2, fch_0_0)
        fch_0_0 := {}
        fky_0_0 := fsn_0_0
      EndIf
      AAdd(fch_0_0, fv_0_2)
    Next
  Next
  If fop_0_1
    AAdd(fo_0_2, fch_0_0)
  EndIf
  fo_0_3 := {}
  For fi_0_2 := 1 To Len(fo_0_2)
    fv_0_3 := fo_0_2[fi_0_2]
    fv_0_3 := len(fv_0_3)
    AAdd(fo_0_3, fv_0_3)
  Next
  aQ := fo_0_3

  // two chains on one line, and one in a postfix condition
  nT := nT + len(u_xtpl_distinct(aRows)) + len(u_xtpl_reverse(aRows))
  If len(u_xtpl_distinct(aRows)) > 3
    nT := 99
  EndIf

  conout(cMsg + cValToChar(len(aX)) + cValToChar(len(aQ)))

  conout("saindo")
  return nT

// -----------------------------------------------------------------------------
// the end
