#include "totvs.ch"
#include "tlpp-core.th"

// 09_arity.tlpp -- calls checked against signatures in the same file.
//
// AdvPL checks none of this. Only too MANY arguments is reported: a missing
// parameter arrives as Nil and plenty of code relies on that, but an extra
// one cannot be reached at all, so it is always a mistake.
// --------------------------------------------------------------------------------

static function calcTotal(nBase, nRate)

  return nBase * nRate

static function semArgs()

  return 1

user function testArity(nX)

  Local nT := 0


  nT := calcTotal(nX, 2)  // exactly right
  nT := nT + calcTotal(nX)  // fewer: ordinary, the second is Nil
  nT := nT + semArgs()

  return nT

// --------------------------------------------------------------------------------
// the end