#include "totvs.ch"
#include "tlpp-core.th"

// 34_stream_stages.xtpl -- scan, expand, tap and pairwise.
//
// All four are steps: the value carries on down the chain. expand is the
// structurally odd one -- it opens a For inside the fused loop, so the rest
// of the chain runs once per inner element, and that block closes with Next
// rather than EndIf. Tracking what closes a block, instead of counting how
// many are open, is what makes that possible.
// -----------------------------------------------------------------------------

user function testStreamStages(aMovs, aRows, aLeituras)
  local aSaldos := {}
  local aCodigos := {}
  local aDeltas := {}
  local aProdutos := {}
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fa_0_0  // the running value of a scan
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fi_0_2  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fpv_0_0  // the element pairwise saw last
  Local fhd_0_0  // whether pairwise has seen an element
  Local fol_0_0  // the element before, for pairwise
  Local frd_0_0  // whether pairwise has a pair
  Local fo_0_2  // the result of the chain
  Local far_0_0  // the area selected before the walk
  Local frc_0_0  // the record the area was on before the walk
  Local fbg_0_0  // the inner array of an expand
  Local fj_0_0  // the position in the inner array of an expand
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain

  // the balance after each movement, not just the closing one
  fa_0_0 := 0
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aMovs)
    fv_0_0 := aMovs[fi_0_0]
    fv_0_0 := fv_0_0:nValor
    fa_0_0 := fa_0_0 + fv_0_0
    fv_0_0 := fa_0_0
    AAdd(fo_0_0, fv_0_0)
  Next
  aSaldos := fo_0_0

  // look into the chain without taking it apart: the value is untouched
  fo_0_1 := {}
  For fi_0_1 := 1 To Len(aRows)
    fv_0_1 := aRows[fi_0_1]
    If fv_0_1:nSaldo > 0
      conout("passou: " + fv_0_1:cCod)
      fv_0_1 := fv_0_1:cCod
      AAdd(fo_0_1, fv_0_1)
    EndIf
  Next
  aCodigos := fo_0_1

  // each reading with the one before it: n readings give n-1 deltas
  fpv_0_0 := Nil
  fhd_0_0 := .F.
  fo_0_2 := {}
  For fi_0_2 := 1 To Len(aLeituras)
    fv_0_2 := aLeituras[fi_0_2]
    fv_0_2 := fv_0_2:nMedidor
    fol_0_0 := fpv_0_0
    frd_0_0 := fhd_0_0
    fpv_0_0 := fv_0_2
    fhd_0_0 := .T.
    If frd_0_0
      fv_0_2 := {fol_0_0, fv_0_2}
      fv_0_2 := fv_0_2[2] - fv_0_2[1]
      AAdd(fo_0_2, fv_0_2)
    EndIf
  Next
  aDeltas := fo_0_2

  // one order becomes its items, and the chain carries on with the items
  far_0_0 := Alias()
  DbSelectArea("SC5")
  frc_0_0 := SC5->(RecNo())
  SC5->(DbGoTop())
  fo_0_3 := {}
  While !SC5->(Eof())
    fbg_0_0 := itensDoPedido(SC5->C5_NUM)
    For fj_0_0 := 1 To Len(fbg_0_0)
      fv_0_3 := fbg_0_0[fj_0_0]
      fv_0_3 := fv_0_3:cProduto
      AAdd(fo_0_3, fv_0_3)
    Next
    SC5->(DbSkip())
  EndDo
  SC5->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf
  aProdutos := fo_0_3

  return len(aSaldos) + len(aCodigos) + len(aDeltas) + len(aProdutos)

// -----------------------------------------------------------------------------
// the end
