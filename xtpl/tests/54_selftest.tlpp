#include "totvs.ch"
#include "tlpp-core.th"

// 54_selftest.xtpl -- roda o que as outras fixtures apenas compilam.
//
// Cinquenta e tres fixtures passam pelo compilador. Nenhuma linha gerada foi
// executada, e compilar nao e funcionar: se um laco fundido calcula o que a
// cadeia disse, ninguem sabe.
//
// Esta e um programa so, sem tabelas e sem arquivos, que exercita o runtime e
// as construcoes geradas e confere cada resposta. Compile e chame u_selftest():
// ele imprime uma linha por falha e um total no fim.
//
//   u_selftest()
//   selftest: 47 ok, 0 falhas
//
// Tudo aqui e computacao pura de proposito. Nada que dependa de area de
// trabalho, arquivo ou tela entra, porque o objetivo e uma resposta certa ou
// errada, nao um ambiente.
// -----------------------------------------------------------------------------

user function selftest()
  local nOk := 0
  local nBad := 0
  local aNums := {3, 1, 4, 1, 5, 9, 2, 6}
  local aRep := {1, 1, 2, 2, 2, 3, 1}
  local aPal := {"beta", "alfa", "gama"}
  local hCfg := u_xtpl_hnew({{"taxa", 5}, {"limite", 10}})
  local oFila
  local aTmp := {}
  local nTmp := 0
  local cTmp := ""
  local lTmp := .F.
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain
  Local fi_0_1  // the position in the array walked
  Local fv_0_1  // the element walked
  Local fo_0_1  // the result of the chain
  Local fi_0_2  // the position in the array walked
  Local fv_0_2  // the element walked
  Local fo_0_2  // the result of the chain
  Local fi_0_3  // the position in the array walked
  Local fv_0_3  // the element walked
  Local fo_0_3  // the result of the chain
  Local fs_0_0  // the array walked
  Local fi_0_4  // the position in the array walked
  Local fv_0_4  // the element walked
  Local fo_0_4  // the result of the chain
  Local fi_0_5  // the position in the array walked
  Local fv_0_5  // the element walked
  Local fo_0_5  // the result of the chain
  Local fi_0_6  // the position in the array walked
  Local fv_0_6  // the element walked
  Local fn_0_0  // how many elements have passed
  Local fo_0_6  // the result of the chain
  Local fi_0_7  // the position in the array walked
  Local fv_0_7  // the element walked
  Local fo_0_7  // the result of the chain
  Local fi_0_8  // the position in the array walked
  Local fv_0_8  // the element walked
  Local fo_0_8  // the result of the chain
  Local fi_0_9  // the position in the array walked
  Local fv_0_9  // the element walked
  Local fo_0_9  // the result of the chain
  Local fi_0_10  // the position in the array walked
  Local fv_0_10  // the element walked
  Local fo_0_10  // the result of the chain
  Local fi_0_11  // the position in the array walked
  Local fv_0_11  // the element walked
  Local fo_0_11  // the result of the chain
  Local fi_0_12  // the position in the array walked
  Local fv_0_12  // the element walked
  Local fo_0_12  // the result of the chain
  Local fbs_0_0  // the best key maxby/minby has seen
  Local fop_0_0  // whether maxby/minby has seen an element
  Local fpb_0_0  // the key of the element maxby/minby looks at
  Local fs_0_1  // the array walked
  Local fi_0_13  // the position in the array walked
  Local fv_0_13  // the element walked
  Local fa_0_0  // the running value of a scan
  Local fo_0_13  // the result of the chain
  Local fs_0_2  // the array walked
  Local fi_0_14  // the position in the array walked
  Local fv_0_14  // the element walked
  Local fpv_0_0  // the element pairwise saw last
  Local fhd_0_0  // whether pairwise has seen an element
  Local fol_0_0  // the element before, for pairwise
  Local frd_0_0  // whether pairwise has a pair
  Local fo_0_14  // the result of the chain
  Local fs_0_3  // the array walked
  Local fi_0_15  // the position in the array walked
  Local fv_0_15  // the element walked
  Local fbg_0_0  // the inner array of an expand
  Local fj_0_0  // the position in the inner array of an expand
  Local fo_0_15  // the result of the chain
  Local fi_0_16  // the position in the array walked
  Local fv_0_16  // the element walked
  Local fo_0_16  // the result of the chain
  Local fch_0_0  // the chunk chunkby is filling
  Local fky_0_0  // the key of the chunk chunkby is filling
  Local fop_0_1  // whether chunkby has seen an element
  Local fsn_0_0  // the key of the element chunkby looks at
  Local fi_0_17  // the position in the array walked
  Local fv_0_17  // the element walked
  Local fo_0_17  // the result of the chain
  Local fi_0_18  // the position in the array walked
  Local fv_0_18  // the element walked
  Local fdr_0_0  // whether the leading run of a dropwhile is still on
  Local fo_0_18  // the result of the chain
  Local gt_0_0  // the error block a 'fallback' sets aside
  Local nCada  // a block local
  Local fs_0_4  // the source of a 'for ... in'
  Local fi_0_19  // the counter of a 'for ... in'
  Local nDobro  // a block local

  // ---- runtime: folds ----------------------------------------------------
  nTmp := u_xtpl_asum(aNums)
  check("asum", nTmp == 31, nTmp, @nOk, @nBad)
  nTmp := u_xtpl_amax(aNums)
  check("amax", nTmp == 9, nTmp, @nOk, @nBad)
  nTmp := u_xtpl_amin(aNums)
  check("amin", nTmp == 1, nTmp, @nOk, @nBad)
  nTmp := u_xtpl_aprod({2, 3, 4})
  check("aprod", nTmp == 24, nTmp, @nOk, @nBad)
  nTmp := u_xtpl_asum({})
  check("asum vazio", nTmp == 0, nTmp, @nOk, @nBad)
  check("amax vazio", u_xtpl_amax({}) == Nil, 0, @nOk, @nBad)

  // ---- runtime: transformacoes -------------------------------------------
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(aNums)
    fv_0_0 := aNums[fi_0_0]
    fv_0_0 := fv_0_0 * 2
    AAdd(fo_0_0, fv_0_0)
  Next
  aTmp := fo_0_0
  check("map", len(aTmp) == 8 .and. aTmp[1] == 6, len(aTmp), @nOk, @nBad)
  fo_0_1 := {}
  For fi_0_1 := 1 To Len(aNums)
    fv_0_1 := aNums[fi_0_1]
    If fv_0_1 > 3
      AAdd(fo_0_1, fv_0_1)
    EndIf
  Next
  aTmp := fo_0_1
  check("filter", len(aTmp) == 4, len(aTmp), @nOk, @nBad)
  fo_0_2 := {}
  For fi_0_2 := 1 To Len(aNums)
    fv_0_2 := aNums[fi_0_2]
    If !(fv_0_2 > 3)
      AAdd(fo_0_2, fv_0_2)
    EndIf
  Next
  aTmp := fo_0_2
  check("reject", len(aTmp) == 4, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_take(aNums, 3)
  check("take", len(aTmp) == 3 .and. aTmp[3] == 4, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_drop(aNums, 6)
  check("drop", len(aTmp) == 2 .and. aTmp[1] == 2, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_take(aNums, 99)
  check("take demais", len(aTmp) == 8, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_reverse({1, 2, 3})
  check("reverse", aTmp[1] == 3 .and. aTmp[3] == 1, aTmp[1], @nOk, @nBad)
  aTmp := u_xtpl_distinct(aRep)
  check("distinct", len(aTmp) == 3, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_distinctadjacent(aRep)
  check("distinctAdjacent", len(aTmp) == 4, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_flatten({1, {2, {3, 4}}, 5})
  check("flatten", len(aTmp) == 5 .and. aTmp[4] == 4, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_enumerate({"a", "b"})
  check("enumerate", aTmp[2][1] == 2 .and. aTmp[2][2] == "b", 0, @nOk, @nBad)
  aTmp := u_xtpl_chunks({1, 2, 3, 4, 5}, 2)
  check("chunks", len(aTmp) == 3 .and. len(aTmp[3]) == 1, len(aTmp), @nOk, @nBad)

  // ---- sort copia antes de ordenar ---------------------------------------
  aTmp := u_xtpl_sort(aPal)
  check("sort", aTmp[1] == "alfa", 0, @nOk, @nBad)
  check("sort nao mexe na entrada", aPal[1] == "beta", 0, @nOk, @nBad)
  aTmp := u_xtpl_sortby(aPal, {|c| len(c)})
  check("sortBy", len(aTmp) == 3, len(aTmp), @nOk, @nBad)

  // ---- dobras com bloco --------------------------------------------------
  fo_0_3 := 100
  For fi_0_3 := 1 To Len(aNums)
    fv_0_3 := aNums[fi_0_3]
    fo_0_3 := fo_0_3 + fv_0_3
  Next
  nTmp := fo_0_3
  check("reduce com semente", nTmp == 131, nTmp, @nOk, @nBad)
  fs_0_0 := {4, 9, 2}
  fo_0_4 := Nil
  For fi_0_4 := 1 To Len(fs_0_0)
    fv_0_4 := fs_0_0[fi_0_4]
    If fo_0_4 == Nil
      fo_0_4 := fv_0_4
    Else
      fo_0_4 := Iif(fv_0_4 > fo_0_4, fv_0_4, fo_0_4)
    EndIf
  Next
  nTmp := fo_0_4
  check("fold", nTmp == 9, nTmp, @nOk, @nBad)
  check("fold vazio", u_xtpl_fold({}, {|acc, x| acc}) == Nil, 0, @nOk, @nBad)

  // ---- zip ---------------------------------------------------------------
  aTmp := u_xtpl_zip({1, 2, 3}, {"a", "b"})
  check("zip corta no menor", len(aTmp) == 2, len(aTmp), @nOk, @nBad)
  aTmp := u_xtpl_zip({1, 2}, {10, 20}, {|a, b| a + b})
  check("zip com bloco", aTmp[2] == 22, aTmp[2], @nOk, @nBad)

  // ---- pertinencia e divisibilidade --------------------------------------
  check("in array", u_xtpl_in(5, aNums), 0, @nOk, @nBad)
  check("in array ausente", !u_xtpl_in(7, aNums), 0, @nOk, @nBad)
  check("in faixa", (5 >= 1 .And. 5 <= 10), 0, @nOk, @nBad)
  check("divisivel", ((9 % 3) == 0), 0, @nOk, @nBad)
  check("nao divisivel", !((10 % 3) == 0), 0, @nOk, @nBad)

  // ---- cadeia fundida: o resultado tem de bater com as etapas -------------
  fo_0_5 := 0
  For fi_0_5 := 1 To Len(aNums)
    fv_0_5 := aNums[fi_0_5]
    If fv_0_5 > 2
      fv_0_5 := fv_0_5 * 10
      fo_0_5 := fo_0_5 + fv_0_5
    EndIf
  Next
  nTmp := fo_0_5
  check("cadeia fundida", nTmp == 270, nTmp, @nOk, @nBad)
  fn_0_0 := 0
  fo_0_6 := {}
  For fi_0_6 := 1 To Len(aNums)
    fv_0_6 := aNums[fi_0_6]
    If fv_0_6 > 2
      If fn_0_0 >= 2
        Exit
      EndIf
      fn_0_0++
      AAdd(fo_0_6, fv_0_6)
    EndIf
  Next
  aTmp := fo_0_6
  check("take para o laco", len(aTmp) == 2 .and. aTmp[2] == 4, len(aTmp), @nOk, @nBad)
  fo_0_7 := 0
  For fi_0_7 := 1 To Len(aNums)
    fv_0_7 := aNums[fi_0_7]
    If fv_0_7 > 3
      fo_0_7++
    EndIf
  Next
  nTmp := fo_0_7
  check("count", nTmp == 4, nTmp, @nOk, @nBad)
  fo_0_8 := Nil
  For fi_0_8 := 1 To Len(aNums)
    fv_0_8 := aNums[fi_0_8]
    If fv_0_8 > 4
      fo_0_8 := fv_0_8
      Exit
    EndIf
  Next
  nTmp := fo_0_8
  check("first", nTmp == 5, nTmp, @nOk, @nBad)
  check("first sem acerto", u_xtpl_first(aNums, {|x| x > 99}) == Nil, 0, @nOk, @nBad)
  fo_0_9 := .F.
  For fi_0_9 := 1 To Len(aNums)
    fv_0_9 := aNums[fi_0_9]
    If fv_0_9 == 9
      fo_0_9 := .T.
      Exit
    EndIf
  Next
  lTmp := fo_0_9
  check("anyof", lTmp, 0, @nOk, @nBad)
  fo_0_10 := .T.
  For fi_0_10 := 1 To Len(aNums)
    fv_0_10 := aNums[fi_0_10]
    If !(fv_0_10 > 0)
      fo_0_10 := .F.
      Exit
    EndIf
  Next
  lTmp := fo_0_10
  check("allof", lTmp, 0, @nOk, @nBad)
  fo_0_11 := .T.
  For fi_0_11 := 1 To Len(aNums)
    fv_0_11 := aNums[fi_0_11]
    If fv_0_11 > 99
      fo_0_11 := .F.
      Exit
    EndIf
  Next
  lTmp := fo_0_11
  check("noneof", lTmp, 0, @nOk, @nBad)
  fbs_0_0 := Nil
  fop_0_0 := .F.
  fpb_0_0 := Nil
  fo_0_12 := Nil
  For fi_0_12 := 1 To Len(aNums)
    fv_0_12 := aNums[fi_0_12]
    fpb_0_0 := -fv_0_12
    If !fop_0_0 .Or. fpb_0_0 > fbs_0_0
      fop_0_0 := .T.
      fbs_0_0 := fpb_0_0
      fo_0_12 := fv_0_12
    EndIf
  Next
  nTmp := fo_0_12
  check("maxby", nTmp == 1, nTmp, @nOk, @nBad)

  // ---- etapas de fluxo ---------------------------------------------------
  fs_0_1 := {10, -3, 5}
  fa_0_0 := 0
  fo_0_13 := {}
  For fi_0_13 := 1 To Len(fs_0_1)
    fv_0_13 := fs_0_1[fi_0_13]
    fa_0_0 := fa_0_0 + fv_0_13
    fv_0_13 := fa_0_0
    AAdd(fo_0_13, fv_0_13)
  Next
  aTmp := fo_0_13
  check("scan", len(aTmp) == 3 .and. aTmp[3] == 12, aTmp[3], @nOk, @nBad)
  fs_0_2 := {1, 4, 9}
  fpv_0_0 := Nil
  fhd_0_0 := .F.
  fo_0_14 := {}
  For fi_0_14 := 1 To Len(fs_0_2)
    fv_0_14 := fs_0_2[fi_0_14]
    fol_0_0 := fpv_0_0
    frd_0_0 := fhd_0_0
    fpv_0_0 := fv_0_14
    fhd_0_0 := .T.
    If frd_0_0
      fv_0_14 := {fol_0_0, fv_0_14}
      fv_0_14 := fv_0_14[2] - fv_0_14[1]
      AAdd(fo_0_14, fv_0_14)
    EndIf
  Next
  aTmp := fo_0_14
  check("pairwise", len(aTmp) == 2 .and. aTmp[2] == 5, aTmp[2], @nOk, @nBad)
  fs_0_3 := {1, 2, 3}
  fo_0_15 := {}
  For fi_0_15 := 1 To Len(fs_0_3)
    fv_0_15 := fs_0_3[fi_0_15]
    fbg_0_0 := {fv_0_15, fv_0_15}
    For fj_0_0 := 1 To Len(fbg_0_0)
      fv_0_15 := fbg_0_0[fj_0_0]
      AAdd(fo_0_15, fv_0_15)
    Next
  Next
  aTmp := fo_0_15
  check("expand", len(aTmp) == 6, len(aTmp), @nOk, @nBad)
  fch_0_0 := {}
  fky_0_0 := Nil
  fop_0_1 := .F.
  fsn_0_0 := Nil
  fo_0_16 := {}
  For fi_0_16 := 1 To Len(aRep)
    fv_0_16 := aRep[fi_0_16]
    fsn_0_0 := fv_0_16
    If !fop_0_1
      fop_0_1 := .T.
      fky_0_0 := fsn_0_0
    ElseIf !(fsn_0_0 == fky_0_0)
      AAdd(fo_0_16, fch_0_0)
      fch_0_0 := {}
      fky_0_0 := fsn_0_0
    EndIf
    AAdd(fch_0_0, fv_0_16)
  Next
  If fop_0_1
    AAdd(fo_0_16, fch_0_0)
  EndIf
  aTmp := fo_0_16
  check("chunkby", len(aTmp) == 4 .and. len(aTmp[3]) == 1, len(aTmp), @nOk, @nBad)
  fo_0_17 := {}
  For fi_0_17 := 1 To Len(aNums)
    fv_0_17 := aNums[fi_0_17]
    If !(fv_0_17 < 5)
      Exit
    EndIf
    AAdd(fo_0_17, fv_0_17)
  Next
  aTmp := fo_0_17
  check("takewhile", len(aTmp) == 4, len(aTmp), @nOk, @nBad)
  fdr_0_0 := .T.
  fo_0_18 := {}
  For fi_0_18 := 1 To Len(aNums)
    fv_0_18 := aNums[fi_0_18]
    If !(fdr_0_0 .And. (fv_0_18 < 5))
      fdr_0_0 := .F.
      AAdd(fo_0_18, fv_0_18)
    EndIf
  Next
  aTmp := fo_0_18
  check("dropwhile", len(aTmp) == 4 .and. aTmp[1] == 5, len(aTmp), @nOk, @nBad)

  // ---- strings -----------------------------------------------------------
  aTmp := u_xtpl_split("a,b,c", ",")
  check("split", len(aTmp) == 3 .and. aTmp[2] == "b", len(aTmp), @nOk, @nBad)
  cTmp := u_xtpl_join({"a", "b", "c"}, "-")
  check("join", cTmp == "a-b-c", 0, @nOk, @nBad)
  check("starts", u_xtpl_starts("abcdef", "abc"), 0, @nOk, @nBad)
  check("ends", u_xtpl_ends("abcdef", "def"), 0, @nOk, @nBad)
  check("contains", u_xtpl_contains("abcdef", "cde"), 0, @nOk, @nBad)
  cTmp := ("soma " + cValToChar(1 + 2) + " fim")
  check("interpolacao", cTmp == "soma 3 fim", 0, @nOk, @nBad)

  // ---- hash --------------------------------------------------------------
  check("hash leitura", u_xtpl_hget(hCfg, "taxa") == 5, 0, @nOk, @nBad)
  check("hash ausente", u_xtpl_hget(hCfg, "nada") == Nil, 0, @nOk, @nBad)
  check("hash has", u_xtpl_hhas(hCfg, "limite"), 0, @nOk, @nBad)
  hCfg:Set("taxa", 7)
  check("hash escrita", u_xtpl_hget(hCfg, "taxa") == 7, 0, @nOk, @nBad)
  aTmp := u_xtpl_keys(hCfg)
  check("keys", len(aTmp) == 2, len(aTmp), @nOk, @nBad)
  nTmp := u_xtpl_asum(u_xtpl_values(hCfg))
  check("values", nTmp == 17, nTmp, @nOk, @nBad)

  // ---- operadores --------------------------------------------------------
  cTmp := Nil
  If cTmp == Nil
    cTmp := "padrao"
  EndIf
  check("?= atribui quando Nil", cTmp == "padrao", 0, @nOk, @nBad)
  If cTmp == Nil
    cTmp := "outro"
  EndIf
  check("?= nao atribui depois", cTmp == "padrao", 0, @nOk, @nBad)
  nTmp := 42
  check("?: pega a alternativa", nTmp == 42, nTmp, @nOk, @nBad)
  nTmp := 7
  check("?: pega o valor", nTmp == 7, nTmp, @nOk, @nBad)

  // ---- fallback ----------------------------------------------------------
  gt_0_0 := ErrorBlock({|e| Break(e)})
  Begin Sequence
    nTmp := aNums[99]
  Recover
    nTmp := -1
  End Sequence
  ErrorBlock(gt_0_0)
  check("fallback pega o erro", nTmp == -1, nTmp, @nOk, @nBad)
  gt_0_0 := ErrorBlock({|e| Break(e)})
  Begin Sequence
    nTmp := len({1, 2})
  Recover
    nTmp := -1
  End Sequence
  ErrorBlock(gt_0_0)
  check("fallback nao atrapalha", nTmp == 2, nTmp, @nOk, @nBad)

  // ---- fila --------------------------------------------------------------
  // Construida aqui, e nao no prologo: se a classe falhar, so os testes da
  // fila falham, e nao todos os que vem antes.
  oFila := u_xtpl_queue()
  oFila:Push("a")
  oFila:Push("b")
  check("fila conta", oFila:Count() == 2, oFila:Count(), @nOk, @nBad)
  check("fila e FIFO", oFila:Pop() == "a", 0, @nOk, @nBad)
  check("fila sobra", oFila:Peek() == "b", 0, @nOk, @nBad)
  oFila:Pop()
  check("fila vazia", oFila:IsEmpty(), 0, @nOk, @nBad)
  check("pop vazio da Nil", oFila:Pop() == Nil, 0, @nOk, @nBad)

  // ---- escopo de bloco e reciclagem de slot ------------------------------
  nTmp := 0
  fs_0_4 := {1, 2, 3}
  For fi_0_19 := 1 To Len(fs_0_4)
    nCada := fs_0_4[fi_0_19]
    nDobro := nCada * 2
    nTmp := nTmp + nDobro
  next
  check("local de bloco em laco", nTmp == 12, nTmp, @nOk, @nBad)

  // os defers rodam antes da linha do Return, em ordem inversa: 10 +2 +1
  nTmp := defers()
  check("defer roda na saida", nTmp == 13, nTmp, @nOk, @nBad)

  conout("selftest: " + cValToChar(nOk) + " ok, " + cValToChar(nBad) + " falhas")

return nBad

// -----------------------------------------------------------------------------

static function check(cNome, lOk, xVisto, nOk, nBad)
  if lOk
    nOk := nOk + 1
  else
    nBad := nBad + 1
    conout("FALHA  " + cNome + "  (visto: " + cValToChar(xVisto) + ")")
  endif
return nil

// Dois defers, ordem inversa, mais um return antecipado que nao e tomado.
static function defers()
  local nTotal := 0


  nTotal := 10

nTotal := nTotal + 2
nTotal := nTotal + 1
return nTotal

// -----------------------------------------------------------------------------
// the end
