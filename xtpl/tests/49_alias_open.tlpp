#include "totvs.ch"
#include "tlpp-core.th"

// 49_alias_open.xtpl -- is this alias even open?
//
// A field reference against an alias nothing in the function opened. It only
// became checkable once 'using alias' and 'rows()' existed, because those are
// what let a function say which areas it opens.
//
// Reported once per alias, not per use: a function naming SA1 twenty times
// has one problem, not twenty. Off under --legacy, where an alias opened by
// the caller is the norm rather than the exception.
// -----------------------------------------------------------------------------

// the caller opens this one

user function testAliasOpen(nX)
  local nT := 0
  Local far_0_0  // the area selected before a 'using alias'
  Local frc_0_0  // the record the area was on before a 'using alias'

  // opened here, so both uses are fine
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
    nT := SA1->A1_SALDO + SA1->A1_VALOR
  SA1->(DbGoto(frc_0_0))
  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  // opened by DbSelectArea, which counts too
  DbSelectArea("SC5")
  nT := nT + SC5->C5_NUM

  // promised by the external declaration above
  nT := nT + SB1->B1_COD

  // nothing opened this one, and it is used twice
  nT := nT + SD1->D1_QUANT
  nT := nT + SD1->D1_TOTAL

  return nT

// -----------------------------------------------------------------------------
// the end
