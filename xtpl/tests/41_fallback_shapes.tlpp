#include "totvs.ch"
#include "tlpp-core.th"

// 41_fallback_shapes.xtpl -- what a guard can and cannot hold.
//
// 'fallback' folds everything the line generates into one code block, as
// comma-separated expressions. A fused loop is not an expression, so a chain
// under a guard goes unfused, back to the runtime calls -- which are.
//
// This was emitting 'For ... Next' inside a code block, and the golden file
// agreed with it, because a golden records what was produced rather than what
// AdvPL accepts.
// -----------------------------------------------------------------------------

user function testFallbackShapes(aNums, hCfg)
  local nSafe := 0
  local nHash := 0
  local aList := {}
  Local fs_0_0  // the array walked
  Local fi_0_0  // the position in the array walked
  Local fv_0_0  // the element walked
  Local fo_0_0  // the result of the chain

  // a bare call
  nSafe := u_xtpl_safe_pipe({|| riskyCall(1)}, {|| 0})

  // a chain: unfused under the guard, so every step is an expression -- and
  // xtpl says so, because losing a pass is invisible in the source
  nSafe := u_xtpl_safe_pipe({|| u_xtpl_asum(u_xtpl_map(u_xtpl_filter(aNums, {|x| x > 100}), {|x| x * 2}))}, {|| 0})

  // the guard on the part that can fail, and the chain left to fuse
  fs_0_0 := u_xtpl_safe_pipe({|| riskyCall(2)}, {|| {}})
  fo_0_0 := {}
  For fi_0_0 := 1 To Len(fs_0_0)
    fv_0_0 := fs_0_0[fi_0_0]
    If fv_0_0 > 1
      fv_0_0 := fv_0_0 * 2
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next
  aList := fo_0_0

  // a hash read lifts statements, and they are expressions too
  nHash := u_xtpl_safe_pipe({|| u_xtpl_hget(hCfg, "taxa")}, {|| 0})


  return nSafe + nHash + len(aList)

// -----------------------------------------------------------------------------
// the end
