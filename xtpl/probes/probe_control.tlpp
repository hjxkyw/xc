#include "totvs.ch"
#include "tlpp-core.th"

// probe_control.tlpp -- estruturas de controle sobre slots compartilhados.
//
// A regra de aliasing precisa de um terminador:
//
//    #translate !<name>^<num1>^<num2>! => s_<num1>_<num2>
//
// Sem o '!' final o ultimo marcador engole o que vem depois, e o estrago
// aparece justamente num cabecalho 'For', onde ha texto do lado direito.
//
// Este arquivo poe a grafia em toda posicao onde algo pode segui-la: cabecalho
// de laco, condicao, indice, argumento, comparacao, os dois lados de uma
// atribuicao, dentro de um code block e dentro de uma string interpolada.
//
// Compile e rode u_probeControl(). Deve imprimir, exatamente:
//
//    controle: for=6 while=3 case=maior each=cba times=3 nested=10 block=20
//    controle: ok
//
// (nested: aNums e {1,2,3}, a guarda e nX > 1, entao dobra 2 e 3 -- 4 + 6.)
//
// Qualquer numero diferente quer dizer que uma grafia foi reescrita errada.
// --------------------------------------------------------------------------------

user function probeControl()

  Local cSaida := ""
  Local aLetras := {"a", "b", "c"}
  Local aNums := {1, 2, 3}
  Local nFora := 0
  Local aBlocos := {}
  Local lOk := .T.

  Local s_1_0       // um slot, dividido por cJunto, nConta, nSoma, nSub, nTotal, nVezes
  Local s_2_0       // um slot, dividido por each, nI, times
  Local s_2_1       // um slot, dividido por cLetra, nX
  Local s_2_2       // um slot, dividido por eachi, nOnde
  Local b_1_nFator  // o local de bloco 'nFator', fixado: tem armazenamento so dele
  Local s_3_nDobro  // o local de bloco 'nDobro'

  // ---- for contado: a grafia no cabecalho, dos dois lados do To ----------
  if .T.
    s_1_0 := 0
    for s_2_0 := 1 to 3
      s_1_0 := s_1_0 + s_2_0
    next
    cSaida := "for=" + cValToChar(s_1_0)
  endif

  // ---- while com a grafia na condicao e no corpo -------------------------
  if .T.
    s_1_0 := 0
    while s_1_0 < 3
      s_1_0 := s_1_0 + 1
    enddo
    cSaida := cSaida + " while=" + cValToChar(s_1_0)
  endif

  // ---- do case with: sujeito ligado uma vez ------------------------------
  s_1_0 := 7

  Do Case
    case s_1_0 == 6
      cSaida := cSaida + " case=seis"
    case s_1_0 > 3
      cSaida := cSaida + " case=maior"
    otherwise
      cSaida := cSaida + " case=pequeno"
  endcase

  // ---- for ... in: elemento e indice, e a grafia como indice de array ----
  if .T.
    s_1_0 := ""
    s_2_0 := aLetras
    For s_2_2 := 1 To Len(s_2_0)
      s_2_1 := s_2_0[s_2_2]
      s_1_0 := aLetras[s_2_2] + s_1_0
    next
    cSaida := cSaida + " each=" + s_1_0
  endif

  // ---- for <n> times -----------------------------------------------------
  if .T.
    s_1_0 := 0
    For s_2_0 := 1 To 3
      s_1_0 := s_1_0 + 1
    next
    cSaida := cSaida + " times=" + cValToChar(s_1_0)
  endif

  // ---- blocos aninhados: profundidades diferentes, slots diferentes ------
  if .T.
    s_1_0 := 0
    s_2_0 := aNums
    For s_2_2 := 1 To Len(s_2_0)
      s_2_1 := s_2_0[s_2_2]
      if s_2_1 > 1
        s_3_nDobro := s_2_1 * 2
        s_1_0 := s_1_0 + s_3_nDobro
      endif
    next
    cSaida := cSaida + " nested=" + cValToChar(s_1_0)
  endif

  // ---- capturada por um code block: NAO pode dividir slot ----------------
  if .T.
    b_1_nFator := 10
    aadd(aBlocos, {|| b_1_nFator * 2})
  endif

  nFora := eval(aBlocos[1])
  cSaida := cSaida + " block=" + cValToChar(nFora)

  conout("controle: " + cSaida)

  // ---- e a conferencia, para nao depender de ler a linha acima -----------
  lOk := cSaida == "for=6 while=3 case=maior each=cba times=3 nested=10 block=20"
  conout("controle: " + iif(lOk, "ok", "FALHOU"))

  return iif(lOk, 0, 1)

// --------------------------------------------------------------------------------
// the end