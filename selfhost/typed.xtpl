#include "totvs.ch"
#include "xcb.ch"

// typed.xtpl -- what each name holds (cpp/src/typed.cpp): what the back
// end needs of it, a set's or a bag's 'h{k}' (HIX_SETKIND) and a 'for ...
// in' over a hash, a set, a bag or a JSON object (FIN_KEYED), worked out
// for every file; and what goes into a typed array or hash, a fixed one, a
// typed parameter or Data, judged for a file that types one. The types are
// typed.cpp's strings: 'N', 'A<C>', 'H<C,N>', 'S<C>', 'M<C>', '!' before a
// fixed one, 'O:Depot:Stock' -- the class, then those it inherits from in
// the file --, '' for Nil (fits every type), '?' for what xc cannot tell,
// '_' for nothing known yet. There is no dictionary here: a field's type
// is not known.
// -----------------------------------------------------------------------------

#define T_NIL        ""
#define T_UNKNOWN    "?"
#define T_NONE       "_"

// A name: what it is called, whether its type is declared (or one xc does
// not work out), what it holds, the typed array or hash it is declared as,
// the line it is declared on.
#define V_NAME       1
#define V_PINNED     2
#define V_TYPE       3
#define V_CONTAINER  4
#define V_LINE       5
#define V_BLOCK      6       // a lambda's or a code block's parameter

// A type of the file: its name, its TypeDef, its fields (TFD_*) at their
// positions from 1, the place of each by its name in lower case, its
// methods by theirs. A field: its name, what it holds, what xc checks goes
// in (or ''), whether it is <const>, its position, its declarator. Where an
// 'x.f', a value made, a verb is: {the node, the class and the type it is
// in, its line}.
#define TI_NAME      1
#define TI_DEF       2
#define TI_FIELDS    3
#define TI_BYNAME    4
#define TI_METHODS   5
#define TI_INHERITED 6       // the fields of the type it is from, first
#define TFD_NAME     1
#define TFD_TYPE     2
#define TFD_SLOT     3
#define TFD_CONST    4
#define TFD_POS      5
#define TFD_DECL     6
#define TFD_OWNER    7       // the type that declares it, as written
#define AT_E         1
#define AT_CLS       2
#define AT_TYP       3
#define AT_LINE      4

// What a function does (typed.cpp's Event), and on what line: declares a
// name -- the value, its init, and the declarator --, assigns one, counts
// with one, walks something with one, gives one what xc cannot tell,
// passes one by reference, calls -- a stage of a chain, from 0, too --,
// calls a method, returns.
#define EV_KIND      1
#define EV_VAR       2
#define EV_INDEX     3
#define EV_VALUE     4
#define EV_TARGET    5
#define EV_OP        6
#define EV_INCDEC    7
#define EV_LINE      8
#define EV_DECL      9
#define EV_CALL      10
#define EV_CHAIN     11
#define EV_STAGE     12
#define EV_METHOD    13
#define EV_SIZE      13

#define EVK_DECL     1
#define EVK_ASSIGN   2
#define EVK_COUNTER  3
#define EVK_FORIN    4
#define EVK_UNKNOWN  5
#define EVK_REF      6
#define EVK_CALLE    7
#define EVK_METHODE  8
#define EVK_RETURN   9

// A function's events -- the file's statics' too --, the class of a
// method, what it returns if that is a typed array or hash, its name, and
// whether it is a constructor.
#define U_EVENTS     1
#define U_CLS        2
#define U_RET        3
#define U_NAME       4
#define U_CTOR       5

// A Data of a class: what it holds -- its container, or its type's letter
// --, the typed array's, hash's or class's it is declared as, its name as
// declared, its line.
#define DA_TYPE      1
#define DA_CONTAINER 2
#define DA_NAME      3
#define DA_LINE      4

// A function of the file: its name as declared, its parameters.
#define FF_NAME      1
#define FF_PARAMS    2

// Whether a value goes where a type is wanted.
#define FIT_OK       0
#define FIT_WRONG    1
#define FIT_UNKNOWN  2

// A class of the file: its name, those it inherits from and implements (in
// lower case), its Data (DA_*), its methods' signatures and
// implementations -- each a hash by its name in lower case.
#define CI_NAME      1
#define CI_SUPERS    2
#define CI_DATA      3
#define CI_SIGS      4
#define CI_IMPLS     5

Static aVars := {}
Static aScopes := {}
Static hNames := Nil          // what each Name is, by its node's number
Static hBlockParams := Nil    // a block's parameters, by its node's number
Static aHashes := {}          // every 'h{k}', and the class it is in
Static aWalks := {}           // every 'for ... in', and the class it is in
Static hClasses := Nil
Static cCls := ""
Static aUnits := {}
Static hReturns := Nil        // what the file's functions return
Static hFunctions := Nil
Static lChanged := .F.
Static hBuiltins := Nil       // TL++'s functions, and what each gives
Static nLineT := 0
Static cRet := ""             // what the function checked returns, if it is a typed array or hash
Static cRetName := ""
Static aErrors := {}
Static aWarnings := {}
Static hTypes := Nil          // the file's types, by their names in lower case
Static hTypeWords := Nil      // and how the file declares each
Static hTypeBases := Nil      // and the type each is from: 'order' -> 'item'
Static cTyp := ""             // the type of the method walked, in lower case
// Each 'x.f', 'x.m()', each 'x?.f', each 'with object''s subject, each
// value of a type made, each verb that walks with a lambda (AT_*).
Static aDots := {}
Static aSafes := {}
Static aWiths := {}
Static aMakes := {}
Static aVerbs := {}

// The verbs whose lambda is given what they walk.
Static cWalkers := "|map|filter|reject|tap|takewhile|dropwhile|expand|distinctadjacent|sort|sortby|chunkby|scan|" ;
                   + "reduce|fold|count|first|anyof|allof|noneof|maxby|minby|heapof|"

Static cLogical := "|==|=|!=|<>|#|<|>|<=|>=|$|.and.|.or.|!|in|has|%%|(elem)|(cont)|(<=)|(<)|(>=)|(>)|(==)|"

// The runtime's verbs that give an array of what they walk, as they walk
// it: some of it, or in another order.
Static cKeeps := "|filter|reject|tap|take|drop|takewhile|dropwhile|distinct|distinctadjacent|sort|sortby|" ;
                 + "reverse|apick|aroll|"

// The marks of a program's tree: what a 'for ... in' walks and a 'h{k}'
// reads, worked out for every file.
User Function xcb_typed(aProg)
  u_xcb_typedproblems(aProg)
Return Nil

// The same, and what is wrong in a file that types an array or a hash:
// {errors, warnings}, each a list of {line, what}.
User Function xcb_typedproblems(aProg)
  Local nI
  Local nJ
  Local aC
  Local aCi
  Local cK
  Local aD
  Local cT
  Local aF
  Local cName
  Local aM
  Local hFile
  Local aH
  Local cRetW
  Local cWord
  Local aSig
  Local lTyped
  Local aK
  Local aDk
  Local nU
  Local nE
  Local aCd
  Local aU
  Local lGiven
  Local aEv
  aErrors := {}
  aWarnings := {}
  nLineT := 0
  aVars := {}
  aScopes := {}
  hNames := { => }
  hBlockParams := { => }
  aHashes := {}
  aWalks := {}
  hClasses := { => }
  cCls := ""
  aUnits := {}
  hReturns := { => }
  hFunctions := { => }
  hTypes := { => }
  hTypeWords := { => }
  hTypeBases := { => }
  cTyp := ""
  aDots := {}
  aSafes := {}
  aWiths := {}
  aMakes := {}
  aVerbs := {}
  If hBuiltins == Nil
    hBuiltins := Builtins()
  EndIf
  Types(aProg)
  // The file's classes: their names first -- a Data's type may be one
  // declared further on --, then their Data and their methods.
  For nI := 1 To Len(aProg[PG_CLASSES])
    aC := aProg[PG_CLASSES][nI]
    cK := u_xcb_lc(aC[CD_NAME])
    If !(hClasses has cK)
      hClasses{cK} := {"", {}, { => }, { => }, { => }}
    EndIf
    aCi := hClasses{cK}
    aCi[CI_NAME] := aC[CD_NAME]
    // An object of a class is one of the interfaces it implements too.
    For nJ := 1 To Len(aC[CD_SUPERS])
      AAdd(aCi[CI_SUPERS], u_xcb_lc(aC[CD_SUPERS][nJ]))
    Next
    For nJ := 1 To Len(aC[CD_IFACES])
      AAdd(aCi[CI_SUPERS], u_xcb_lc(aC[CD_IFACES][nJ]))
    Next
  Next
  For nI := 1 To Len(aProg[PG_CLASSES])
    aC := aProg[PG_CLASSES][nI]
    aCi := hClasses{u_xcb_lc(aC[CD_NAME])}
    For nJ := 1 To Len(aC[CD_MEMBERS])
      aD := aC[CD_MEMBERS][nJ]
      cT := If(aD[DM_TYPE] != Nil, WordType(aD[DM_TYPE]), T_UNKNOWN)
      aCi[CI_DATA]{u_xcb_lc(aD[DM_NAME])} := {If(!(aD[DM_CONTAINER] == ""), aD[DM_CONTAINER], cT), ;
                                               If(!(aD[DM_CONTAINER] == ""), aD[DM_CONTAINER], ;
                                                  If(IsCheckedSlot(cT), cT, "")), aD[DM_NAME], aD[N_LINE]}
    Next
    For nJ := 1 To Len(aC[CD_METHODS])
      aCi[CI_SIGS]{u_xcb_lc(aC[CD_METHODS][nJ][MS_NAME])} := aC[CD_METHODS][nJ]
    Next
  Next
  For nI := 1 To Len(aProg[PG_FUNCTIONS])
    aF := aProg[PG_FUNCTIONS][nI]
    cName := CalledAs(aF)
    If cName == ""
      Loop
    EndIf
    If !(aF[FN_RETCONTAINER] == "")
      hReturns{cName} := aF[FN_RETCONTAINER]
    ElseIf aF[FN_RETWORD] != Nil
      hReturns{cName} := WordType(aF[FN_RETWORD])
    EndIf
    hFunctions{cName} := {aF[FN_NAME], aF[FN_PARAMS]}
  Next
  For nI := 1 To Len(aProg[PG_METHODS])
    aM := aProg[PG_METHODS][nI]
    cK := u_xcb_lc(aM[MI_CLASS])
    If hClasses has cK
      hClasses{cK}[CI_IMPLS]{u_xcb_lc(aM[MI_NAME])} := aM
    EndIf
  Next
  // The file's statics -- only its functions give them anything, so what
  // they hold is worked out over all of them.
  aScopes := {{ => }}
  AAdd(aUnits, {{}, "", "", "", .F.})
  For nI := 1 To Len(aProg[PG_STATICS])
    For nJ := 1 To Len(aProg[PG_STATICS][nI][DECL_DECLARATORS])
      nLineT := aProg[PG_STATICS][nI][DECL_DECLARATORS][nJ][N_LINE]
      TDeclarator(aProg[PG_STATICS][nI][DECL_DECLARATORS][nJ], "static")
    Next
  Next
  // Nothing is declared into the file's scope after this: each function
  // starts from it, and declares into its own.
  hFile := aScopes[1]
  For nI := 1 To Len(aProg[PG_FUNCTIONS])
    aScopes := {hFile}
    aF := aProg[PG_FUNCTIONS][nI]
    cRetW := aF[FN_RETCONTAINER]
    cWord := If(aF[FN_RETWORD] != Nil, WordType(aF[FN_RETWORD]), "")
    If cRetW == "" .And. IsCheckedSlot(cWord)
      cRetW := cWord
    EndIf
    cTyp := u_xcb_lc(aF[FN_OFTYPE])
    TFunction(aF[FN_PARAMS], aF[FN_BODY], cRetW, aF[FN_NAME], aF[N_LINE])
    cTyp := ""
  Next
  For nI := 1 To Len(aProg[PG_METHODS])
    aScopes := {hFile}
    aM := aProg[PG_METHODS][nI]
    cCls := u_xcb_lc(aM[MI_CLASS])
    cRetW := aM[MI_RETCONTAINER]
    aSig := Nil
    If (hClasses has cCls) .And. (hClasses{cCls}[CI_SIGS] has u_xcb_lc(aM[MI_NAME]))
      aSig := hClasses{cCls}[CI_SIGS]{u_xcb_lc(aM[MI_NAME])}
    EndIf
    If cRetW == "" .And. aSig != Nil
      cRetW := aSig[MS_RETCONTAINER]
    EndIf
    If cRetW == "" .And. IsCheckedSlot(MethodType(cCls, aM[MI_NAME]))
      cRetW := MethodType(cCls, aM[MI_NAME])
    EndIf
    TFunction(aM[MI_PARAMS], aM[MI_BODY], cRetW, "::" + aM[MI_NAME], aM[N_LINE])
    ATail(aUnits)[U_CLS] := cCls
    ATail(aUnits)[U_CTOR] := If(aSig != Nil, aSig[MS_CONSTRUCTOR], u_xcb_lc(aM[MI_NAME]) == "new")
    cCls := ""
  Next
  Infer()
  // What each 'x.f' and 'x.m()' is of -- for the back end, in every file.
  Lambdas()
  Resolve(aProg)
  // A set's or a bag's 'h{k}': Raku's reads and writes.
  For nI := 1 To Len(aHashes)
    aH := aHashes[nI]
    cCls := aH[2]
    cK := KindOf(TypeOf(aH[1][HIX_BASE]))
    If cK == "S" .Or. cK == "M"
      aH[1][HIX_SETKIND] := Asc(cK)
    EndIf
  Next
  // 'for k in h', 'for k, v in h': its keys, and what each holds.
  For nI := 1 To Len(aWalks)
    cCls := aWalks[nI][2]
    cK := KindOf(TypeOf(aWalks[nI][1][FIN_SOURCE]))
    aWalks[nI][1][FIN_KEYED] := IsKeyed(cK) .Or. cK == "J"
  Next
  cCls := ""
  lTyped := AnyTyped(aProg)
  If !lTyped
    Return {aErrors, aWarnings}
  EndIf
  For nU := 1 To Len(aUnits)
    CheckUnit(aUnits[nU])
  Next
  For nI := 1 To Len(aMakes)
    cCls := aMakes[nI][AT_CLS]
    nLineT := aMakes[nI][AT_LINE]
    Made(aMakes[nI][AT_E])
  Next
  For nI := 1 To Len(aDots)
    cCls := aDots[nI][AT_CLS]
    nLineT := aDots[nI][AT_LINE]
    If IsKT(aDots[nI][AT_E], EK_DOTCALL)
      DotArgs(aDots[nI][AT_E])
    EndIf
  Next
  cCls := ""
  // A fixed Data is given its value by the constructor: one the file
  // implements, that never does, is refused.
  aK := keys(hClasses)
  For nI := 1 To Len(aK)
    aCi := hClasses{aK[nI]}
    aDk := keys(aCi[CI_DATA])
    For nJ := 1 To Len(aDk)
      aCd := aCi[CI_DATA]{aDk[nJ]}
      If !IsFixed(aCd[DA_CONTAINER])
        Loop
      EndIf
      For nU := 1 To Len(aUnits)
        aU := aUnits[nU]
        If !(aU[U_CLS] == aK[nI]) .Or. !aU[U_CTOR]
          Loop
        EndIf
        cCls := aU[U_CLS]
        lGiven := .F.
        For nE := 1 To Len(aU[U_EVENTS])
          aEv := aU[U_EVENTS][nE]
          If aEv[EV_KIND] == EVK_ASSIGN .And. IsKT(aEv[EV_TARGET], EK_MEMBER) ;
             .And. IsSelf(aEv[EV_TARGET][MEM_BASE]) .And. u_xcb_lc(aEv[EV_TARGET][MEM_NAME]) == aDk[nJ]
            lGiven := .T.
          EndIf
        Next
        If !lGiven
          AAdd(aErrors, {aCd[DA_LINE], "'::" + aCd[DA_NAME] + "' is " + ShownT(aCd[DA_CONTAINER]) + ": " ;
                                       + SubStr(aU[U_NAME], 3) + "(), the constructor, gives it its value."})
        EndIf
      Next
    Next
  Next
Return {aErrors, aWarnings}

// ---- types ------------------------------------------------------------------
// A value of a type of the file: 'T:item' -- its name in lower case, as the
// parser writes it in a typed array's type (and hTypeWords has how the file
// declares it).
Static Function IsTypedValue(cT)
Return Len(cT) > 2 .And. Left(cT, 2) == "T:"

// Whether a type's value is one of another type: of the same, or of one
// that is from it.
Static Function TypeIs(cV0, cSlot)
  Local cV := cV0
  Local nDepth := 0
  While nDepth < 64 .And. IsTypedValue(cV)
    If cV == cSlot
      Return .T.
    EndIf
    If hTypeBases == Nil .Or. !(hTypeBases has SubStr(cV, 3))
      Return .F.
    EndIf
    cV := "T:" + hTypeBases{SubStr(cV, 3)}
    nDepth++
  EndDo
Return .F.

// What xc checks goes in: an object of a class, a type's value.
Static Function IsCheckedSlot(cT)
Return IsClassed(cT) .Or. IsTypedValue(cT)

Static Function TypeWordT(cT)
  Local cK := SubStr(cT, 3)
  If hTypeWords != Nil .And. (hTypeWords has cK)
    Return hTypeWords{cK}
  EndIf
Return cK

// The file's types: each field's position and what it holds, each method
// -- and what is wrong with them.
Static Function Types(aProg)
  Local hFns := { => }
  Local nI
  Local nJ
  Local nK
  Local aT
  Local cK
  Local aTi
  Local lCls
  Local aD
  Local aTd
  Local cW
  Local cA
  Local cN
  Local aM
  Local aX
  Local aSts
  Local nBefore
  Local cB
  Local aBi
  Local aWas
  Local lMeth
  Local cOwner
  For nI := 1 To Len(aProg[PG_TYPES])
    aT := aProg[PG_TYPES][nI]
    cK := u_xcb_lc(aT[TD_NAME])
    If hTypes has cK
      If Empty(hTypes{cK}[TI_DEF][TD_HEADER])
        AAdd(aErrors, {aT[N_LINE], "'" + aT[TD_NAME] + "' is declared twice, on line " ;
                                   + AllTrim(Str(hTypes{cK}[TI_DEF][N_LINE])) + " and here."})
      Else
        AAdd(aErrors, {aT[N_LINE], "'" + aT[TD_NAME] + "' is a type of " + hTypes{cK}[TI_DEF][TD_HEADER] ;
                                   + " too: give it another name."})
      EndIf
      Loop
    EndIf
    hTypes{cK} := {aT[TD_NAME], aT, {}, { => }, { => }, 0}
    hTypeWords{cK} := aT[TD_NAME]
  Next
  For nI := 1 To Len(aProg[PG_FUNCTIONS])
    If Empty(aProg[PG_FUNCTIONS][nI][FN_OFTYPE])
      hFns{u_xcb_lc(aProg[PG_FUNCTIONS][nI][FN_NAME])} := .T.
    EndIf
  Next
  For nI := 1 To Len(aProg[PG_TYPES])
    aT := aProg[PG_TYPES][nI]
    aTi := hTypes{u_xcb_lc(aT[TD_NAME])}
    If aTi[TI_DEF][N_ID] != aT[N_ID]
      Loop
    EndIf
    // What is wrong with a header's type was said of the header.
    nBefore := Len(aErrors)
    lCls := .F.
    For nJ := 1 To Len(aProg[PG_CLASSES])
      lCls := lCls .Or. u_xcb_lc(aProg[PG_CLASSES][nJ][CD_NAME]) == u_xcb_lc(aT[TD_NAME])
    Next
    If (hFns has u_xcb_lc(aT[TD_NAME])) .Or. lCls
      AAdd(aErrors, {aT[N_LINE], "'" + aT[TD_NAME] + "' is a type of the file and a " + If(lCls, "class", "function") ;
                                 + " of it: '" + aT[TD_NAME] + "(...)' makes a value of the type."})
    EndIf
    // 'type B from A': A's fields first, at their places, and its methods --
    // A declared before B, so that its own are worked out.
    If !Empty(aT[TD_BASE])
      cB := u_xcb_lc(aT[TD_BASE])
      If cB == u_xcb_lc(aT[TD_NAME])
        AAdd(aErrors, {aT[N_LINE], "'" + aT[TD_NAME] + "' cannot be from itself."})
      ElseIf !(hTypes has cB)
        AAdd(aErrors, {aT[N_LINE], "'" + aT[TD_NAME] + "' is from '" + aT[TD_BASE] + "', which is no type of the file."})
      ElseIf Empty(hTypes{cB}[TI_DEF][TD_HEADER]) .And. hTypes{cB}[TI_DEF][N_FROM] > aT[N_FROM]
        aBi := hTypes{cB}
        AAdd(aErrors, {aT[N_LINE], "'" + aT[TD_NAME] + "' is from " + aBi[TI_NAME] + ", declared further on, on line " ;
                                   + AllTrim(Str(aBi[TI_DEF][N_LINE])) + ": declare " + aBi[TI_NAME] + " first."})
      Else
        aBi := hTypes{cB}
        for aWas in aBi[TI_FIELDS] exec AAdd(aTi[TI_FIELDS], aWas)
        for cOwner in keys(aBi[TI_BYNAME]) exec aTi[TI_BYNAME]{cOwner} := aBi[TI_BYNAME]{cOwner}
        for cOwner in keys(aBi[TI_METHODS]) exec aTi[TI_METHODS]{cOwner} := aBi[TI_METHODS]{cOwner}
        aTi[TI_INHERITED] := Len(aBi[TI_FIELDS])
        hTypeBases{u_xcb_lc(aT[TD_NAME])} := cB
      EndIf
    EndIf
    For nJ := 1 To Len(aT[TD_FIELDS])
      aD := aT[TD_FIELDS][nJ][TF_DECL]
      cW := u_xcb_typeword(If(aD[DCL_TYPESPEC] == Nil, "", aD[DCL_TYPESPEC]))
      aTd := {aD[DCL_NAME], "", "", .F., Len(aTi[TI_FIELDS]) + 1, aD, aT[TD_NAME]}
      aTd[TFD_TYPE] := If(!(aD[DCL_CONTAINER] == ""), aD[DCL_CONTAINER], If(!(cW == ""), WordType(cW), T_UNKNOWN))
      aTd[TFD_SLOT] := If(aTd[TFD_TYPE] == T_UNKNOWN, "", aTd[TFD_TYPE])
      For nK := 1 To Len(aD[DCL_ATTRS])
        cA := aD[DCL_ATTRS][nK]
        If cA == "const"
          aTd[TFD_CONST] := .T.
        Else
          AAdd(aErrors, {aD[N_LINE], "the field '" + aD[DCL_NAME] + "' of " + aT[TD_NAME] + " is <" + cA ;
                                     + ">: a field takes <const>, nothing else."})
        EndIf
      Next
      cN := u_xcb_lc(aD[DCL_NAME])
      If cN == "and" .Or. cN == "or" .Or. cN == "not" .Or. cN == "t" .Or. cN == "f" .Or. cN == "y" .Or. cN == "n"
        AAdd(aErrors, {aD[N_LINE], "a field cannot be called '" + aD[DCL_NAME] + "': '." + aD[DCL_NAME] ;
                                   + ".' is TL++'s own."})
      EndIf
      If aTi[TI_BYNAME] has cN
        aWas := aTi[TI_FIELDS][aTi[TI_BYNAME]{cN}]
        AAdd(aErrors, {aD[N_LINE], If(aWas[TFD_OWNER] == aT[TD_NAME], ;
                                      "'" + aD[DCL_NAME] + "' is a field of " + aT[TD_NAME] + " twice.", ;
                                      "'" + aD[DCL_NAME] + "' is a field of " + aWas[TFD_OWNER] + ", which " ;
                                      + aT[TD_NAME] + " is from: " + aT[TD_NAME] + " has it already.")})
        Loop
      EndIf
      If hFns has u_xcb_lc(aT[TD_NAME] + "_" + aD[DCL_NAME])
        AAdd(aErrors, {aD[N_LINE], "'" + aT[TD_NAME] + "_" + aD[DCL_NAME] + "' is the position of " + aT[TD_NAME] ;
                                   + "'s field '" + aD[DCL_NAME] + "', and a function of the file."})
      EndIf
      // Its default is made where a value is: no variable is there.
      If aD[DCL_INIT] != Nil .And. !aD[DCL_INITMADE]
        aX := u_xcb_walkexpr(aD[DCL_INIT])
        For nK := 1 To Len(aX)
          If IsKT(aX[nK], EK_NAME)
            AAdd(aErrors, {aD[N_LINE], "the field '" + aD[DCL_NAME] + "' of " + aT[TD_NAME] ;
                                       + " starts at a value made where one is: it cannot read '" ;
                                       + aX[nK][NAME_NAME] + "'."})
          EndIf
        Next
      EndIf
      aTi[TI_BYNAME]{cN} := Len(aTi[TI_FIELDS]) + 1
      AAdd(aTi[TI_FIELDS], aTd)
    Next
    For nJ := 1 To Len(aT[TD_METHODS])
      aM := aT[TD_METHODS][nJ]
      For nK := 2 To Len(aM[FN_PARAMS])
        OwnSelf(aM, aM[FN_PARAMS][nK][PRM_NAME], aM[N_LINE])
      Next
      aSts := u_xcb_walk(aM[FN_BODY])
      For nK := 1 To Len(aSts)
        If aSts[nK][N_KIND] == SK_DECLARATION
          AEval(aSts[nK][DECL_DECLARATORS], {|v| OwnSelf(aM, v[DCL_NAME], v[N_LINE])})
        EndIf
      Next
      If hFns has u_xcb_lc(aM[FN_NAME])
        AAdd(aErrors, {aM[N_LINE], "'" + aM[FN_NAME] + "' is the function " + aT[TD_NAME] + "'s method " ;
                                   + aM[FN_METHOD] + "() is, and a function of the file."})
      EndIf
      cN := u_xcb_lc(aM[FN_METHOD])
      If (aTi[TI_METHODS] has cN) .Or. (aTi[TI_BYNAME] has cN)
        lMeth := aTi[TI_METHODS] has cN
        cOwner := If(lMeth, aTi[TI_METHODS]{cN}[FN_OFTYPE], aTi[TI_FIELDS][aTi[TI_BYNAME]{cN}][TFD_OWNER])
        AAdd(aErrors, {aM[N_LINE], "'" + aM[FN_METHOD] + "' is " + If(lMeth, "a method", "a field") + " of " ;
                                   + If(cOwner == aT[TD_NAME], aT[TD_NAME] + " already.", ;
                                        cOwner + ", which " + aT[TD_NAME] + " is from: " + aT[TD_NAME] ;
                                        + " has it already.")})
        Loop
      EndIf
      aTi[TI_METHODS]{cN} := aM
    Next
    If !Empty(aT[TD_HEADER])
      ASize(aErrors, nBefore)
    EndIf
  Next
Return Nil

// Self is TL++'s aSelf, the function's first parameter: a type's method
// declares no other.
Static Function OwnSelf(aM, cName, nLine)
  If u_xcb_lc(cName) == "self" .Or. u_xcb_lc(cName) == "aself"
    AAdd(aErrors, {nLine, "'" + cName + "' is the value " + aM[FN_METHOD] + "() is called on -- 'aSelf' in TL++: " ;
                          + "a type's method declares no other."})
  EndIf
Return Nil

// The type of the file a value of type cT is of (TI_*), or Nil.
Static Function TypeInfoOf(cT)
  If !IsTypedValue(cT) .Or. !(hTypes has SubStr(cT, 3))
    Return Nil
  EndIf
Return hTypes{SubStr(cT, 3)}

Static Function FieldOf(cT, cName)
  Local aTi := TypeInfoOf(cT)
  Local cK := u_xcb_lc(cName)
  If aTi == Nil .Or. !(aTi[TI_BYNAME] has cK)
    Return Nil
  EndIf
Return aTi[TI_FIELDS][aTi[TI_BYNAME]{cK}]

// What a type's method gives: its typed array or hash, its type, or '?'.
Static Function MethodRet(aTi, cName)
  Local aF
  If aTi == Nil .Or. !(aTi[TI_METHODS] has u_xcb_lc(cName))
    Return T_UNKNOWN
  EndIf
  aF := aTi[TI_METHODS]{u_xcb_lc(cName)}
  If !(aF[FN_RETCONTAINER] == "")
    Return aF[FN_RETCONTAINER]
  EndIf
Return If(aF[FN_RETWORD] != Nil, WordType(aF[FN_RETWORD]), T_UNKNOWN)

// 'x.f' as a message names it: 'aIt', 'aOrd.oCli', 'Self'; '' for what has
// no name.
Static Function DotName(aE)
  Local cB
  If IsKT(aE, EK_NAME)
    Return aE[NAME_NAME]
  EndIf
  If IsKT(aE, EK_DOT)
    cB := DotName(aE[DOT_BASE])
    Return If(cB == "", "", cB + "." + aE[DOT_NAME])
  EndIf
Return ""

// A field written to, said so: "'aIt.nQtd' is Numeric".
Static Function FieldWho(aD)
  Local aF := FieldOf(TypeOf(aD[DOT_BASE]), aD[DOT_NAME])
  Local cN := DotName(aD)
Return "'" + If(cN == "", "." + aD[DOT_NAME], cN) + "' is " + ShownT(If(aF != Nil, aF[TFD_TYPE], T_UNKNOWN))

// A lambda a verb walks a type's values with: its parameter is one -- what
// xc knows of the array, worked out.
Static Function Lambdas()
  Local nI
  Local nJ
  Local aV
  Local aP
  For nI := 1 To Len(aVerbs)
    aV := aVerbs[nI]
    cCls := aV[AT_CLS]
    If IsKT(aV[AT_E], EK_PIPELINE)
      aP := aV[AT_E]
      For nJ := 1 To Len(aP[PIPE_STAGES])
        GiveLambda(aP[PIPE_STAGES][nJ], ChainType(aP, nJ - 1), 1)
      Next
    ElseIf Len(aV[AT_E][CALL_ARGS]) > 0
      GiveLambda(aV[AT_E], TypeOf(aV[AT_E][CALL_ARGS][1]), 2)
    EndIf
  Next
  cCls := ""
Return Nil

// A verb's -- or TL++'s ASort()'s, AEval()'s, AScan()'s, whose block is
// given an array's elements -- lambdas and code blocks from its argument
// nFrom: the parameter that takes an element is one.
Static Function GiveLambda(aC, cFed, nFrom)
  Local cN := u_xcb_lc(aC[CALL_NAME])
  Local cEl := ElemOf(cFed)
  Local nK
  Local nI
  Local nJ
  Local aPs
  Local aArg
  If !(("|" + cN + "|") $ cWalkers .Or. (("|" + cN + "|") $ "|asort|aeval|ascan|" .And. nFrom == 2)) ;
     .Or. !IsTypedValue(BareT(cEl))
    Return Nil
  EndIf
  If cN == "asort"
    cN := "sort"
  EndIf
  nK := If(cN == "reduce" .Or. cN == "fold" .Or. cN == "scan", 2, 1)
  For nI := nFrom To Len(aC[CALL_ARGS])
    aArg := aC[CALL_ARGS][nI]
    If aArg == Nil .Or. !(hBlockParams has aArg[N_ID])
      Loop
    EndIf
    aPs := hBlockParams{aArg[N_ID]}
    For nJ := 1 To Len(aPs)
      If (nJ == nK .Or. cN == "sort") .And. aPs[nJ][V_TYPE] == T_UNKNOWN
        aPs[nJ][V_TYPE] := BareT(cEl)
      EndIf
    Next
  Next
Return Nil

// Each 'x.f', 'x.m()': the type x is of, the field's position -- or why xc
// cannot tell.
Static Function Resolve(aProg)
  Local aSaid := {}
  Local nI
  Local nJ
  Local aA
  Local lCall
  Local aBase
  Local cName
  Local cWhat
  Local cT
  Local aTi
  Local cWho
  Local aHave
  Local aX
  Local lHas
  Local lCan
  Local cHint
  For nI := 1 To Len(aDots)
    AAdd(aSaid, {})
  Next
  // The innermost first: what one cannot tell is not said again of the
  // field read from it -- the messages then go in the order found.
  For nI := Len(aDots) To 1 Step -1
    aA := aDots[nI]
    cCls := aA[AT_CLS]
    nLineT := aA[AT_LINE]
    lCall := IsKT(aA[AT_E], EK_DOTCALL)
    aBase := If(lCall, aA[AT_E][DC_BASE], aA[AT_E][DOT_BASE])
    cName := If(lCall, aA[AT_E][DC_NAME], aA[AT_E][DOT_NAME])
    cWhat := "'." + cName + If(lCall, "()'", "'")
    cT := TypeOf(aBase)
    aTi := TypeInfoOf(cT)
    If aTi == Nil
      // Read from a field xc could not work out: said of that one.
      If (IsKT(aBase, EK_DOT) .And. Empty(aBase[DOT_TYPE])) .Or. (IsKT(aBase, EK_DOTCALL) .And. Empty(aBase[DC_TYPE]))
        Loop
      EndIf
      cWho := DotName(aBase)
      cWho := If(cWho == "", "this", "'" + cWho + "'")
      If !(BareT(cT) == T_UNKNOWN) .And. !(cT == T_NONE) .And. !(cT == "")
        AAdd(aSaid[nI], {nLineT, cWho + " is " + ShownT(cT) + ", no type's value: " + cWhat + " is a type's " ;
                                 + If(lCall, "method.", "field.") ;
                                 + If(IsClassed(cT), " Its class's are read with ':'.", "")})
        Loop
      EndIf
      // The types that have it: one, and its name says how to declare it.
      aHave := {}
      For nJ := 1 To Len(aProg[PG_TYPES])
        aX := hTypes{u_xcb_lc(aProg[PG_TYPES][nJ][TD_NAME])}
        lHas := If(lCall, aX[TI_METHODS] has u_xcb_lc(cName), aX[TI_BYNAME] has u_xcb_lc(cName))
        If aX[TI_DEF][N_ID] == aProg[PG_TYPES][nJ][N_ID] .And. lHas
          AAdd(aHave, aProg[PG_TYPES][nJ][TD_NAME])
        EndIf
      Next
      // A name the function declares can say so; a block's parameter
      // cannot.
      lCan := .F.
      If IsKT(aBase, EK_NAME) .And. (hNames has aBase[N_ID])
        lCan := !hNames{aBase[N_ID]}[V_BLOCK]
      EndIf
      cHint := If(Len(aHave) == 1 .And. lCan, " -- '" + SubStr(cWho, 2, Len(cWho) - 2) + " as " + aHave[1] ;
                                              + "' says it is one.", "")
      AAdd(aSaid[nI], {nLineT, cWhat + ": xc cannot tell that " + cWho + " is a type's value" ;
                               + If(cHint == "", ".", cHint)})
      Loop
    EndIf
    If lCall
      If !(aTi[TI_METHODS] has u_xcb_lc(cName))
        AAdd(aSaid[nI], {nLineT, "'" + aTi[TI_NAME] + "' has no method '" + cName + "()'."})
        Loop
      EndIf
      aA[AT_E][DC_TYPE] := aTi[TI_NAME]
      Loop
    EndIf
    If !(aTi[TI_BYNAME] has u_xcb_lc(cName))
      AAdd(aSaid[nI], {nLineT, "'" + aTi[TI_NAME] + "' has no field '" + cName + "'."})
      Loop
    EndIf
    // Its position is a #define of the type's: there only after it.
    If Empty(aTi[TI_DEF][TD_HEADER]) .And. aA[AT_E][N_FROM] >= 0 .And. aA[AT_E][N_FROM] < aTi[TI_DEF][N_FROM]
      AAdd(aSaid[nI], {nLineT, "'" + aTi[TI_NAME] + "' is declared on line " + AllTrim(Str(aTi[TI_DEF][N_LINE])) ;
                               + ": its fields are read after it."})
      Loop
    EndIf
    aA[AT_E][DOT_TYPE] := aTi[TI_NAME]
    aA[AT_E][DOT_POS] := aTi[TI_FIELDS][aTi[TI_BYNAME]{u_xcb_lc(cName)}][TFD_POS]
  Next
  For nI := 1 To Len(aSaid)
    AEval(aSaid[nI], {|f| AAdd(aErrors, f)})
  Next
  // 'with object' takes an object: a type's value has its fields.
  For nI := 1 To Len(aWiths)
    aA := aWiths[nI]
    cCls := aA[AT_CLS]
    nLineT := aA[AT_LINE]
    cT := TypeOf(aA[AT_E])
    If !IsTypedValue(cT)
      Loop
    EndIf
    cWho := DotName(aA[AT_E])
    AAdd(aErrors, {nLineT, "'with object' takes an object, and " + If(cWho == "", "this", "'" + cWho + "'") + " is " ;
                           + ShownT(cT) + ": its fields are '" + If(cWho == "", "x", cWho) + ".x'."})
  Next
  // 'x?.f', 'x?.m()' of a type's value: Nil if x is, else its field, its
  // method -- of an object, what they always were.
  For nI := 1 To Len(aSafes)
    aA := aSafes[nI]
    cCls := aA[AT_CLS]
    nLineT := aA[AT_LINE]
    lCall := IsKT(aA[AT_E], EK_SAFECALL)
    aBase := If(lCall, aA[AT_E][MC_BASE], aA[AT_E][MEM_BASE])
    cName := If(lCall, aA[AT_E][MC_NAME], aA[AT_E][MEM_NAME])
    aTi := TypeInfoOf(TypeOf(aBase))
    If aTi == Nil
      Loop
    EndIf
    If lCall
      If !(aTi[TI_METHODS] has u_xcb_lc(cName))
        AAdd(aErrors, {nLineT, "'" + aTi[TI_NAME] + "' has no method '" + cName + "()'."})
        Loop
      EndIf
      aA[AT_E][MC_TYPE] := aTi[TI_NAME]
      Loop
    EndIf
    If !(aTi[TI_BYNAME] has u_xcb_lc(cName))
      AAdd(aErrors, {nLineT, "'" + aTi[TI_NAME] + "' has no field '" + cName + "'."})
      Loop
    EndIf
    If Empty(aTi[TI_DEF][TD_HEADER]) .And. aA[AT_E][N_FROM] >= 0 .And. aA[AT_E][N_FROM] < aTi[TI_DEF][N_FROM]
      AAdd(aErrors, {nLineT, "'" + aTi[TI_NAME] + "' is declared on line " + AllTrim(Str(aTi[TI_DEF][N_LINE])) ;
                             + ": its fields are read after it."})
      Loop
    EndIf
    aA[AT_E][MEM_TYPE] := aTi[TI_NAME]
    aA[AT_E][MEM_POS] := aTi[TI_FIELDS][aTi[TI_BYNAME]{u_xcb_lc(cName)}][TFD_POS]
  Next
  cCls := ""
Return Nil

// A type's value made: the fields, by their places and by their names.
Static Function Made(aC)
  Local aTi := TypeInfoOf("T:" + u_xcb_lc(aC[CALL_NAME]))
  Local aGiven := {}
  Local lByName := .F.
  Local nAt := 0
  Local nI
  Local aA
  Local cK
  Local nF
  If aTi == Nil
    Return Nil
  EndIf
  For nI := 1 To Len(aTi[TI_FIELDS])
    AAdd(aGiven, .F.)
  Next
  For nI := 1 To Len(aC[CALL_ARGS])
    aA := aC[CALL_ARGS][nI]
    If IsKT(aA, EK_NAMED)
      lByName := .T.
      cK := u_xcb_lc(aA[NMD_NAME])
      If !(aTi[TI_BYNAME] has cK)
        AAdd(aErrors, {nLineT, "'" + aTi[TI_NAME] + "' has no field '" + aA[NMD_NAME] + "'."})
        Loop
      EndIf
      nF := aTi[TI_BYNAME]{cK}
      If aGiven[nF]
        AAdd(aErrors, {nLineT, aTi[TI_NAME] + "(): '" + aA[NMD_NAME] + "' is given twice."})
        Loop
      EndIf
      aGiven[nF] := .T.
      Put(aA[NMD_VALUE], aTi[TI_FIELDS][nF][TFD_SLOT], MadeWho(aTi, aTi[TI_FIELDS][nF]))
      Loop
    EndIf
    If lByName
      AAdd(aErrors, {nLineT, aTi[TI_NAME] + "(): the values by their places come before those by their names."})
      Return Nil
    EndIf
    If nAt >= Len(aTi[TI_FIELDS])
      AAdd(aErrors, {nLineT, aTi[TI_NAME] + "() has " + AllTrim(Str(Len(aTi[TI_FIELDS]))) + " field" ;
                             + If(Len(aTi[TI_FIELDS]) == 1, "", "s") + ": this gives it more."})
      Return Nil
    EndIf
    nAt++
    aGiven[nAt] := .T.
    If !IsKT(aA, EK_OMITTED)
      Put(aA, aTi[TI_FIELDS][nAt][TFD_SLOT], MadeWho(aTi, aTi[TI_FIELDS][nAt]))
    EndIf
  Next
Return Nil

Static Function MadeWho(aTi, aF)
Return "the field '" + aF[TFD_NAME] + "' of " + aTi[TI_NAME] + "() is " + ShownT(aF[TFD_TYPE])

// 'x.m(...)': what its parameters are declared as -- Self aside.
Static Function DotArgs(aD)
  Local aTi := TypeInfoOf(TypeOf(aD[DC_BASE]))
  Local aM
  Local aPs
  Local nI
  Local cSlot
  If aTi == Nil .Or. !(aTi[TI_METHODS] has u_xcb_lc(aD[DC_NAME]))
    Return Nil
  EndIf
  aM := aTi[TI_METHODS]{u_xcb_lc(aD[DC_NAME])}
  aPs := aM[FN_PARAMS]
  For nI := 1 To Min(Len(aPs) - 1, Len(aD[DC_ARGS]))
    cSlot := SlotOf(aPs[nI + 1])
    If cSlot == ""
      Loop
    EndIf
    GoesInto(aD[DC_ARGS][nI], cSlot, "the parameter '" + aPs[nI + 1][PRM_NAME] + "' of " + aTi[TI_NAME] + "." ;
                                     + aM[FN_METHOD] + "() is " + ShownT(cSlot), .F.)
  Next
Return Nil

// A value that goes into a field: GoesInto() for what xc checks of arrays,
// hashes, objects and types; for TL++'s types, what is known to be another
// -- a Decimal aside (decimal.xtpl).
Static Function Put(aE, cSlot, cWho)
  Local cT
  If aE == Nil .Or. cSlot == ""
    Return Nil
  EndIf
  If IsBox(KindOf(cSlot)) .Or. IsCheckedSlot(cSlot) .Or. IsFixed(cSlot)
    GoesInto(aE, cSlot, cWho, .F.)
    Return Nil
  EndIf
  cT := TypeOf(aE)
  If BareT(cT) == "F" .Or. cSlot == "F" .Or. IsKT(aE, EK_REF) .Or. IsKT(aE, EK_OMITTED)
    Return Nil
  EndIf
  If Fits(cT, cSlot) == FIT_WRONG
    AAdd(aErrors, {nLineT, cWho + ": this is " + ShownT(cT) + "."})
  EndIf
Return Nil

// ---- the types' strings -----------------------------------------------------
Static Function IsFixed(cT)
Return Left(cT, 1) == "!"

Static Function BareT(cT)
Return If(IsFixed(cT), SubStr(cT, 2), cT)

// Its kind: its letter, '' for Nil.
Static Function KindOf(cT)
Return If(IsFixed(cT), SubStr(cT, 2, 1), Left(cT, 1))

Static Function IsGeneric(cT)
  Local nAt := If(IsFixed(cT), 1, 0)
Return Len(cT) > nAt + 2 .And. SubStr(cT, nAt + 2, 1) == "<"

// An array, a hash, a set or a bag: what holds others.
Static Function IsBox(cK)
Return cK == "A" .Or. cK == "H" .Or. cK == "S" .Or. cK == "M"

// A hash, a set or a bag: what is read by its keys.
Static Function IsKeyed(cK)
Return cK == "H" .Or. cK == "S" .Or. cK == "M"

// An object of a class of the file: 'O:Depot:Stock'.
Static Function IsClassed(cT)
Return Len(cT) > 2 .And. Left(cT, 2) == "O:"

// Its class, and those it inherits from: 'Depot', 'Stock'.
Static Function Lineage(cT)
  Local aOut := {}
  Local nFrom := 3
  Local nI
  If !IsClassed(cT)
    Return aOut
  EndIf
  For nI := 3 To Len(cT) + 1
    If nI > Len(cT) .Or. SubStr(cT, nI, 1) == ":"
      AAdd(aOut, SubStr(cT, nFrom, nI - nFrom))
      nFrom := nI + 1
    EndIf
  Next
Return aOut

// Whether an object of type t is one of that class -- or of one that
// inherits from it.
Static Function IsA(cT, cClass)
  Local aL := Lineage(cT)
  Local cC := u_xcb_lc(cClass)
  Local nI
  For nI := 1 To Len(aL)
    If u_xcb_lc(aL[nI]) == cC
      Return .T.
    EndIf
  Next
Return .F.

// Fixed, if it holds others, or is what xc cannot tell: what is read from
// a fixed one.
Static Function FixT(cT)
Return If(IsFixed(cT) .Or. !(IsBox(KindOf(cT)) .Or. cT == T_UNKNOWN), cT, "!" + cT)

// Nothing fixed in it: what AClone() gives.
Static Function UnfixT(cT)
Return StrTran(cT, "!", "")

// The types between the '<' and the '>' of 'A<T>' or 'H<K,V>'.
Static Function ArgsOf(cT0)
  Local aOut := {}
  Local cT
  Local nDepth := 0
  Local nFrom := 2
  Local nI
  Local cC
  If !IsGeneric(cT0)
    Return aOut
  EndIf
  cT := BareT(cT0)
  // Offsets from 0, as typed.cpp's.
  For nI := 2 To Len(cT) - 2
    cC := SubStr(cT, nI + 1, 1)
    If cC == "<"
      nDepth++
    ElseIf cC == ">"
      nDepth--
    ElseIf cC == "," .And. nDepth == 0
      AAdd(aOut, SubStr(cT, nFrom + 1, nI - nFrom))
      nFrom := nI + 1
    EndIf
  Next
  AAdd(aOut, SubStr(cT, nFrom + 1, Len(cT) - 1 - nFrom))
Return aOut

// What an element of an array of type t is; a key, a value of a hash --
// fixed, read from a fixed one. nN from 0.
Static Function PartOf(cT, cK, nN)
  Local cR
  If cT == T_NONE
    Return T_NONE
  EndIf
  If !(KindOf(cT) == cK)
    Return T_UNKNOWN
  EndIf
  cR := If(IsGeneric(cT), ArgsOf(cT)[nN + 1], T_UNKNOWN)
Return If(IsFixed(cT), FixT(cR), cR)

Static Function ElemOf(cT)
Return PartOf(cT, "A", 0)

// A set's or a bag's keys are its one type; what one reads at a key, a
// Logical and a Numeric.
Static Function KeyOf(cT)
  Local cK := KindOf(cT)
Return If(cK == "S" .Or. cK == "M", PartOf(cT, cK, 0), PartOf(cT, "H", 0))

Static Function ValueOf(cT)
  If cT == T_NONE
    Return T_NONE
  EndIf
  If KindOf(cT) == "S"
    Return "L"
  EndIf
  If KindOf(cT) == "M"
    Return "N"
  EndIf
Return PartOf(cT, "H", 1)

Static Function ArrayOf(cT)
  If cT == T_NONE
    Return T_NONE
  EndIf
Return If(cT == "" .Or. BareT(cT) == T_UNKNOWN, "A", "A<" + cT + ">")

// A type TL++ declares, as its letter: 'Numeric' is 'N'.
Static Function LetterOf(cDeclared)
  Local cD := u_xcb_lc(cDeclared)
  Do Case
    Case cD == "numeric" .Or. cD == "integer" .Or. cD == "double"
      Return "N"
    Case cD == "character"
      Return "C"
    Case cD == "logical"
      Return "L"
    Case cD == "date"
      Return "D"
    Case cD == "array"
      Return "A"
    Case cD == "object"
      Return "O"
    Case cD == "codeblock"
      Return "B"
    Case cD == "json"
      Return "J"
    Case cD == "decimal"
      Return "F"
  EndCase
Return T_UNKNOWN

// What a name holds, given two of its values -- fixed, if one is.
Static Function JoinT(cA, cB)
  Local cX
  Local cY
  Local cR
  Local aLx
  Local nI
  Local nJ
  If cA == T_NONE .Or. cA == ""
    Return cB
  EndIf
  If cB == T_NONE .Or. cB == ""
    Return cA
  EndIf
  If cA == cB
    Return cA
  EndIf
  cX := BareT(cA)
  cY := BareT(cB)
  cR := T_UNKNOWN
  If cX == cY
    cR := cX
  ElseIf !(cX == T_UNKNOWN) .And. !(cY == T_UNKNOWN) .And. Left(cX, 1) == Left(cY, 1) .And. IsBox(Left(cX, 1))
    cR := Left(cX, 1)
  ElseIf Left(cX, 1) == "O" .And. Left(cY, 1) == "O"
    // Two objects: of the nearest class both are of, or just objects.
    cR := "O"
    aLx := Lineage(cX)
    nI := 1
    While nI <= Len(aLx) .And. cR == "O"
      If IsA(cY, aLx[nI])
        cR := "O"
        For nJ := nI To Len(aLx)
          cR += ":" + aLx[nJ]
        Next
      EndIf
      nI++
    EndDo
  EndIf
Return If(IsFixed(cA) .Or. IsFixed(cB), FixT(cR), cR)

Static Function IsLogical(cOp)
Return "|" + cOp + "|" $ cLogical

// What a set built from t has for keys: an array's elements, a hash's, a
// set's or a bag's keys, a value itself.
Static Function MemberOf(cT)
  Local cK
  Local cM
  If cT == T_NONE .Or. cT == ""
    Return cT
  EndIf
  cK := KindOf(cT)
  cM := If(cK == "A", ElemOf(cT), If(IsKeyed(cK), KeyOf(cT), BareT(cT)))
Return BareT(cM)

// A set or a bag of what each of two holds -- 'S<K>' or 'M<K>'; '-' for
// cB: of the one.
Static Function KeysOf(cK, cA, cB)
  Local cX := MemberOf(cA)
  Local cY := If(cB == "-", cX, MemberOf(cB))
  Local cM
  If cX == T_NONE .Or. cY == T_NONE
    Return T_NONE
  EndIf
  cM := If(cX == "", cY, If(cY == "" .Or. cX == cY, cX, T_UNKNOWN))
Return If(cM == "" .Or. cM == T_UNKNOWN, cK, cK + "<" + cM + ">")

// What a set operation gives: a bag where a bag goes in, else a set; a bag
// always from '(+)' and '(.)'.
Static Function SetOp(cOp, cA, cB)
  Local lBag
  If IsLogical(cOp)
    Return "L"
  EndIf
  lBag := cOp == "(+)" .Or. cOp == "(.)" .Or. KindOf(cA) == "M" .Or. KindOf(cB) == "M"
Return KeysOf(If(lBag, "M", "S"), cA, cB)

// An operator's result, given its operands'.
Static Function BinOp(cOp, cL0, cR0)
  Local cL
  Local cR
  If IsLogical(cOp)
    Return "L"
  EndIf
  If cOp == "?:"
    If cL0 == T_NONE .Or. cR0 == T_NONE
      Return T_NONE
    EndIf
    Return If(cL0 == cR0 .Or. cR0 == "", cL0, If(cL0 == "", cR0, If(JoinT(cL0, cR0) == cL0, cL0, T_UNKNOWN)))
  EndIf
  cL := BareT(cL0)
  cR := BareT(cR0)
  If cOp == "neg"
    Return If(cR == T_NONE, T_NONE, If(cR == "N" .Or. cR == "F", cR, T_UNKNOWN))
  EndIf
  If cL == T_NONE .Or. cR == T_NONE
    Return T_NONE
  EndIf
  If (cL == "N" .Or. cL == "F") .And. (cR == "N" .Or. cR == "F")
    Return If(cL == "F" .Or. cR == "F", "F", "N")
  EndIf
  If cOp == "+" .Or. cOp == "-"
    // A string and something xc cannot tell: a string, or an error.
    If (cL == "C" .And. (cR == "C" .Or. cR == T_UNKNOWN)) .Or. (cR == "C" .And. cL == T_UNKNOWN)
      Return "C"
    EndIf
  EndIf
  If cOp == "+"
    If cL == "C" .And. cR == "C"
      Return "C"
    EndIf
    If (cL == "D" .And. cR == "N") .Or. (cL == "N" .And. cR == "D")
      Return "D"
    EndIf
  EndIf
  If cOp == "-"
    If cL == "C" .And. cR == "C"
      Return "C"
    EndIf
    If cL == "D" .And. cR == "N"
      Return "D"
    EndIf
    If cL == "D" .And. cR == "D"
      Return "N"
    EndIf
  EndIf
Return T_UNKNOWN

Static Function Chop(cS)
Return If(cS == "", cS, Left(cS, Len(cS) - 1))

// TL++'s functions, and what each gives.
Static Function Builtins()
  Local hB := { => }
  Local aEach := { ;
    {"N", "len val at rat asc mod sqrt exp log year month day dow seconds ascan recno reccount lastrec " ;
          + "fcount randomize"}, ;
    {"C", "str strzero alltrim trim rtrim ltrim upper lower substr left right padl padr padc replicate " ;
          + "space chr strtran stuff transform dtos dtoc time cvaltochar valtype capital cmonth cdow " ;
          + "elaptime procname alias encodeutf8 decodeutf8 memoline"}, ;
    {"L", "empty file isdigit isalpha isupper islower eof bof found deleted dbseek"}, ;
    {"D", "date ctod stod msdate lastday firstday daysum daysub monthsum monthsub yearsum yearsub"}, ;
    {"A", "array directory"}, ;
    {"A<C>", "strtokarr strtokarr2 separa"}}
  Local nI
  Local nJ
  Local aW
  For nI := 1 To Len(aEach)
    aW := u_xcb_words(aEach[nI][2])
    For nJ := 1 To Len(aW)
      hB{aW[nJ]} := aEach[nI][1]
    Next
  Next
Return hB

// How a function of the file is called: a user function with its 'u_'.
Static Function CalledAs(aF)
  Local cT := u_xcb_lc(aF[FN_TYPE])
  If cT == "user"
    Return "u_" + u_xcb_lc(aF[FN_NAME])
  EndIf
  If cT == "" .Or. cT == "static"
    Return u_xcb_lc(aF[FN_NAME])
  EndIf
Return ""

// ---- names ------------------------------------------------------------------
Static Function DeclareVar(cName, lPinned, cType, cContainer)
  Local aV := {cName, lPinned, If(lPinned, cType, T_NONE), If(cContainer == Nil, "", cContainer), nLineT, .F.}
  Local hScope := ATail(aScopes)
  AAdd(aVars, aV)
  hScope{u_xcb_lc(cName)} := aV
Return aV

Static Function FindVar(cName)
  Local cK := u_xcb_lc(cName)
  Local nI
  For nI := Len(aScopes) To 1 Step -1
    If aScopes[nI] has cK
      Return aScopes[nI]{cK}
    EndIf
  Next
Return Nil

Static Function PushScope()
  AAdd(aScopes, { => })
Return Nil

Static Function PopScope()
  ASize(aScopes, Len(aScopes) - 1)
Return Nil

Static Function AddEvent(aEv)
  ASize(aEv, EV_SIZE)
  aEv[EV_LINE] := nLineT
  AAdd(ATail(aUnits)[U_EVENTS], aEv)
Return Nil

// A declarator's name: declared as a typed array or hash -- by its type, or
// by its value, '{ <n> }' --, with a type, or worked out from what it is
// given (a Local's, a Static's).
Static Function TDeclarator(aD, cScope)
  Local cContainer
  Local aInit := aD[DCL_INIT]
  Local aV
  Local nI
  Local cT
  Local aEv
  TExpr(aInit)
  For nI := 1 To Len(aD[DCL_DIMS])
    TExpr(aD[DCL_DIMS][nI])
  Next
  cContainer := aD[DCL_CONTAINER]
  If cContainer == "" .And. aInit != Nil .And. (cScope == "local" .Or. cScope == "static")
    If aInit[N_KIND] == EK_ARRAYLIT .And. !(aInit[ARR_ELEM] == "")
      cContainer := TypeOf(aInit)
    ElseIf aInit[N_KIND] == EK_HASHLIT .And. !(aInit[HASH_KEYTYPE] == "")
      cContainer := TypeOf(aInit)
    EndIf
  EndIf
  If !(cContainer == "")
    aV := DeclareVar(aD[DCL_NAME], .T., cContainer, cContainer)
  ElseIf !(cScope == "local") .And. !(cScope == "static")
    aV := DeclareVar(aD[DCL_NAME], .T., T_UNKNOWN, "")
  ElseIf !(aD[DCL_DECLARED] == "?")
    // 'as Order': an Order goes in, as into a typed array.
    cT := DeclType(aD)
    aV := DeclareVar(aD[DCL_NAME], .T., cT, If(IsCheckedSlot(cT), cT, ""))
  Else
    aV := DeclareVar(aD[DCL_NAME], .F., T_NONE, "")
  EndIf
  aEv := {EVK_DECL, aV, Nil, aInit, Nil, "", ""}
  AddEvent(aEv)
  aEv[EV_DECL] := aD
Return Nil

// ---- classes ----------------------------------------------------------------
// A Data of a class of the file, or of one it inherits from there (DA_*):
// Nil for none.
Static Function DataOf(cClass, cName, nDepth)
  Local aC
  Local cN := u_xcb_lc(cName)
  Local nI
  Local xD
  If !(hClasses has cClass) .Or. nDepth > 20
    Return Nil
  EndIf
  aC := hClasses{cClass}
  If aC[CI_DATA] has cN
    Return aC[CI_DATA]{cN}
  EndIf
  For nI := 1 To Len(aC[CI_SUPERS])
    xD := DataOf(aC[CI_SUPERS][nI], cName, nDepth + 1)
    If xD != Nil
      Return xD
    EndIf
  Next
Return Nil

// The class of the file -- cls or one it inherits from -- that has a method
// by that name.
Static Function ClassOfMethod(cClass, cName, nDepth)
  Local aC
  Local cN := u_xcb_lc(cName)
  Local nI
  Local aX
  If !(hClasses has cClass) .Or. nDepth > 20
    Return Nil
  EndIf
  aC := hClasses{cClass}
  If (aC[CI_SIGS] has cN) .Or. (aC[CI_IMPLS] has cN)
    Return aC
  EndIf
  For nI := 1 To Len(aC[CI_SUPERS])
    aX := ClassOfMethod(aC[CI_SUPERS][nI], cName, nDepth + 1)
    If aX != Nil
      Return aX
    EndIf
  Next
Return Nil

// '::' -- or Self, by name -- in a method.
Static Function IsSelf(aE)
Return !(cCls == "") .And. aE != Nil ;
       .And. (aE[N_KIND] == EK_SELFREF .Or. (aE[N_KIND] == EK_NAME .And. u_xcb_lc(aE[NAME_NAME]) == "self"))

// An object of a class of the file: 'O:Depot:Stock' -- the class, then
// those it inherits from there, by the names they are declared with.
Static Function ClassType(cClass)
  Local cOut := "O"
  Local hSeen := { => }
  Local nSeen := 0
  Local aTodo := {cClass}
  Local cK
  Local aC
  Local nI
  While Len(aTodo) > 0 .And. nSeen < 20
    cK := aTodo[1]
    ADel(aTodo, 1)
    ASize(aTodo, Len(aTodo) - 1)
    If !(hClasses has cK)
      Loop
    EndIf
    If hSeen has cK
      Loop
    EndIf
    hSeen{cK} := .T.
    nSeen++
    aC := hClasses{cK}
    cOut += ":" + aC[CI_NAME]
    For nI := 1 To Len(aC[CI_SUPERS])
      AAdd(aTodo, aC[CI_SUPERS][nI])
    Next
  EndDo
Return cOut

// A type as declared: TL++'s word, or a class of the file's name.
Static Function WordType(cWord)
  Local cT := LetterOf(cWord)
  If cT == T_UNKNOWN .And. (hClasses has u_xcb_lc(cWord))
    Return ClassType(u_xcb_lc(cWord))
  EndIf
  If cT == T_UNKNOWN .And. (hTypes has u_xcb_lc(cWord))
    Return "T:" + u_xcb_lc(cWord)
  EndIf
Return cT

// What a declarator is declared as, if it is: 'Local nX as Numeric' is
// 'N', 'Local oX as Order' an Order, 'Local aX[10]' an array.
Static Function DeclType(aD)
  Local cW := u_xcb_typeword(If(aD[DCL_TYPESPEC] == Nil, "", aD[DCL_TYPESPEC]))
  If !(cW == "")
    Return WordType(cW)
  EndIf
Return If(aD[DCL_DECLARED] == "Array", "A", T_UNKNOWN)

// The class of the file an object is of, in lower case: '::' in a method,
// or a value known to be one -- or ''.
Static Function ObjClass(aE)
  Local cT
  If IsSelf(aE)
    Return cCls
  EndIf
  cT := TypeOf(aE)
Return If(IsClassed(cT), u_xcb_lc(Lineage(cT)[1]), "")

// What 'o:m()' gives: its return type, as declared.
Static Function MethodType(cClass, cName)
  Local aC := ClassOfMethod(cClass, cName, 0)
  Local cN := u_xcb_lc(cName)
  Local aI
  Local aG
  If aC == Nil
    Return T_UNKNOWN
  EndIf
  aI := aC[CI_IMPLS]{cN}
  aG := aC[CI_SIGS]{cN}
  If aI != Nil .And. !(aI[MI_RETCONTAINER] == "")
    Return aI[MI_RETCONTAINER]
  EndIf
  If aG != Nil .And. !(aG[MS_RETCONTAINER] == "")
    Return aG[MS_RETCONTAINER]
  EndIf
  If aI != Nil .And. aI[MI_RETURNS] != Nil
    Return WordType(aI[MI_RETURNS])
  EndIf
  If aG != Nil .And. aG[MS_RETURNS] != Nil
    Return WordType(aG[MS_RETURNS])
  EndIf
Return T_UNKNOWN

// ---- the walk ---------------------------------------------------------------
Static Function TFunction(aParams, aBody, cRetIn, cName, nAt)
  Local nI
  Local aQ
  Local cT
  nLineT := nAt
  AAdd(aUnits, {{}, "", cRetIn, cName, .F.})
  PushScope()
  For nI := 1 To Len(aParams)
    aQ := aParams[nI]
    If aQ == Nil
      Loop
    EndIf
    cT := If(!(aQ[PRM_CONTAINER] == ""), aQ[PRM_CONTAINER], ;
             If(aQ[PRM_TYPEWORD] != Nil, WordType(aQ[PRM_TYPEWORD]), T_UNKNOWN))
    DeclareVar(aQ[PRM_NAME], .T., cT, SlotOf(aQ))
  Next
  TBody(aBody)
  PopScope()
Return Nil

Static Function TBody(aBody)
  Local nI
  PushScope()
  For nI := 1 To Len(aBody)
    TStmt(aBody[nI])
  Next
  PopScope()
Return Nil

Static Function TStmt(aSt)
  Local nK
  Local nI
  Local aV
  Local aEv
  Local aEs
  If aSt == Nil
    Return Nil
  EndIf
  If aSt[N_LINE] > 0
    nLineT := aSt[N_LINE]
  EndIf
  nK := aSt[N_KIND]
  Do Case
    Case nK == SK_DECLARATION
      For nI := 1 To Len(aSt[DECL_DECLARATORS])
        TDeclarator(aSt[DECL_DECLARATORS][nI], u_xcb_lc(aSt[DECL_SCOPE]))
      Next
    Case nK == SK_ASSIGNMENT
      TExpr(aSt[ASG_TARGET])
      TExpr(aSt[ASG_VALUE])
      AddEvent({EVK_ASSIGN, Nil, Nil, aSt[ASG_VALUE], aSt[ASG_TARGET], aSt[ASG_OP], ""})
    Case nK == SK_CALLSTMT
      TExpr(aSt[CS_CALL])
    Case nK == SK_RETURNSTMT
      TExpr(aSt[RET_VALUE])
      AddEvent({EVK_RETURN, Nil, Nil, aSt[RET_VALUE], Nil, "", ""})
    Case nK == SK_IFSTMT
      PushScope()
      If aSt[IF_HEADER] != Nil
        TDeclarator(aSt[IF_HEADER], "local")
      EndIf
      For nI := 1 To Len(aSt[IF_BRANCHES])
        nLineT := aSt[N_LINE]
        TExpr(aSt[IF_BRANCHES][nI][BR_COND])
        TBody(aSt[IF_BRANCHES][nI][BR_BODY])
      Next
      TBody(aSt[IF_OTHERWISE])
      PopScope()
    Case nK == SK_CASESTMT
      PushScope()
      If aSt[CASE_SUBJDECL] != Nil
        TDeclarator(aSt[CASE_SUBJDECL], "local")
      EndIf
      If aSt[CASE_SUBJASSIGN] != Nil
        TStmt(aSt[CASE_SUBJASSIGN])
      EndIf
      For nI := 1 To Len(aSt[CASE_BRANCHES])
        TExpr(aSt[CASE_BRANCHES][nI][BR_COND])
        TBody(aSt[CASE_BRANCHES][nI][BR_BODY])
      Next
      TBody(aSt[CASE_OTHERWISE])
      PopScope()
    Case nK == SK_WHILESTMT
      PushScope()
      If aSt[WH_HEADER] != Nil
        TDeclarator(aSt[WH_HEADER], "local")
      EndIf
      TExpr(aSt[WH_COND])
      TBody(aSt[WH_BODY])
      PopScope()
    Case nK == SK_FORSTMT
      TExpr(aSt[FOR_FROM])
      TExpr(aSt[FOR_TO])
      TExpr(aSt[FOR_STEP])
      PushScope()
      aV := If(aSt[FOR_VARLOCAL], DeclareVar(aSt[FOR_VAR], .F., T_NONE, ""), FindVar(aSt[FOR_VAR]))
      If aV != Nil
        AddEvent({EVK_COUNTER, aV, Nil, Nil, Nil, "", ""})
      EndIf
      TBody(aSt[FOR_BODY])
      PopScope()
    Case nK == SK_FORINSTMT
      AAdd(aWalks, {aSt, cCls})
      TExpr(aSt[FIN_SOURCE])
      PushScope()
      aEv := {EVK_FORIN, Nil, Nil, aSt[FIN_SOURCE], Nil, "", ""}
      aEv[EV_VAR] := DeclareVar(aSt[FIN_ELEM], .F., T_NONE, "")
      If aSt[FIN_INDEX] != Nil
        aEv[EV_INDEX] := DeclareVar(aSt[FIN_INDEX], .F., T_NONE, "")
      EndIf
      AddEvent(aEv)
      TBody(aSt[FIN_BODY])
      PopScope()
    Case nK == SK_FORTIMESSTMT
      TExpr(aSt[FT_COUNT])
      TBody(aSt[FT_BODY])
    Case nK == SK_MODIFIED
      TExpr(aSt[MOD_COND])
      TStmt(aSt[MOD_STMT])
    Case nK == SK_DEFERRED
      TStmt(aSt[DEF_STMT])
    Case nK == SK_USINGALIAS
      TExpr(aSt[UA_ORDER])
      TBody(aSt[UA_BODY])
    Case nK == SK_WITHOBJECT
      AAdd(aWiths, {aSt[WO_SUBJECT], cCls, cTyp, nLineT})
      TExpr(aSt[WO_SUBJECT])
      TBody(aSt[WO_BODY])
    Case nK == SK_RAWSTMT
      // TL++ as written: a name in it may be given anything.
      For nI := 1 To Len(aSt[RAW_LINES])
        RawNames(aSt[RAW_LINES][nI])
      Next
    Case nK == SK_TRYSTMT
      TBody(aSt[TRY_BODY])
      If aSt[TRY_ERRVAR] != Nil
        Unknown(FindVar(aSt[TRY_ERRVAR]))
      EndIf
      TBody(aSt[TRY_HANDLER])
      TBody(aSt[TRY_FINALLY])
    Case nK == SK_TRANSACTIONSTMT
      TBody(aSt[TX_BODY])
    Case nK == SK_SEQUENCESTMT
      TBody(aSt[SEQ_BODY])
      If aSt[SEQ_ERRVAR] != Nil
        Unknown(FindVar(aSt[SEQ_ERRVAR]))
      EndIf
      TBody(aSt[SEQ_RECOVER])
    Case nK == SK_DEFAULTSTMT
      For nI := 1 To Len(aSt[DFL_PAIRS])
        TStmt(aSt[DFL_PAIRS][nI])
      Next
    Otherwise
      aEs := u_xcb_exprsof(aSt)
      For nI := 1 To Len(aEs)
        TExpr(aEs[nI])
      Next
  EndCase
Return Nil

// A name xc cannot tell what it is given.
Static Function Unknown(aV)
  If aV != Nil
    AddEvent({EVK_UNKNOWN, aV, Nil, Nil, Nil, "", ""})
  EndIf
Return Nil

// The names of a line of TL++ that are the function's.
Static Function RawNames(cLine)
  Local cW := ""
  Local nI
  Local nC
  For nI := 1 To Len(cLine) + 1
    nC := If(nI <= Len(cLine), Asc(SubStr(cLine, nI, 1)), 32)
    If u_xcb_isw(nC)
      cW += Chr(nC)
      Loop
    EndIf
    If !(cW == "")
      Unknown(FindVar(cW))
    EndIf
    cW := ""
  Next
Return Nil

Static Function TExpr(aE)
  Local nK
  Local nI
  Local nJ
  Local aPs
  Local aSub
  Local aV
  Local aSt
  Local aEv
  Local cN
  Local lMake
  If aE == Nil
    Return Nil
  EndIf
  nK := aE[N_KIND]
  Do Case
    Case nK == EK_NAME
      aV := FindVar(aE[NAME_NAME])
      If aV != Nil
        hNames{aE[N_ID]} := aV
      EndIf
    Case nK == EK_LAMBDA .Or. nK == EK_CODEBLOCK
      PushScope()
      aPs := {}
      For nI := 1 To Len(aE[CB_PARAMS])
        aV := DeclareVar(aE[CB_PARAMS][nI], .T., T_UNKNOWN, "")
        aV[V_BLOCK] := .T.
        AAdd(aPs, aV)
      Next
      hBlockParams{aE[N_ID]} := aPs
      For nI := 1 To Len(aE[CB_BODY])
        TExpr(aE[CB_BODY][nI])
      Next
      PopScope()
    Case nK == EK_ASSIGNEXPR
      TExpr(aE[AE_TARGET])
      TExpr(aE[AE_VALUE])
      AddEvent({EVK_ASSIGN, Nil, Nil, aE[AE_VALUE], aE[AE_TARGET], aE[AE_OP], aE[AE_INCDEC]})
    Case nK == EK_REF
      TExpr(aE[REF_TARGET])
      If aE[REF_TARGET] != Nil .And. aE[REF_TARGET][N_KIND] == EK_NAME
        aV := FindVar(aE[REF_TARGET][NAME_NAME])
        If aV != Nil
          AddEvent({EVK_REF, aV, Nil, Nil, Nil, "", ""})
        EndIf
      EndIf
    Case nK == EK_CALL
      cN := u_xcb_lc(aE[CALL_NAME])
      lMake := (hTypes has cN) .And. !(hFunctions has cN)
      If lMake
        AAdd(aMakes, {aE, cCls, cTyp, nLineT})
      EndIf
      For nI := 1 To Len(aE[CALL_ARGS])
        If IsKT(aE[CALL_ARGS][nI], EK_LAMBDA) .Or. IsKT(aE[CALL_ARGS][nI], EK_CODEBLOCK)
          AAdd(aVerbs, {aE, cCls, cTyp, nLineT})
          Exit
        EndIf
      Next
      For nI := 1 To Len(aE[CALL_ARGS])
        If !lMake .And. IsKT(aE[CALL_ARGS][nI], EK_NAMED)
          AAdd(aErrors, {nLineT, "'" + aE[CALL_ARGS][nI][NMD_NAME] + " =>': a field by its name, and " ;
                                 + aE[CALL_NAME] + "() makes no type's value."})
        EndIf
        TExpr(aE[CALL_ARGS][nI])
      Next
      aEv := {EVK_CALLE, Nil, Nil, Nil, Nil, "", ""}
      AddEvent(aEv)
      aEv[EV_CALL] := aE
    Case nK == EK_DOT .Or. nK == EK_DOTCALL
      AAdd(aDots, {aE, cCls, cTyp, nLineT})
      aSub := u_xcb_subexprs(aE)
      For nI := 1 To Len(aSub)
        TExpr(aSub[nI])
      Next
    Case nK == EK_MEMBER .Or. nK == EK_SAFEMEMBER
      If nK == EK_SAFEMEMBER
        AAdd(aSafes, {aE, cCls, cTyp, nLineT})
      EndIf
      If !Empty(cTyp) .And. IsKT(aE[MEM_BASE], EK_SELFREF)
        AAdd(aErrors, {nLineT, "'::" + aE[MEM_NAME] + "' is a class's: in a type's method, a field is '." ;
                               + aE[MEM_NAME] + "'."})
      EndIf
      aSub := u_xcb_subexprs(aE)
      For nI := 1 To Len(aSub)
        TExpr(aSub[nI])
      Next
    Case nK == EK_METHODCALL .Or. nK == EK_SAFECALL
      If nK == EK_SAFECALL
        AAdd(aSafes, {aE, cCls, cTyp, nLineT})
      EndIf
      If !Empty(cTyp) .And. IsKT(aE[MC_BASE], EK_SELFREF)
        AAdd(aErrors, {nLineT, "'::" + aE[MC_NAME] + "()' is a class's: in a type's method, a method is '." ;
                               + aE[MC_NAME] + "()'."})
      EndIf
      TExpr(aE[MC_BASE])
      For nI := 1 To Len(aE[MC_ARGS])
        TExpr(aE[MC_ARGS][nI])
      Next
      aEv := {EVK_METHODE, Nil, Nil, Nil, Nil, "", ""}
      AddEvent(aEv)
      aEv[EV_METHOD] := aE
    Case nK == EK_HASHINDEX
      AAdd(aHashes, {aE, cCls})
      aSub := u_xcb_subexprs(aE)
      For nI := 1 To Len(aSub)
        TExpr(aSub[nI])
      Next
    Case nK == EK_PIPELINE
      AAdd(aVerbs, {aE, cCls, cTyp, nLineT})
      TExpr(aE[PIPE_SOURCE])
      For nI := 1 To Len(aE[PIPE_STAGES])
        aSt := aE[PIPE_STAGES][nI]
        For nJ := 1 To Len(aSt[CALL_ARGS])
          TExpr(aSt[CALL_ARGS][nJ])
        Next
        aEv := {EVK_CALLE, Nil, Nil, Nil, Nil, "", ""}
        AddEvent(aEv)
        aEv[EV_CALL] := aSt
        aEv[EV_CHAIN] := aE
        aEv[EV_STAGE] := nI - 1
      Next
    Otherwise
      aSub := u_xcb_subexprs(aE)
      For nI := 1 To Len(aSub)
        TExpr(aSub[nI])
      Next
  EndCase
Return Nil

// ---- what each name holds ---------------------------------------------------
// Every value a Local or a Static is given, over and over until nothing
// changes: what it holds, when they agree.
Static Function Infer()
  Local nRound := 0
  Local nU
  Local nE
  Local aEv
  Local aT
  Local aV
  Local cT
  Local cK
  Local cOp
  lChanged := .T.
  While lChanged .And. nRound < 20
    lChanged := .F.
    For nU := 1 To Len(aUnits)
      cCls := aUnits[nU][U_CLS]
      For nE := 1 To Len(aUnits[nU][U_EVENTS])
        aEv := aUnits[nU][U_EVENTS][nE]
        Do Case
          Case aEv[EV_KIND] == EVK_DECL
            If aEv[EV_VALUE] != Nil
              Give(aEv[EV_VAR], TypeOf(aEv[EV_VALUE]))
            EndIf
          Case aEv[EV_KIND] == EVK_ASSIGN
            aT := aEv[EV_TARGET]
            If aT == Nil .Or. aT[N_KIND] != EK_NAME
              Loop
            EndIf
            aV := hNames{aT[N_ID]}
            If aV == Nil
              Loop
            EndIf
            cOp := aEv[EV_OP]
            If !(aEv[EV_INCDEC] == "")
              Give(aV, BinOp("+", aV[V_TYPE], "N"))
            ElseIf cOp == ":=" .Or. cOp == "=" .Or. cOp == "?="
              Give(aV, TypeOf(aEv[EV_VALUE]))
            Else
              Give(aV, BinOp(Chop(cOp), aV[V_TYPE], TypeOf(aEv[EV_VALUE])))
            EndIf
          Case aEv[EV_KIND] == EVK_COUNTER
            Give(aEv[EV_VAR], "N")
          Case aEv[EV_KIND] == EVK_FORIN
            // Over a hash, a set, a bag, a JSON object: each key, and what
            // it holds there.
            cT := TypeOf(aEv[EV_VALUE])
            cK := KindOf(cT)
            If IsKeyed(cK) .Or. cK == "J"
              Give(aEv[EV_VAR], If(cK == "J", "C", BareT(KeyOf(cT))))
              Give(aEv[EV_INDEX], If(cK == "J", T_UNKNOWN, ValueOf(cT)))
            Else
              Give(aEv[EV_VAR], ElemIn(aEv[EV_VALUE]))
              Give(aEv[EV_INDEX], "N")
            EndIf
          Case aEv[EV_KIND] == EVK_UNKNOWN .Or. aEv[EV_KIND] == EVK_REF
            Give(aEv[EV_VAR], T_UNKNOWN)
        EndCase
      Next
    Next
    nRound++
  EndDo
  cCls := ""
  For nU := 1 To Len(aVars)
    If !aVars[nU][V_PINNED] .And. aVars[nU][V_TYPE] == T_NONE
      aVars[nU][V_TYPE] := T_UNKNOWN
    EndIf
  Next
Return Nil

Static Function Give(aV, cT)
  Local cN
  If aV == Nil .Or. aV[V_PINNED]
    Return Nil
  EndIf
  cN := JoinT(aV[V_TYPE], cT)
  If !(cN == aV[V_TYPE])
    aV[V_TYPE] := cN
    lChanged := .T.
  EndIf
Return Nil

// What a 'for ... in' gives its name, walking source.
Static Function ElemIn(aSource)
  Local cT
  If aSource != Nil .And. aSource[N_KIND] == EK_INTERVAL
    Return "N"
  EndIf
  cT := TypeOf(aSource)
  If cT == T_NONE
    Return T_NONE
  EndIf
  If cT == "C"
    Return "C"
  EndIf
Return ElemOf(cT)

// ---- what an expression is --------------------------------------------------
Static Function TypeOf(aE)
  Local nK
  Local cT
  Local nI
  Local aV
  Local cN
  Local xD
  Local cC
  Local aB
  Local cB
  Local aFd
  If aE == Nil
    Return T_UNKNOWN
  EndIf
  nK := aE[N_KIND]
  Do Case
    Case nK == EK_LITERAL
      cT := aE[LIT_TYPE]
      Do Case
        Case cT == "Numeric"
          Return "N"
        Case cT == "Character"
          Return "C"
        Case cT == "Logical"
          Return "L"
        Case cT == "Variant" .And. u_xcb_lc(aE[LIT_TEXT]) == "nil"
          Return T_NIL
      EndCase
      Return T_UNKNOWN
    Case nK == EK_INTERP
      Return "C"
    Case nK == EK_ARRAYLIT
      Return If(aE[ARR_ELEM] == "", "A", "A<" + aE[ARR_ELEM] + ">")
    Case nK == EK_HASHLIT
      If aE[HASH_SETKIND] != 0
        cC := Chr(aE[HASH_SETKIND])
        Return If(aE[HASH_KEYTYPE] == "", cC, cC + "<" + aE[HASH_KEYTYPE] + ">")
      EndIf
      Return If(aE[HASH_KEYTYPE] == "", "H", "H<" + aE[HASH_KEYTYPE] + "," + aE[HASH_VALTYPE] + ">")
    Case nK == EK_JSONLIT
      Return "J"
    Case nK == EK_CODEBLOCK .Or. nK == EK_LAMBDA
      Return "B"
    Case nK == EK_NAME
      aV := hNames{aE[N_ID]}
      If aV != Nil
        Return aV[V_TYPE]
      EndIf
      Return If(IsSelf(aE), ClassType(cCls), T_UNKNOWN)
    Case nK == EK_SELFREF
      Return If(cCls == "", T_UNKNOWN, ClassType(cCls))
    Case nK == EK_INDEX
      cT := TypeOf(aE[IDX_BASE])
      For nI := 1 To Len(aE[IDX_INDICES])
        cT := ElemOf(cT)
      Next
      Return cT
    Case nK == EK_HASHINDEX
      Return ValueOf(TypeOf(aE[HIX_BASE]))
    Case nK == EK_BINARY
      If IsLogical(aE[BIN_OP])
        Return "L"
      EndIf
      If Left(aE[BIN_OP], 1) == "("
        Return SetOp(aE[BIN_OP], TypeOf(aE[BIN_LEFT]), TypeOf(aE[BIN_RIGHT]))
      EndIf
      Return BinOp(aE[BIN_OP], If(aE[BIN_LEFT] != Nil, TypeOf(aE[BIN_LEFT]), T_UNKNOWN), TypeOf(aE[BIN_RIGHT]))
    Case nK == EK_ASSIGNEXPR
      If !(aE[AE_INCDEC] == "")
        Return BinOp("+", TypeOf(aE[AE_TARGET]), "N")
      EndIf
      If aE[AE_OP] == ":=" .Or. aE[AE_OP] == "="
        Return TypeOf(aE[AE_VALUE])
      EndIf
      Return BinOp(Chop(aE[AE_OP]), TypeOf(aE[AE_TARGET]), TypeOf(aE[AE_VALUE]))
    Case nK == EK_CALL
      // 'Order()', a class of the file's: the object New() is then called
      // on.
      cN := u_xcb_lc(aE[CALL_NAME])
      If (hTypes has cN) .And. !(hFunctions has cN)
        Return "T:" + cN
      EndIf
      If Len(aE[CALL_ARGS]) == 0 .And. (hClasses has cN) .And. !(hFunctions has cN)
        Return ClassType(cN)
      EndIf
      Return CallType(cN, aE[CALL_ARGS], Nil)
    Case nK == EK_DOT
      cB := TypeOf(aE[DOT_BASE])
      If cB == T_NONE
        Return T_NONE
      EndIf
      aFd := FieldOf(cB, aE[DOT_NAME])
      Return If(aFd != Nil, aFd[TFD_TYPE], T_UNKNOWN)
    Case nK == EK_DOTCALL
      cB := TypeOf(aE[DC_BASE])
      If cB == T_NONE
        Return T_NONE
      EndIf
      Return MethodRet(TypeInfoOf(cB), aE[DC_NAME])
    Case nK == EK_NAMED
      Return TypeOf(aE[NMD_VALUE])
    Case nK == EK_SAFEMEMBER
      cB := TypeOf(aE[MEM_BASE])
      If IsTypedValue(cB)
        aFd := FieldOf(cB, aE[MEM_NAME])
        Return If(aFd != Nil, aFd[TFD_TYPE], T_UNKNOWN)
      EndIf
      Return T_UNKNOWN
    Case nK == EK_SAFECALL
      Return MethodRet(TypeInfoOf(TypeOf(aE[MC_BASE])), aE[MC_NAME])
    Case nK == EK_PIPELINE
      Return ChainType(aE, Len(aE[PIPE_STAGES]))
    Case nK == EK_GUARD
      Return BinOp("?:", TypeOf(aE[GRD_EXPR]), TypeOf(aE[GRD_FALLBACK]))
    Case nK == EK_MEMBER
      // '::x' in a method, 'o:x' of an object of a class of the file: the
      // Data, as its class declares it.
      xD := DataOf(ObjClass(aE[MEM_BASE]), aE[MEM_NAME], 0)
      Return If(xD != Nil, xD[DA_TYPE], T_UNKNOWN)
    Case nK == EK_METHODCALL
      // 'Name():New()': THashMap's a hash, JsonObject's a JSON, a class of
      // the file's an object of it, any other an object. '::m()', 'o:m()'
      // of an object of a class of the file: what m is declared to give.
      If u_xcb_lc(aE[MC_NAME]) == "new" .And. aE[MC_BASE] != Nil .And. aE[MC_BASE][N_KIND] == EK_CALL
        aB := aE[MC_BASE]
        cC := u_xcb_lc(aB[CALL_NAME])
        If Len(aB[CALL_ARGS]) == 0 .And. (hClasses has cC) .And. !(hFunctions has cC)
          Return ClassType(cC)
        EndIf
        Return If(cC == "thashmap", "H", If(cC == "jsonobject", "J", "O"))
      EndIf
      cC := ObjClass(aE[MC_BASE])
      Return If(cC == "", T_UNKNOWN, MethodType(cC, aE[MC_NAME]))
    Case nK == EK_EXPRLIST
      Return If(Len(aE[EL_ITEMS]) == 0, T_UNKNOWN, TypeOf(ATail(aE[EL_ITEMS])))
  EndCase
  // A field's type is the dictionary's, and there is none here.
Return T_UNKNOWN

// The type of a call's argument, from 0 -- the first what a chain feeds it,
// when it does (cFed).
Static Function ArgType(aArgs, cFed, nI)
  Local nOff := If(cFed != Nil, 1, 0)
  If cFed != Nil .And. nI == 0
    Return cFed
  EndIf
Return If(nI - nOff < Len(aArgs), TypeOf(aArgs[nI - nOff + 1]), T_UNKNOWN)

// What a call gives -- cFed the type of what a chain feeds it, its first
// argument then; Nil when it is not a stage.
Static Function CallType(cName, aArgs, cFed)
  Local nOff := If(cFed != Nil, 1, 0)
  Local cA
  Local nI
  Local cK
  Local cM
  Local cT
  Local cS
  Local aF
  Local aPs
  Local aWas
  Local cR
  Local cOp
  If hBuiltins has cName
    Return hBuiltins{cName}
  EndIf
  If cName == "round" .Or. cName == "noround" .Or. cName == "int" .Or. cName == "abs"
    cA := ArgType(aArgs, cFed, 0)
    Return If(cA == T_NONE, T_NONE, If(cA == "F", "F", "N"))
  EndIf
  If cName == "max" .Or. cName == "min" .Or. cName == "if" .Or. cName == "iif"
    nI := If(Left(cName, 1) == "m", 0, 1)
    Return BinOp("?:", ArgType(aArgs, cFed, nI), ArgType(aArgs, cFed, nI + 1))
  EndIf
  If cName == "aclone"
    Return UnfixT(ArgType(aArgs, cFed, 0))
  EndIf
  If cName == "asort" .Or. cName == "asize" .Or. cName == "adel" .Or. cName == "ains" .Or. cName == "afill"
    Return ArgType(aArgs, cFed, 0)
  EndIf
  If cName == "aadd" .Or. cName == "acopy"
    Return ArgType(aArgs, cFed, 1)
  EndIf
  If cName == "atail"
    Return ElemOf(ArgType(aArgs, cFed, 0))
  EndIf
  // The runtime's verbs: sets and bags.
  If cName == "setof" .Or. cName == "bagof"
    cK := If(Left(cName, 1) == "s", "S", "M")
    If Len(aArgs) + nOff == 1
      Return KeysOf(cK, ArgType(aArgs, cFed, 0), "-")
    EndIf
    cM := T_NIL
    For nI := 0 To Len(aArgs) + nOff - 1
      cT := BareT(ArgType(aArgs, cFed, nI))
      If cT == T_NONE
        Return T_NONE
      EndIf
      cM := If(cM == "", cT, If(cT == "" .Or. cT == cM, cM, T_UNKNOWN))
    Next
    Return If(cM == "" .Or. cM == T_UNKNOWN .Or. IsBox(KindOf(cM)), cK, cK + "<" + cM + ">")
  EndIf
  cOp := SetOpOf(cName)
  If !(cOp == "")
    Return SetOp(cOp, ArgType(aArgs, cFed, 0), ArgType(aArgs, cFed, 1))
  EndIf
  If cName == "elems" .Or. cName == "totalof"
    Return "N"
  EndIf
  If cName == "heap" .Or. cName == "heapof" .Or. cName == "queue"
    Return "O"
  EndIf
  If cName == "kxxv"
    Return ArrayOf(MemberOf(ArgType(aArgs, cFed, 0)))
  EndIf
  If cName == "minpairs" .Or. cName == "maxpairs"
    Return "A<A>"
  EndIf
  // The runtime's verbs.
  cS := ArgType(aArgs, cFed, 0)
  // A copy: fixed no more, but for what it holds.
  If "|" + cName + "|" $ cKeeps
    Return If(cS == T_NONE, T_NONE, If(!(KindOf(cS) == "A"), "A", If(IsFixed(cS), ArrayOf(ElemOf(cS)), cS)))
  EndIf
  If cName == "map"
    aF := If(1 >= nOff .And. 1 - nOff < Len(aArgs), aArgs[1 - nOff + 1], Nil)
    If aF != Nil .And. (aF[N_KIND] == EK_LAMBDA .Or. aF[N_KIND] == EK_CODEBLOCK)
      aPs := hBlockParams{aF[N_ID]}
      If Len(aF[CB_BODY]) == 0 .Or. aPs == Nil
        Return "A"
      EndIf
      cT := ElemOf(cS)
      aWas := {}
      For nI := 1 To Len(aPs)
        AAdd(aWas, aPs[nI][V_TYPE])
      Next
      If Len(aPs) > 0
        aPs[1][V_TYPE] := If(cT == T_NONE, T_UNKNOWN, cT)
      EndIf
      cR := TypeOf(ATail(aF[CB_BODY]))
      For nI := 1 To Len(aPs)
        aPs[nI][V_TYPE] := aWas[nI]
      Next
      Return If(cS == T_NONE, T_NONE, ArrayOf(cR))
    EndIf
    If aF != Nil .And. aF[N_KIND] == EK_NAME .And. !(hNames has aF[N_ID])
      cT := u_xcb_lc(aF[NAME_NAME])
      If hBuiltins has cT
        Return ArrayOf(hBuiltins{cT})
      EndIf
      If hReturns has cT
        Return ArrayOf(hReturns{cT})
      EndIf
    EndIf
    Return "A"
  EndIf
  Do Case
    Case cName == "count"
      Return "N"
    Case cName == "asum" .Or. cName == "aprod"
      Return If(ElemOf(cS) == "F", "F", "N")
    Case cName == "amax" .Or. cName == "amin" .Or. cName == "first" .Or. cName == "maxby" .Or. cName == "minby"
      Return ElemOf(cS)
    Case cName == "anyof" .Or. cName == "allof" .Or. cName == "noneof"
      Return "L"
    Case cName == "chunks" .Or. cName == "chunkby" .Or. cName == "pairwise"
      Return If(cS == T_NONE, T_NONE, If(IsGeneric(cS) .And. KindOf(cS) == "A", "A<" + cS + ">", "A<A>"))
    Case cName == "enumerate" .Or. cName == "zip" .Or. cName == "pairs"
      Return "A<A>"
    Case cName == "flatten" .Or. cName == "expand"
      Return "A"
    Case cName == "keys"
      Return If(cS == T_NONE, T_NONE, ArrayOf(KeyOf(cS)))
    Case cName == "values"
      Return If(cS == T_NONE, T_NONE, ArrayOf(ValueOf(cS)))
    Case cName == "split"
      Return "A<C>"
    Case cName == "join"
      Return "C"
    Case cName == "starts" .Or. cName == "ends" .Or. cName == "contains"
      Return "L"
  EndCase
  If hReturns has cName
    Return hReturns{cName}
  EndIf
Return T_UNKNOWN

// The set operator a verb is: 'union' is '(|)' -- '' for any other.
Static Function SetOpOf(cName)
  Do Case
    Case cName == "union"
      Return "(|)"
    Case cName == "intersect"
      Return "(&)"
    Case cName == "minus"
      Return "(-)"
    Case cName == "symdiff"
      Return "(^)"
    Case cName == "bagsum"
      Return "(+)"
    Case cName == "bagprod"
      Return "(.)"
    Case cName == "subset"
      Return "(<=)"
    Case cName == "psubset"
      Return "(<)"
    Case cName == "superset"
      Return "(>=)"
    Case cName == "psuperset"
      Return "(>)"
    Case cName == "sameset"
      Return "(==)"
  EndCase
Return ""

// What a chain gives after its first n stages.
Static Function ChainType(aP, nStages)
  Local cT := TypeOf(aP[PIPE_SOURCE])
  Local nI
  Local aC
  For nI := 1 To Min(nStages, Len(aP[PIPE_STAGES]))
    aC := aP[PIPE_STAGES][nI]
    cT := CallType(u_xcb_lc(aC[CALL_NAME]), aC[CALL_ARGS], cT)
  Next
Return cT

// ---- what is checked --------------------------------------------------------
Static Function IsKT(aE, nKind)
Return aE != Nil .And. aE[N_KIND] == nKind

// Whether a file types an array or a hash -- what is wrong is said only of
// one that does: a typed one declared, a Data, a parameter, a return; a
// class of the file named as a type; a literal of one, a set operator,
// setOf(), bagOf().
Static Function AnyTyped(aProg)
  Local nI
  Local nJ
  Local nK
  Local aC
  Local aM
  Local aF
  If Len(aProg[PG_TYPES]) > 0
    Return .T.
  EndIf
  For nI := 1 To Len(aProg[PG_CLASSES])
    aC := aProg[PG_CLASSES][nI]
    For nJ := 1 To Len(aC[CD_MEMBERS])
      If !(aC[CD_MEMBERS][nJ][DM_CONTAINER] == "") .Or. Named(aC[CD_MEMBERS][nJ][DM_TYPE])
        Return .T.
      EndIf
    Next
    For nJ := 1 To Len(aC[CD_METHODS])
      aM := aC[CD_METHODS][nJ]
      If !(aM[MS_RETCONTAINER] == "") .Or. Named(aM[MS_RETURNS])
        Return .T.
      EndIf
      For nK := 1 To Len(aM[MS_PARAMS])
        If TypedParam(aM[MS_PARAMS][nK])
          Return .T.
        EndIf
      Next
    Next
  Next
  For nI := 1 To Len(aProg[PG_METHODS])
    aM := aProg[PG_METHODS][nI]
    If !(aM[MI_RETCONTAINER] == "") .Or. Named(aM[MI_RETURNS])
      Return .T.
    EndIf
    For nK := 1 To Len(aM[MI_PARAMS])
      If TypedParam(aM[MI_PARAMS][nK])
        Return .T.
      EndIf
    Next
  Next
  For nI := 1 To Len(aProg[PG_STATICS])
    For nJ := 1 To Len(aProg[PG_STATICS][nI][DECL_DECLARATORS])
      aF := aProg[PG_STATICS][nI][DECL_DECLARATORS][nJ]
      If !(aF[DCL_CONTAINER] == "") .Or. IsClassed(DeclType(aF))
        Return .T.
      EndIf
    Next
  Next
  For nI := 1 To Len(aProg[PG_FUNCTIONS])
    aF := aProg[PG_FUNCTIONS][nI]
    If !(aF[FN_RETCONTAINER] == "") .Or. Named(aF[FN_RETWORD])
      Return .T.
    EndIf
    For nK := 1 To Len(aF[FN_PARAMS])
      If TypedParam(aF[FN_PARAMS][nK])
        Return .T.
      EndIf
    Next
  Next
  For nI := 1 To Len(aProg[PG_STATICS])
    For nJ := 1 To Len(aProg[PG_STATICS][nI][DECL_DECLARATORS])
      If TypedIn(aProg[PG_STATICS][nI][DECL_DECLARATORS][nJ][DCL_INIT])
        Return .T.
      EndIf
    Next
  Next
  For nI := 1 To Len(aProg[PG_FUNCTIONS])
    If TypedBody(aProg[PG_FUNCTIONS][nI][FN_BODY])
      Return .T.
    EndIf
  Next
  For nI := 1 To Len(aProg[PG_METHODS])
    If TypedBody(aProg[PG_METHODS][nI][MI_BODY])
      Return .T.
    EndIf
  Next
Return .F.

// A class of the file named as a type.
Static Function Named(xWord)
Return xWord != Nil .And. (hClasses has u_xcb_lc(xWord))

Static Function TypedParam(aQ)
Return aQ != Nil .And. (!(aQ[PRM_CONTAINER] == "") .Or. Named(aQ[PRM_TYPEWORD]))

Static Function TypedBody(aBody)
  Local aAll := u_xcb_walk(aBody)
  Local nI
  Local nJ
  Local aSt
  Local aV
  Local aEs
  For nI := 1 To Len(aAll)
    aSt := aAll[nI]
    If aSt[N_KIND] == SK_DECLARATION
      For nJ := 1 To Len(aSt[DECL_DECLARATORS])
        aV := aSt[DECL_DECLARATORS][nJ]
        If !(aV[DCL_CONTAINER] == "") .Or. IsClassed(DeclType(aV))
          Return .T.
        EndIf
      Next
    EndIf
    aEs := u_xcb_exprsof(aSt)
    For nJ := 1 To Len(aEs)
      If TypedIn(aEs[nJ])
        Return .T.
      EndIf
    Next
  Next
Return .F.

// A typed literal, a set operator, setOf(), bagOf() in a value.
Static Function TypedIn(aE)
  Local aXs
  Local nI
  Local aX
  Local cN
  If aE == Nil
    Return .F.
  EndIf
  aXs := u_xcb_walkexpr(aE)
  For nI := 1 To Len(aXs)
    aX := aXs[nI]
    Do Case
      Case aX[N_KIND] == EK_ARRAYLIT
        If !(aX[ARR_ELEM] == "")
          Return .T.
        EndIf
      Case aX[N_KIND] == EK_HASHLIT
        If !(aX[HASH_KEYTYPE] == "")
          Return .T.
        EndIf
      Case aX[N_KIND] == EK_BINARY
        If Left(aX[BIN_OP], 1) == "("
          Return .T.
        EndIf
      Case aX[N_KIND] == EK_CALL
        cN := u_xcb_lc(aX[CALL_NAME])
        If cN == "setof" .Or. cN == "bagof"
          Return .T.
        EndIf
    EndCase
  Next
Return .F.

// What a parameter takes, if xc checks it: a typed array or hash, or an
// object of a class of the file -- '' for none.
Static Function SlotOf(aQ)
  Local cT
  If aQ == Nil
    Return ""
  EndIf
  If !(aQ[PRM_CONTAINER] == "")
    Return aQ[PRM_CONTAINER]
  EndIf
  cT := If(aQ[PRM_TYPEWORD] != Nil, WordType(aQ[PRM_TYPEWORD]), T_UNKNOWN)
Return If(IsCheckedSlot(cT), cT, "")

// A method's parameters: the implementation's, or the signature's.
Static Function MethodParams(cClass, cName)
  Local aC := ClassOfMethod(cClass, cName, 0)
  Local cN := u_xcb_lc(cName)
  If aC == Nil
    Return {}
  EndIf
  If aC[CI_IMPLS] has cN
    Return aC[CI_IMPLS]{cN}[MI_PARAMS]
  EndIf
  If aC[CI_SIGS] has cN
    Return aC[CI_SIGS]{cN}[MS_PARAMS]
  EndIf
Return {}

// A Data as a message names it: '::aItems', 'oOrder:aItems',
// '::oCust:aTags' -- 'Order:aItems', read from anything else.
Static Function MemberName(aM)
  Local cC := ObjClass(aM[MEM_BASE])
  Local aD := DataOf(cC, aM[MEM_NAME], 0)
  Local cN := If(aD != Nil, aD[DA_NAME], aM[MEM_NAME])
  If IsSelf(aM[MEM_BASE])
    Return "::" + cN
  EndIf
  If IsKT(aM[MEM_BASE], EK_NAME)
    Return aM[MEM_BASE][NAME_NAME] + ":" + cN
  EndIf
  If IsKT(aM[MEM_BASE], EK_MEMBER)
    Return MemberName(aM[MEM_BASE]) + ":" + cN
  EndIf
Return If(hClasses has cC, hClasses{cC}[CI_NAME], "?") + ":" + cN

// A Data, said so: "'::aItems' is an Array<n>".
Static Function MemberWho(aM)
  Local aD := DataOf(ObjClass(aM[MEM_BASE]), aM[MEM_NAME], 0)
Return "'" + MemberName(aM) + "' is " + ShownT(If(aD != Nil, aD[DA_TYPE], T_UNKNOWN))

// A method, as a message names it: '::Add()', 'Order:Add()'.
Static Function MethodWho(aM, cClass)
  If IsSelf(aM[MC_BASE])
    Return "::" + aM[MC_NAME] + "()"
  EndIf
Return If(hClasses has cClass, hClasses{cClass}[CI_NAME], "?") + ":" + aM[MC_NAME] + "()"

// A type as xtpl writes it: 'Numeric', 'Array<n>', 'Hash<c, Array<n>>',
// 'Array<fixed n>'.
Static Function ShowT(cT)
  Local cF := If(IsFixed(cT), "fixed", "")
  Local aA
  Local cPre
  Local cW
  If IsGeneric(cT)
    aA := ArgsOf(cT)
    cPre := If(cF == "", "", cF + " ")
    cW := BoxName(KindOf(cT))
    If Len(aA) > 1
      Return cW + "<" + cPre + Inner(aA[1]) + ", " + Inner(aA[2]) + ">"
    EndIf
    Return cW + "<" + cPre + Inner(aA[1]) + ">"
  EndIf
  If !(cF == "")
    Return If(IsBox(KindOf(cT)), BoxName(KindOf(cT)) + "<fixed>", "?")
  EndIf
  If IsClassed(cT)
    Return Lineage(cT)[1]
  EndIf
  If IsTypedValue(cT)
    Return TypeWordT(cT)
  EndIf
  Do Case
    Case cT == "N"
      Return "Numeric"
    Case cT == "C"
      Return "Character"
    Case cT == "L"
      Return "Logical"
    Case cT == "D"
      Return "Date"
    Case cT == "A"
      Return "Array"
    Case cT == "H"
      Return "Hash"
    Case cT == "S"
      Return "Set"
    Case cT == "M"
      Return "Bag"
    Case cT == "O"
      Return "Object"
    Case cT == "B"
      Return "CodeBlock"
    Case cT == "J"
      Return "JSON"
    Case cT == "F"
      Return "Decimal"
  EndCase
Return cT

Static Function BoxName(cK)
  Do Case
    Case cK == "A"
      Return "Array"
    Case cK == "H"
      Return "Hash"
    Case cK == "S"
      Return "Set"
    Case cK == "M"
      Return "Bag"
  EndCase
Return ""

Static Function Inner(cT)
Return If(IsGeneric(cT) .Or. IsFixed(cT) .Or. IsClassed(cT) .Or. IsTypedValue(cT), ShowT(cT), u_xcb_lc(cT))

// With its article, for an array or a hash: 'an Array<n>', 'Character'.
Static Function ShownT(cT)
  Local cN
  If KindOf(cT) == "A"
    Return "an " + ShowT(cT)
  EndIf
  If IsKeyed(KindOf(cT))
    Return "a " + ShowT(cT)
  EndIf
  If IsClassed(cT) .Or. IsTypedValue(cT)
    cN := ShowT(cT)
    Return If(Len(cN) > 0 .And. Left(cN, 1) $ "aeiouAEIOU", "an ", "a ") + cN
  EndIf
Return ShowT(cT)

// Whether a value of type cV goes where cSlot is wanted (FIT_*). A fixed
// array or hash goes where a fixed one is, or where nothing is said:
// anywhere else, it could be written into.
Static Function Fits(cV, cSlot)
  Local cVk
  Local cSk
  Local nK
  Local nX
  Local aVa
  Local aSa
  Local nWorst := FIT_OK
  Local nF
  Local nI
  If cSlot == "" .Or. cSlot == T_UNKNOWN .Or. cV == ""
    Return FIT_OK
  EndIf
  If IsTypedValue(cSlot)
    // A type's value is an array: one xc cannot tell is taken for one --
    // what TOTVS' functions give --, an array known to hold this or that
    // is not.
    If BareT(cV) == T_UNKNOWN .Or. cV == T_NONE .Or. BareT(cV) == "A"
      Return FIT_OK
    EndIf
    Return If(TypeIs(BareT(cV), cSlot), FIT_OK, FIT_WRONG)
  EndIf
  If BareT(cV) == T_UNKNOWN .Or. cV == T_NONE
    Return FIT_UNKNOWN
  EndIf
  // And goes where an array does.
  If IsTypedValue(cV)
    Return If(KindOf(cSlot) == "A" .And. !IsGeneric(cSlot), FIT_OK, FIT_WRONG)
  EndIf
  cVk := KindOf(cV)
  cSk := KindOf(cSlot)
  If IsBox(cVk) .And. IsBox(cSk) .And. IsFixed(cV) .And. !IsFixed(cSlot)
    Return FIT_WRONG
  EndIf
  If BareT(cV) == BareT(cSlot)
    Return FIT_OK
  EndIf
  If IsClassed(cSlot)
    // An object of that class, or of one that inherits from it.
    If !(cVk == "O")
      Return FIT_WRONG
    EndIf
    If !IsClassed(cV)
      Return FIT_UNKNOWN
    EndIf
    Return If(IsA(cV, Lineage(cSlot)[1]), FIT_OK, FIT_WRONG)
  EndIf
  // A THashMap is an object, and an object may be one.
  If cSk == "O" .And. IsKeyed(cVk)
    Return FIT_OK
  EndIf
  If cVk == "O" .And. IsKeyed(cSk)
    Return FIT_UNKNOWN
  EndIf
  If (cVk == "S" .Or. cVk == "M") .And. cSk == "H"
    // A set is a hash of Logicals, a bag one of Numerics.
    If !IsGeneric(cSlot)
      Return FIT_OK
    EndIf
    nK := Fits(KeyOf(cV), KeyOf(cSlot))
    nX := Fits(ValueOf(cV), ValueOf(cSlot))
    Return If(nK == FIT_WRONG .Or. nX == FIT_WRONG, FIT_WRONG, ;
              If(nK == FIT_UNKNOWN .Or. nX == FIT_UNKNOWN, FIT_UNKNOWN, FIT_OK))
  EndIf
  If !(cVk == cSk)
    Return FIT_WRONG
  EndIf
  // An array, whatever it holds; what it holds, not known.
  If !IsGeneric(cSlot)
    Return FIT_OK
  EndIf
  If !IsGeneric(cV)
    Return FIT_UNKNOWN
  EndIf
  aVa := ArgsOf(cV)
  aSa := ArgsOf(cSlot)
  For nI := 1 To Len(aSa)
    nF := Fits(If(IsFixed(cV), FixT(aVa[nI]), aVa[nI]), aSa[nI])
    If nF == FIT_WRONG
      Return FIT_WRONG
    EndIf
    If nF == FIT_UNKNOWN
      nWorst := FIT_UNKNOWN
    EndIf
  Next
Return nWorst

// A value that goes where cSlot is wanted -- cWho: what it goes into, said
// so; a literal array or hash, each of what it holds.
Static Function GoesInto(aE, cSlot, cWho, lKey)
  Local cN
  Local cT
  Local nI
  Local cWhat
  Local nF
  If aE == Nil .Or. cSlot == "" .Or. cSlot == T_UNKNOWN .Or. IsKT(aE, EK_REF) .Or. IsKT(aE, EK_OMITTED)
    Return Nil
  EndIf
  If IsTypedValue(cSlot) .And. IsKT(aE, EK_ARRAYLIT)
    AAdd(aErrors, {nLineT, cWho + ": an array written out is none -- " + ShowT(cSlot) + "(...) makes one."})
    Return Nil
  EndIf
  // setOf(), bagOf(): an empty set or bag, of whatever is wanted.
  If IsKT(aE, EK_CALL) .And. Len(aE[CALL_ARGS]) == 0
    cN := u_xcb_lc(aE[CALL_NAME])
    If (cN == "setof" .And. KindOf(cSlot) == "S") .Or. (cN == "bagof" .And. KindOf(cSlot) == "M")
      Return Nil
    EndIf
  EndIf
  If IsKT(aE, EK_ARRAYLIT) .And. aE[ARR_ELEM] == "" .And. IsGeneric(cSlot) .And. KindOf(cSlot) == "A"
    cT := ElemOf(cSlot)
    For nI := 1 To Len(aE[ARR_ITEMS])
      GoesInto(aE[ARR_ITEMS][nI], cT, cWho, .F.)
    Next
    Return Nil
  EndIf
  If IsKT(aE, EK_HASHLIT) .And. aE[HASH_KEYTYPE] == "" .And. IsGeneric(cSlot) .And. KindOf(cSlot) == "H"
    For nI := 1 To Len(aE[HASH_PAIRS])
      GoesInto(aE[HASH_PAIRS][nI][KV_KEY], KeyOf(cSlot), cWho, .T.)
      GoesInto(aE[HASH_PAIRS][nI][KV_VALUE], ValueOf(cSlot), cWho, .F.)
    Next
    Return Nil
  EndIf
  cT := TypeOf(aE)
  cWhat := If(lKey, "this key", "this")
  nF := Fits(cT, cSlot)
  If nF == FIT_WRONG
    AAdd(aErrors, {nLineT, cWho + ": " + cWhat + " is " + ShownT(cT) + ", not " + ShownT(cSlot) + "."})
  ElseIf nF == FIT_UNKNOWN
    AAdd(aWarnings, {nLineT, cWho + ": xc cannot tell that " + cWhat + " is " + ShownT(cSlot) + "."})
  EndIf
Return Nil

// What an element is read from: the base of 'a[i]', 'h{k}', over and over.
Static Function RootOf(aE)
  Local aRoot := aE
  While IsKT(aRoot, EK_INDEX) .Or. IsKT(aRoot, EK_HASHINDEX)
    aRoot := If(IsKT(aRoot, EK_INDEX), aRoot[IDX_BASE], aRoot[HIX_BASE])
  EndDo
Return aRoot

// What an element written to belongs to, said so: the name it is read
// from, and what that is.
Static Function WhoOf(aBase)
  Local aRoot := RootOf(aBase)
  Local cT
  If IsKT(aRoot, EK_NAME)
    Return "'" + aRoot[NAME_NAME] + "' is " + ShownT(TypeOf(aRoot))
  EndIf
  If IsKT(aRoot, EK_MEMBER) .And. !(ObjClass(aRoot[MEM_BASE]) == "")
    Return MemberWho(aRoot)
  EndIf
  cT := TypeOf(aBase)
Return If(KindOf(cT) == "H", "the hash", "the array") + " is " + ShownT(cT)

// A fixed array or hash written into, said so: the name it is, or the one
// it is read from.
Static Function FixedWho(aW)
  Local cT := TypeOf(aW)
  Local cWhat := If(BareT(cT) == T_UNKNOWN, "a fixed array or hash", ShownT(cT))
  Local aV
  Local aRoot
  If IsKT(aW, EK_NAME)
    // Declared so, or given one somewhere.
    aV := If(hNames has aW[N_ID], hNames{aW[N_ID]}, Nil)
    Return "'" + aW[NAME_NAME] + If(aV != Nil .And. IsFixed(aV[V_CONTAINER]), "' is ", "' may hold ") + cWhat
  EndIf
  If IsKT(aW, EK_MEMBER) .And. !(ObjClass(aW[MEM_BASE]) == "")
    Return MemberWho(aW)
  EndIf
  aRoot := RootOf(aW)
  If IsKT(aRoot, EK_NAME)
    Return "'" + aRoot[NAME_NAME] + "' holds " + cWhat + " here"
  EndIf
  If IsKT(aRoot, EK_MEMBER) .And. !(ObjClass(aRoot[MEM_BASE]) == "")
    Return "'" + MemberName(aRoot) + "' holds " + cWhat + " here"
  EndIf
Return "this is " + cWhat

// A fixed name, as its declaration says: "'aX' is an Array<fixed n>
// (declared on line 3)".
Static Function DeclaredAs(aV)
Return "'" + aV[V_NAME] + "' is " + ShownT(aV[V_CONTAINER]) + " (declared on line " + AllTrim(Str(aV[V_LINE])) + ")"

// A function that writes into what it is given -- cHow: its name --, given
// a fixed array or hash. xFed: the type of what a chain feeds it, or Nil.
Static Function Writes(aInto, cHow, xFed)
  Local cT := If(xFed != Nil, xFed, TypeOf(aInto))
  Local cWho
  If !IsFixed(cT)
    Return Nil
  EndIf
  cWho := If(aInto != Nil, FixedWho(aInto), ;
             "this is " + If(BareT(cT) == T_UNKNOWN, "a fixed array or hash", ShownT(cT)))
  AAdd(aErrors, {nLineT, cWho + ": " + cHow + "() would write into it."})
Return Nil

// A call's argument, from 0: what a chain feeds it first, when it does.
Static Function CheckArg(aArgs, aFedExpr, xFed, nI)
  Local nOff := If(xFed != Nil, 1, 0)
  If xFed != Nil .And. nI == 0
    Return aFedExpr
  EndIf
Return If(nI - nOff < Len(aArgs), aArgs[nI - nOff + 1], Nil)

Static Function CheckArgType(aArgs, aFedExpr, xFed, nI)
  If xFed != Nil .And. nI == 0
    Return xFed
  EndIf
Return TypeOf(CheckArg(aArgs, aFedExpr, xFed, nI))

// TL++'s functions that change the array they are given, by their names in
// lower case: '' for any other.
Static Function ArrayWriter(cName)
  Do Case
    Case cName == "aadd"
      Return "AAdd"
    Case cName == "adel"
      Return "ADel"
    Case cName == "ains"
      Return "AIns"
    Case cName == "asize"
      Return "ASize"
    Case cName == "afill"
      Return "AFill"
    Case cName == "asort"
      Return "ASort"
  EndCase
Return ""

// THashMap's methods that change it.
Static Function HashWriter(cName)
  Do Case
    Case cName == "set"
      Return "Set"
    Case cName == "del"
      Return "Del"
    Case cName == "clean"
      Return "Clean"
    Case cName == "clear"
      Return "Clear"
    Case cName == "remove"
      Return "Remove"
  EndCase
Return ""

// AAdd(), AFill(), ACopy(), and a function of the file whose parameters
// are typed arrays or hashes: what each puts in, or is given. aFedExpr,
// xFed: what a chain feeds it, and its type -- xFed Nil for a call that is
// no stage.
Static Function CallCheck(cName, aArgs, aFedExpr, xFed)
  Local cW := ArrayWriter(cName)
  Local cT
  Local aA0
  Local cWho
  Local aFn
  Local aPs
  Local nI
  Local cSlot
  Local nF
  If !(cW == "")
    cT := CheckArgType(aArgs, aFedExpr, xFed, 0)
    aA0 := CheckArg(aArgs, aFedExpr, xFed, 0)
    If IsFixed(cT)
      Writes(aA0, cW, If(xFed != Nil .And. aFedExpr == Nil, xFed, Nil))
      Return Nil
    EndIf
    // A hash, a set, a bag, a value known to be no array.
    If !(cT == "") .And. !(cT == T_UNKNOWN) .And. !(cT == T_NONE) .And. !(KindOf(cT) == "A") .And. !(KindOf(cT) == "O")
      cWho := If(IsKT(aA0, EK_NAME), "'" + aA0[NAME_NAME] + "' is ", "this is ")
      AAdd(aErrors, {nLineT, cWho + ShownT(cT) + ": " + cW + "() takes an array."})
      Return Nil
    EndIf
    If (cName == "aadd" .Or. cName == "afill") .And. IsGeneric(cT) .And. KindOf(cT) == "A" ;
       .And. CheckArg(aArgs, aFedExpr, xFed, 1) != Nil
      GoesInto(CheckArg(aArgs, aFedExpr, xFed, 1), ElemOf(cT), ;
           If(xFed != Nil .And. aFedExpr == Nil, "the array is " + ShownT(cT), WhoOf(aA0)), .F.)
    EndIf
    Return Nil
  EndIf
  If cName == "acopy"
    cT := TypeOf(CheckArg(aArgs, aFedExpr, xFed, 1))
    If IsFixed(cT)
      Writes(CheckArg(aArgs, aFedExpr, xFed, 1), "ACopy", Nil)
      Return Nil
    EndIf
    If IsGeneric(cT) .And. KindOf(cT) == "A" .And. CheckArg(aArgs, aFedExpr, xFed, 0) != Nil
      GoesInto(CheckArg(aArgs, aFedExpr, xFed, 0), cT, WhoOf(CheckArg(aArgs, aFedExpr, xFed, 1)), .F.)
    EndIf
    Return Nil
  EndIf
  If !(hFunctions has cName)
    Return Nil
  EndIf
  aFn := hFunctions{cName}
  aPs := aFn[FF_PARAMS]
  For nI := 0 To Len(aPs) - 1
    cSlot := SlotOf(aPs[nI + 1])
    If cSlot == "" .Or. CheckArg(aArgs, aFedExpr, xFed, nI) == Nil
      Loop
    EndIf
    cWho := "the parameter '" + aPs[nI + 1][PRM_NAME] + "' of " + aFn[FF_NAME] + "() is " + ShownT(cSlot)
    If xFed != Nil .And. nI == 0
      nF := Fits(xFed, cSlot)
      If nF == FIT_WRONG
        AAdd(aErrors, {nLineT, cWho + ": this is " + ShownT(xFed) + ", not " + ShownT(cSlot) + "."})
      ElseIf nF == FIT_UNKNOWN
        AAdd(aWarnings, {nLineT, cWho + ": xc cannot tell that this is " + ShownT(cSlot) + "."})
      EndIf
      Loop
    EndIf
    GoesInto(CheckArg(aArgs, aFedExpr, xFed, nI), cSlot, cWho, .F.)
  Next
Return Nil

// What a function's events put where: each judged on its own line.
Static Function CheckUnit(aU)
  Local nE
  Local aEv
  Local aV
  Local aD
  Local aT
  Local aM
  Local aDa
  Local lOwn
  Local aBase
  Local cSlot
  Local cWho
  Local cV
  Local cR
  Local cOp
  Local cT
  Local cW
  Local cC
  Local aPs
  Local nI
  Local aCall
  Local aTi
  Local aFd
  Local cN
  cRet := aU[U_RET]
  cRetName := aU[U_NAME]
  cCls := aU[U_CLS]
  For nE := 1 To Len(aU[U_EVENTS])
    aEv := aU[U_EVENTS][nE]
    nLineT := aEv[EV_LINE]
    cOp := aEv[EV_OP]
    Do Case
      Case aEv[EV_KIND] == EVK_DECL
        aV := aEv[EV_VAR]
        aD := aEv[EV_DECL]
        If IsFixed(aV[V_CONTAINER]) .And. (aD[DCL_INIT] == Nil .Or. aD[DCL_INITMADE])
          AAdd(aErrors, {nLineT, "'" + aV[V_NAME] + "' is " + ShownT(aV[V_CONTAINER]) ;
                                 + ": it takes its value where it is declared."})
        ElseIf !(aV[V_CONTAINER] == "") .And. aD[DCL_INIT] != Nil .And. !aD[DCL_INITMADE]
          GoesInto(aD[DCL_INIT], aV[V_CONTAINER], "'" + aV[V_NAME] + "' is " + ShownT(aV[V_CONTAINER]), .F.)
        EndIf
      Case aEv[EV_KIND] == EVK_COUNTER
        If IsFixed(aEv[EV_VAR][V_CONTAINER])
          AAdd(aErrors, {nLineT, DeclaredAs(aEv[EV_VAR]) + " and cannot be assigned."})
        EndIf
      Case aEv[EV_KIND] == EVK_REF
        If IsFixed(aEv[EV_VAR][V_CONTAINER])
          AAdd(aErrors, {nLineT, DeclaredAs(aEv[EV_VAR]) + " and cannot be passed by reference."})
        EndIf
      Case aEv[EV_KIND] == EVK_ASSIGN
        aT := aEv[EV_TARGET]
        If IsKT(aT, EK_NAME)
          aV := If(hNames has aT[N_ID], hNames{aT[N_ID]}, Nil)
          If aV != Nil .And. IsFixed(aV[V_CONTAINER])
            AAdd(aErrors, {nLineT, DeclaredAs(aV) + " and cannot be assigned."})
          ElseIf aV != Nil .And. !(aV[V_CONTAINER] == "") .And. aEv[EV_INCDEC] == "" ;
                 .And. (cOp == ":=" .Or. cOp == "=" .Or. cOp == "?=")
            GoesInto(aEv[EV_VALUE], aV[V_CONTAINER], "'" + aV[V_NAME] + "' is " + ShownT(aV[V_CONTAINER]), .F.)
          EndIf
        ElseIf IsKT(aT, EK_DOT)
          // 'x.f := v': as the type declares it -- a '<const>' one only
          // where a value is made.
          aTi := TypeInfoOf(TypeOf(aT[DOT_BASE]))
          aFd := FieldOf(TypeOf(aT[DOT_BASE]), aT[DOT_NAME])
          If aFd != Nil
            If aFd[TFD_CONST]
              cN := DotName(aT)
              AAdd(aErrors, {nLineT, "'" + If(cN == "", "." + aT[DOT_NAME], cN) + "' is <const>: it takes its value " ;
                                     + "where " + ShownT(If(aTi != Nil, "T:" + u_xcb_lc(aTi[TI_NAME]), T_UNKNOWN)) ;
                                     + " is made."})
            ElseIf aEv[EV_INCDEC] == "" .And. (cOp == ":=" .Or. cOp == "=" .Or. cOp == "?=")
              Put(aEv[EV_VALUE], aFd[TFD_SLOT], FieldWho(aT))
            EndIf
          EndIf
        ElseIf IsKT(aT, EK_MEMBER)
          // '::x := v', 'o:x := v': as the class declares it -- a fixed one
          // only in the constructor, its own.
          aM := aT
          aDa := DataOf(ObjClass(aM[MEM_BASE]), aM[MEM_NAME], 0)
          If aDa != Nil .And. !(aDa[DA_CONTAINER] == "")
            lOwn := IsSelf(aM[MEM_BASE]) .And. aU[U_CTOR]
            If IsFixed(aDa[DA_CONTAINER]) .And. !(lOwn .And. aEv[EV_INCDEC] == "" .And. (cOp == ":=" .Or. cOp == "="))
              AAdd(aErrors, {nLineT, "'" + MemberName(aM) + "' is " + ShownT(aDa[DA_CONTAINER]) ;
                                     + " (declared on line " + AllTrim(Str(aDa[DA_LINE])) ;
                                     + "): only the constructor gives it its value."})
            ElseIf aEv[EV_INCDEC] == "" .And. (cOp == ":=" .Or. cOp == "=" .Or. cOp == "?=")
              GoesInto(aEv[EV_VALUE], aDa[DA_CONTAINER], MemberWho(aM), .F.)
            EndIf
          EndIf
        Else
          aBase := If(IsKT(aT, EK_INDEX), aT[IDX_BASE], If(IsKT(aT, EK_HASHINDEX), aT[HIX_BASE], Nil))
          If aBase != Nil
            If IsFixed(TypeOf(aBase))
              AAdd(aErrors, {nLineT, FixedWho(aBase) + ": nothing in it may be written."})
            Else
              cSlot := TypeOf(aT)
              If !(cSlot == T_UNKNOWN) .And. !(cSlot == T_NONE)
                cWho := WhoOf(aBase)
                If IsKT(aT, EK_HASHINDEX)
                  GoesInto(aT[HIX_KEY], KeyOf(TypeOf(aBase)), cWho, .T.)
                EndIf
                If aEv[EV_INCDEC] == ""
                  If cOp == ":=" .Or. cOp == "=" .Or. cOp == "?="
                    GoesInto(aEv[EV_VALUE], cSlot, cWho, .F.)
                  Else
                    // 'a[i] += v': what the operator makes of the two.
                    cV := TypeOf(aEv[EV_VALUE])
                    cR := BinOp(Chop(cOp), cSlot, cV)
                    If cV == T_UNKNOWN .Or. cV == T_NONE
                      AAdd(aWarnings, {nLineT, cWho + ": xc cannot tell that this is " + ShownT(cSlot) + "."})
                    ElseIf cR == T_UNKNOWN .Or. Fits(cR, cSlot) == FIT_WRONG
                      AAdd(aErrors, {nLineT, cWho + ": this is " + ShownT(cV) + ", and '" + cOp + "' makes no " ;
                                             + ShownT(cSlot) + " of it."})
                    EndIf
                  EndIf
                EndIf
              EndIf
            EndIf
          EndIf
        EndIf
      Case aEv[EV_KIND] == EVK_CALLE
        aCall := aEv[EV_CALL]
        If aEv[EV_CHAIN] != Nil
          CallCheck(u_xcb_lc(aCall[CALL_NAME]), aCall[CALL_ARGS], ;
                    If(aEv[EV_STAGE] == 0, aEv[EV_CHAIN][PIPE_SOURCE], Nil), ChainType(aEv[EV_CHAIN], aEv[EV_STAGE]))
        Else
          CallCheck(u_xcb_lc(aCall[CALL_NAME]), aCall[CALL_ARGS], Nil, Nil)
        EndIf
      Case aEv[EV_KIND] == EVK_METHODE
        aM := aEv[EV_METHOD]
        cT := TypeOf(aM[MC_BASE])
        cW := HashWriter(u_xcb_lc(aM[MC_NAME]))
        If !(cW == "") .And. IsFixed(cT)
          Writes(aM[MC_BASE], cW, Nil)
        Else
          If u_xcb_lc(aM[MC_NAME]) == "set" .And. Len(aM[MC_ARGS]) >= 2 .And. IsGeneric(cT) .And. IsKeyed(KindOf(cT))
            cWho := WhoOf(aM[MC_BASE])
            GoesInto(aM[MC_ARGS][1], KeyOf(cT), cWho, .T.)
            GoesInto(aM[MC_ARGS][2], ValueOf(cT), cWho, .F.)
          EndIf
          // '::m(...)', 'o:m(...)' of an object of a class of the file: what
          // its parameters are declared as.
          cC := ObjClass(aM[MC_BASE])
          If !(cC == "")
            aPs := MethodParams(cC, aM[MC_NAME])
            For nI := 1 To Min(Len(aPs), Len(aM[MC_ARGS]))
              cSlot := SlotOf(aPs[nI])
              If cSlot == ""
                Loop
              EndIf
              GoesInto(aM[MC_ARGS][nI], cSlot, "the parameter '" + aPs[nI][PRM_NAME] + "' of " + MethodWho(aM, cC) ;
                                           + " is " + ShownT(cSlot), .F.)
            Next
          EndIf
        EndIf
      Case aEv[EV_KIND] == EVK_RETURN
        If !(cRet == "") .And. aEv[EV_VALUE] != Nil
          GoesInto(aEv[EV_VALUE], cRet, cRetName + "() returns " + ShownT(cRet), .F.)
        EndIf
    EndCase
  Next
Return Nil
