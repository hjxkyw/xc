#include "totvs.ch"
#include "xcb.ch"

// ast.xtpl -- the nodes of the tree (xcb.ch): each made with the C++ xc's
// defaults -- '' for a string, {} for a list, -1 for an offset, .F., Nil for
// what is not there --, and a number of its own.
// -----------------------------------------------------------------------------

Static aTpl := Nil
Static nLastId := 0

// A node of that kind.
User Function xcb_new(nKind)
  Local aN
  If aTpl == Nil
    aTpl := Templates()
  EndIf
  aN := AClone(aTpl[nKind])
  nLastId++
  aN[N_ID] := nLastId
Return aN

// Each kind's node, as it starts: the header, then its fields.
Static Function Templates()
  Local aT := Array(NK_TYPEDEF)
  Local aExpr := {0, 0, 0, -1, -1}
  Local aStmt := {0, 0, 0, -1, -1, .F., .F.}
  Local aNode := {0, 0, 0, -1, -1}
  Local nK

  aT[EK_LITERAL] := Joined(aExpr, {"", ""})
  aT[EK_NAME] := Joined(aExpr, {""})
  aT[EK_USERTRANS] := Joined(aExpr, {"", Nil})
  aT[EK_CALL] := Joined(aExpr, {"", {}})
  aT[EK_BINARY] := Joined(aExpr, {"", Nil, Nil})
  aT[EK_INDEX] := Joined(aExpr, {Nil, {}})
  aT[EK_SELFREF] := Joined(aExpr, {})
  aT[EK_SUBJECTREF] := Joined(aExpr, {})
  aT[EK_MEMBER] := Joined(aExpr, {Nil, "", "", 0})
  aT[EK_SAFEMEMBER] := Joined(aExpr, {Nil, "", "", 0})
  aT[EK_HASHINDEX] := Joined(aExpr, {Nil, Nil, 0})
  aT[EK_INTERVAL] := Joined(aExpr, {Nil, Nil})
  aT[EK_METHODCALL] := Joined(aExpr, {Nil, "", {}, ""})
  aT[EK_SAFECALL] := Joined(aExpr, {Nil, "", {}, ""})
  aT[EK_ALIASFIELD] := Joined(aExpr, {Nil, Nil, "", Nil})
  aT[EK_INALIAS] := Joined(aExpr, {Nil, Nil, Nil})
  aT[EK_MACRO] := Joined(aExpr, {Nil, .F., {}})
  aT[EK_REF] := Joined(aExpr, {Nil})
  aT[EK_OMITTED] := Joined(aExpr, {})
  aT[EK_EXPRLIST] := Joined(aExpr, {{}})
  aT[EK_ASSIGNEXPR] := Joined(aExpr, {Nil, "", Nil, ""})
  aT[EK_ARRAYLIT] := Joined(aExpr, {"", "", {}, ""})
  aT[EK_INTERP] := Joined(aExpr, {"", "", {}})
  aT[EK_JSONLIT] := Joined(aExpr, {"", "", {}})
  aT[EK_HASHLIT] := Joined(aExpr, {"", "", {}, "", "", 0})
  aT[EK_CODEBLOCK] := Joined(aExpr, {"", "", {}, {}})
  aT[EK_LAMBDA] := Joined(aExpr, {"", "", {}, {}})
  aT[EK_GUARD] := Joined(aExpr, {Nil, Nil})
  aT[EK_PIPELINE] := Joined(aExpr, {Nil, {}, .F.})
  aT[EK_DOT] := Joined(aExpr, {Nil, "", "", 0})
  aT[EK_DOTCALL] := Joined(aExpr, {Nil, "", {}, ""})
  aT[EK_NAMED] := Joined(aExpr, {"", Nil})

  aT[SK_DECLARATION] := Joined(aStmt, {"", {}})
  aT[SK_ASSIGNMENT] := Joined(aStmt, {Nil, "", Nil})
  aT[SK_CALLSTMT] := Joined(aStmt, {Nil})
  aT[SK_RETURNSTMT] := Joined(aStmt, {Nil})
  aT[SK_EXITSTMT] := Joined(aStmt, {})
  aT[SK_LOOPSTMT] := Joined(aStmt, {})
  aT[SK_ANNOTATION] := Joined(aStmt, {"", {}})
  aT[SK_IFSTMT] := Joined(aStmt, {{}, {}, Nil})
  aT[SK_CASESTMT] := Joined(aStmt, {{}, {}, Nil, Nil})
  aT[SK_WHILESTMT] := Joined(aStmt, {Nil, {}, Nil})
  aT[SK_FORSTMT] := Joined(aStmt, {"", .F., Nil, Nil, Nil, {}, -1, -1})
  aT[SK_FORINSTMT] := Joined(aStmt, {"", Nil, .F., Nil, {}, -1, -1})
  aT[SK_FORTIMESSTMT] := Joined(aStmt, {Nil, {}})
  aT[SK_MODIFIED] := Joined(aStmt, {Nil, "", Nil})
  aT[SK_DEFERRED] := Joined(aStmt, {Nil})
  aT[SK_USINGALIAS] := Joined(aStmt, {"", Nil, {}})
  aT[SK_WITHOBJECT] := Joined(aStmt, {Nil, {}})
  aT[SK_RAWSTMT] := Joined(aStmt, {.F., {}})
  aT[SK_TRYSTMT] := Joined(aStmt, {{}, Nil, {}, {}})
  aT[SK_TRANSACTIONSTMT] := Joined(aStmt, {{}})
  aT[SK_NOOPSTMT] := Joined(aStmt, {""})
  aT[SK_BREAKSTMT] := Joined(aStmt, {Nil, .F.})
  aT[SK_DEFAULTSTMT] := Joined(aStmt, {{}})
  aT[SK_SEQUENCESTMT] := Joined(aStmt, {{}, .F., Nil, 0, {}})

  aT[NK_KEYVALUE] := Joined(aNode, {Nil, Nil})
  aT[NK_BRANCH] := Joined(aNode, {Nil, {}})
  aT[NK_DECLARATOR] := Joined(aNode, {"", Nil, "", {}, .F., Nil, {}, "", .F., .F.})
  aT[NK_PARAM] := Joined(aNode, {"", "", Nil, {}, -1, -1, "", -1, -1, ""})
  aT[NK_FUNCTIONDEF] := Joined(aNode, {"", "", {}, {}, {}, Nil, "", -1, -1, "", "", "", -1, -1, -1})
  aT[NK_DATAMEMBER] := Joined(aNode, {"", Nil, Nil, Nil, "", "", -1, -1, ""})
  aT[NK_METHODSIG] := Joined(aNode, {"", {}, Nil, .F., .F., Nil, "", -1, -1, ""})
  aT[NK_CLASSDEF] := Joined(aNode, {"", {}, {}, {}, {}, .F.})
  aT[NK_METHODIMPL] := Joined(aNode, {"", "", {}, Nil, {}, .F., "", -1, -1, ""})
  aT[NK_EXTERNAL] := Joined(aNode, {.F., {}})
  aT[NK_PROGRAM] := Joined(aNode, {Nil, {}, {}, {}, {}, {}, {}, {}, {}, {}})
  aT[NK_TYPEFIELD] := Joined(aNode, {Nil})
  aT[NK_TYPEDEF] := Joined(aNode, {"", -1, -1, -1, 0, {}, {}, ""})

  For nK := 1 To Len(aT)
    If aT[nK] != Nil
      aT[nK][N_KIND] := nK
    EndIf
  Next
Return aT

// The header, then the fields: a template of its own.
Static Function Joined(aHead, aFields)
  Local aOut := AClone(aHead)
  Local nI
  For nI := 1 To Len(aFields)
    AAdd(aOut, aFields[nI])
  Next
Return aOut
