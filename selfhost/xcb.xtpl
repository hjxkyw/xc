#include "totvs.ch"
#include "xcb.ch"

// xcb.xtpl -- the compiler written in xtpl, from the command line: an
// AppServer's, and xc-vm's (cpp/tests/selfhost.cmake).
//
//   appserver -run=u_xcb -env=NAME bytecode SOURCE [OUT] [includes=DIRS] [said]
//   appserver -run=u_xcb -env=NAME bytecode LIST [includes=DIRS] [said]
//   xc-vm --run=U_XCB runtime.xbc ast.xbc ... xcb.xbc -- bytecode SOURCE [OUT]
//
// 'bytecode': a source -- .xtpl, .prw, .prx, .tlpp -- as bytecode, what
// 'xc --bytecode' writes: to OUT, else beside it as NAME.xbc; or each
// source of LIST, a line each, a tab and the .xbc after it. DIRS: the
// include folders searched after the source's own, ';' or ',' between
// them. It says 'SOURCE -> OUT (N.NN s)' for each, or why it is not made.
// With 'said', what it says of each -- but where it went -- goes to a file
// beside its .xbc too, NAME.said: the AppServer's console may break a long
// line with what else it writes there.
// u_xcb_compile() is the same, for a program: the interpreter
// (interp/xbc.xtpl) runs a source with it.
//
// The rest is for selfhost.cmake. 'ast': each line of LIST names a source
// and a file, a tab between them; the source's tree goes to the file, as
// 'xc-ast --bare' writes it -- or 'not parsed at N'. 'facts': the tree
// marked, then its facts, as 'xc-ast --bare --facts' writes them; the
// files after it on the line, each after another tab, are given the
// source's bytecode, as 'xc --bytecode' writes it -- or what cannot become
// bytecode yet, a line each --, what the checks find, as 'xc-ast --bare
// --checks' writes it, and what 'bytecode' says of the source, but the
// line that says where it went. 'values': each line of each source read
// in each form a statement holds an expression as, as 'xc-ast --values'
// reads it.
//
// What xc refuses although it parses is refused here too, and its warnings
// said, as xc says them; a source's own commands (#command, #translate),
// and its include files', are found where it uses them, as xc finds them
// (commands.xtpl).
// -----------------------------------------------------------------------------

// The headers read for the file compiled, by their paths in lower case
// (.F. while one is read): each once -- {its name as the '#include' names
// it, its own types, the headers it includes, its path in lower case}.
Static hHeaders := Nil
#define HD_NAME      1
#define HD_OWN       2
#define HD_USES      3
#define HD_KEY       4

// The arguments as the AppServer gives them -- the program, its options
// among them -- or as xc-vm does.
User Function xcb(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10)
  Local aArgs := {}
  Local aEach := {p1, p2, p3, p4, p5, p6, p7, p8, p9, p10}
  Local nI
  Local cArg
  For nI := 1 To Len(aEach)
    cArg := If(ValType(aEach[nI]) == "C", aEach[nI], "")
    If cArg == "" .Or. Left(cArg, 1) == "-" .Or. ".exe" $ Lower(cArg) .Or. "appsrv" $ Lower(cArg)
      Loop
    EndIf
    AAdd(aArgs, cArg)
  Next
  If Len(aArgs) >= 2 .And. aArgs[1] == "bytecode"
    Return Bytecodes(aArgs)
  EndIf
  If Len(aArgs) >= 2 .And. (aArgs[1] == "ast" .Or. aArgs[1] == "facts" .Or. aArgs[1] == "values")
    Return Lists(aArgs[1], aArgs[2])
  EndIf
  ConOut("usage: xcb bytecode SOURCE [OUT] [includes=DIRS] [said] | bytecode LIST [includes=DIRS] [said] | " ;
         + "ast|facts|values LIST")
Return 2

// A source as bytecode: {the .xbc's text, what was said} -- the text Nil
// when it cannot be made, and what was said, a line each, as xc says it:
// the warnings, and why it is not made. aDirs: the include folders
// searched after the source's own.
User Function xcb_compile(cPath, aDirs)
  Local aSource
  Local cWhy
  Local aProg
  Local aDefines
  Local aSpans
  Local aUses
  Local aSaid
  If aDirs == Nil
    aDirs := {}
  EndIf
  If !File(cPath)
    Return {Nil, {cPath + ": cannot be read"}}
  EndIf
  aSource := ReadAll(cPath)
  cWhy := Utf8Reason(aSource[1])
  If cWhy != Nil
    Return {Nil, {cPath + ": " + cWhy}}
  EndIf
  If HeaderName(cPath) .And. FolderEnd(cPath) < Len(cPath) - 3
    Return {Nil, {cPath + ": a header (.xth) is made no bytecode: each source that includes it has its types"}}
  EndIf
  aSpans := Spans(aSource[1], FolderOf(cPath), aDirs)
  aProg := u_xcb_parse(aSource[1], aSource[2], aSpans, IsAdvpl(cPath))
  If aProg == Nil
    Return {Nil, NotParsed(aSource[1], cPath, u_xcb_furthest(), aSpans)}
  EndIf
  // The types of the headers it includes (.xth), each read and checked as a
  // file of its own, are its own too.
  hHeaders := { => }
  aUses := {}
  aSaid := {}
  If !LoadUses(aSource[1], FolderOf(cPath), aDirs, aUses, aSaid) .Or. !WithHeaders(aProg, aUses, cPath, aSaid)
    Return {Nil, aSaid}
  EndIf
  aDefines := IncludeDefines(aSource[1], FolderOf(cPath), aDirs)
Return Made(cPath, aProg, aSource[1], aDefines, ;
            u_xcb_checkall(aProg, Len(LinesOf(aSource[1], .F.)), aSource[1], IsAdvpl(cPath), .T., aDefines), ;
            Nil)

// What becomes of a program the checks have seen (aChecked: {errors,
// warnings}): {the .xbc's text, what was said}, as u_xcb_compile() gives
// it. aBc: the back end's {text, problems}, when it has run already.
Static Function Made(cPath, aProg, cText, aDefines, aChecked, aBc)
  Local aSaid := {}
  Local nP
  For nP := 1 To Len(aChecked[2])
    AAdd(aSaid, cPath + ":" + AllTrim(Str(aChecked[2][nP][1])) + ": warning: " + Cp1252ToUtf8(aChecked[2][nP][2]))
  Next
  If Len(aChecked[1]) > 0
    For nP := 1 To Len(aChecked[1])
      AAdd(aSaid, cPath + ":" + AllTrim(Str(aChecked[1][nP][1])) + ": " + Cp1252ToUtf8(aChecked[1][nP][2]))
    Next
    Return {Nil, aSaid}
  EndIf
  If aBc == Nil
    aBc := u_xcb_bytecode(aProg, cText, IsAdvpl(cPath), SourceName(cPath), aDefines)
  EndIf
  If aBc[1] == Nil
    For nP := 1 To Len(aBc[2])
      AAdd(aSaid, cPath + ":" + AllTrim(Str(aBc[2][nP][1])) + ": " + Cp1252ToUtf8(aBc[2][nP][2]) ;
                  + " cannot become bytecode yet")
    Next
    Return {Nil, aSaid}
  EndIf
Return {aBc[1], aSaid}

// 'bytecode SOURCE [OUT]', 'bytecode LIST': each made, and said so.
Static Function Bytecodes(aArgs)
  Local aDirs := {}
  Local aWork := {}
  Local nI
  Local cArg
  Local aLines
  Local nTab
  Local nBad := 0
  Local nStart
  Local aMade
  Local lSaid := .F.
  For nI := 2 To Len(aArgs)
    cArg := aArgs[nI]
    If Lower(Left(cArg, 9)) == "includes="
      aDirs := StrTran(SubStr(cArg, 10), ",", ";") |> split(";")
      aDirs := aDirs |> filter([d] !(d == ""))
    EndIf
    lSaid := lSaid .Or. Lower(cArg) == "said"
  Next
  cArg := aArgs[2]
  If IsSource(cArg)
    AAdd(aWork, {cArg, If(Len(aArgs) >= 3 .And. !IsOption(aArgs[3]), aArgs[3], Left(cArg, RAt(".", cArg)) + "xbc")})
  Else
    aLines := StrTran(ReadAll(cArg)[1], Chr(13), "") |> split(Chr(10))
    For nI := 1 To Len(aLines)
      nTab := At(Chr(9), aLines[nI])
      If nTab > 0
        AAdd(aWork, {Left(aLines[nI], nTab - 1), SubStr(aLines[nI], nTab + 1)})
      EndIf
    Next
  EndIf
  For nI := 1 To Len(aWork)
    nStart := Seconds()
    aMade := u_xcb_compile(aWork[nI][1], aDirs)
    AEval(aMade[2], {|l| ConOut(l)})
    If lSaid
      MemoWrite(SaidFile(aWork[nI][2]), Joined(aMade[2]))
    EndIf
    If aMade[1] == Nil
      nBad++
      Loop
    EndIf
    MemoWrite(aWork[nI][2], aMade[1])
    ConOut(aWork[nI][1] + " -> " + aWork[nI][2] + " (" + AllTrim(Str(Seconds() - nStart, 10, 2)) + " s)")
  Next
Return If(nBad > 0, 1, 0)

// An option of 'bytecode': 'includes=DIRS', 'said'.
Static Function IsOption(cArg)
Return Lower(Left(cArg, 9)) == "includes=" .Or. Lower(cArg) == "said"

// The file beside an .xbc for what is said of its source: NAME.said.
Static Function SaidFile(cXbc)
  Local nDot := RAt(".", cXbc)
Return If(nDot > FolderEnd(cXbc), Left(cXbc, nDot), cXbc + ".") + "said"

// Whether a file is a source: .xtpl, .prw, .prx, .tlpp.
Static Function IsSource(cPath)
  Local cExt := Lower(SubStr(cPath, RAt(".", cPath) + 1))
Return RAt(".", cPath) > 0 .And. (cExt == "xtpl" .Or. cExt == "prw" .Or. cExt == "prx" .Or. cExt == "tlpp")

// Why a source's bytes are UTF-8, not windows-1252 -- or Nil when they are
// windows-1252: they start with UTF-8's byte-order mark, or what is beyond
// ASCII in them is valid UTF-8 (driver.cpp's utf8_reason).
Static Function Utf8Reason(cB)
  Local cFix := "Protheus' sources are windows-1252 (cp1252): save it so"
  Local nFirst := 1
  Local cBefore
  If Left(cB, 3) == Chr(239) + Chr(187) + Chr(191)
    Return "it starts with UTF-8's byte-order mark. " + cFix
  EndIf
  While nFirst <= Len(cB) .And. Asc(SubStr(cB, nFirst, 1)) < 128
    nFirst++
  EndDo
  If nFirst > Len(cB)
    Return Nil
  EndIf
  If Utf8ToCp1252(cB) == Nil
    Return Nil
  EndIf
  cBefore := Left(cB, nFirst - 1)
Return "it is UTF-8 -- the first character beyond ASCII is on line " ;
       + AllTrim(Str(1 + Len(cBefore) - Len(StrTran(cBefore, Chr(10), "")))) + ". " + cFix

// What is said when a source does not parse, a line each: the line it
// stopped at, and why, as far as can be told (driver.cpp's not_parsed).
// aSpans: where it uses its own commands, as it was read.
Static Function NotParsed(cSrc, cPath, nFurthest, aSpans)
  Local nLine
  Local aL
  Local cText
  Local aNames := {}
  Local aProg
  Local aDecl
  Local aOut := {}
  Local nI
  If u_xcb_trim(SubStr(cSrc, nFurthest + 1)) == ""
    Return {cPath + ": the file ends inside a block that was never closed"}
  EndIf
  nLine := LineAt(cSrc, nFurthest)
  aL := LinesOf(cSrc, .F.)
  cText := If(nLine <= Len(aL), u_xcb_trim(aL[nLine]), "")
  // A name xc keeps for itself is refused by the grammar, which can only
  // say the line does not parse. Read again with any name allowed, the
  // checks say which name and why.
  u_xcb_anyname(.T.)
  aProg := u_xcb_parse(cSrc, Nil, aSpans)
  If aProg != Nil
    aNames := u_xcb_checknames(aProg)
  Else
    aDecl := Declaration(cText)
    If aDecl != Nil
      aNames := u_xcb_checkdeclared(aDecl)
      For nI := 1 To Len(aNames)
        aNames[nI][1] := nLine
      Next
    EndIf
  EndIf
  u_xcb_anyname(.F.)
  If Len(aNames) > 0
    For nI := 1 To Len(aNames)
      AAdd(aOut, cPath + ":" + AllTrim(Str(aNames[nI][1])) + ": " + Cp1252ToUtf8(aNames[nI][2]))
    Next
    Return aOut
  EndIf
  If LateDeclaration(cText)
    Return {cPath + ":" + AllTrim(Str(nLine)) + ": 'local' cannot be declared here: every local comes before the " ;
            + "first statement of its function or its block -- '" + Cp1252ToUtf8(cText) + "'"}
  EndIf
Return {cPath + ":" + AllTrim(Str(nLine)) + ": cannot parse this line: " + Cp1252ToUtf8(cText)}

// A text read whole as one declaration: the node, or Nil.
Static Function Declaration(cText)
  Local aRead
  u_xcb_source(cText, Nil)
  aRead := u_xcb_read(8, 0, .F.)
Return If(aRead[1] != Nil .And. aRead[2] == Len(cText), aRead[1], Nil)

// A 'local' where a statement was wanted (driver.cpp's late_declaration).
Static Function LateDeclaration(cText)
  If !(Len(cText) >= 5 .And. u_xcb_lc(Left(cText, 5)) == "local" ;
       .And. !(Len(cText) > 5 .And. u_xcb_isw(Asc(SubStr(cText, 6, 1)))))
    Return .F.
  EndIf
Return Declaration(u_xcb_trim(u_xcb_codeof(cText))) != Nil

// The line, from 1, an offset from 0 is on: a "\r\n" is one line end
// (driver.cpp's line_at).
Static Function LineAt(cSrc, nO)
  Local aStarts := {}
  Local nB := 0
  Local nI := 0
  Local nN := Len(cSrc)
  Local nRow := 0
  Local nLines
  Local nR
  Local cC
  While nI < nN
    cC := SubStr(cSrc, nI + 1, 1)
    If cC == Chr(10) .Or. cC == Chr(13)
      AAdd(aStarts, nB)
      nI += If(cC == Chr(13) .And. SubStr(cSrc, nI + 2, 1) == Chr(10), 2, 1)
      nB := nI
    Else
      nI++
    EndIf
  EndDo
  If nB < nN
    AAdd(aStarts, nB)
  EndIf
  nLines := Len(aStarts)
  AAdd(aStarts, nN)
  For nR := 1 To Len(aStarts)
    If aStarts[nR] <= nO
      nRow := nR - 1
    EndIf
  Next
Return Min(nRow + 1, Max(1, nLines))

// 'ast', 'facts', 'values' over a LIST.
Static Function Lists(cWhat, cList)
  Local aLines
  Local nI
  Local nTab
  Local aSource
  Local aProg
  Local cSource
  Local cText
  Local aCols
  Local nP
  Local aChecked
  Local aDefines
  Local cChecks
  Local nB
  aLines := StrTran(ReadAll(cList)[1], Chr(13), "") |> split(Chr(10))
  For nI := 1 To Len(aLines)
    nTab := At(Chr(9), aLines[nI])
    If nTab == 0
      Loop
    EndIf
    cSource := Left(aLines[nI], nTab - 1)
    aSource := ReadAll(cSource)
    If cWhat == "values"
      MemoWrite(SubStr(aLines[nI], nTab + 1), EachValue(aSource[1], aSource[2]))
      Loop
    EndIf
    aCols := SubStr(aLines[nI], nTab + 1) |> split(Chr(9))
    // As xc-ast --bare reads it: the source's own commands not looked for.
    aProg := u_xcb_parse(aSource[1], aSource[2], Nil, IsAdvpl(cSource))
    If aProg == Nil
      cText := "not parsed at " + AllTrim(Str(u_xcb_furthest())) + Chr(10)
      If cWhat == "facts" .And. Len(aCols) > 2
        MemoWrite(aCols[3], cText)
      EndIf
    ElseIf cWhat == "facts"
      // The checks first, on the tree as it was read, as 'xc-ast --checks'
      // has it: TL++'s, then bytecode's.
      aDefines := IncludeDefines(aSource[1], FolderOf(cSource), {})
      If Len(aCols) > 2
        cChecks := ""
        For nB := 1 To 2
          aChecked := u_xcb_checkall(aProg, Len(LinesOf(aSource[1], .F.)), aSource[1], IsAdvpl(cSource), nB == 2, ;
                                     aDefines)
          cChecks += If(nB == 2, "checks bytecode", "checks tlpp") + Chr(10)
          For nP := 1 To Len(aChecked[2])
            cChecks += "W " + AllTrim(Str(aChecked[2][nP][1])) + " " + aChecked[2][nP][2] + Chr(10)
          Next
          For nP := 1 To Len(aChecked[1])
            cChecks += "E " + AllTrim(Str(aChecked[1][nP][1])) + " " + aChecked[1][nP][2] + Chr(10)
          Next
        Next
        MemoWrite(aCols[3], cChecks)
      EndIf
      u_xcb_typed(aProg)
      cText := u_xcb_dump(aProg) + u_xcb_facts(aProg, IsAdvpl(cSource))
    Else
      cText := u_xcb_dump(aProg)
    EndIf
    MemoWrite(aCols[1], cText)
    If cWhat == "facts" .And. Len(aCols) > 1
      Compiled(cSource, aSource, aProg, aCols)
    EndIf
  Next
Return 0

// What xc makes of a source -- read with the commands it brings, when it
// brings some (aBare: as it was read without them) --, for 'facts': its
// bytecode, or what cannot become bytecode yet, a line each, to aCols[2];
// what compiling it says to aCols[4].
Static Function Compiled(cSource, aSource, aBare, aCols)
  Local aSpans := Spans(aSource[1], FolderOf(cSource), {})
  Local aProg := aBare
  Local cWhy := Utf8Reason(aSource[1])
  Local aDefines := IncludeDefines(aSource[1], FolderOf(cSource), {})
  Local aChecked
  Local aBc
  Local oErr
  Local cText
  Local nP
  Local aUses := {}
  Local aSaid := {}
  If aSpans != Nil
    aProg := u_xcb_parse(aSource[1], aSource[2], aSpans, IsAdvpl(cSource))
  EndIf
  If aProg == Nil
    If Len(aCols) > 3
      MemoWrite(aCols[4], Joined(If(cWhy != Nil, {cSource + ": " + cWhy}, ;
                                    NotParsed(aSource[1], cSource, u_xcb_furthest(), aSpans))))
    EndIf
    Return Nil
  EndIf
  // Its headers' types, as u_xcb_compile() has them.
  hHeaders := { => }
  If !LoadUses(aSource[1], FolderOf(cSource), {}, aUses, aSaid) .Or. !WithHeaders(aProg, aUses, cSource, aSaid)
    MemoWrite(aCols[2], "")
    If Len(aCols) > 3
      MemoWrite(aCols[4], Joined(aSaid))
    EndIf
    Return Nil
  EndIf
  aChecked := u_xcb_checkall(aProg, Len(LinesOf(aSource[1], .F.)), aSource[1], IsAdvpl(cSource), .T., aDefines)
  // A source xc refuses may take the back end where the C++ reads what is
  // not there: what goes wrong is said, and the next one read.
  Try
    aBc := u_xcb_bytecode(aProg, aSource[1], IsAdvpl(cSource), SourceName(cSource), aDefines)
  Catch oErr
    aBc := {"error: " + oErr:Description + Chr(10), {}}
  EndTry
  cText := aBc[1]
  If cText == Nil
    cText := ""
    For nP := 1 To Len(aBc[2])
      cText += AllTrim(Str(aBc[2][nP][1])) + ": " + Cp1252ToUtf8(aBc[2][nP][2]) + " cannot become bytecode yet" ;
               + Chr(10)
    Next
  EndIf
  MemoWrite(aCols[2], cText)
  If Len(aCols) > 3
    MemoWrite(aCols[4], Joined(If(cWhy != Nil, {cSource + ": " + cWhy}, ;
                                  Made(cSource, aProg, aSource[1], aDefines, aChecked, aBc)[2])))
  EndIf
Return Nil

// Where a source uses its own commands and translations, for u_xcb_parse()
// -- Nil for nowhere (commands.cpp's user_spans).
Static Function Spans(cText, cDir, aDirs)
  Local aSp
  If !u_xcb_mentionsdirective(cText)
    Return Nil
  EndIf
  aSp := u_xcb_userspans(cText, IncludeTexts(cText, cDir, aDirs))
Return If(Len(keys(aSp[1])) == 0 .And. Len(keys(aSp[2])) == 0, Nil, aSp)

// Lines, each ended.
Static Function Joined(aLines)
  Local cOut := ""
  Local nI
  For nI := 1 To Len(aLines)
    cOut += aLines[nI] + Chr(10)
  Next
Return cOut

// Each line of a text a value, as 'xc-ast --values' reads them: where it
// starts and ends, then the node.
Static Function EachValue(cText, aCodes)
  Local cOut := ""
  Local nAt := 0
  Local nNext
  Local nK
  Local nN := Len(aCodes)
  Local aRead
  Local nForm
  u_xcb_source(cText, aCodes)
  While nAt < nN
    nNext := nAt
    While nNext < nN .And. aCodes[nNext + 1] != 10
      nNext++
    EndDo
    nNext := Min(nNext + 1, nN)
    nK := nAt
    While nK < nNext .And. (aCodes[nK + 1] == 32 .Or. aCodes[nK + 1] == 9)
      nK++
    EndDo
    If !(nK >= nN .Or. aCodes[nK + 1] == 10 .Or. aCodes[nK + 1] == 13 .Or. ;
         (aCodes[nK + 1] == 47 .And. nK + 1 < nN .And. aCodes[nK + 2] == 47))
      For nForm := 1 To 7
        aRead := u_xcb_read(nForm, nK, .F.)
        cOut += "@" + AllTrim(Str(nK)) + " form " + AllTrim(Str(nForm)) + " end " + AllTrim(Str(aRead[2])) + Chr(10) ;
                + u_xcb_dumpexpr(aRead[1])
      Next
    EndIf
    nAt := nNext
  EndDo
Return cOut

// Whether a source is AdvPL: a .prw or a .prx (driver.cpp's is_advpl).
Static Function IsAdvpl(cPath)
  Local nDot := RAt(".", cPath)
  Local cExt
  If nDot == 0 .Or. At("/", SubStr(cPath, nDot)) > 0 .Or. At("\", SubStr(cPath, nDot)) > 0
    Return .F.
  EndIf
  cExt := u_xcb_lc(SubStr(cPath, nDot + 1))
Return cExt == "prw" .Or. cExt == "prx"

// The name of a source, its folders aside, for the .xbc's 'source' line;
// the folder it is in. '/' or '\' ends a folder.
Static Function SourceName(cPath)
Return SubStr(cPath, FolderEnd(cPath) + 1)

Static Function FolderOf(cPath)
  Local nCut := FolderEnd(cPath)
Return If(nCut > 0, Left(cPath, nCut - 1), ".")

Static Function FolderEnd(cPath)
Return Max(RAt("/", cPath), RAt("\", cPath))

// ---- headers ----------------------------------------------------------------
// A header (.xth) a file includes: read, parsed and checked as a file of its
// own, the headers it includes first; its types are the file's too
// (driver.cpp's load_header()) -- HD_*.
Static Function HeaderName(cN)
Return Len(cN) > 4 .And. u_xcb_lc(Right(cN, 4)) == ".xth"

// Where an include file is: the folder of the file that includes it, then
// the include folders; "" when it is in none.
Static Function FindInclude(cName, cDir, aDirs)
  Local aPlaces := {cDir}
  Local nP
  For nP := 1 To Len(aDirs)
    AAdd(aPlaces, aDirs[nP])
  Next
  For nP := 1 To Len(aPlaces)
    If File(InFolder(aPlaces[nP], cName))
      Return InFolder(aPlaces[nP], cName)
    EndIf
  Next
Return ""

// What a header holds that is no type and no directive: each source that
// includes it would have its own. {line, what}, by line.
Static Function NotHeader(aProg)
  Local aOut := {}
  Local cNo := ": a header (.xth) holds types and directives, nothing else."
  Local nI
  For nI := 1 To Len(aProg[PG_FUNCTIONS])
    If Empty(aProg[PG_FUNCTIONS][nI][FN_OFTYPE])
      AAdd(aOut, {aProg[PG_FUNCTIONS][nI][N_LINE], "'" + aProg[PG_FUNCTIONS][nI][FN_NAME] + "' is a function" + cNo})
    EndIf
  Next
  For nI := 1 To Len(aProg[PG_CLASSES])
    AAdd(aOut, {aProg[PG_CLASSES][nI][N_LINE], "'" + aProg[PG_CLASSES][nI][CD_NAME] + "' is a class" + cNo})
  Next
  For nI := 1 To Len(aProg[PG_METHODS])
    AAdd(aOut, {aProg[PG_METHODS][nI][N_LINE], "'" + aProg[PG_METHODS][nI][MI_NAME] + "' is a method of a class" + cNo})
  Next
  For nI := 1 To Len(aProg[PG_STATICS])
    AAdd(aOut, {aProg[PG_STATICS][nI][N_LINE], "a Static" + cNo})
  Next
Return ByLine(aOut)

// {line, what} pairs in the order of their lines, those of a line as they
// came.
Static Function ByLine(aIn)
  Local aOut := {}
  Local aLines := {}
  Local nI
  Local nJ
  For nI := 1 To Len(aIn)
    If AScan(aLines, aIn[nI][1]) == 0
      AAdd(aLines, aIn[nI][1])
    EndIf
  Next
  ASort(aLines)
  For nJ := 1 To Len(aLines)
    For nI := 1 To Len(aIn)
      If aIn[nI][1] == aLines[nJ]
        AAdd(aOut, aIn[nI])
      EndIf
    Next
  Next
Return aOut

// The types of the headers given, and of theirs, each once -- those of the
// headers a header includes before its own.
Static Function TypesOf(aUses, aOut, hSeen)
  Local nI
  Local nJ
  Local aU
  For nI := 1 To Len(aUses)
    aU := aUses[nI]
    If hSeen has aU[HD_KEY]
      Loop
    EndIf
    hSeen{aU[HD_KEY]} := .T.
    TypesOf(aU[HD_USES], aOut, hSeen)
    For nJ := 1 To Len(aU[HD_OWN])
      AAdd(aOut, aU[HD_OWN][nJ])
    Next
  Next
Return Nil

// The headers' types put before a file's own: .F., with what is said, when
// two of them have the same name.
Static Function WithHeaders(aProg, aUses, cIn, aSaid)
  Local aMore := {}
  Local hNames := { => }
  Local nI
  Local aT
  Local cK
  TypesOf(aUses, aMore, { => })
  For nI := 1 To Len(aMore)
    aT := aMore[nI]
    cK := u_xcb_lc(aT[TD_NAME])
    If hNames has cK
      AAdd(aSaid, cIn + ": '" + Cp1252ToUtf8(aT[TD_NAME]) + "' is a type of " + Cp1252ToUtf8(hNames{cK}[TD_HEADER]) ;
                  + " and of " + Cp1252ToUtf8(aT[TD_HEADER]))
      Return .F.
    EndIf
    hNames{cK} := aT
  Next
  For nI := 1 To Len(aProg[PG_TYPES])
    AAdd(aMore, aProg[PG_TYPES][nI])
  Next
  aProg[PG_TYPES] := aMore
Return .T.

// The headers a text includes, each loaded into aUses: .F., with what is
// said, when one cannot be.
Static Function LoadUses(cText, cDir, aDirs, aUses, aSaid)
  Local aNames := IncludesOf(cText)
  Local aH
  Local nI
  For nI := 1 To Len(aNames)
    If !HeaderName(aNames[nI])
      Loop
    EndIf
    aH := LoadHeader(aNames[nI], cDir, aDirs, aSaid)
    If aH == Nil
      Return .F.
    EndIf
    AAdd(aUses, aH)
  Next
Return .T.

// A header read and checked as a file of its own -- what is wrong with it
// said of it, as compiling it says it --, then its types marked as its, for
// the files that include it.
Static Function LoadHeader(cName, cDir, aDirs, aSaid)
  Local cPath := FindInclude(cName, cDir, aDirs)
  Local cKey
  Local aSrc
  Local cWhy
  Local cHdir
  Local aUses := {}
  Local aSpans
  Local aProg
  Local aH
  Local aWrong
  Local aChecked
  Local nI
  If cPath == ""
    AAdd(aSaid, Cp1252ToUtf8(cName) + ": no such header, in the folder of the file that includes it or in the " ;
                + "include folders")
    Return Nil
  EndIf
  cKey := u_xcb_lc(cPath)
  If hHeaders has cKey
    If ValType(hHeaders{cKey}) == "L"
      AAdd(aSaid, Cp1252ToUtf8(cName) + ": it includes itself, through the headers it includes")
      Return Nil
    EndIf
    Return hHeaders{cKey}
  EndIf
  hHeaders{cKey} := .F.
  aSrc := ReadAll(cPath)
  cWhy := Utf8Reason(aSrc[1])
  If cWhy != Nil
    AAdd(aSaid, Cp1252ToUtf8(cName) + ": " + cWhy)
    Return Nil
  EndIf
  cHdir := FolderOf(cPath)
  If !LoadUses(aSrc[1], cHdir, aDirs, aUses, aSaid)
    Return Nil
  EndIf
  aSpans := Spans(aSrc[1], cHdir, aDirs)
  aProg := u_xcb_parse(aSrc[1], aSrc[2], aSpans)
  If aProg == Nil
    aWrong := NotParsed(aSrc[1], cName, u_xcb_furthest(), aSpans)
    For nI := 1 To Len(aWrong)
      AAdd(aSaid, aWrong[nI])
    Next
    Return Nil
  EndIf
  aH := {cName, {}, aUses, cKey}
  For nI := 1 To Len(aProg[PG_TYPES])
    AAdd(aH[HD_OWN], aProg[PG_TYPES][nI])
  Next
  If !WithHeaders(aProg, aUses, cName, aSaid)
    Return Nil
  EndIf
  aWrong := NotHeader(aProg)
  aChecked := u_xcb_checkall(aProg, Len(LinesOf(aSrc[1], .F.)), aSrc[1], .F., .T., IncludeDefines(aSrc[1], cHdir, aDirs))
  For nI := 1 To Len(aChecked[1])
    AAdd(aWrong, aChecked[1][nI])
  Next
  aWrong := ByLine(aWrong)
  For nI := 1 To Len(aWrong)
    AAdd(aSaid, Cp1252ToUtf8(cName) + ":" + AllTrim(Str(aWrong[nI][1])) + ": " + Cp1252ToUtf8(aWrong[nI][2]))
  Next
  If Len(aWrong) > 0
    Return Nil
  EndIf
  For nI := 1 To Len(aH[HD_OWN])
    aH[HD_OWN][nI][TD_HEADER] := cName
  Next
  hHeaders{cKey} := aH
Return aH

// ---- include files ----------------------------------------------------------
// The '#define' lines of the include files a source names, and those they
// name (commands.cpp's include_defines).
Static Function IncludeDefines(cText, cDir, aDirs)
  Local aOut := {}
  AEval(IncludeTexts(cText, cDir, aDirs), {|t| DefinesOf(t, aOut)})
Return aOut

// The texts of the include files a source names, and of those they name --
// each found beside the source, then in each folder of aDirs, each once, in
// the order found (commands.cpp's each_include). TOTVS' compressed ones
// ('#zip') are skipped.
Static Function IncludeTexts(cText, cDir, aDirs)
  Local aOut := {}
  Local hSeen := { => }
  Local aTodo := IncludesOf(cText)
  Local nNext := 1
  Local cName
  Local aPlaces
  Local nP
  Local cT
  While nNext <= Len(aTodo)
    cName := aTodo[nNext]
    nNext++
    If hSeen has u_xcb_lc(cName)
      Loop
    EndIf
    hSeen{u_xcb_lc(cName)} := .T.
    aPlaces := {cDir}
    For nP := 1 To Len(aDirs)
      AAdd(aPlaces, aDirs[nP])
    Next
    For nP := 1 To Len(aPlaces)
      If !File(InFolder(aPlaces[nP], cName))
        Loop
      EndIf
      cT := IncludeText(InFolder(aPlaces[nP], cName))
      If cT != Nil
        AAdd(aOut, cT)
        AEval(IncludesOf(cT), {|x| AAdd(aTodo, x)})
      EndIf
      Exit
    Next
  EndDo
Return aOut

// A file in a folder, with the folder's own separator: an AppServer's
// '\xbc', a '/' anywhere else.
Static Function InFolder(cDir, cName)
Return cDir + If("\" $ cDir, "\", "/") + cName

// The names a text includes: '#include "x.ch"', '<x.ch>' or 'x.ch' in
// single quotes.
Static Function IncludesOf(cText)
  Local aOut := {}
  Local aL := LinesOf(cText, .T.)
  Local nI
  Local cL
  Local nK
  Local nB
  Local cQ
  For nI := 1 To Len(aL)
    cL := aL[nI]
    nK := SkipH(cL, 1)
    If !(SubStr(cL, nK, 1) == "#")
      Loop
    EndIf
    nK := SkipH(cL, nK + 1)
    If !(Lower(SubStr(cL, nK, 7)) == "include")
      Loop
    EndIf
    nK := SkipH(cL, nK + 7)
    cQ := SubStr(cL, nK, 1)
    If !(cQ == '"' .Or. cQ == "'" .Or. cQ == "<")
      Loop
    EndIf
    nK++
    nB := nK
    While nK <= Len(cL) .And. !(SubStr(cL, nK, 1) $ ('"' + "'>"))
      nK++
    EndDo
    If nK == nB .Or. nK > Len(cL)
      Loop
    EndIf
    AAdd(aOut, u_xcb_trim(SubStr(cL, nB, nK - nB)))
  Next
Return aOut

// The '#define' lines of a text, from their '#'.
Static Function DefinesOf(cText, aOut)
  Local aL := LinesOf(cText, .F.)
  Local nI
  Local cL
  Local nK
  Local nW
  For nI := 1 To Len(aL)
    cL := aL[nI]
    nK := SkipH(cL, 1)
    If !(SubStr(cL, nK, 1) == "#")
      Loop
    EndIf
    nW := SkipH(cL, nK + 1)
    If Lower(SubStr(cL, nW, 6)) == "define" .And. nW + 6 <= Len(cL) .And. u_xcb_ish(Asc(SubStr(cL, nW + 6, 1)))
      AAdd(aOut, SubStr(cL, nK))
    EndIf
  Next
Return Nil

// Past the blanks of \h from a place, from 1.
Static Function SkipH(cL, nK)
  While nK <= Len(cL) .And. u_xcb_ish(Asc(SubStr(cL, nK, 1)))
    nK++
  EndDo
Return nK

// Raku's .lines: split at "\r\n", "\n" and "\r"; no empty last line. lKeep:
// each line with its line end.
Static Function LinesOf(cText, lKeep)
  Local aOut := {}
  Local nB := 1
  Local nI := 1
  Local nN := Len(cText)
  Local cC
  Local nE
  While nI <= nN
    cC := SubStr(cText, nI, 1)
    If cC == Chr(13) .Or. cC == Chr(10)
      nE := nI + If(cC == Chr(13) .And. SubStr(cText, nI + 1, 1) == Chr(10), 2, 1)
      AAdd(aOut, SubStr(cText, nB, If(lKeep, nE, nI) - nB))
      nI := nE
      nB := nI
    Else
      nI++
    EndIf
  EndDo
  If nB <= nN
    AAdd(aOut, SubStr(cText, nB))
  EndIf
Return aOut

// An include file's text, as windows-1252 when it is UTF-8: Nil for one of
// TOTVS' compressed ones.
Static Function IncludeText(cPath)
  Local cT := ReadAll(cPath)[1]
  Local cOut
  If Left(cT, 4) == "#zip"
    Return Nil
  EndIf
  cOut := Utf8ToCp1252(cT)
Return If(cOut == Nil, cT, cOut)

// UTF-8 as windows-1252 (chars.cpp's utf8_to_cp1252): Nil when it is not
// UTF-8; a character windows-1252 does not have is '?'.
Static Function Utf8ToCp1252(cIn)
  Local cOut := ""
  Local nI := 1
  Local nLen := Len(cIn)
  Local nB
  Local nCp
  Local nN
  Local nK
  Local nC
  Local nAt
  Local aHigh := {{8364, 128}, {8218, 130}, {402, 131}, {8222, 132}, {8230, 133}, {8224, 134}, {8225, 135}, ;
                  {710, 136}, {8240, 137}, {352, 138}, {8249, 139}, {338, 140}, {381, 142}, {8216, 145}, ;
                  {8217, 146}, {8220, 147}, {8221, 148}, {8226, 149}, {8211, 150}, {8212, 151}, {732, 152}, ;
                  {8482, 153}, {353, 154}, {8250, 155}, {339, 156}, {382, 158}, {376, 159}}
  While nI <= nLen
    nB := Asc(SubStr(cIn, nI, 1))
    Do Case
      Case nB < 128
        nCp := nB
        nN := 0
      Case Int(nB / 32) == 6
        nCp := nB % 32
        nN := 1
      Case Int(nB / 16) == 14
        nCp := nB % 16
        nN := 2
      Case Int(nB / 8) == 30
        nCp := nB % 8
        nN := 3
      Otherwise
        Return Nil
    EndCase
    For nK := 1 To nN
      If nI + nK > nLen
        Return Nil
      EndIf
      nC := Asc(SubStr(cIn, nI + nK, 1))
      If Int(nC / 64) != 2
        Return Nil
      EndIf
      nCp := nCp * 64 + nC % 64
    Next
    If (nN == 1 .And. nCp < 128) .Or. (nN == 2 .And. nCp < 2048) .Or. (nN == 3 .And. nCp < 65536) ;
       .Or. nCp > 1114111 .Or. (nCp >= 55296 .And. nCp <= 57343)
      Return Nil
    EndIf
    If nCp < 256
      cOut += Chr(nCp)
    Else
      nAt := AScan(aHigh, {|h| h[1] == nCp})
      cOut += If(nAt > 0, Chr(aHigh[nAt][2]), "?")
    EndIf
    nI += nN + 1
  EndDo
Return cOut

// Windows-1252 as UTF-8, as the C++ xc says what it finds (chars.cpp's
// cp1252_to_utf8): the five bytes windows-1252 leaves undefined as the
// characters of the same number.
Static Function Cp1252ToUtf8(cIn)
  Local cOut := ""
  Local nI
  Local nC
  Local nU
  Local aHigh := {8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143, 144, ;
                  8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376}
  For nI := 1 To Len(cIn)
    nC := Asc(SubStr(cIn, nI, 1))
    nU := If(nC >= 128 .And. nC < 160, aHigh[nC - 127], nC)
    If nU < 128
      cOut += Chr(nU)
    ElseIf nU < 2048
      cOut += Chr(192 + Int(nU / 64)) + Chr(128 + nU % 64)
    Else
      cOut += Chr(224 + Int(nU / 4096)) + Chr(128 + Int(nU / 64) % 64) + Chr(128 + nU % 64)
    EndIf
  Next
Return cOut

// A file's text, and its bytes' codes, read a piece at a time.
Static Function ReadAll(cPath)
  Local nH := FOpen(cPath)
  Local cBuf := Space(4096)
  Local cText := ""
  Local aCodes := {}
  Local nGot
  Local nI
  Local cPart
  If nH < 0
    Return {"", {}}
  EndIf
  While .T.
    nGot := FRead(nH, @cBuf, 4096)
    If nGot <= 0
      Exit
    EndIf
    cPart := Left(cBuf, nGot)
    cText += cPart
    For nI := 1 To nGot
      AAdd(aCodes, Asc(SubStr(cPart, nI, 1)))
    Next
  EndDo
  FClose(nH)
Return {cText, aCodes}
